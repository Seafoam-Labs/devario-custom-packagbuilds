pkgbase = tern
	pkgdesc = Rust-native terminal workspace with persistent daemon sessions, by Stencil
	pkgver = 0.9.28
	pkgrel = 1
	url = https://stencil.so/tern
	arch = x86_64
	license = LicenseRef-Tern
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = hicolor-icon-theme
	depends = libglvnd
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = webkitgtk-4.1: browser panes (WebKitGTK backend)
	optdepends = libwpe: browser panes (WPEWebKit backend)
	optdepends = libwpebackend-fdo: WPEWebKit Wayland backend
	optdepends = pipewire: screen sharing panes
	optdepends = libpulse: audio playback (libpulse-simple)
	optdepends = zenity: file, save and confirmation dialogs
	optdepends = kdialog: alternative dialogs on Plasma
	optdepends = git: git panes and repository registration
	optdepends = openssh: remote hosts and SSH panes
	optdepends = xdg-utils: open links in the default browser
	optdepends = libnotify: desktop notifications via notify-send
	optdepends = libsecret: credential storage via secret-tool
	optdepends = bubblewrap: sandboxed panes
	optdepends = perf: perf since marks in the task manager
	options = !strip
	options = !debug
	source = Tern-0.9.28-linux-x86_64.tar.gz
