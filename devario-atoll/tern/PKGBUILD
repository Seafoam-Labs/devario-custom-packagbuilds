# Tern is closed-source, closed-beta software: builds are published only to
# signed-in Stencil accounts at https://build.stencil.so/tern, and anonymous
# requests redirect to https://auth.stencil.so/login (the builds API,
# https://build.stencil.so/api/products/tern/builds, answers 401). The tarball
# therefore cannot be a remote source here. While signed in, download
# Tern-$pkgver-linux-x86_64.tar.gz (the glibc build; the musl variant is not
# for this distribution) and place it, under that exact name, next to this
# PKGBUILD before building. Do not redistribute the tarball or the package.
#
# To move to a newer build: pick it at https://build.stencil.so/tern, update
# pkgver, drop the new tarball beside this PKGBUILD and pin its checksum:
#   printf 'y\n' | shelly build --updpkgsums PKGBUILD
# The build service publishes a sha256 per file in its builds API; the pin
# below is the one published for this artifact by the plumj-am/nixos Nix
# packaging (packages/tern/tern.nix).
#
# The tarball holds a single self-contained tern/tern binary. DT_NEEDED is
# only glibc, libstdc++ and libgcc_s; every other library is dlopen'd at
# runtime, so the feature libraries are optdepends. The dependency set follows
# the Nix packagings of the same artifact (theoparis/nix-tern, plumj-am/nixos,
# tdortman/dotfiles), which diff `strings` output between releases: wgpu's
# Vulkan + EGL/GLES chain, Wayland and X11 (libxcb since 0.5.0, selected with
# STENCIL_DISPLAY_SERVER), WebKitGTK/WPEWebKit for browser panes, libpipewire
# for screen sharing and libpulse-simple since 0.7.0. Unlike those Nix
# wrappers, no LD_LIBRARY_PATH or XDG_DATA_DIRS wrapper is needed here: the
# libraries, GIO modules and GSettings schemas live in the default prefixes.
#
# Not to be confused with the hosted tour and hook tool at https://tern.sh,
# which also ships a binary named `tern`.

pkgname=tern
pkgver=0.9.28
pkgrel=1
pkgdesc='Rust-native terminal workspace with persistent daemon sessions, by Stencil'
arch=('x86_64')
url='https://stencil.so/tern'
license=('LicenseRef-Tern')
depends=(
  'gcc-libs'           # libstdc++, libgcc_s
  'glib2'              # dlopen'd; gdbus for the settings portal
  'glibc'
  'hicolor-icon-theme'
  'libglvnd'           # EGL / GLES fallback for wgpu
  'libxcb'             # X11 backend
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'  # wgpu's primary backend
  'wayland'
)
optdepends=(
  'webkitgtk-4.1: browser panes (WebKitGTK backend)'
  'libwpe: browser panes (WPEWebKit backend)'
  'libwpebackend-fdo: WPEWebKit Wayland backend'
  'pipewire: screen sharing panes'
  'libpulse: audio playback (libpulse-simple)'
  'zenity: file, save and confirmation dialogs'
  'kdialog: alternative dialogs on Plasma'
  'git: git panes and repository registration'
  'openssh: remote hosts and SSH panes'
  'xdg-utils: open links in the default browser'
  'libnotify: desktop notifications via notify-send'
  'libsecret: credential storage via secret-tool'
  'bubblewrap: sandboxed panes'
  'perf: perf since marks in the task manager'
)
# Prebuilt proprietary binary. Stripping is not merely useless here: strip
# rewrites the ELF from its section headers and drops the embedded font
# segment, which has none, breaking the bundled fonts.
options=('!strip' '!debug')
source=("Tern-$pkgver-linux-x86_64.tar.gz")
sha256sums=('8322a3abbfca1d829a7280aa6f2532338ee8fdbfbd4773c1f4c2e4f063d38dd4')

package() {
  install -Dm755 "$srcdir/tern/tern" "$pkgdir/usr/bin/tern"

  # `tern register` writes the official desktop entries and hicolor icons
  # under $HOME/.local/share. Run it against a scratch HOME so they can be
  # shipped system-wide, then rewrite Exec from the build root to the
  # installed path. Tern also self-registers per user at runtime
  # (~/.local/bin/tern and per-user entries); that is harmless here because
  # /usr/bin/tern is a stable path.
  local home="$srcdir/register-home"
  install -dm755 "$home"
  HOME="$home" XDG_DATA_HOME="$home/.local/share" TERN_CONFIG_DIR="$home/.config" \
    "$pkgdir/usr/bin/tern" register

  local apps="$pkgdir/usr/share/applications"
  install -dm755 "$apps"
  cp -a "$home/.local/share/applications/." "$apps/"
  if [ -d "$home/.local/share/icons" ]; then
    cp -a "$home/.local/share/icons" "$pkgdir/usr/share/"
    # Regenerated by the icon-theme hook on install.
    rm -f "$pkgdir/usr/share/icons/hicolor/icon-theme.cache"
  fi

  [ -f "$apps/so.stencil.tern.desktop" ] || {
    echo 'tern register did not write the expected desktop entries' >&2
    return 1
  }
  sed -i "s|$pkgdir||g" "$apps/"*.desktop
  # Only the main launcher may claim windows; the hidden MIME handler would
  # otherwise compete with it for taskbar grouping.
  if [ -f "$apps/so.stencil.tern.open.desktop" ]; then
    sed -i '/^StartupWMClass=/d' "$apps/so.stencil.tern.open.desktop"
  fi

  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  cat >"$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Tern" <<'EOF'
Tern is proprietary, closed-source software of Stencil Labs, Inc., published
in closed beta through https://build.stencil.so to signed-in Stencil accounts
(https://auth.stencil.so). Builds are not publicly redistributable: every user
downloads their own tarball under their Stencil account terms. This package
repackages a user-provided tarball and adds no Tern code or assets of its own.
EOF
}