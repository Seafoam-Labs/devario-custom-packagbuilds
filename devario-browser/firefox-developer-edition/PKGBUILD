# Maintainer: Andrew Crerar <crerar@archlinux.org>
# Contributor: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=firefox-developer-edition
pkgver=160.0b3
pkgrel=1
pkgdesc="Fast, Private & Safe Web Browser (Developer Edition)"
url="https://www.mozilla.org/firefox/developer/"
arch=(x86_64)
license=(MPL-2.0)
# Mozilla's linux-x86_64 payload carries its own nspr, nss, sqlite3, codec and
# onnxruntime libraries, so those are not dependencies here; this list is the
# payload's DT_NEEDED closure minus what it ships itself. libatk-1.0.so.0 and
# libatk-bridge-2.0.so.0 come from at-spi2-core, which provides atk here, and
# libpulse is dlopened by the payload's cubeb backend rather than linked.
depends=(
  alsa-lib
  at-spi2-core
  bash
  cairo
  dbus
  fontconfig
  freetype2
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgcc
  libpulse
  libstdc++
  libx11
  libxcb
  libxcomposite
  libxcursor
  libxdamage
  libxext
  libxfixes
  libxi
  libxrandr
  libxrender
  mime-types
  pango
  ttf-font
)
optdepends=(
  'hunspell-dictionary: Spell checking'
  'libnotify: Notification integration'
  'networkmanager: Location detection via available WiFi networks'
  'speech-dispatcher: Text-to-Speech'
  'xdg-desktop-portal: Screensharing with Wayland'
)
# The payload ships stripped and already carries Mozilla's own optimization and
# hardening; re-stripping would rewrite binaries Mozilla signs.
options=(!strip)
# The payload's own remoting name. The source build renamed it to $pkgname so the
# channels could coexist; firefox-dev is already distinct from firefox and
# firefox-beta, so the rename is gone and the integration files follow the
# payload instead of $pkgname.
_remoting=firefox-dev
# Mozilla's official build is keyed with Google API keys registered to Mozilla
# itself, which the payload ships embedded in browser/omni.ja. Unkeying it would
# mean editing the payload, unlike the keyless source build in GOOGLE-API-KEYS.md.
source=(
  https://archive.mozilla.org/pub/devedition/releases/$pkgver/linux-x86_64/en-US/firefox-$pkgver.tar.xz{,.asc}
  $pkgname-symbolic.svg
  $pkgname.desktop
  org.mozilla.$pkgname.metainfo.xml
  # The builder ships local sources as flat related-file names and rejects any
  # path separator, so this copy of the license text sits beside the PKGBUILD
  # rather than in the LICENSES/ directory that holds it for REUSE.
  MPL-2.0.txt
)
validpgpkeys=(
  # Mozilla Software Releases <release@mozilla.com>
  # https://blog.mozilla.org/security/2026-08-10/updated-gpg-key-for-signing-firefox-and-thunderbird-releases/
  14F26682D0916CDD81E37B6D61B7B526D98F0353
)
sha256sums=('a35ccb3e514191326da6d1cb90675a57948db0470f38377de5f3095b4b9b32d9'
            'SKIP'
            'a9b8b4a0a1f4a7b4af77d5fc70c2686d624038909263c795ecc81e0aec7711e9'
            '2eaa7e9df839d4c25259b8ad3f12f46a126e194114fae66e5bfd5731ca45c8f0'
            '48e33f75f3760387305997ee0a3fcea030a1e7310fc461e92d7b73e6cf600096'
            '66a3107d5ad6a058aab753eaac2047ccb2ed0e39465dd0fe5844da3e300d5172')
b2sums=('7258e944ede8d6e0b0c0bae270e40cf0d6cc48af17b520dc548f3b6a4319b329bd3171222eba0fc8b5a1b590b3c1657e540536d247f698881f66ee21dc0a7f91'
        'SKIP'
        '63a8dd9d8910f9efb353bed452d8b4b2a2da435857ccee083fc0c557f8c4c1339ca593b463db320f70387a1b63f1a79e709e9d12c69520993e26d85a3d742e34'
        '1c2d9d33210d6052c2684e1efda3057114fa55890db97829b037b397fc03ed647262053304305d702ef9c3dcb03bea439abd5bb24c8be097b48a700752c9ce11'
        '826db294d078c66e6bf3561c3c6de32d7522251b2ccbd47ab26fb6380988f117d854a726c36f45ddd2e846a1456ca0f6c883733d1c660351430f2d1fbc95b1eb'
        'e57391102771f85905986aac45cb923f1738fe96ec4a520bad9a79ce68e7a5b14898cdc97d17d84dc8aff7c5aa2aab853701ef8b27c6a5fe9c1f634c19ca9d9b')

package() {
  local appdir="$pkgdir/usr/lib/$pkgname"

  # Repack of Mozilla's build, copied as shipped: its bundled libraries, its
  # updater, the .sig files its content security reads, and its distribution.ini,
  # which identifies the payload as the official build that the update and crash
  # reporter endpoints expect.
  install -dm755 "$appdir"
  cp -a "$srcdir/firefox/." "$appdir/"

  # Mozilla's own "the package manager owns updates" marker, which its .deb ships
  # and this payload reads. Without it the tarball self-updates from
  # aus5.mozilla.org on app.update.channel=aurora behind pacman's back.
  : > "$appdir/is-packaged-app"

  # defaults/pref is the prefs directory this layout reads from disk;
  # browser/defaults/preferences exists only inside browser/omni.ja here.
  install -Dvm644 /dev/stdin "$appdir/defaults/pref/vendor.js" <<END
// Use LANG environment variable to choose locale
pref("intl.locale.requested", "");

// Use system-provided dictionaries
pref("spellchecker.dictionary_path", "/usr/share/hunspell");

// Disable default browser checking.
pref("browser.shell.checkDefaultBrowser", false);

// Don't disable extensions in the application directory
pref("extensions.autoDisableScopes", 11);

// Enable GNOME Shell search provider
pref("browser.gnome-search-provider.enabled", true);
END

  # Install desktop icons and metadata
  local i
  for i in 16 32 48 64 128; do
    install -Dvm644 "$appdir/browser/chrome/icons/default/default$i.png" \
      "$pkgdir/usr/share/icons/hicolor/${i}x${i}/apps/$pkgname.png"
  done

  install -Dvm644 "$srcdir/$pkgname-symbolic.svg" -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"
  install -Dvm644 "$srcdir/$pkgname.desktop" -t "$pkgdir/usr/share/applications"
  install -Dvm644 "$srcdir/org.mozilla.$pkgname.metainfo.xml" -t "$pkgdir/usr/share/metainfo"

  # Install a wrapper to avoid confusion about binary path
  install -Dvm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<END
#!/bin/sh
exec /usr/lib/$pkgname/firefox "\$@"
END

  # The payload's own firefox-bin stays the binary it ships: the source build's
  # wrapper symlink existed to replace a duplicate that is not present here.
  # https://bugzilla.mozilla.org/show_bug.cgi?id=658850

  # Bundled NSS ships no libnssckbi.so and validates certificates without one, so
  # the source build's system-certificate swap has nothing to replace.

  # MPL-2.0 asks whoever distributes the executable form to say where the source
  # version of the same release is.
  install -Dvm644 "$srcdir/MPL-2.0.txt" -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dvm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/NOTICE" <<END
Firefox Developer Edition is MPL-2.0 licensed. The Source Code Version of this
exact build is Mozilla's own release tarball:
https://archive.mozilla.org/pub/devedition/releases/$pkgver/source/firefox-$pkgver.source.tar.xz
END

  # Register GNOME search provider under the payload's remoting name
  install -Dvm644 /dev/stdin "$pkgdir/usr/share/gnome-shell/search-providers/$pkgname.search-provider.ini" <<END
[Shell Search Provider]
DesktopId=$pkgname.desktop
BusName=org.mozilla.${_remoting//-/_}.SearchProvider
ObjectPath=/org/mozilla/${_remoting//-/_}/SearchProvider
Version=2
END
}

