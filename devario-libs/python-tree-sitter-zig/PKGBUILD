# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-zig
_srcname=tree_sitter_zig
pkgver=1.1.2
pkgrel=1
pkgdesc='Python bindings for the zig Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter-grammars/tree-sitter-zig
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/5c/97/75967b81460e0ce999de4736b9ac189dcd5ad1c85aabcc398ba529f4838e/tree_sitter_zig-1.1.2.tar.gz")
sha256sums=('da24db16df92f7fcfa34448e06a14b637b1ff985f7ce2ee19183c489e187a92e')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
