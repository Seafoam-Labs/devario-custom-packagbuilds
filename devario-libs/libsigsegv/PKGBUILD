pkgname=libsigsegv
pkgver=2.15
pkgrel=1
pkgdesc='A library for handling page faults in user mode'
arch=('x86_64')
url='https://www.gnu.org/software/libsigsegv/'
license=('GPL-2.0-only')
depends=('glibc')
options=('!lto')
# upstream's "$pkgname-$pkgver.tar.gz::URL"{,.sig} prefix renames the .sig onto
# the tarball's own path, so both sources land on one file
source=("https://ftp.gnu.org/gnu/$pkgname/$pkgname-$pkgver.tar.gz"{,.sig})
sha512sums=('5558585ffbf243a328cf040a540576ff73813076f53b182bb8af7b5d3b8abe877694279886fb0d25b3d5197c836b46f7f0338206b098c673e7ee3f6581cb787c'
            'SKIP')
b2sums=('cf0323b50f9f5d5c3c72bfd272ac16ec280b38dcac7f624caf5d7c0532e172e8a5ea38c27e3b686f89a47e115cb5db84a83d70149b7165931ea322e7c3cd1995'
        'SKIP')
# upstream lists two expired RSA keys; the 2.15 tarball is signed by this ed25519 key
validpgpkeys=('E0FFBD975397F77A32AB76ECB6301D9E1BBEAC08') # Bruno Haible (Free Software Development) <bruno@clisp.org>

build() {
  cd "$pkgname-$pkgver"

  ./configure \
    --prefix=/usr \
    --enable-shared

  make 
}

package() {
  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install
}
