pkgname=libsigsegv
pkgver=2.16
pkgrel=1
pkgdesc='A library for handling page faults in user mode'
arch=('x86_64')
url='https://www.gnu.org/software/libsigsegv/'
license=('GPL-2.0-only')
depends=('glibc')
options=('!lto')
# upstream's "$pkgname-$pkgver.tar.gz::URL"{,.sig} prefix renames the .sig onto
# the tarball's own path, so both sources land on one file
source=("https://ftp.gnu.org/gnu/$pkgname/$pkgname-$pkgver.tar.gz"{,.sig})
sha512sums=('09cdf99b5003a8cf05513e2e1ea280bd02a4dc361e8573bdedbd29a8b4fd19406427a250a38ecc78eb712c2fd943962f6cc1426fe36b01edc9a964d2269e3525'
            'SKIP')
b2sums=('5425454633d8abdaf9a6d70d2568dbc6ae1228ba606a5a83ddae8c7dfcfa8f229608d7ff4038a5db35de4b45534fbce9f9c14d2c1306b5c38c346f34918576bc'
            'SKIP')
# upstream lists two expired RSA keys; the 2.15 tarball is signed by this ed25519 key
validpgpkeys=('E0FFBD975397F77A32AB76ECB6301D9E1BBEAC08') # Bruno Haible (Free Software Development) <bruno@clisp.org>

build() {
  cd "$pkgname-$pkgver"

  ./configure \
    --prefix=/usr \
    --enable-shared

  make 
}

package() {
  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install
}
