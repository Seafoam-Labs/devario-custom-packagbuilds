# Maintainer: George Rawlinson <george@rawlinson.net.nz>
# Contributor: Immae <ismael.bouya@normalesup.org>

pkgname=editline
pkgver=2.1.0
pkgrel=1
pkgdesc='A readline() replacement for UNIX without termcap (ncurses)'
arch=('x86_64')
url='http://troglobit.com/editline.html'
license=(Spencer-94)
depends=(glibc)
makedepends=(git)
# Shelly keeps a bare .so provision without expanding it to the SONAME, so
# declare the 1 that libtool's -version-info pins for 2.1.0.
provides=(libeditline.so 'libeditline.so=1-64')
install="$pkgname.install"
source=("$pkgname::git+https://github.com/troglobit/editline#tag=$pkgver")
sha512sums=('a09fd54f4281f2c920e15489675cfa1e1485e43e8c48436017561ac6de0d52ee1cd6d8c7b36395e335e99ed59e817348300897a8652046b63774f6a6f1bf229b')
b2sums=('fc280e5fdb6b5d9f086fa1e58f8b6b3766aefe0215f86619fa071e0f2d4198d23a3c48a17b58a42ca2b7a59167b471fa020aae7da090ba0bc42898f37f31fbff')

build () {
  cd "$pkgname"

  ./autogen.sh

  ./configure --prefix=/usr

  make
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" install
  
  # avoid libedit conflict
  mv "$pkgdir"/usr/share/man/man3/editline{,-troglobit}.3

  # license
  install -Dm0644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"

  # additional documentation
  cp -vrt "$pkgdir/usr/share/doc/$pkgname" docs

  # libeditline.so is libtool's bare symlink to libeditline.so.1; following it
  # confirms both that link and the SONAME the provision promises.
  _verify_soname "$pkgdir/usr/lib/libeditline.so" libeditline.so.1 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
