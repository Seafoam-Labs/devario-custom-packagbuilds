# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=migraphx
pkgver=7.2.3
pkgrel=8
pkgdesc="AMD's graph optimization engine"
arch=('x86_64')
url="https://rocm.docs.amd.com/projects/AMDMIGraphX/en/latest/"
license=('MIT AND (Apache-2.0 WITH LLVM-exception OR NCSA)')
depends=(
  rocm-core
  miopen-hip
  rocblas
  hip-runtime-amd
  protobuf
  msgpack-cxx
  sqlite
)
makedepends=(
  git
  cmake
  ninja
  rocm-cmake
  rocm-llvm
  half
  nlohmann-json
  rocmlir
)
_git='https://github.com/ROCm/AMDMIGraphX'
source=(
  "$pkgname::git+$_git#tag=rocm-$pkgver"
  "0001-migraphx-check-if-use_hipblaslt-before-call-gfx_defa.patch"
)
sha256sums=('2c30c6185c141291e041b80f3ee90b1459c731aa9f86cbc496fd32dcb253a887'
            'd1ef55d9b38e923567b8195d8e577ff59c3c939cbdf2451e27472d03ee5a851b')
options=(!lto)

prepare() {
  cd $pkgname
  patch -p1 -i "$srcdir"/0001-migraphx-check-if-use_hipblaslt-before-call-gfx_defa.patch
}

build() {
  # amdclang lives in /opt/rocm/bin, which rocm-core only puts on PATH through
  # /etc/profile.d/rocm.sh; Shelly's build shell does not source profile.d.
  export PATH="/opt/rocm/bin:$PATH"
  # --hip-link makes the driver append -lamdhip64; it infers the ROCm root
  # from the compiler path and misses /opt/rocm/lib without ROCM_PATH.
  export ROCM_PATH=/opt/rocm
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  CXXFLAGS+=" -fcf-protection=none"
  local cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$pkgname"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D CMAKE_CXX_COMPILER=amdclang++
    -D CMAKE_BUILD_TYPE=None
    -D Boost_USE_STATIC_LIBS=OFF
    -D BUILD_TESTING=OFF
    -D rocMLIR_DIR=/opt/rocm/lib/cmake/rocmlir
    # Generic targets cover gfx1100-1103/gfx1150-1153 and gfx1200/1201, the
    # same policy rocsolver and composable-kernel use.
    -D GPU_TARGETS="gfx11-generic;gfx12-generic"
    -D MIGRAPHX_ENABLE_PYTHON=OFF
    -D MIGRAPHX_USE_COMPOSABLEKERNEL=OFF
    -D MIGRAPHX_USE_HIPBLASLT=OFF
    -D MIOPEN_BACKEND=HIP
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  # The CMake cache holds the bare compiler names, so an install-time
  # regeneration needs the same PATH as the build.
  export PATH="/opt/rocm/bin:$PATH"

  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /usr/share/licenses/rocmlir/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rocMLIR"
  install -Dm644 /usr/share/licenses/rocmlir/LICENSE.llvm-project \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.llvm-project"
  install -Dm644 /usr/share/licenses/rocmlir/LICENSE.rocmlir-lib \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rocmlir-lib"
}
