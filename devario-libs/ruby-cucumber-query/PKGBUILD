# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-cucumber-query
pkgver=16.3.0
pkgrel=1
pkgdesc="Cucumber Query - query messages"
arch=(any)
url='https://github.com/cucumber/query/tree/main/ruby'
license=(MIT)
depends=(
  'ruby>=3.3'
  'ruby-cucumber-messages>=34.1'
  'ruby-cucumber-messages<36'
)
makedepends=(
  git
  ruby-rdoc
)
checkdepends=(
  'ruby-rspec>=3.13'
  'ruby-rspec<4'
)
options=(!emptydirs)
source=(git+https://github.com/cucumber/query.git#tag=v16.3.0)
sha512sums=('c74b1431d4deb13488bc1cc4d1181619bcbd26536ed6e563634fb027da34d6daf142e16f8a2d9942b2ff51b263446d396f6011da353b14826002d1857d0400dc')
b2sums=('54cf769a00da2d73dffa9f4368585b58c27d848eb1db3dd72a3087f29c9aa9a6c2ecfb291305ab9e89a6a3d682b4246fc600d8a11c150b48a249355cf88367ba')

build() {
  local _gemdir="$(gem env gemdir)"
  cd query/ruby
  gem build cucumber-query.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    cucumber-query-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd query/ruby
  GEM_HOME="tmp_install/$_gemdir" rspec
}

package() {
  cd query/ruby
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 ../LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
