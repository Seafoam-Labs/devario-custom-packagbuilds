# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-cucumber-query
pkgver=16.2.0
pkgrel=1
pkgdesc="Cucumber Query - query messages"
arch=(any)
url='https://github.com/cucumber/query/tree/main/ruby'
license=(MIT)
depends=(
  'ruby>=3.3'
  'ruby-cucumber-messages>=34.1'
  'ruby-cucumber-messages<36'
)
makedepends=(
  git
  ruby-rdoc
)
checkdepends=(
  'ruby-rspec>=3.13'
  'ruby-rspec<4'
)
options=(!emptydirs)
source=(git+https://github.com/cucumber/query.git#tag=v$pkgver)
sha512sums=('e4f60d0dd52a666ef2e87cf8393c386b15e0214179fbde84b6674b1e3d2b235066725b30d3ac5034e31a4cb8cf1bce92955647a57d55455e89391d47a1499827')
b2sums=('39e116a1bd28c1569dcbc50c5fae932ba447fc2eea4fe1df5778b3154dfc0cfe6bcf844e0f3b6e146b5d9f5f27a0b33b946ae9915620ad987866cbf29a2790ec')

build() {
  local _gemdir="$(gem env gemdir)"
  cd query/ruby
  gem build cucumber-query.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    cucumber-query-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd query/ruby
  GEM_HOME="tmp_install/$_gemdir" rspec
}

package() {
  cd query/ruby
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 ../LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
