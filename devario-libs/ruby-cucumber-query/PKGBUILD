# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-cucumber-query
pkgver=16.4.0
pkgrel=1
pkgdesc="Cucumber Query - query messages"
arch=(any)
url='https://github.com/cucumber/query/tree/main/ruby'
license=(MIT)
depends=(
  'ruby>=3.3'
  'ruby-cucumber-messages>=34.1'
  'ruby-cucumber-messages<36'
)
makedepends=(
  git
  ruby-rdoc
)
checkdepends=(
  'ruby-rspec>=3.13'
  'ruby-rspec<4'
)
options=(!emptydirs)
source=(git+https://github.com/cucumber/query.git#tag=v16.4.0)
sha512sums=('16fa432936ad6d2072b29831d9c1a5e66fe7a77a5413008622f4302f124b753d7001aa0891322c2f2e7774dc3c0d826243a2fa16926e3a9972a2a77d945017a7')
b2sums=('c14fa55429fd0fbf15ad9ef1f7c8b053c35d6d1a214f5b96cb102805f37d840efff9a2c7342b559a9da7e1f09980c11851499f1b982a4e4fa5dd06ff88eef69f')

build() {
  local _gemdir="$(gem env gemdir)"
  cd query/ruby
  gem build cucumber-query.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    cucumber-query-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd query/ruby
  GEM_HOME="tmp_install/$_gemdir" rspec
}

package() {
  cd query/ruby
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 ../LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
