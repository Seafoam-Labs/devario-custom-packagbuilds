# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-python
_srcname=tree_sitter_python
pkgver=0.25.0
pkgrel=1
pkgdesc='Python bindings for the python Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-python
license=('MIT')
depends=(glibc 'python>=3.10' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/b8/8b/c992ff0e768cb6768d5c96234579bf8842b3a633db641455d86dd30d5dac/tree_sitter_python-0.25.0.tar.gz")
sha256sums=('b13e090f725f5b9c86aa455a268553c65cadf325471ad5b65cd29cac8a1a68ac')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
