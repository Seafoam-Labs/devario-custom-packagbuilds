# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=python-filelock
pkgver=4.3.1
pkgrel=1
pkgdesc="A platform-independent file lock"
arch=('any')
url="https://github.com/tox-dev/filelock"
license=('MIT')
depends=('python>=3.11')
makedepends=(
  'git'
  'python-build'
  'python-hatch-fancy-pypi-readme>=25.1'
  'python-hatch-vcs>=0.5'
  'python-hatchling>=1.29'
  'python-installer'
)
source=("git+$url.git#tag=$pkgver")
b2sums=('SKIP')

prepare() {
  cd ${pkgname#python-}
  # Recent releases embed a CycloneDX SBOM via the python-sbom hatch hook, which
  # is not packaged. The hook only adds wheel metadata, so drop it and its
  # requirement.
  sed -i '/"python-sbom\[hatch\]/d; /build\.hooks\.python-sbom/d' pyproject.toml
}

build() {
  cd ${pkgname#python-}
  python -m build --wheel --no-isolation
}

package() {
  cd ${pkgname#python-}
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
