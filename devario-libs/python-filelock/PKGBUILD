# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=python-filelock
pkgver=4.2.9
pkgrel=1
pkgdesc="A platform-independent file lock"
arch=('any')
url="https://github.com/tox-dev/filelock"
license=('MIT')
depends=('python>=3.11')
makedepends=(
  'git'
  'python-build'
  'python-hatch-fancy-pypi-readme>=25.1'
  'python-hatch-vcs>=0.5'
  'python-hatchling>=1.29'
  'python-installer'
)
source=("git+$url.git#tag=$pkgver")
b2sums=('0b1e5d46d5de9cfa937736ed36aa29f0b41a542cf8e54e4e946166fe413ece3494ea60cda9da1d553e6a359dd72997815f6865d66f3d9f0d1e73bbaee21d157f')

build() {
  cd ${pkgname#python-}
  python -m build --wheel --no-isolation
}

package() {
  cd ${pkgname#python-}
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
