pkgname=python-html5lib
pkgver=1.1
pkgrel=20
arch=('any')
url="https://github.com/html5lib"
license=('MIT')
pkgdesc="A Python HTML parser/tokenizer based on the WHATWG HTML5 spec"
_deps=('six' 'webencodings')
depends=(python-six python-webencodings)
makedepends=('python-build' 'python-packaging' 'python-installer' 'python-setuptools' 'python-wheel' python-six python-webencodings)
optdepends=('python-lxml: lxml treebuilder'
            'python-genshi: genshi treewalker')
source=("$pkgname-$pkgver.tar.gz::https://github.com/html5lib/html5lib-python/archive/${pkgver}.tar.gz"
  'html5lib-mock-stdlib.patch::https://github.com/html5lib/html5lib-python/commit/5ec6e5e614679ee938545704fad958a3491c678b.patch'
  'python-3.14-compatibility.patch'
  'html5lib-use-context-manager-for-urllib.patch'
  'html5lib-pkg_resources_removal.patch')
sha256sums=('66e9e24a53c10c27abb6be8a3cf2cf55824c6ea1cef8570a633cb223ec46e894'
  '084aeb6fe430a82e482bae01e7f962308f77107d97c42316e512efb7045f7030'
  '4e1646d275e1402aaff36a116fbecd1018e3db2df5758f84a620a6a3d9005ba4'
  '85a3c8cfb3ce2b65fde2272c9759419d120dd8e0e97d929c1c64bf2dcd1ed2a5'
  'e5f612788ade18d611c0f4d29eae3f12a9dc23dac63fd6a87a1a6ff996395728')

prepare() {
    cd html5lib-python-${pkgver}

    patch -p1 -i ../html5lib-mock-stdlib.patch
    patch -p1 -i ../python-3.14-compatibility.patch
    patch -p1 -i ../html5lib-use-context-manager-for-urllib.patch
    patch -p1 -i ../html5lib-pkg_resources_removal.patch
}

build() {
    cd html5lib-python-${pkgver}

    python -m build --wheel --no-isolation
}

package() {
    cd html5lib-python-${pkgver}

    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm644 LICENSE "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
