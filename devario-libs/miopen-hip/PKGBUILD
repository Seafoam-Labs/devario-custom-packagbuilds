pkgname=miopen-hip
pkgver=7.2.4
pkgrel=2
# pin frugally-deep version as workaround workaround for https://github.com/ROCm/MIOpen/issues/3588
_fdeep_ver=0.15.31
pkgdesc="AMD's Machine Intelligence Library (HIP backend)"
arch=('x86_64')
url="https://rocm.docs.amd.com/projects/MIOpen/en/latest/index.html"
license=('MIT')
depends=(
  'bzip2'
  'comgr'
  'composable-kernel'
  'glibc'
  'hip-runtime-amd'
  'hipblas'
  'hipblaslt'
  'libgcc'
  'rocblas'
  'rocm-core'
  'rocrand'
  'roctracer'
  'sqlite'
)
makedepends=(
  'boost'
  'boost-libs'
  'cmake'
  'eigen'
  'functional-plus'
  'git'
  'git-lfs'
  'lbzip2'
  'ninja'
  'nlohmann-json'
  'rocm-cmake'
  'rocm-toolchain'
  'rocm-llvm'
  'rocmlir'
)
provides=('miopen')
conflicts=('miopen')
_git='https://github.com/ROCm/rocm-libraries'
source=(
  "rocm-libraries::git+$_git.git#tag=rocm-$pkgver"
  "${pkgname}-MIFin::git+https://github.com/ROCm/MIFin.git"
  "${pkgname}-half::git+https://github.com/ROCm/half#tag=rocm-$pkgver"
  "${pkgname}-frugally-deep::git+https://github.com/Dobiasd/frugally-deep#tag=v$_fdeep_ver"
)
sha256sums=('b476acbcd0f4017c800e4b05533e6dfb875bde32242729c8df557d4624379623'
            'SKIP'
            'f21d7a04cae40af1d843ad9ca81416bb469f0540607f68b2e35b642362c89b42'
            'd1e1d55945eded7219c50f59f55967327118d6792df5a283c01131b18a3f061f')
options=(!lto)
_dirname="rocm-libraries/projects/miopen"

prepare() {
  cd "$_dirname"
  git submodule init

  git config submodule."fin".url "${srcdir}/${pkgname}"-MIFin

  git -c protocol.file.allow=always submodule update --init --recursive

  # Disable tests as they require an AMD GPU at build time
  sed -i '/add_subdirectory(test)/d' CMakeLists.txt

  # All 'return {var};' patterns that cause Boost::optional errors and fix them
  sed -i 's/return {ovr_rec};/return ovr_rec;/g' src/include/miopen/sqlite_db.hpp
  sed -i 's/return {rec};/return rec;/g' src/include/miopen/sqlite_db.hpp
  sed -i 's/return {res};/return res;/g' src/find_controls.cpp
}

build() {
  # amdclang lives in /opt/rocm/bin, which rocm-core only puts on PATH through
  # /etc/profile.d/rocm.sh; Shelly's build shell does not source profile.d.
  export PATH="/opt/rocm/bin:$PATH"
  # --hip-link makes the driver append -lamdhip64; it infers the ROCm root
  # from the compiler path and misses /opt/rocm/lib without ROCM_PATH.
  export ROCM_PATH=/opt/rocm

  local fdeep_args=(
    -S $pkgname-frugally-deep
        -B build-frugally-deep
        -Wno-dev
        -DCMAKE_BUILD_TYPE=None
        -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  )
  cmake "${fdeep_args[@]}"
  cmake --build build-frugally-deep
  DESTDIR="$srcdir/deps" cmake --install build-frugally-deep

  local half_args=(
    -Wno-dev
    -G Ninja
    -B build-half
    -S "$pkgname-half"
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_POLICY_VERSION_MINIMUM=3.5
  )
  cmake "${half_args[@]}"
  cmake --build build-half
  DESTDIR="$srcdir/deps" cmake --install build-half

  # define NDEBUG to silence internal logging (mimics cmake release build)
  # https://rocmsoftwareplatform.github.io/MIOpen/doc/html/DebugAndLogging.html
  local cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$_dirname"
    -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none -DNDEBUG"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_C_COMPILER=amdclang
    -D CMAKE_CXX_COMPILER=amdclang++
    -D MIOPEN_BACKEND=HIP
    -D HALF_INCLUDE_DIR="$srcdir/deps/usr/include"
    -D CMAKE_PREFIX_PATH="$srcdir/deps/usr/lib/cmake"
    -D rocMLIR_DIR=/opt/rocm/lib/cmake/rocmlir
    -D CMAKE_POLICY_VERSION_MINIMUM=3.5
    # Device code is emitted once per target; the two generic targets cover
    # gfx1100-1103/gfx1150-1153 and gfx1200/1201, as migraphx uses.
    -D GPU_TARGETS="gfx11-generic;gfx12-generic"
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  # The CMake cache holds the bare compiler names, so an install-time
  # regeneration needs the same PATH as the build.
  export PATH="/opt/rocm/bin:$PATH"

  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /usr/share/licenses/rocmlir/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rocMLIR"
  install -Dm644 /usr/share/licenses/rocmlir/LICENSE.llvm-project \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.llvm-project"
  install -Dm644 /usr/share/licenses/rocmlir/LICENSE.rocmlir-lib \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rocmlir-lib"
}
