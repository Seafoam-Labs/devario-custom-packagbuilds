# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-c
_srcname=tree_sitter_c
pkgver=0.24.2
pkgrel=1
pkgdesc='Python bindings for the c Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-c
license=('MIT')
depends=(glibc 'python>=3.10' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/a6/c9/3834f3d9278251aea7312274971bc4c45b17aec2490fd4b884d93bd7019a/tree_sitter_c-0.24.2.tar.gz")
sha256sums=('1628584df0299b5a340aa63f8e67b6c97c91517f52fa7e7a4c557e40adb330a9')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
