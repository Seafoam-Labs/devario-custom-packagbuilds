# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=python-pyfakefs
pkgver=6.3.2
pkgrel=1
pkgdesc='pyfakefs implements a fake file system that mocks the Python file system modules'
url=https://github.com/jmcgeheeiv/pyfakefs/
license=(APACHE)
arch=(any)
depends=('python>=3.10' 'python-pytest>=6.2.5')
makedepends=(
  git
  python-build
  python-installer
  'python-setuptools>=77.0.3'
  python-wheel
)
checkdepends=(
  python-pandas
  python-xlrd
  python-openpyxl
)
source=(git+https://github.com/jmcgeheeiv/pyfakefs.git#tag=v${pkgver})
b2sums=('5d0126bb0a568e70bc2a5331a1d9c4f8634b65e905c1318806ac9db3c28bd0205f9a578239ffddbb007faad62c6a9f124e8eef203554753483b1834ed0cb3d3f')

build() {
  cd  pyfakefs
  python -m build --wheel --no-isolation
}

check() {
  cd  pyfakefs
  python -m pyfakefs.tests.all_tests
  python -m pytest pyfakefs/pytest_tests/pytest_plugin_test.py
}

package() {
  python -m installer --destdir="${pkgdir}" pyfakefs/dist/*.whl
}

