# Based on Arch Linux packaging by Laurent Carlier <lordheavym@gmail.com>.
# Devario: OpenCL C++ headers for consumers including GGML's OpenVINO backend.
pkgname=opencl-clhpp
pkgver=2026.05.29
pkgrel=1
pkgdesc='OpenCL C++ header files'
arch=(any)
url='https://github.com/KhronosGroup/OpenCL-CLHPP'
license=(Apache-2.0)
depends=(opencl-headers)
makedepends=(cmake ninja)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/KhronosGroup/OpenCL-CLHPP/archive/v${pkgver}.tar.gz")
sha256sums=('fafb4fd202d113992c009d46e6358e70076167e62a5baeb377fe813033a2655e')

build() {
  # Header-only SDK; examples/tests require an OpenCL loader, and docs need Doxygen.
  cmake -S "OpenCL-CLHPP-${pkgver}" -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_DOCS=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "OpenCL-CLHPP-${pkgver}/LICENSE.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
