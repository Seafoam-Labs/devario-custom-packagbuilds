# Based on packaging by Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=webrtc-audio-processing-1
_pkgname=webrtc-audio-processing
pkgver=1.3
pkgrel=1
pkgdesc="AudioProcessing library based on Google's implementation of WebRTC (legacy)"
url="https://freedesktop.org/software/pulseaudio/webrtc-audio-processing/"
arch=(x86_64)
license=(BSD-3-Clause)
depends=(
  abseil-cpp
  glibc
  libgcc
  libstdc++
)
makedepends=(meson)
provides=(
  libwebrtc-audio-coding-1.so
  libwebrtc-audio-coding-1.so=3-64
  libwebrtc-audio-processing-1.so
  libwebrtc-audio-processing-1.so=3-64
)
source=(
  "${url}${_pkgname}-${pkgver}.tar.xz"
  0001-Fix-compilation-with-GCC-15.patch
)
sha256sums=('2365e93e778d7b61b5d6e02d21c47d97222e9c7deff9e1d0838ad6ec2e86f1b9'
            '5acec54415f9fa720a589bfa7113aa3b97929b90091b26555ab0234384779f42')

prepare() {
  patch -d "${_pkgname}-${pkgver}" -Np1 \
    -i "$srcdir/0001-Fix-compilation-with-GCC-15.patch"
}

build() {
  meson setup build "${_pkgname}-${pkgver}" \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=plain \
    --wrap-mode=nofallback \
    -Ddefault_library=shared \
    -Dcpp_std=c++17 \
    -Dneon=no
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "${_pkgname}-${pkgver}/COPYING" \
    -t "$pkgdir/usr/share/licenses/$pkgname"

  _verify_soname "$pkgdir/usr/lib/libwebrtc-audio-coding-1.so" libwebrtc-audio-coding-1.so.3 || return 1
  _verify_soname "$pkgdir/usr/lib/libwebrtc-audio-processing-1.so" libwebrtc-audio-processing-1.so.3 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
