# Maintainer: Torsten Keßler <tpkessler@archlinux.org>
pkgbase=cudnn-frontend
pkgname=(${pkgbase} python-${pkgbase})
pkgver=1.30.0
pkgrel=1
pkgdesc="Modern, open-source entry point to the cuDNN library"
arch=("x86_64")
url="https://docs.nvidia.com/deeplearning/cudnn/latest/"
license=("MIT")
makedepends=(
	git
	cmake
	ninja
	cuda
	cudnn
	pybind11
	catch2
	python
	python-build
	python-installer
	python-wheel
	python-setuptools
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/NVIDIA/cudnn-frontend/archive/refs/tags/v${pkgver}.tar.gz"
	pyproject.patch)
sha256sums=('2e6a28661b91c0f43c2b24809750b480a93975bcf949c9715e540a7ab8575b31'
            '4910a5be87991be35d779b23cf3a52bbf6b204cef5560db279a5bb07a8b976a8')

prepare() {
	cd ${pkgname}-${pkgver}
	# Drop cmake, ninja, and pybind11 dependencies from pyproject.toml
	patch -p1 < ../pyproject.patch
}

build() {
	# CUDA installs into /opt/cuda, which lands on PATH and the loader search
	# list only through /etc/profile.d/cuda.sh and /etc/ld.so.conf.d/cuda.conf.
	# Shelly's build shell sources neither, so without this CMake's
	# FindCUDAToolkit cannot resolve nvcc and aborts with "Could not find nvcc
	# executable in path". The explicit CUDAToolkit_ROOT keeps the probe away
	# from any host CUDA install.
	export CUDA_PATH=/opt/cuda
	export PATH="/opt/cuda/bin:$PATH"
	local cmake_args=(
		-Wno-dev
		-G Ninja
		-B build
		-S ${pkgbase}-${pkgver}
		-D CMAKE_BUILD_TYPE=None
		-D CMAKE_INSTALL_PREFIX=/usr
		-D CUDAToolkit_ROOT=/opt/cuda
	)
	echo "Build C++ library"
	cmake "${cmake_args[@]}"
	cmake --build build

	echo "Build python wrapper"
	cd ${pkgbase}-${pkgver}
	python -m build --wheel --no-isolation
}

package_cudnn-frontend() {
	depends+=(
		glibc
		libstdc++
		libgcc
		cuda
		cudnn
	)
	# Each PKGBUILD function runs in its own shell under Shelly, so the CUDA
	# PATH/CUDA_PATH set in build() is gone here. The cached CMake generator
	# and compiler paths are absolute, but re-exporting keeps any reconfigure
	# from failing to find nvcc again.
	export CUDA_PATH=/opt/cuda
	export PATH="/opt/cuda/bin:$PATH"
	DESTDIR="${pkgdir}" cmake --install build
	cd ${pkgbase}-${pkgver}
	install -Dm644 LICENSE.txt "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}

package_python-cudnn-frontend() {
	depends+=(
		glibc
		libstdc++
		libgcc
		python
		cuda
		cudnn
	)
	cd ${pkgbase}-${pkgver}
	python -m installer --destdir="${pkgdir}" dist/*.whl
	install -Dm644 LICENSE.txt "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
