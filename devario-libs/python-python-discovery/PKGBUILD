# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-python-discovery
pkgver=1.9.8
pkgrel=1
pkgdesc='Python interpreter discovery'
arch=(any)
url='https://python-discovery.readthedocs.io'
license=(MIT)
depends=(
  'python>=3.9'
  'python-filelock>=3.16.1'
)
makedepends=(
  git
  python-build
  # python-discovery 1.9+ declares hatch-fancy-pypi-readme in build-system
  # requires; python-build --no-isolation fails when it is not installed
  'python-hatch-fancy-pypi-readme>=25.1'
  python-installer
  python-hatchling
  python-hatch-vcs
  # the [hatch] extra is satisfied by python-hatchling above
  'python-sbom>=0.1.2'
)
source=(
  "$pkgname::git+https://github.com/tox-dev/python-discovery#tag=1.9.8"
  no-vermin.patch
)
sha512sums=('SKIP'
            'b9a0e4a9383ac775e5d53d9a5d643cee48f061eef6125f40ece87aa1994ad35efdce576446d322992c6f3b4c6117712eebca53733b5779cba7ab8309732988c0')
b2sums=('SKIP'
            'f1b685de7e9fe1911e682a63f97a0ab90ca1e2d8d8dfcd1702338dc5f9a6c43442111ddd75866878c91b1f07b8204a644a0613509b4200145a918bf3104c5ef8')

prepare() {
  cd "$pkgname"

  # we don't want to detect old python versions
  patch -p1 -i "$srcdir/no-vermin.patch"
}

build() {
  cd "$pkgname"

  SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver" python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
