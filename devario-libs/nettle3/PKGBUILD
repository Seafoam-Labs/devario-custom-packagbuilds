# Maintainer: Andreas Radke <andyrtr@archlinux.org>
# Contributor: bender02 at gmx dot com
# Adapted for Devario: preserve the explicit library ABIs for Shelly.

pkgname=nettle3
_pkgname=nettle
pkgver=3.10.2
pkgrel=3
pkgdesc="A low-level cryptographic library, version 3"
arch=('x86_64')
url="https://www.lysator.liu.se/~nisse/nettle"
license=('LGPL-3.0-or-later OR GPL-2.0-or-later')
depends=('glibc' 'gmp')
provides=('libnettle.so' 'libnettle.so=8-64' 'libhogweed.so' 'libhogweed.so=6-64')
checkdepends=('valgrind')
source=(https://ftp.gnu.org/gnu/$_pkgname/$_pkgname-$pkgver.tar.gz{,.sig})
sha256sums=('fe9ff51cb1f2abb5e65a6b8c10a92da0ab5ab6eaf26e7fc2b675c45f1fb519b5'
            'SKIP')
validpgpkeys=('343C2FF0FBEE5EC2EDBEF399F3599FF828C67298') # Niels Möller <nisse@lysator.liu.se>


build() {
  cd $_pkgname-$pkgver
  ./configure --prefix=/usr \
    --includedir=/usr/include/nettle3 \
    --libdir=/usr/lib/nettle3 \
    --disable-static \
    --disable-documentation
  make
}

check() {
  cd $_pkgname-$pkgver
  make -k check
}

package() {
  cd $_pkgname-$pkgver
  make DESTDIR="$pkgdir/" install
  rm -r "$pkgdir"/usr/bin
# Move versioned libraries to /usr/lib
  cd "$pkgdir"
  for _lib in usr/lib/nettle3/*; do
    if [[ $_lib == *.so ]]; then
      ln -srf -- usr/lib/"$(readlink $_lib)" $_lib
    elif [[ ! -d $_lib ]]; then
      mv $_lib usr/lib
    fi
  done
  _verify_soname "$pkgdir/usr/lib/nettle3/libnettle.so" libnettle.so.8 || return 1
  _verify_soname "$pkgdir/usr/lib/nettle3/libhogweed.so" libhogweed.so.6 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
