# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=python-librt
pkgver=0.17.0
pkgrel=1
pkgdesc='Mypyc runtime library'
arch=('x86_64')
url="https://github.com/mypyc/librt"
license=('MIT AND PSF-2.0')
depends=('glibc')
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
source=("https://github.com/mypyc/librt/archive/refs/tags/v0.17.0.tar.gz")
b2sums=('249b621ace9a24bcc5a03d487f2cf0015672e33a4134f0e07b73049767cbcf91daf5fc92503c11e888dd101529320dcee7a8bd8fbcb4e6a63324a886b7038646')

prepare() {
  cd librt-$pkgver
  # Necessary for building, see:
  # .github/workflows/buildwheels.yml
  cp -vr lib-rt/* .
}

build() {
  cd librt-$pkgver
  python -m build --wheel --no-isolation
}

package() {
  cd librt-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
