pkgname=python-httplib2
pkgver=0.32.1
pkgrel=1
pkgdesc='Comprehensive HTTP client library, supporting many features'
arch=(any)
url='https://github.com/httplib2/httplib2'
license=(MIT)
depends=(
  ca-certificates
  'python>=3.8'
  'python-pyparsing>=3.1'
  'python-pyparsing<4'
)
makedepends=(
  git
  python-build
  python-installer
  python-wheel
  'python-setuptools>=40.8.0'
)
optdepends=(
  'python-pysocks: SOCKS proxy client support'
)
source=("$pkgname::git+$url#tag=v$pkgver"
  use-system-certificates.patch)
sha512sums=('c7c95227bd601d1ed9eb247fc7400d6ced7e0caa7a1698da4078c6929c6314aae90895715a9bd7db741713ac97e776409a2e61af11d8ae4b2a33274a09e0417d'
            '99b4d3ad273f531a0ddf429015a59263e7e79754cd404580427cd7a0d8ad6455096ff49a3fbf60009448d066925b9a10255d0d4b3e75d2a9b6c88cbd6da5bb34')
b2sums=('c8095277ea62c0332f14794140ad72818d333558f111749af71e241fed4688527765f4310ce09175d80018999c6d360bc744c129424ad02169a899bdbe0d1ab8'
        '532f8208a57a2903d804ecda0e7f5076d300a3e1029c4effc29c6bb93683aaa283ae2f658c4be455d001e94afdcfbf331e06f19ac3a4c96db14210d185f5e904')

prepare() {
  cd "$pkgname"

  # use system ca certificates
  patch -p1 -i "$srcdir/use-system-certificates.patch"
  rm -vf httplib2/cacerts.txt
}

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}

