pkgbase = electron44-bin
	pkgdesc = Build cross platform desktop apps with web technologies — prebuilt
	pkgver = 44.11.3
	pkgrel = 1
	url = https://electronjs.org
	arch = x86_64
	license = MIT
	license = BSD-3-Clause
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = expat
	depends = glib2
