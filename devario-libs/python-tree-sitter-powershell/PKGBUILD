# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-powershell
_srcname=tree_sitter_powershell
pkgver=0.26.4
pkgrel=1
pkgdesc='Python bindings for the powershell Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/airbus-cert/tree-sitter-powershell
license=('MIT')
depends=(glibc 'python>=3.10' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/05/59/e1806757895926cec99a71a73ac5252add3dd739c34b3e21b60f74182cbd/tree_sitter_powershell-0.26.4.tar.gz")
sha256sums=('ffc7f7526420fe335cb78823b38bc8b0c27453eb974ca6056779e4cfefffa605')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
