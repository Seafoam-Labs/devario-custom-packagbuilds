# Adapted from Arch Linux packaging for Devario.
# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: sum01 <sum01@protonmail.com>

pkgname=cpp-httplib
pkgver=0.65.0
pkgrel=1
pkgdesc='A C++ header-only HTTP/HTTPS server and client library'
arch=(any)
url=https://github.com/yhirose/cpp-httplib
license=(MIT)
# Devario ships the mbedtls crypto in the namespaced mbedtls3 slot, so the
# optional mbedtls TLS backend (the meson default is openssl) resolves there.
makedepends=(
  brotli
  git
  meson
  ninja
  mbedtls3
  openssl
  python
  zlib
  zstd
)
checkdepends=(gtest)
optdepends=(
  'brotli: Brotli compression support'
  'mbedtls3: HTTPS support'
  'openssl: HTTPS support'
  'zlib: Zlib compression support'
  'zstd: Zstandard compression support'
)
source=(git+${url}.git#tag=v${pkgver})
b2sums=('5ae41ca4833827ce5a420b2c7e396c4e5e106ebc83d3be724029b4952b6e202c802782f17a0f02c90ac6925962ab7234eb178031a983b9820d541eeaebb7b54d')

build() {
  arch-meson cpp-httplib build
  meson compile -C build
}

#check() {
#  ctest --test-dir build -F
#}

package() {
  DESTDIR="${pkgdir}" meson install -C build
  install -Dm 644 cpp-httplib/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
