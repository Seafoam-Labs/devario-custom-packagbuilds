pkgname=python-tinycss2
_name=tinycss2
pkgver=1.5.1
pkgrel=1.1
pkgdesc='Low-level CSS parser for Python'
arch=(any)
url='https://github.com/Kozea/tinycss2'
license=(BSD-3-Clause)
depends=(python python-webencodings)
makedepends=(python-build python-installer python-flit-core3)
checkdepends=(python-pytest)
source=("$_name-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/t/$_name/$_name-$pkgver.tar.gz")
sha256sums=('d339d2b616ba90ccce58da8495a78f46e55d4d25f9fd71dfd526f07e7d53f957')

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver"
  python -m pytest
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
