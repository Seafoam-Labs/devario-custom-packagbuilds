# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-rust
_srcname=tree_sitter_rust
pkgver=0.24.2
pkgrel=1
pkgdesc='Python bindings for the rust Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-rust
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/b7/87/75cbd22b927267d310f76cca1ab3c1d9d41035dfa3eb9cc95f96ee199440/tree_sitter_rust-0.24.2.tar.gz")
sha256sums=('54fb02a5911e345308b405174465112479f56dc39e3f1e7744d7568595f00db9')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
