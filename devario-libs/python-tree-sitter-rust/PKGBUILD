# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-rust
_srcname=tree-sitter-rust
pkgver=0.24.2
pkgrel=2
pkgdesc='Python bindings for the rust Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-rust
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-rust/tar.gz/refs/tags/v0.24.2")
sha256sums=('061e90a539a55a6aa65dceb0ad6425c50ab1a6e3e6d4ba430e2795ed4550f10e')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
