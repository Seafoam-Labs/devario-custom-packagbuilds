# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Veeti Paananen <veeti.paananen@rojekti.fi>

pkgname=cmark-gfm
pkgver=0.29.0.gfm.13
pkgrel=2
pkgdesc="GitHub's fork of cmark, a CommonMark parsing and rendering library and program in C"
arch=('x86_64')
url="https://github.com/github/cmark"
license=('BSD-2-Clause')
depends=('glibc')
makedepends=('cmake' 'python')
# Shelly keeps bare .so provisions, so declare the SONAME versions both CMakeLists set.
provides=('libcmark-gfm.so' 'libcmark-gfm.so=0.29.0.gfm.13-64'
          'libcmark-gfm-extensions.so' 'libcmark-gfm-extensions.so=0.29.0.gfm.13-64')
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
sha512sums=('435298fcf782dfc5b64c578ac839759b9d5cd0c08eb90d6702f26278062a0f4887c65c18e89e2c9f6be23f10dd835c769a7e0f8c934be068b6754dcca30cdd7c')

prepare() {
  mkdir -p build
}

build() {
  cd build
  cmake \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMARK_STATIC=off \
    ../cmark-gfm-$pkgver
  make
}

check() {
  cd build
  make test
}

package() {
  cd build
  make install DESTDIR="$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libcmark-gfm.so" libcmark-gfm.so.0.29.0.gfm.13 || return 1
  _verify_soname "$pkgdir/usr/lib/libcmark-gfm-extensions.so" libcmark-gfm-extensions.so.0.29.0.gfm.13 || return 1
  install -Dm0644 -t "$pkgdir"/usr/share/licenses/$pkgname/ "$srcdir"/cmark-gfm-$pkgver/COPYING
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
