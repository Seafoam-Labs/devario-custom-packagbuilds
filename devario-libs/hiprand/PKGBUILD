# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=hiprand
pkgver=10.0
pkgrel=1
pkgdesc='rocRAND marshalling library'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/hipRAND/en/latest/'
license=('MIT')
depends=(
  'glibc'
  'hip-runtime-amd'
  'libgcc'
  'rocm-core'
  'rocrand'
)
makedepends=(
  'cmake'
  'gcc-fortran'
  'rocm-cmake'
)
optdepends=('gcc-fortran: Use Fortran wrapper')
_git='https://github.com/ROCm/rocm-libraries'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('1b3c41fa482088db86be2d6b34d0d7f85356782c6a2533a5ea12910fb90ad117')
options=(!lto)

build() {
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  local cmake_args=(
    -Wno-dev
    -S "$pkgname"
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_COMPILER=/opt/rocm/bin/hipcc
    -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D BUILD_FORTRAN_WRAPPER=ON
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
