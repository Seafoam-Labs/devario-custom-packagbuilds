+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "asb-package.h"
+
+G_BEGIN_DECLS
+
+#define ASB_TYPE_PACKAGE_SHELLY (asb_package_shelly_get_type ())
+G_DECLARE_FINAL_TYPE (AsbPackageShelly, asb_package_shelly, ASB, PACKAGE_SHELLY, AsbPackage)
+
+AsbPackage *asb_package_shelly_new (void);
