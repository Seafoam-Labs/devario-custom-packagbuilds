_cpanname=SGMLSpm
pkgname=perl-sgmls
epoch=1
pkgver=1.1
pkgrel=15
pkgdesc="A Post-Processor for SGMLS and NSGMLS"
arch=('any')
url="https://search.cpan.org/dist/SGMLSpm"
license=('GPL' 'PerlArtistic')
depends=('perl')
options=('!emptydirs' 'docs')
source=(https://search.cpan.org/CPAN/authors/id/R/RA/RAAB/SGMLSpm-$pkgver.tar.gz)
sha256sums=('550c9245291c8df2242f7e88f7921a0f636c7eec92c644418e7d89cfea70b2bd')

prepare() {
	cd "$srcdir/$_cpanname-$pkgver"
	find . -type f -exec chmod 0644 {} \;
}

prepareEnvironment() {
	cd "$srcdir/$_cpanname-$pkgver"
	# DESTDIR is deliberately not set here. Exporting it through PERL_MM_OPT
	# makes MakeMaker bake the path into the generated Makefile while build()
	# runs, and $pkgdir is not the same value in every function under Shelly,
	# so package() would install into the build()-time directory while its own
	# $pkgdir points elsewhere. Pass DESTDIR to "make install" instead.
	export \
		PERL_MM_USE_DEFAULT=1 \
		PERL_AUTOINSTALL=--skipdeps \
		PERL_MM_OPT="INSTALLDIRS=vendor" \
		PERL_MB_OPT="--installdirs vendor" \
		MODULEBUILDRC=/dev/null
}

build() {
	prepareEnvironment
	/usr/bin/perl Makefile.PL
	make
}

check() {
	prepareEnvironment
	make test
}

package() {
	prepareEnvironment
	make DESTDIR="$pkgdir" install

	# FS#51874
	ln -sv /usr/bin/vendor_perl/sgmlspl.pl "$pkgdir"/usr/bin/sgmlspl
}
