pkgbase = electron42-bin
	pkgdesc = Build cross platform desktop apps with web technologies — prebuilt
	pkgver = 42.11.18
	pkgrel = 1
	url = https://electronjs.org
	arch = x86_64
	license = MIT
	license = BSD-3-Clause
	depends = alsa-lib
