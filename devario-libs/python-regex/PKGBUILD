_pkgbase=regex
pkgname=python-regex
pkgver=2026.11.15
pkgrel=1
pkgdesc="Alternative python regular expression module."
arch=('x86_64')
url="https://github.com/mrabarnett/mrab-regex"
license=('Apache-2.0 AND CNRI-Python')
depends=('python>=3.11')
makedepends=('python-build' 'python-installer' 'python-setuptools>77.0.3' 'python-wheel')
options=(!emptydirs)
# Devario: fetch the upstream release tag archive directly from GitHub so the
# recipe tracks the exact detected upstream release (tag 2026.11.15).
source=("${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('dca2a15f40c7a3a3d7ca438ff72b73f2160cbf4ceadb72ccf5d8d13aa6010cfe')
b2sums=('49802e71199c36dc30d2c195b2086d83cc09f13d932ee6422494c726d687ea9bff1173f2715c83167b8a3c14f433a5c2d77c75eefb046154fc4a8498d9cb557f')

build() {
  cd "mrab-regex-${pkgver}"

  python -m build -wn
}

check() {
  cd "mrab-regex-${pkgver}"

  local _pyver=cpython-$(python -c 'import sys; print("".join(map(str, sys.version_info[:2])))')
  cd "$PWD/build/lib.linux-$CARCH-$_pyver"
  python -m unittest regex/tests/test_regex.py
}

package() {
  cd "mrab-regex-${pkgver}"

  python -m installer --d "${pkgdir}" dist/*.whl
  install -Dm644 LICENSE.txt "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE.txt
}
