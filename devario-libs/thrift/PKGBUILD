pkgbase=thrift
pkgname=(
  thrift
  python-thrift
)
pkgver=0.25.0
pkgrel=1
pkgdesc="Scalable cross-language services framework for IPC/RPC"
arch=(x86_64)
url="https://thrift.apache.org"
_url="https://github.com/apache/thrift"
license=(Apache-2.0)
makedepends=(
  boost
  'cmake>=3.16'
  emacs-nox
  git
  'glib2>=2.48'
  glibc
  libevent
  libgcc
  libstdc++
  openssl
  python
  python-build
  python-installer
  'python-setuptools>=69'
  python-wheel
  qt5-base
  zlib
)
checkdepends=(
  'python-tornado>=6.3.0'
  'python-twisted>=24.3.0'
  'python-zope-interface>=6.1'
)
source=(
  "git+$_url.git#tag=v$pkgver?signed"
  "$pkgbase-python-adapt-tests-to-python3.patch"
  "$pkgbase-python-disable-failing-tests.patch"
)
b2sums=('1684b1cad059344d347082260d4153ab4b7e9f58eb2ada7e87dff4b06d8b77acfc4db50648347d92d486c80fa5abb3ee76f00cab89052a738bf48423fe4123f0'
        '8d89a47d8514f502267c705357dc3cf5d1d5f61e22b693d803d774cc9d2e1324e81e88879dbd6801a9f6e9461dc9b34fb934555398393834ccadba4929ce4300'
        '72b0b6d7a3a0c38c6ed2ea0d0043e4c17971d7fa21d97dc518218cc629f52be989243a41b26cc7ba04330bec6d1b9bd85e98a7a30c1c25c4cd534180a1ed3b85')
validpgpkeys=('8CD87F186F06E958EFCA963D76BD340FC4B75865') # Jens Geyer <jensg@apache.org>

prepare() {
  cd $pkgbase
  # Python 3.14 compatibility
  if ! git merge-base --is-ancestor 5abe53feaf598e40ab84eb259399113a79461791 HEAD; then
    git cherry-pick -n 5abe53feaf598e40ab84eb259399113a79461791
  fi
  # Remove use of collections.Hashable
  if ! git merge-base --is-ancestor 5c22d91b435341324e23dc505fe26850ddf3485e HEAD; then
    git cherry-pick -n 5c22d91b435341324e23dc505fe26850ddf3485e
  fi
  # test/py/TSimpleJSONProtocolTest.py still uses py2-era unittest aliases; the other
  # python test fixes this patch used to carry are upstream as of v0.25.0
  patch -Np1 < ../$pkgbase-python-adapt-tests-to-python3.patch
  patch -Np1 < ../$pkgbase-python-disable-failing-tests.patch
}

build() {
  cd $pkgbase
  cmake -S . -B build \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -W no-dev \
    -D BUILD_SHARED_LIBS=ON \
    -D BUILD_JAVA=OFF \
    -D BUILD_JAVASCRIPT=OFF \
    -D BUILD_KOTLIN=OFF \
    -D BUILD_NODEJS=OFF \
    -D BUILD_PYTHON=ON
  cmake --build build
  python -m build --wheel --no-isolation lib/py
  emacs -Q --batch -f batch-byte-compile contrib/thrift.el
}

check() {
  cd $pkgbase
  local skip_tests=(
    # See https://issues.apache.org/jira/browse/THRIFT-5680
    testapplicationexception
    testfdtransport
    testthriftfdreadcheck
  )
  local skip_tests_pattern="${skip_tests[0]}$(printf '|%s' "${skip_tests[@]:1}")"
  ctest --test-dir build --output-on-failure -E "$skip_tests_pattern"
}

package_thrift() {
  depends=(
    'glib2>=2.48'
    glibc
    libevent
    libgcc
    libstdc++
    openssl
    zlib
  )
  optdepends=('qt5-base: TQTcpServer (Qt5) support')
  provides=(
    libthrift.so
    libthrift_c_glib.so
    libthriftnb.so
    libthriftqt5.so
    libthriftz.so
  )

  cd $pkgbase
  DESTDIR="$pkgdir" cmake --install build
  install -vDm644 -t "$pkgdir/usr/share/vim/vimfiles/syntax" contrib/thrift.vim
  install -vDm644 -t "$pkgdir/usr/share/emacs/site-lisp" \
    contrib/thrift.el \
    contrib/thrift.elc
}

package_python-thrift() {
  pkgdesc+=" (Python bindings)"
  depends=(
    glibc
    libgcc
    libstdc++
    python
  )
  optdepends=(
    'python-tornado>=6.3.0: for tornado backend'
    'python-twisted>=24.3.0: for twisted backend'
    'python-zope-interface>=6.1: for twisted backend'
  )

  cd $pkgbase
  python -m installer --destdir="$pkgdir" lib/py/dist/*.whl
}
