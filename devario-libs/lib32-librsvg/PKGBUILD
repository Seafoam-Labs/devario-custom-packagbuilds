# Contributor: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: jtts <jussaar@mbnet.fi>
# Contributor: Jan de Groot <jgc@archlinux.org>

pkgbase=lib32-librsvg
pkgname=(
  lib32-librsvg
)
pkgver=2.63.4
pkgrel=1
epoch=2
pkgdesc="SVG rendering library (32-bit)"
url="https://gitlab.gnome.org/GNOME/librsvg"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  'lib32-cairo>=1.18.0'
  lib32-fontconfig
  'lib32-freetype2>=2.8.0'
  lib32-gcc-libs
  'lib32-gdk-pixbuf2>=2.20'
  'lib32-glib2>=2.50.0'
  lib32-glibc
  'lib32-harfbuzz>=2.0.0'
  'lib32-libxml2>=2.9.0'
  'lib32-pango>=1.50.0'
  librsvg
)
makedepends=(
  'cargo-c>=0.10.10'
  git
  gobject-introspection
  lib32-rust-libs
  llvm
  'meson>=1.3.0'
  'rust>=1.92.0'
)
checkdepends=(ttf-dejavu)
source=(
  # librsvg tags use SSH signatures which makepkg doesn't understand
  "git+https://gitlab.gnome.org/GNOME/librsvg.git#tag=$pkgver"
)
b2sums=('9c55c6161eee4cc5762c3a19c229b27da9169d599e57fc3ec72012fe0825038b37f6355ffd422e15613f9aa5548e1a6c7a11106eb2acdf34d0f6623487303cd1')

# Use debug
export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

# Use LTO
export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

prepare() {
  cd librsvg

  cargo fetch --locked --target i686-unknown-linux-gnu
}

build() {
  local meson_options=(
    --cross-file=lib32
    -D avif=disabled
    -D docs=disabled
    -D introspection=disabled
    -D pixbuf-loader=enabled
    -D triplet=i686-unknown-linux-gnu
    -D vala=disabled
  )

  arch-meson librsvg build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-rebuild
}

package_lib32-librsvg() {
  provides=(librsvg-${pkgver%%.*}.so)

  meson install -C build --no-rebuild --destdir "$pkgdir"

  rm -r "$pkgdir"/usr/{bin,include,share}
}

# vim:set sw=2 sts=-1 et:
