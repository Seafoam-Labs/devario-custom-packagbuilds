# Contributor: Thomas Jost <schnouki@schnouki.net>
# Contributor: Andrey Mikhaylenko <neithere@gmail.com>

pkgname=python-slugify
pkgver=9.1.3
pkgrel=1
pkgdesc='A Python slugify application that handles unicode'
arch=(any)
url=https://github.com/un33k/python-slugify
license=(MIT)
depends=(
  'python>=3.10'
  'python-text-unidecode>=1.3'
)
makedepends=(
  git
  python-build
  python-installer
  'python-setuptools>=77'
  python-wheel
)
optdepends=('python-unidecode: Unidecode support')
source=(git+https://github.com/un33k/python-slugify.git#tag=v${pkgver})
b2sums=('a219cdcddf006b2eb58d52481fb929d16d8035463a8b818f57f822710861dab3092da74702dc0fc3ff0d69e0611b73e21ef641d5cc139dfe5a9a73a55a51b9ca')

build() {
  cd python-slugify
  python -m build --wheel --no-isolation
}

package() {
  cd python-slugify
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm 644 LICENSE -t "${pkgdir}"/usr/share/licenses/python-slugify/
}
