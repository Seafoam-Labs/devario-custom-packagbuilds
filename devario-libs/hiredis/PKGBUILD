# Contributor: Vladimir Tsanev <tsachev@gmail.com>

pkgname=hiredis
pkgver=1.5.0
pkgrel=1
pkgdesc='Minimalistic C client library for Redis'
arch=('x86_64')
url="https://github.com/redis/hiredis/"
license=('BSD-3-Clause')
depends=('glibc')
checkdepends=('valkey')
source=("$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
b2sums=('9a24fb55d0a7875b0c95dffcd3449c3e4e8a12ed3894793d1537223dfd822590206ac49af97dd9d8276fc9e209087850c8f5e54b93425e8064714062ef5dd09e')

build() {
  cd $pkgname-$pkgver
  make PREFIX=/usr
}

check() {
  cd $pkgname-$pkgver
  make check
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -vDm 644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
