# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-java
_srcname=tree-sitter-java
pkgver=0.23.5
pkgrel=2
pkgdesc='Python bindings for the java Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-java
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-java/tar.gz/refs/tags/v0.23.5")
sha256sums=('cb199e0faae4b2c08425f88cbb51c1a9319612e7b96315a174a624db9bf3d9f0')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
