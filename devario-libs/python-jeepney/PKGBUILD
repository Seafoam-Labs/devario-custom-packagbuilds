# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: Felix Yan <felixonmars@archlinux.org>

pkgname=python-jeepney
pkgver=0.9.0
pkgrel=1
pkgdesc="Low-level, pure Python DBus protocol wrapper"
arch=('any')
url="https://gitlab.com/takluyver/jeepney"
license=('MIT')
depends=('python')
makedepends=(
  'python-build'
  'python-flit-core'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-trio'
  'python-testpath'
  'python-trio'
)
optdepends=('python-trio: support D-Bus applications with Trio')
source=("https://pypi.org/packages/source/j/jeepney/jeepney-$pkgver.tar.gz")
sha256sums=('cf0e9e845622b81e4a28df94c40345400256ec608d0e55bb8a3feaa9163f5732')

prepare() {
  cd "jeepney-$pkgver"
  # Devario also ships flit-core 4; this project uses standard PEP 621 metadata.
  sed -i 's/flit_core >=3.11,<4/flit_core >=3.11/' pyproject.toml
}

build() {
  cd "jeepney-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "jeepney-$pkgver"
  pytest
}

package() {
  cd "jeepney-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  # Do not install tests
  rm -vr "$pkgdir"/usr/lib/python*/site-packages/jeepney/tests
  rm -vr "$pkgdir"/usr/lib/python*/site-packages/jeepney/io/tests

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
