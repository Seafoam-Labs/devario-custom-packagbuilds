	optdepends = ggml-cuda: NVIDIA CUDA backend
	optdepends = ggml-vulkan: Vulkan GPU backend
	optdepends = ggml-zendnn: AMD ZenDNN CPU backend
	optdepends = ggml-openvino: OpenVINO Intel GPU backend
	provides = ggml-cpu=1.0.0

