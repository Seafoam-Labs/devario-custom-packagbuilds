# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-elixir
_srcname=tree-sitter-elixir
pkgver=0.3.5
pkgrel=2
pkgdesc='Python bindings for the elixir Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/elixir-lang/tree-sitter-elixir
license=('Apache-2.0')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/elixir-lang/tree-sitter-elixir/tar.gz/refs/tags/v0.3.5")
sha256sums=('7d8bf37949e2bea75a19d38491d7680ed1c9f0f5a41a5235832d718ec174c7c4')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
