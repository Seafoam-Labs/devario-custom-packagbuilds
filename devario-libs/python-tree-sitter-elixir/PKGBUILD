# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-elixir
_srcname=tree_sitter_elixir
pkgver=0.3.5
pkgrel=1
pkgdesc='Python bindings for the elixir Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/elixir-lang/tree-sitter-elixir
license=('Apache-2.0')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/e8/83/0501ee426bcd40cf5f765ce66ff2e7136d438ff4e65aeb08991f9826d4e5/tree_sitter_elixir-0.3.5.tar.gz")
sha256sums=('ead089393b1ce732304e6b6fb0bc0ab79e3295663d697be025bd49f0f367b74d')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
