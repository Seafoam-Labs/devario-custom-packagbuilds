# Contributor: Daniele Paolella <dp@mcrservice.it>

# First publish python-distlib and python-filelock, then python-python-discovery.
# Set to 1 and regenerate .SRCINFO to include documentation once Sphinx is available.
_build_docs=0

pkgname=python-virtualenv
pkgver=21.15.6
pkgrel=1
pkgdesc='Virtual Python Environment builder'
arch=(any)
url='https://virtualenv.pypa.io'
license=(MIT)
depends=(
  'python>=3.9'
  'python-distlib>=0.4.3'
  'python-distlib<1'
  'python-filelock>=3.24.2'
  'python-filelock<5'
  'python-packaging>=26.3'
  'python-platformdirs>=4.4'
  'python-platformdirs<5'
  'python-python-discovery>=1.6.1'
  'python-typing_extensions>=4.16'
)
makedepends=(
  git
  python-build
  python-installer
  'python-hatchling>=1.28'
  'python-hatch-fancy-pypi-readme>=25.1'
  'python-hatch-vcs>=0.5'
  python-wheel
)
if (( _build_docs )); then
  makedepends+=(
    python-sphinx
    python-sphinx-argparse
    python-sphinx-autodoc-typehints
    python-sphinx-copybutton
    python-sphinx-inline-tabs
    python-sphinxcontrib-towncrier
    python-sphinxcontrib-mermaid
    towncrier
  )
fi
replaces=(virtualenv)
conflicts=(virtualenv)
options=(!makeflags)
source=(
  "$pkgname::git+https://github.com/pypa/virtualenv#tag=$pkgver"
  no-llm-crap.patch
)
sha512sums=('281cf46232389cc1a4ac20e572e01b586bc19ae43e4895a61d70d9d9782aa54b3ac18bf06875ab2e2b17e1d625430e7e8e85a0f51f65fc4d6b6496dba4ecaa6c'
            '9d198995dabe340d905d63d8bd372980223033155956c522479537f26a93c83149b0a323e81abf8de0e31decd6e1f6063aae3be1f5200f872901d81acefa063e')
b2sums=('5be087dcbdbb8190c8ad2935902dfef480a199b896b723ad7bfbbb69a561e793551e7137cfb118ed8af4e5d87f5bc86c4e826dc7ddea976c715f86ed0ee1d579'
        '202e755826989926017b045ba310bf2a90e0e57940b851ca3add5cb28b062f4606f88c1cf3bd6b19b983d95443b19004f68d58e0fde274f8353900df1b90ffca')

prepare() {
  cd "$pkgname"

  # this really is completely unnecessary
  patch -p1 -i "$srcdir/no-llm-crap.patch"
}

build() {
  cd "$pkgname"

  export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"

  python -m build --wheel --no-isolation

  if (( _build_docs )); then
    # Install to a temporary directory for documentation generation.
    python -m installer --destdir=test_dir dist/*.whl
    local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
    PYTHONPATH="$(pwd)/test_dir/$site_packages:$PYTHONPATH" \
      sphinx-build -b man docs docs/_build/man
  fi
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  if (( _build_docs )); then
    # man page and compatibility alias
    install -vDm644 -t "$pkgdir/usr/share/man/man1" docs/_build/man/virtualenv.1
    ln -s virtualenv.1.gz "${pkgdir}/usr/share/man/man1/virtualenv3.1.gz"
  fi

  # executable compatibility alias is also needed during bootstrap
  ln "$pkgdir/usr/bin/virtualenv" "$pkgdir/usr/bin/virtualenv3"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
