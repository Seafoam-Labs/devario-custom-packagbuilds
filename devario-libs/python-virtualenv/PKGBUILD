# Contributor: Dan McGee <dan@archlinux.org>
# Contributor: Daniele Paolella <dp@mcrservice.it>

# First publish python-distlib and python-filelock, then python-python-discovery.
# Set to 1 and regenerate .SRCINFO to include documentation once Sphinx is available.
_build_docs=0

pkgname=python-virtualenv
pkgver=21.14.5
pkgrel=3
pkgdesc='Virtual Python Environment builder'
arch=(any)
url='https://virtualenv.pypa.io'
license=(MIT)
depends=(
  python
  python-distlib
  python-filelock
  python-packaging
  python-platformdirs
  python-python-discovery
)
makedepends=(
  git
  python-build
  python-installer
  python-hatchling
  python-hatch-vcs
  python-wheel
)
if (( _build_docs )); then
  makedepends+=(
    python-sphinx
    python-sphinx-argparse
    python-sphinx-autodoc-typehints
    python-sphinx-copybutton
    python-sphinx-inline-tabs
    python-sphinxcontrib-towncrier
    python-sphinxcontrib-mermaid
    towncrier
  )
fi
replaces=(virtualenv)
conflicts=(virtualenv)
options=(!makeflags)
source=(
  "$pkgname::git+https://github.com/pypa/virtualenv#tag=$pkgver"
  no-llm-crap.patch
)
sha512sums=('041271c572875c2532ca8489362e2768b4ad5953c65bc645102b508fbaaac7a5ea3304a285baac8d4e878108193c3117b68401e794e868f49f50d9b9586f7d17'
            '243e7a6b08616b9bd30bd32295fe52b32ce3902f462dcd21f7f5ba3979577ad79fdf571965dbb6ff8d85ddd3ac8aa52f6937bfd2c995e518c6729c84033fe8e5')
b2sums=('cfd511d5e41eee1df03b3997581615983c9134636703c0af4ce48bd1518d451bed20582a07b5625f624926e08e26b66a89d5daaa5dc30d3a0fe71a4329f16cb0'
        'f8291a2cfce1adcd1ca4d4b861967d7c6d22b7a5828978d91bc26c4d0a53268bcebb93601b23e550339a8a05dbc3cc4943fab5e8d138e268a078fb691e92f895')

prepare() {
  cd "$pkgname"

  # this really is completely unnecessary
  patch -p1 -i "$srcdir/no-llm-crap.patch"
}

build() {
  cd "$pkgname"

  export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"

  python -m build --wheel --no-isolation

  if (( _build_docs )); then
    # Install to a temporary directory for documentation generation.
    python -m installer --destdir=test_dir dist/*.whl
    local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
    PYTHONPATH="$(pwd)/test_dir/$site_packages:$PYTHONPATH" \
      sphinx-build -b man docs docs/_build/man
  fi
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  if (( _build_docs )); then
    # man page and compatibility alias
    install -vDm644 -t "$pkgdir/usr/share/man/man1" docs/_build/man/virtualenv.1
    ln -s virtualenv.1.gz "${pkgdir}/usr/share/man/man1/virtualenv3.1.gz"
  fi

  # executable compatibility alias is also needed during bootstrap
  ln "$pkgdir/usr/bin/virtualenv" "$pkgdir/usr/bin/virtualenv3"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
