# Contributor: Chris Severance aur.severach aATt spamgourmet dott com (rustdesk AUR)
# Contributor: Rojikku <RojikkuNoKami at gmail dot com> (rustdesk AUR)
# Contributor: Tech <technetium1337 at gmail dot com> (rustdesk AUR)
pkgname=ffmpeg-rustdesk
pkgver=7.1.1
pkgrel=4
pkgdesc='Patched static FFmpeg libraries for RustDesk hardware codecs'
arch=('x86_64')
url='https://github.com/rustdesk/rustdesk'
license=('LGPL-2.1-or-later')
depends=('glibc' 'libdrm' 'zlib')
makedepends=(
  'clang'
  'libva'
  'nasm'
  'pkgconf'
)
# RustDesk links these native archives into its shared library.
options=('!lto' 'staticlibs')
# Keep this patch set in sync with the source pin in rustdesk/PKGBUILD.
_rustdesk_commit=23e5bb471a040d62f0a6ad52591fb30784265b73
_nvcodec=12.1.14.0
_amf=1.4.35
# hwcodec expects this private vcpkg-style layout, separate from system FFmpeg.
_libdir=/usr/lib/rustdesk-ffmpeg-static
_includedir=/usr/include/rustdesk-ffmpeg-static
_compatdir=/usr/lib/rustdesk-ffmpeg/installed/x64-linux
source=(
  "ffmpeg-$pkgver.tar.gz::https://codeload.github.com/FFmpeg/FFmpeg/tar.gz/refs/tags/n$pkgver"
  "rustdesk-$_rustdesk_commit.tar.gz::https://codeload.github.com/rustdesk/rustdesk/tar.gz/$_rustdesk_commit"
  "nv-codec-headers-$_nvcodec.tar.gz::https://codeload.github.com/FFmpeg/nv-codec-headers/tar.gz/refs/tags/n$_nvcodec"
  "amf-$_amf.tar.gz::https://codeload.github.com/GPUOpen-LibrariesAndSDKs/AMF/tar.gz/refs/tags/v$_amf"
)
sha256sums=(
  'f117507dc501f2a6c11f9241d8d0c3213846cfad91764361af37befd6b6c523d'
  'b0094708b091d320601373ba23c984594b3cc9e972ba069ab439a4f9f58c4c7b'
  '2fefaa227d2a3b4170797796425a59d1dd2ed5fd231db9b4244468ba327acd0b'
  '5d93101eae5895247bea58cff40bb84424158170ae7f931105666157cc187636'
)
# Paths in res/vcpkg/ffmpeg/ of the checksummed RustDesk source archive.
_patches=(
  0001-create-lib-libraries.patch
  0002-fix-msvc-link.patch
  0003-fix-windowsinclude.patch
  0004-dependencies.patch
  0005-fix-nasm.patch
  0007-fix-lib-naming.patch
  0013-define-WINVER.patch
  0020-fix-aarch64-libswscale.patch
  0024-fix-osx-host-c11.patch
  0040-ffmpeg-add-av_stream_get_first_dts-for-chromium.patch
  0041-add-const-for-opengl-definition.patch
  0043-fix-miss-head.patch
  patch/0001-avcodec-amfenc-add-query_timeout-option-for-h264-hev.patch
  patch/0002-libavcodec-amfenc-reconfig-when-bitrate-change.patch
  patch/0004-videotoolbox-changing-bitrate.patch
  patch/0005-mediacodec-changing-bitrate.patch
  patch/0006-dlopen-libva.patch
  patch/0007-fix-linux-configure.patch
  patch/0008-remove-amf-loop-query.patch
  patch/0009-fix-nvenc-reconfigure-blur.patch
  patch/0010.disable-loading-DLLs-from-app-dir.patch
  patch/0011-android-mediacodec-encode-align-64.patch
  patch/0013-fix-qsv-encode-timeouts.patch
  patch/0014-fix-qsv-encode-buffer.patch
  patch/0015-fix-hybrid-mp4-finalization.patch
)

prepare() {
  cd "FFmpeg-n$pkgver"
  local _patch
  # Upstream order, omitting the macOS-only weak-import patch on Linux.
  for _patch in "${_patches[@]}"; do
    patch -Np1 -i \
      "$srcdir/rustdesk-$_rustdesk_commit/res/vcpkg/ffmpeg/$_patch"
  done

  local _codec_headers="$srcdir/codec-headers"
  install -d "$_codec_headers/include/AMF" "$_codec_headers/lib/pkgconfig"
  cp -a "$srcdir/nv-codec-headers-n$_nvcodec/include/ffnvcodec" "$_codec_headers/include/"
  cp -a "$srcdir/AMF-$_amf/amf/public/include/." "$_codec_headers/include/AMF/"
  sed "s|@@PREFIX@@|$_codec_headers|g" \
    "$srcdir/nv-codec-headers-n$_nvcodec/ffnvcodec.pc.in" \
    > "$_codec_headers/lib/pkgconfig/ffnvcodec.pc"
}

build() {
  cd "FFmpeg-n$pkgver"
  export PKG_CONFIG_PATH="$srcdir/codec-headers/lib/pkgconfig"
  ./configure \
    --prefix=/usr --libdir="$_libdir" --incdir="$_includedir" \
    --datadir="/usr/share/$pkgname" --arch="$CARCH" --target-os=linux \
    --cc=clang --cxx=clang++ \
    --extra-cflags="$CFLAGS -I$srcdir/codec-headers/include" \
    --extra-ldflags="$LDFLAGS" \
    --disable-shared --enable-static --enable-pic \
    --disable-autodetect --disable-everything \
    --disable-programs --disable-doc --disable-debug --disable-network \
    --disable-avdevice --disable-avfilter --disable-swresample --disable-swscale \
    --disable-postproc --disable-vdpau \
    --enable-pthreads --enable-zlib --enable-libdrm --enable-vaapi \
    --enable-avcodec --enable-avformat \
    --enable-decoder=h264,hevc --enable-parser=h264,hevc \
    --enable-bsf=h264_mp4toannexb,hevc_mp4toannexb,h264_metadata,hevc_metadata \
    --enable-muxer=mp4 --enable-protocol=file \
    --enable-cuda --enable-cuda-llvm --enable-ffnvcodec --enable-amf \
    --enable-nvenc --enable-nvdec \
    --enable-encoder=h264_nvenc,hevc_nvenc,h264_amf,hevc_amf,h264_vaapi,hevc_vaapi \
    --enable-hwaccel=h264_nvdec,hevc_nvdec,h264_vaapi,hevc_vaapi
  make
}

check() {
  cd "FFmpeg-n$pkgver"
  local _library _encoder
  for _library in avcodec avformat avutil; do
    test -s "lib$_library/lib$_library.a"
  done
  # Execution of these encoders needs separate GPU tests.
  for _encoder in H264_NVENC HEVC_NVENC H264_AMF HEVC_AMF H264_VAAPI HEVC_VAAPI; do
    grep -qx "#define CONFIG_${_encoder}_ENCODER 1" config_components.h
  done
}

package() {
  cd "FFmpeg-n$pkgver"
  make DESTDIR="$pkgdir" install
  install -d "$pkgdir$_compatdir"
  ln -s ../../../rustdesk-ffmpeg-static "$pkgdir$_compatdir/lib"
  ln -s ../../../../include/rustdesk-ffmpeg-static "$pkgdir$_compatdir/include"
  install -Dm644 "$srcdir/rustdesk-$_rustdesk_commit/res/vcpkg/ffmpeg/portfile.cmake" \
    "$pkgdir/usr/share/doc/$pkgname/upstream-portfile.cmake"
}
