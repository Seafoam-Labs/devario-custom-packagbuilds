# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=blosc
pkgver=1.21.7
pkgrel=1
pkgdesc='A blocking, shuffling and loss-less compression library'
arch=(x86_64)
url='https://www.blosc.org'
license=(BSD-3-Clause)
depends=(
  glibc
  lz4
  snappy
  zlib
  zstd
)
makedepends=(git 'cmake>=3.10')
source=("$pkgname::git+https://github.com/Blosc/c-blosc#tag=v$pkgver")
sha512sums=('59b7f9e636de0b87a716c9797e3a31813dca5accc5ed83191e6d0872af1cc933f49f0b2aa8ea3c7b98b8b73267d8560208a155a09fe2fd2817b1fb8c547cbf6e')
b2sums=('c87dc75478e0d9ca917e808dda311e6725080d791ebb65dcfd7a66db868cb7f697f3c99450e59a4c888910c89000c235b77c2ce7d3d7e98090a20c18df181aea')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -D CMAKE_INSTALL_PREFIX=/usr
    -D BUILD_STATIC=OFF
    -D DEACTIVATE_SNAPPY=OFF
    -D PREFER_EXTERNAL_LZ4=ON
    -D PREFER_EXTERNAL_ZLIB=ON
    -D PREFER_EXTERNAL_ZSTD=ON
    -D CMAKE_C_STANDARD=17
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

check() {
  cd build

  ctest --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/LICENSE.txt"
}
