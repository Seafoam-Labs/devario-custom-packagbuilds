# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Tomaz Canabrava <tomaz.canabrava@archlinux.org>

_inner_folder_name=KDDockWidgets
pkgname=kddockwidgets
pkgver=2.4.1
pkgrel=1
pkgdesc="Dock Widgets Library by KDAB for Qt6"
arch=('x86_64')
url="https://github.com/KDAB/KDDockWidgets"
license=(GPL-2.0-only
         GPL-3.0-only)
depends=(
    fmt
    glibc
    libgcc
    libstdc++
    qt6-base
    qt6-declarative
    spdlog
)
makedepends=(
    cmake
    nlohmann-json
    qt6-tools
)
# Shelly keeps bare .so provisions, so declare the SONAME alongside it.
provides=(libkddockwidgets-qt6.so 'libkddockwidgets-qt6.so=3-64')

source=($url/releases/download/v$pkgver/kddockwidgets-$pkgver.tar.gz{,.asc})

sha256sums=('5cd9495d9316cf6cc937bb328a7fd491c3248ef2469cfa42511f1039f6148aca'
            'SKIP')

validpgpkeys=(E86C000370B1B9E2A9191AD53DBFB6882C9358FB) # info@kdab.com

build() {
    cmake -B build -S $_inner_folder_name-$pkgver \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DKDDockWidgets_FRONTENDS='qtwidgets;qtquick'
    cmake --build build
}

package() {
    depends+=(libfmt.so libspdlog.so)
    DESTDIR="$pkgdir" cmake --install build
    _verify_soname "$pkgdir/usr/lib/libkddockwidgets-qt6.so" libkddockwidgets-qt6.so.3 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
