# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-kotlin
_srcname=tree-sitter-kotlin
pkgver=1.1.0
pkgrel=2
pkgdesc='Python bindings for the kotlin Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter-grammars/tree-sitter-kotlin
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter-grammars/tree-sitter-kotlin/tar.gz/refs/tags/v1.1.0")
sha256sums=('3c36bd5627fff38e4323ebead1f7e86e6d1727f0353618d1c976fea88260ba90')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
