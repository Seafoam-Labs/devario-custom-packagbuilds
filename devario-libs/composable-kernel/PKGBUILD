# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=composable-kernel
pkgver=10.0
pkgrel=1
pkgdesc="High Performance Composable Kernel for AMD GPUs"
arch=('x86_64')
url="https://github.com/ROCm/rocm-libraries"
license=('MIT')
depends=('rocm-core' 'glibc' 'libgcc' 'libstdc++' 'hip-runtime-amd')
makedepends=('git' 'cmake' 'ninja' 'rocm-cmake' 'rocm-toolchain' 'rocm-llvm' 'openmp')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/therock-$pkgver/composablekernel.tar.gz")
sha256sums=('2ae559e9e321f5fc290b7d46ffd64ce6a9491977f9d33e5fb11742bf50f8d931')
# Build without default flags as they cause the final linking step to fail
# https://github.com/ROCmSoftwarePlatform/composable_kernel/issues/736
options=(!lto !buildflags)
_dirname=composablekernel

prepare() {
    # Remove tests as they require a supported AMD GPU to run
    sed -i '/add_subdirectory(test)/d' "$_dirname/CMakeLists.txt"
}

build() {
  # amdclang++ lives in /opt/rocm/bin, which rocm-core only puts on PATH through
  # /etc/profile.d/rocm.sh. Shelly's build shell does not source profile.d, so
  # CMake cannot resolve the bare compiler name below.
  export PATH="/opt/rocm/bin:$PATH"
  # CK links a shared library against HIP, and clang's driver has to infer the
  # ROCm root to emit the -L that pairs with the -lamdhip64 that --hip-link
  # adds. Walking up from /opt/rocm/lib/llvm/bin lands on /opt/rocm/lib, so
  # point it at the real prefix. rocsparse and rocblas need the same export.
  export ROCM_PATH=/opt/rocm

  local _cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$_dirname"
    -D CMAKE_CXX_COMPILER=amdclang++
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    # CK doesn't support all targets
    # -D GPU_ARCHS="$(rocm-supported-gfx)"
    -D GPU_ARCHS="gfx908;gfx90a;gfx942;gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201"
    -D BUILD_DEV=OFF
    -D INSTANCES_ONLY=ON
  )
  cmake "${_cmake_args[@]}"
  cmake --build build
}

package() {
  # The CMake cache holds CMAKE_CXX_COMPILER as the bare name "amdclang++", and
  # each PKGBUILD function runs in its own shell under Shelly, so a regeneration
  # during install would fail to find it again.
  export PATH="/opt/rocm/bin:$PATH"

  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
