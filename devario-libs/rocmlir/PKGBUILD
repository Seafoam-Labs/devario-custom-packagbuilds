pkgname=rocmlir
pkgver=7.2.3
pkgrel=1
pkgdesc="AMD's MLIR-based compiler for ROCm (rockCompiler)"
arch=('x86_64')
url="https://github.com/ROCm/rocMLIR"
license=('MIT AND Apache-2.0 WITH LLVM-exception')
depends=('hsa-rocr')
makedepends=(
  git
  cmake
  ninja
  rocm-cmake
  rocm-llvm
  hsa-rocr
)
# Tags rocm-7.2.2 and rocm-7.2.3 point at the same commit, which is the tree
# MIGraphX 7.2.3 pins and MIOpen 7.2.4 already uses.
source=("$pkgname::git+https://github.com/ROCm/rocMLIR#tag=rocm-$pkgver")
sha256sums=('674cf03c6d5d0fb65e7b57c71cb0671cc29e1672446f4abb39c13cd9296aa9ef')
options=(!lto)

build() {
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  CXXFLAGS+=" -fcf-protection=none"
  local cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$pkgname"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    # GNUInstallDirs picks lib64 for /opt/rocm, but the install rules put
    # librockCompiler.a in lib; keep the CMake config beside it.
    -D CMAKE_INSTALL_LIBDIR=lib
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_C_COMPILER=amdclang
    -D CMAKE_CXX_COMPILER=amdclang++
    -D BUILD_FAT_LIBROCKCOMPILER=ON
    -D BUILD_SHARED_LIBS=OFF
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE.TXT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname/external/llvm-project/LICENSE.TXT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.llvm-project"
  install -Dm644 "$pkgname/mlir/tools/rocmlir-lib/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rocmlir-lib"
}
