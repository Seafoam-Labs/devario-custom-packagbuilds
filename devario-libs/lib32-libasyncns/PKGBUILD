pkgname=lib32-libasyncns
pkgver=0.8+r3+g68cd5af
pkgrel=3
epoch=1
pkgdesc="A C library for executing name service queries asynchronously (32-bit)"
url="https://0pointer.net/lennart/projects/libasyncns/"
arch=(x86_64)
license=(LGPL)
depends=(lib32-glibc libasyncns)
makedepends=(git lynx)
_commit=68cd5aff1467638c086f1bedcc750e34917168e4  # master
# Fetch only from Seafoam Labs. Use a distinct cache name so an old
# libasyncns source cache from 0pointer is not reused.
source=("seafoam-libasyncns::git+https://github.com/Seafoam-Labs/libasyncns.git#commit=$_commit")
sha256sums=('SKIP')

# No pkgver(): the mirror tags the pinned commit v0.8-r3, so git describe
# would shorten the version to 0.8+r3. Keep the value Arch computes upstream.

prepare() {
  cd "$srcdir/seafoam-libasyncns"

  # Fix libdir
  sed -i '/^libdir=/s:/lib:/lib32:' *.pc.in

  NOCONFIGURE=1 ./bootstrap.sh
}

build() {
  cd "$srcdir/seafoam-libasyncns"

  export CC="gcc -m32"
  export CXX="g++ -m32"
  export PKG_CONFIG=i686-pc-linux-gnu-pkg-config

  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
      --libdir=/usr/lib32 \
      --disable-static
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd "$srcdir/seafoam-libasyncns"
  make DESTDIR="$pkgdir" install
  rm -r "$pkgdir"/usr/{include,share}
}

