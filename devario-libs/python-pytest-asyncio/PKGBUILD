pkgname=python-pytest-asyncio
pkgver=1.4.1.post1
pkgrel=1
pkgdesc="Pytest support for asyncio."
arch=('any')
url="https://github.com/pytest-dev/pytest-asyncio"
license=('Apache-2.0')
depends=('python>=3.10' 'python-pytest>=8.4')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools>=77' 'python-setuptools-scm>=6.2')
checkdepends=('python-hypothesis>=5.7.1')
source=("git+https://github.com/pytest-dev/pytest-asyncio.git#tag=v$pkgver")
b2sums=('93ff185afc8510d8d502d4251efb81d0adc66317a5ac984e916cb88a614063e69d15f8bc567c06fc953dec2ef5c75ac4b8944dd9786e4c55e458e60079bc9666')

build() {
  cd pytest-asyncio
  python -m build -wn
}

check() {
  cd pytest-asyncio
  PYTHONPATH="$PWD" pytest
}

package() {
  cd pytest-asyncio
  python -m installer --destdir="$pkgdir" dist/*.whl
}
