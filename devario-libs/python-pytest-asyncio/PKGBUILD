pkgname=python-pytest-asyncio
pkgver=1.5.0
pkgrel=1
pkgdesc="Pytest support for asyncio."
arch=('any')
url="https://github.com/pytest-dev/pytest-asyncio"
license=('Apache-2.0')
depends=('python>=3.10' 'python-pytest>=8.4')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools>=77' 'python-setuptools-scm>=6.2')
checkdepends=('python-hypothesis>=5.7.1')
source=("git+https://github.com/pytest-dev/pytest-asyncio.git#tag=v1.5.0")
b2sums=('ee85677b6fd6abb46e0903e9dded15f57baf94236bd1cd0b2847935f123d8e53eda3fc1e0aaa6661dbe333a3c25689a68163642518c1751166c4d1e2d0ddc1f5')

build() {
  cd pytest-asyncio
  python -m build -wn
}

check() {
  cd pytest-asyncio
  PYTHONPATH="$PWD" pytest
}

package() {
  cd pytest-asyncio
  python -m installer --destdir="$pkgdir" dist/*.whl
}
