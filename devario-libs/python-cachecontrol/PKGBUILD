pkgname=python-cachecontrol
_name=cachecontrol
pkgver=0.15.0
pkgrel=1
epoch=1
pkgdesc='Caching for the requests HTTP library'
arch=(any)
url='https://github.com/psf/cachecontrol'
license=(Apache-2.0)
depends=(python python-requests python-msgpack)
makedepends=(python-build python-installer python-uv-build)
checkdepends=(python-pytest python-cherrypy python-freezegun python-filelock)
optdepends=('python-filelock: file-based cache backend')
source=("$_name-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/c/$_name/$_name-$pkgver.tar.gz")
sha256sums=('52157b539eb64d85c8c793660e86cf05cf95fad7b98c8ef6846e4a0ddffdb193')

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver"
  # 0.15.0 resolves __version__ through importlib.metadata, so the tests
  # need the wheel's dist-info installed.
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest tests
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
