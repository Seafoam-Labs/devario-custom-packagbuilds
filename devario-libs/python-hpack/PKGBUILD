# Maintainer: Devario maintainers
_name=hpack
pkgname=python-hpack
pkgver=4.2.0
pkgrel=1
pkgdesc='Pure-Python HPACK header encoding'
arch=(any)
url='https://github.com/python-hyper/hpack'
license=(MIT)
depends=(
  'python>=3.10'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools>=82'
  'python-wheel>=0.46.3'
)
source=("https://files.pythonhosted.org/packages/source/h/$_name/$_name-$pkgver.tar.gz")
sha256sums=('0895cfa3b5531fc65fe439c05eb65144f123bf7a394fcaa56aa423548d8e45c0')

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
