# Maintainer: Eric Bélanger <eric@archlinux.org>

pkgname=python-pyasn1
pkgdesc="ASN.1 library for Python 3"
pkgver=0.6.5
pkgrel=1
arch=('any')
url="https://github.com/pyasn1/pyasn1"
license=('BSD-2-Clause')
depends=('python>=3.8')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
replaces=('pyasn1')
provides=('pyasn1')
source=("git+https://github.com/pyasn1/pyasn1.git#tag=v$pkgver")
sha512sums=('6ee4a2a6aa7d11908f5110cd7ebe0d4d4e142ea218f67ab64b0e62b7ac769bf3c019abef12dee9a9469047c2a46408592138ad70e2867a7e996d84828cb08a49')

build() {
  cd pyasn1
  python -m build -nw
}

check() {
  cd pyasn1
  python -m unittest discover -s tests
}

package() {
  cd pyasn1
  python -m installer -d "$pkgdir" dist/*.whl

  # Symlink license file
  install -Dm644 LICENSE.rst "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
