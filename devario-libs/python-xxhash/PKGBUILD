# Contributor: Konstantin Gizdov <arch at kge dot pw>

pkgname=python-xxhash
pkgver=4.1.0
pkgrel=1
pkgdesc='Python binding for xxHash'
arch=(x86_64)
url="https://github.com/ifduyue/$pkgname"
license=(BSD-2-Clause)
depends=(
    glibc
    'python>=3.9'
    xxhash
)
makedepends=(
    git
    python-build
    python-installer
    'python-setuptools>=45'
    python-setuptools-scm
    python-wheel
)
source=("$pkgname::git+$url.git#tag=v$pkgver")
b2sums=('16ae1e2b66aeae5f27a595c8036ade9927dbffdcab2952ea5913a1e2e50d93f71fad3c29892aeddab8c54f16faa160abb0f7f2c2a6b6df36e44549743ce6e6fc')

build() {
    cd $pkgname
    # link to xxHash
    XXHASH_LINK_SO=1 \
    python -m build --wheel --no-isolation
}

package() {
    cd $pkgname
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
