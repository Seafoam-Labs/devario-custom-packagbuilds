# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=syndication
pkgver=6.31.0
pkgrel=1
pkgdesc='RSS/Atom parser library'
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=(LGPL-2.0-only LGPL-3.0-only)
depends=(libgcc
         libstdc++
         glibc
         'kcodecs>=6.31.0'
         'qt6-base>=6.10.0')
makedepends=('cmake>=3.30'
             doxygen
             'extra-cmake-modules>=6.31.0'
             qt6-tools)
groups=(kf6)
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz{,.sig})
sha256sums=('7cd3ac299ff01736b7a9a1a2eb3700561810267a2e3af50935c3f3cce9635077'
            'SKIP')
validpgpkeys=(590D53B263D6A9250ABE5F0E209C870760231085 # Christophe Giboudeaux <christophe@krop.fr>
              72318AC88F5F1DFBDFFC46B2A584840902449FB7 # Nicolas Fella <nicolas.fella@gmx.de>
              )

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
