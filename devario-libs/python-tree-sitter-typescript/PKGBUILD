# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-typescript
_srcname=tree_sitter_typescript
pkgver=0.23.2
pkgrel=1
pkgdesc='Python bindings for the typescript Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-typescript
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/1e/fc/bb52958f7e399250aee093751e9373a6311cadbe76b6e0d109b853757f35/tree_sitter_typescript-0.23.2.tar.gz")
sha256sums=('7b167b5827c882261cb7a50dfa0fb567975f9b315e87ed87ad0a0a3aedb3834d')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
