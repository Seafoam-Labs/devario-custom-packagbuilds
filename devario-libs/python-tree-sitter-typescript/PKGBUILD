# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-typescript
_srcname=tree-sitter-typescript
pkgver=0.23.2
pkgrel=2
pkgdesc='Python bindings for the typescript Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-typescript
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-typescript/tar.gz/refs/tags/v0.23.2")
sha256sums=('2c4ce711ae8d1218a3b2f899189298159d672870b5b34dff5d937bed2f3e8983')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
