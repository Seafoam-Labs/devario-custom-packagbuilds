# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-c-sharp
_ghname=tree-sitter-c-sharp
pkgver=0.24.0
pkgrel=1
pkgdesc='Python bindings for the c-sharp Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-c-sharp
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://github.com/tree-sitter/tree-sitter-c-sharp/archive/refs/tags/v0.24.0.tar.gz")
sha256sums=('207d4fa4132dcb4503ba9efce808d3c42d60126910ef092a68eb41291fc1c9b2')

build() {
  cd "$_ghname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_ghname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
