# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-julia
_srcname=tree_sitter_julia
pkgver=0.23.1
pkgrel=1
pkgdesc='Python bindings for the julia Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-julia
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/d5/e7/1ff7d38967471f13b77420cdfc58ce170c8ceb83ff4b55ce50744c076e79/tree_sitter_julia-0.23.1.tar.gz")
sha256sums=('07607c4fc902b21e6821622f56b08aa2321b921fe0644e2ab4aba1747e6c8808')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
