# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-json
_srcname=tree-sitter-json
pkgver=0.24.8
pkgrel=2
pkgdesc='Python bindings for the json Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-json
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-json/tar.gz/refs/tags/v0.24.8")
sha256sums=('acf6e8362457e819ed8b613f2ad9a0e1b621a77556c296f3abea58f7880a9213')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
