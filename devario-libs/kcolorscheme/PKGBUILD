# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=kcolorscheme
pkgver=6.32.0
pkgrel=1
pkgdesc='Classes to read and interact with KColorScheme'
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=(LGPL-2.0-only LGPL-3.0-only)
depends=(glibc
         'kconfig>=6.32.0'
         'kguiaddons>=6.32.0'
         'ki18n>=6.32.0'
         libstdc++
         'qt6-base>=6.10.0')
makedepends=('cmake>=3.30'
             doxygen
             'extra-cmake-modules>=6.32.0'
             qt6-tools)
groups=(kf6)
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz{,.sig})
sha256sums=('235c73afa46669c41cbe2e3a14c5a6ae1f8ad8cbb386b3f65261f65449d2b915'
            'SKIP')
validpgpkeys=(53E6B47B45CEA3E0D5B7457758D0EE648A48B3BB # David Faure <faure@kde.org>
              90A968ACA84537CC27B99EAF2C8DF587A6D4AAC1 # Nicolas Fella <nicolas.fella@kde.org>
              )

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
