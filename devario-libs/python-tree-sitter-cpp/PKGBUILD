# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-cpp
_srcname=tree-sitter-cpp
pkgver=0.23.4
pkgrel=2
pkgdesc='Python bindings for the cpp Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-cpp
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-cpp/tar.gz/refs/tags/v0.23.4")
sha256sums=('7a2c55afe3028f4105f25762ea58cc16537d1f5a1dcd9cca90410b3cd5d46051')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
