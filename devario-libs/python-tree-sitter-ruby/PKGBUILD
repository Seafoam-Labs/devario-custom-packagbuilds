# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-ruby
_srcname=tree-sitter-ruby
pkgver=0.23.1
pkgrel=2
pkgdesc='Python bindings for the ruby Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-ruby
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-ruby/tar.gz/refs/tags/v0.23.1")
sha256sums=('e7e49577ddc1f2de8e42d42353b477e338c15bbb95b2558e123ddc13d88789f0')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
