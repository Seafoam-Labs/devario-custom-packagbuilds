# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Adapted for Devario from Arch Linux packaging: build only the gtk4 plugin
# (gtk4paintablesink) needed by gthumb. The full workspace build requires
# csound and other dependencies not carried by Devario; other plugins can be
# re-enabled here once their dependencies are available.

pkgbase=gst-plugins-rs
pkgname=(gst-plugin-gtk4)
pkgver=0.15.4
pkgrel=2.1
pkgdesc="Multimedia graph framework - gtk4 plugin"
url="https://gstreamer.freedesktop.org/"
arch=(x86_64)
license=(MPL-2.0)
depends=(
  glib2
  glibc
  graphene
  gst-plugins-base-libs
  gstreamer
  gtk4
  libgcc
)
makedepends=(
  cargo-c
  git
  graphene
  gst-plugins-base
  gst-plugins-base-libs
  gtk4
  rust
)
options=(!lto)
groups=(gst-plugins-rs)
source=(
  "git+https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs.git?signed#tag=$pkgver"
  0001-Update-lockfile.patch
)
b2sums=('271492d6096a59643e99b876716c43b70161ff5a5b5ca18ca04dbbc7d178f508317730d51b3efe0e9287f8a2e6048e80bbad6f6e735af64d68aeec9ec969ab0b'
        'a484e253f4ae9cca78185e2b8b7f27ad0862bb67372b08353dc1b1cbbe72b21eeee3eb0be4767b591f63fe63b0461d40d4e47d913b1d207319e18a2aaac9c2b3')
validpgpkeys=(
  7F4BC7CC3CA06F97336BBFEB0668CC1486C2D7B5 # Sebastian Dröge <sebastian@centricular.com>
)

# Features of the gst-plugin-gtk4 crate only; the upstream workspace-wide
# feature list does not apply to a single-crate build.
_cargo_features=(
  dmabuf
  gtk_v4_20
  v1_28
  waylandegl
  x11egl
  x11glx
)

_cargo_c_options=(
  --prefix /usr
  --library-type cdylib
  --features "$(IFS=,; echo "${_cargo_features[*]}")"
  -p gst-plugin-gtk4
)

# Use debug
export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

# Use LTO
export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

prepare() {
  cd $pkgbase
  git apply -3 ../0001-Update-lockfile.patch
  CARGO_HOME="$srcdir" cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgbase
  CARGO_HOME="$srcdir" cargo cbuild --release --frozen "${_cargo_c_options[@]}"
}

package() {
  cd $pkgbase
  CARGO_HOME="$srcdir" cargo cinstall --release --frozen "${_cargo_c_options[@]}" --destdir "$pkgdir"
}
