# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-php
_srcname=tree-sitter-php
pkgver=0.25.2
pkgrel=1
pkgdesc='Python bindings for the php Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-php
license=('MIT')
depends=(glibc 'python>=3.10' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-php/tar.gz/refs/tags/v$pkgver")
sha256sums=('3278e2454581261adea5c27bdbc41f7051deaf748a44d6436545b50ce5c70794')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
