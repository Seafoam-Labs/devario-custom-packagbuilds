# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-iniconfig
pkgver=2.3.1
pkgrel=1
pkgdesc="brain-dead simple config-ini parsing"
url="https://github.com/pytest-dev/iniconfig"
license=('MIT')
arch=('any')
depends=('python>=3.10')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools>=77' 'python-setuptools-scm>=8')
source=("git+https://github.com/pytest-dev/iniconfig.git#tag=v$pkgver")
sha512sums=('8283345318f5e1bcc159dca6a33f7d0c90164a7604d7ee9cc56973d078b741b90f9436b23d267be19b691ca3b90c45f192d806161a4d22a5320fdf6465acf9fe')

build() {
  cd iniconfig
  python -m build -nw
}

package() {
  cd iniconfig
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
