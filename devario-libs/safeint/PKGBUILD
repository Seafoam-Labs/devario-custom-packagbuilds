# Maintainer: Torsten Keßler <tpkessler@archlinux.org>
pkgname=safeint
pkgver=3.24
pkgrel=1
pkgdesc="class library for C++ that manages integer overflows"
arch=("any")
url="https://github.com/dcleblanc/SafeInt"
license=("MIT")
depends=()
makedepends=()
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('af6c7222a8420f6f87e198dc94791c28da75fe7241b605342c333fd03fd9dea6')

package() {
	cd SafeInt-${pkgver}
	install -vDm644 SafeInt.hpp "${pkgdir}"/usr/include/SafeInt.hpp
	install -vDm644 LICENSE "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
