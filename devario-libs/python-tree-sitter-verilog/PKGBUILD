# Dependency version selected from Graphify v0.9.100's uv.lock.
pkgname=python-tree-sitter-verilog
_srcname=tree-sitter-verilog
pkgver=1.0.3
pkgrel=2
pkgdesc='Python bindings for the verilog Tree-sitter grammar'
arch=('x86_64')
url=https://github.com/tree-sitter/tree-sitter-verilog
license=('MIT')
depends=(glibc 'python>=3.9' 'python-tree-sitter>=0.25' 'python-tree-sitter<0.26')
makedepends=(python-build python-installer python-setuptools python-wheel)
# The PyPI sdist omits the generated parser headers; use the complete tag archive.
source=("$pkgname-$pkgver-upstream.tar.gz::https://codeload.github.com/tree-sitter/tree-sitter-verilog/tar.gz/refs/tags/v1.0.3")
sha256sums=('2b985c74fa7d0035db7415908935cf1ba7eea3d928ccebfa1d89541d5b6fa7b4')

build() {
  cd "$_srcname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_srcname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
