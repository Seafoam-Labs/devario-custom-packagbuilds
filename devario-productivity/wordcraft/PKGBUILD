# Maintainer: Caroline Snyder <carolinemariesnyder@gmail.com>

pkgname=wordcraft
pkgver=0.18.1
pkgrel=1
pkgdesc="Clean-room reimplementation of Microsoft Word for documents and .docx"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/wordcraft"
license=('MIT OR Apache-2.0')
depends=(
    'glibc'
    'libgcc'
    'libxkbcommon'
    'vulkan-icd-loader'
  )
makedepends=(
    'rust>=1.95'
  )
optdepends=(
    'libglvnd: EGL/GL rendering when no Vulkan loader is present'
    'wayland: Wayland windowing support'
    'libx11: X11 windowing support'
    'libxcursor: themed cursor rendering under X11'
    'libxi: pen tablet and touch input under X11'
    'libxrandr: multi-monitor and DPI change handling'
    'mesa: Vulkan drivers for GPU rendering'
    'xdg-desktop-portal: native file dialogs and system dark/light theme'
  )
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
# Stale checksum carried over from an earlier release; Shelly validation must
# regenerate sha256sums from the actual v0.18.1 source archive bytes.
sha256sums=('55e6e6ca0e988a7ba320bef506e3910d2e2e5c1d1599a79571e144947438ab92')

_commit=079f478
_releasedate=2026-11-09
_appid=ai.storyteller.wordcraft

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"

  export WORDCRAFT_BUILD_SHA="$_commit"
  export WORDCRAFT_BUILD_DATE="$_releasedate"

  cargo build --release --frozen -p wordcraft -p wordcraft-cli
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/wordcraft" "$pkgdir/usr/bin/wordcraft"
  install -Dm755 "target/release/wordcraft-cli" "$pkgdir/usr/bin/wordcraft-cli"

  install -Dm644 "packaging/linux/$_appid.desktop" \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "packaging/linux/$_appid.mime.xml" \
    "$pkgdir/usr/share/mime/packages/$_appid.xml"

  sed -e "s/@VERSION@/$pkgver/g" -e "s/@DATE@/$_releasedate/g" \
    "packaging/linux/$_appid.metainfo.xml.in" > "$_appid.metainfo.xml"
  install -Dm644 "$_appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"

  install -dm755 "$pkgdir/usr/share/icons/hicolor"
  cp -a assets/app-icon/hicolor/. "$pkgdir/usr/share/icons/hicolor/"

  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "NOTICE" "$pkgdir/usr/share/doc/$pkgname/NOTICE"
  install -Dm644 "ATTRIBUTION.md" "$pkgdir/usr/share/doc/$pkgname/ATTRIBUTION.md"

  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
