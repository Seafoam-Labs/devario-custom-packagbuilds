# Maintainer: Seafoam Labs recipe maintainers
# Adapted for Seafoam Labs from Mark Wagie's AUR ente-auth recipe.
# Original maintainer: Mark Wagie <mark dot wagie at proton dot me>
# Build inputs come from Ente, Simple Icons, and the official Flutter SDK.

pkgname=ente-auth
_app_id=io.ente.auth
pkgver=4.4.26
pkgrel=2
_flutter_ver=3.47.2
pkgdesc='Open source 2FA authenticator, with end-to-end encrypted backups'
arch=('x86_64')
url='https://ente.com/auth'
license=('AGPL-3.0-or-later')
depends=(
  'bash'
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'
  'libsecret'
  'libsodium'
  'libx11'
  'org.freedesktop.secrets'
  'polkit'
  'sqlite'
  'xdg-user-dirs'
)
makedepends=(
  'clang'
  'cmake'
  'curl'
  'git'
  'java-environment'
  'ninja'
  'patchelf'
  'pkgconf'
  'unzip'
  'xz'
)
checkdepends=('appstream' 'desktop-file-utils')
source=(
  "ente::git+https://github.com/ente/ente.git#tag=auth-v${pkgver}"
  'simple-icons::git+https://github.com/simple-icons/simple-icons.git'
  'enteauth.sh'
)
sha256sums=(
  'fe13157113d1c1b2e41fa31d042b830d4a592c4b6ddcb3102eadc38a24694916'
  'SKIP'
  'f769d36c7c05aecdad7e0977d81e129f0a113013d379439e9be65e2d9a9f3085'
)
source_x86_64=(
  "flutter_linux_${_flutter_ver}-stable.tar.xz::https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${_flutter_ver}-stable.tar.xz"
)
sha256sums_x86_64=('447878859d01ca9bfdb99a85f245af07ed8a15fedcd9d189c4749e8e92d1f185')

_setup_flutter() {
  export FLUTTER_ROOT="${srcdir}/flutter"
  export PATH="${FLUTTER_ROOT}/bin:${PATH}"
  export PUB_CACHE="${srcdir}/pub-cache"
  export HOME="${srcdir}/build-home"
  export XDG_CONFIG_HOME="${HOME}/.config"
  export XDG_CACHE_HOME="${HOME}/.cache"
  export CI=true
  export FLUTTER_SUPPRESS_ANALYTICS=true
  export DART_SUPPRESS_ANALYTICS=true
  mkdir -p "${HOME}" "${XDG_CONFIG_HOME}" "${XDG_CACHE_HOME}" "${PUB_CACHE}"
}

prepare() {
  cd "${srcdir}/ente"

  # Refuse an SDK mismatch instead of silently building a new release with
  # an old Flutter pin. Update the SDK version and checksum together.
  local required_flutter
  required_flutter=$(awk '$1 == "FLUTTER_VERSION:" {print $2; exit}' \
    .github/actions/setup-flutter/action.yml) || return 1
  if [[ "${required_flutter}" != "${_flutter_ver}" ]]; then
    printf 'Ente requires Flutter %s; update _flutter_ver and its SDK checksum (currently %s).\n' \
      "${required_flutter:-unknown}" "${_flutter_ver}" >&2
    return 1
  fi

  # The submodule's name differs from its path in the current Ente tree.
  git submodule init -- mobile/apps/auth/assets/simple-icons
  git config submodule.auth/assets/simple-icons.url "${srcdir}/simple-icons"
  git -c protocol.file.allow=always submodule update -- mobile/apps/auth/assets/simple-icons

  _setup_flutter
  cd mobile/apps/auth
  flutter config --no-analytics
  dart --disable-analytics
  flutter clean
  flutter pub get --enforce-lockfile
}

build() {
  _setup_flutter
  export LIBSODIUM_USE_PKGCONFIG=1

  # Retain the reference recipe's compatibility flags for newer Clang.
  export CXXFLAGS="${CXXFLAGS} -Wno-error=deprecated-declarations -Wno-error=deprecated-literal-operator -Wno-error=incompatible-pointer-types-discards-qualifiers"
  cd "${srcdir}/ente/mobile/apps/auth"

  # Keep Ente's independent flavor; this does not disable its update prompts.
  flutter build linux --release --no-pub --dart-define=app.flavor=independent
}

check() {
  _setup_flutter
  cd "${srcdir}/ente/mobile/apps/auth"
  flutter test --no-pub
  appstreamcli validate --no-net linux/packaging/enteauth.appdata.xml || :
  desktop-file-validate linux/packaging/enteauth.desktop
}

package() {
  cd "${srcdir}/ente/mobile/apps/auth"
  local bundle='build/linux/x64/release/bundle'

  # JNI is built as a plugin dependency but is not needed by this Linux app.
  rm -f "${bundle}/lib/libdartjni.so"
  install -Dm755 "${bundle}/enteauth" -t "${pkgdir}/opt/${pkgname}/"
  cp -a "${bundle}/data" "${bundle}/lib" "${pkgdir}/opt/${pkgname}/"
  chmod 0755 "${pkgdir}/opt/${pkgname}"/lib/*.so
  install -Dm755 "${srcdir}/enteauth.sh" "${pkgdir}/usr/bin/enteauth"

  # Upstream supplies a 1024-pixel icon: 512 logical pixels at scale 2.
  # Install it unchanged; desktop icon loaders handle display scaling.
  install -Dm644 assets/icons/auth-icon.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512@2/apps/${_app_id}.png"
  install -Dm644 assets/icons/auth-icon.png \
    "${pkgdir}/usr/share/pixmaps/${_app_id}.png"

  install -d "${pkgdir}/usr/share/polkit-1/actions"
  ln -s /opt/ente-auth/data/flutter_assets/assets/polkit/com.ente.auth.policy \
    "${pkgdir}/usr/share/polkit-1/actions/"
  install -Dm644 linux/packaging/enteauth.desktop -t "${pkgdir}/usr/share/applications/"
  install -Dm644 linux/packaging/enteauth.appdata.xml -t "${pkgdir}/usr/share/metainfo/"

  # Remove shared-library RUNPATH entries that refer to the build directory.
  patchelf --remove-rpath "${pkgdir}/opt/${pkgname}"/lib/*.so
}
