# Maintainer: Devario maintainers
pkgname=vaultite
pkgver=0.15.0
pkgrel=1
pkgdesc='Local Markdown vault with an editor, search and integrated terminals'
arch=('x86_64')
url='https://github.com/Vaultite/vaultite'
license=('Apache-2.0')
_electron=electron44
_source_commit=6fd9df8113c231fec979e0a219d5badf63da7471
depends=("$_electron" 'hicolor-icon-theme' 'libsecret' 'xdg-utils')
makedepends=('nodejs' 'npm' 'patch')
optdepends=('git: Git integration for vaults')
conflicts=('vaultite-bin')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'disable-self-updates.patch' 'vaultite-launcher' 'vau-launcher' 'vaultite.desktop')
sha256sums=('2a861920bf7f9af6e5fb15e3acc1d3127cfb52c9012a1e9a9035c10ab65c3247'
            'a80b88958fd3a7b14b75b179f804a4dfb033bf3a631bdc169f3ba31af17cfef5'
            '3f1f8c63c152d9a0d84fdef5a14a8e4d128e1ca70440993c57d3e17e32bbf220'
            '39bed73bd0be0e0659b23e7a8583a5331d18166ba558792cf18f3fead9eeeddf'
            '3c4ee1c5b5e01e3be50b6a5ac36f982a998120659214f76d1df41ba15ed5b124')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    patch -Np1 -i "$srcdir/disable-self-updates.patch"
}

_stamp_release() {
    # The release tarball has no Git checkout for upstream's stamp command.
    node --input-type=module - "$_source_commit" "$url.git" <<'JS'
import { writeFileSync } from 'node:fs';
import { sourceSnapshot } from './core/appsource.ts';
import { stamps } from './electron/identity.ts';
import { fingerprint } from './electron/shell/print.mjs';

const [commit, repo] = process.argv.slice(2);
if (!/^[0-9a-f]{40}$/.test(commit ?? '') || !repo?.startsWith('https://')) {
  throw new Error('expected a pinned source commit and HTTPS repository URL');
}
const { code, shell } = stamps({ commit, repo, branch: 'main',
  fingerprint: fingerprint(process.cwd()), env: { VAULTITE_RELEASE: '1' } });
for (const [file, data] of Object.entries({ build: code, shell, cli: sourceSnapshot() })) {
  writeFileSync(`electron/${file}.json`, `${JSON.stringify(data, null, 2)}\n`);
}
JS
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    local electron_dist="/usr/lib/$_electron" electron_version appdir pty
    electron_version=$(<"$electron_dist/version")
    electron_version=${electron_version#v}
    [[ $electron_version == 44.* ]] || return 1
    export HOME="$srcdir/.vaultite-home" XDG_CACHE_HOME="$srcdir/.vaultite-cache"
    export ELECTRON_SKIP_BINARY_DOWNLOAD=1
    install -d "$HOME" "$XDG_CACHE_HOME"
    npm ci --ignore-scripts --no-audit --no-fund --cache "$srcdir/.npm-cache"
    npm run build
    _stamp_release
    ./node_modules/.bin/electron-builder --linux dir --publish never \
        -c.electronDist="$electron_dist" -c.electronVersion="$electron_version"

    appdir=dist-app/linux-unpacked/resources/app
    pty="$appdir/node_modules/node-pty/prebuilds"
    test -s "$pty/linux-x64/pty.node"
    rm -rf -- "$pty"/{darwin-arm64,darwin-x64,linux-arm64,win32-arm64,win32-x64}
    printf 'shelly\n' > "$appdir/package-type"
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    local appdir="$PWD/dist-app/linux-unpacked/resources/app"
    test -s "$appdir/web/dist/index.html"
    test -s "$appdir/electron/cli.json"
    test ! -e "$appdir/node_modules/electron"
    ELECTRON_RUN_AS_NODE=1 "/usr/lib/$_electron/electron" --input-type=commonjs - "$appdir" <<'JS'
const assert = require('node:assert/strict');
const path = require('node:path');
const pty = require(path.join(process.argv[2], 'node_modules', 'node-pty'));
const shell = pty.spawn('/usr/bin/printf', ['vaultite-pty-ok'], { env: { PATH: '/usr/bin' } });
const timer = setTimeout(() => process.exit(2), 7000);
let output = '';
shell.onData(text => { output += text; });
shell.onExit(({ exitCode }) => {
  clearTimeout(timer);
  assert.equal(exitCode, 0);
  assert.equal(output.trim(), 'vaultite-pty-ok');
  console.log('Vaultite node-pty OK on Electron', process.versions.electron);
});
JS
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -dm755 "$pkgdir/usr/lib/$pkgname"
    cp -a dist-app/linux-unpacked/resources/app/. "$pkgdir/usr/lib/$pkgname/"
    install -Dm755 "$srcdir/vaultite-launcher" "$pkgdir/usr/bin/vaultite"
    install -Dm755 "$srcdir/vau-launcher" "$pkgdir/usr/bin/vau"
    install -Dm644 "$srcdir/vaultite.desktop" "$pkgdir/usr/share/applications/vaultite.desktop"
    install -Dm644 web/public/icon-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/vaultite.png"
    install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
