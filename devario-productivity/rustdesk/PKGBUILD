_set_build_environment() {
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  export PUB_CACHE="$srcdir/pub-cache"
  export FVM_CACHE_PATH="$srcdir/fvm"
  # ffmpeg-rustdesk supplies this layout; no vcpkg bootstrap is needed.
  export VCPKG_ROOT=/usr/lib/rustdesk-ffmpeg
  export PKG_CONFIG_PATH="$srcdir/pkgconfig"
  export LIBCLANG_PATH=/usr/lib
}

_apply_cached_patch() {
  local _patch=$1
  # Cargo checkouts and Flutter SDKs survive source re-extraction.
  if ! patch --force --silent --dry-run -Rp1 -i "$_patch"; then
    patch --batch -Np1 -i "$_patch"
  fi
}

prepare() {
  _set_build_environment
  cd "rustdesk-$_commit"
  # Use bundle-relative library paths instead of Flutter's build-directory paths.
  patch -Np1 -i "$srcdir/flutter-rpath.patch"
  rmdir libs/hbb_common
  ln -s "$srcdir/hbb_common-$_hbb_commit" libs/hbb_common
  # Arch libyuv lacks the pkg-config metadata required by linux-pkg-config.
  install -Dm644 "$srcdir/libyuv.pc" "$srcdir/pkgconfig/libyuv.pc"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"

  (
    cd "$CARGO_HOME"/git/checkouts/rust-webm-*/*/src/sys/libwebm
    # Fix GCC 15+ integer types in the locked libwebm dependency.
    _apply_cached_patch "$srcdir/libwebm-cstdint-$_libwebm_fix.patch"
  )

  fvm install "$_flutter_bridge"
  fvm install "$_flutter_app"
  "$FVM_CACHE_PATH/versions/$_flutter_app/bin/flutter" --disable-analytics
  (
    cd "$FVM_CACHE_PATH/versions/$_flutter_app"
    # Fix stale dropdown filtering state in the pinned application SDK.
    _apply_cached_patch "$srcdir/flutter-dropdown-$_commit.patch"
  )
}

build() {
  _set_build_environment
  cd "rustdesk-$_commit"
  local _original_path="$PATH"
  export PATH="$FVM_CACHE_PATH/versions/$_flutter_bridge/bin:$_original_path"
  flutter --disable-analytics
  # The bridge SDK cannot resolve extended_text 14; restore it for the app SDK.
  sed -i 's/extended_text: 14.0.0/extended_text: 13.0.0/' flutter/pubspec.yaml
  (cd flutter && flutter pub get)
  # Old ffigen needs Clang's resource headers explicitly to resolve stdbool.h.
  flutter-rust-bridge-codegen1 \
    --rust-input src/flutter_ffi.rs \
    --dart-output flutter/lib/generated_bridge.dart \
    --c-output flutter/macos/Runner/bridge_generated.h \
    --llvm-path /usr/lib \
    --llvm-compiler-opts="-I$(clang -print-resource-dir)/include"
  sed -i 's/extended_text: 13.0.0/extended_text: 14.0.0/' flutter/pubspec.yaml

  export PATH="$FVM_CACHE_PATH/versions/$_flutter_app/bin:$_original_path"
  (cd flutter && flutter pub get)
  # Use system software codecs; hwcodec uses the private patched FFmpeg above.
  cargo build --frozen --release --lib \
    --features flutter,hwcodec,linux-pkg-config,unix-file-copy-paste
  (cd flutter && flutter build linux --release)
}

package() {
  cd "rustdesk-$_commit"
  # Keep Flutter's engine, plugins and assets together for relative loading.
  install -d "$pkgdir/usr/lib/rustdesk" "$pkgdir/usr/bin"
  cp -a flutter/build/linux/x64/release/bundle/. "$pkgdir/usr/lib/rustdesk/"
  ln -s ../lib/rustdesk/rustdesk "$pkgdir/usr/bin/rustdesk"
  install -Dm644 res/rustdesk.service "$pkgdir/usr/lib/systemd/system/rustdesk.service"
  install -Dm644 res/rustdesk.desktop "$pkgdir/usr/share/applications/rustdesk.desktop"
  install -Dm644 res/rustdesk-link.desktop "$pkgdir/usr/share/applications/rustdesk-link.desktop"
  local _icon_size
  for _icon_size in 32 128; do
    install -Dm644 "res/${_icon_size}x${_icon_size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${_icon_size}x${_icon_size}/apps/rustdesk.png"
  done
  install -Dm644 res/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rustdesk.png"
  install -Dm644 res/scalable.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/rustdesk.svg"
}
