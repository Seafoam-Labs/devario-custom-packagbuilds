# Adapted for Devario from the AUR hermes-agent and hermes-agent-desktop
# recipes (packaging files are 0BSD; see DEVARIO-UPSTREAM.json).
# Local change: one recipe base with two outputs, so the desktop app can never
# be published against an older runtime than the agent it depends on, and the
# AUR's source/-bin conflicts=() dance is dropped — Shelly publishes built
# binaries, so a -bin twin of either output would be redundant.
# Builds Hermes Agent from the upstream release tag into /opt/hermes-agent.
# Upstream pins a large, partly native Python dependency set; uv's relocatable
# venv keeps the packaged environment usable after makepkg moves it under /opt.
# The local files (keep-venv-interpreter.patch, release-date-from-stamp.patch,
# system-browser-fallback.patch, system-tools.py, hermes_agent_env.py,
# package-managed-runtime.patch, package-managed-bootstrap.patch,
# harden-hud-modifier-monitor.patch, hermes-desktop, launcher.test.cjs) are the
# AUR's, unchanged.
pkgbase=hermes-agent
pkgname=(hermes-agent hermes-agent-desktop)
_pkgver_tag=v0.23.1
_commit=3b421578588243f920886e6fe79a6faa87ea026e
_tagver=${_pkgver_tag#v}           # tag without the leading v — GitHub strips it from the archive dir
_optname=hermes-agent              # fixed install dir (pkgname-independent, matches the app's stamp)
_libname=hermes-agent-desktop      # fixed desktop resource dir, referenced by the launcher
_binname=hermes-desktop            # /usr/bin launcher name of the desktop output
_upstream=Hermes                   # productName + executableName of the desktop app
# Devario's python minor and the next one; keep depends=() in step
_pyver=3.14
_pymax=3.15
_uvmin=0.13.5                      # pm's uv pin (pm/lock.json); check() stops when it moves
_pnpmver=12.15.0                   # pm's pnpm pin (pm/lock.json); prepare() stops when it moves
# Devario's Electron runtime: the major upstream locks, or a newer one;
# prepare() points the launcher and its test at it and refuses an older one.
_electron=electron44
pkgver=0.23.1
pkgrel=1
pkgdesc="Locally-run AI agent with tool use, web browsing, and automation"
arch=('x86_64')                     # @pnpm/exe.linux-x64 is x86_64-only; add the arm64 pins with Electron's arm64 runtime before enabling aarch64
url='https://github.com/NousResearch/hermes-agent'
license=('MIT')
# rsync: the runtime tree copy; cmake: python-olm (matrix extra). gcc, make and
# pkgconf build node-pty's native addon through node-gyp, which the pinned
# pnpm's own dist/ supplies — the system pnpm never builds the workspaces, but
# package() runs system-tools.py, which symlinks /usr/bin/pnpm into pm's store,
# so pnpm has to be in the build root too. The Electron runtime is a make
# dependency and not only the desktop output's dependency: the build
# root has to hold /usr/lib/electronNN, because prepare() copies it into the
# locked electron package's dist/ and check() loads node-pty under that binary.
# A split output's depends=() is recorded for installers, not installed while
# building, so it cannot carry that requirement. The same applies to every
# tool system-tools.py symlinks from the build root's /usr/bin: ffmpeg and
# ripgrep have to be make dependencies too, not only runtime ones.
makedepends=("${_electron}" 'rsync' 'cmake' 'nodejs' 'npm' 'pnpm' 'python' "uv>=${_uvmin}" 'gcc' 'make' 'pkgconf' 'ffmpeg' 'ripgrep')
# The desktop tests create temporary git repositories.
checkdepends=('nodejs' 'git')
options=('!debug' '!strip')         # package() strips the native libraries itself
source=(
  "hermes-agent-${_tagver}.tar.gz::${url}/archive/refs/tags/${_pkgver_tag}.tar.gz"
  'keep-venv-interpreter.patch'
  'release-date-from-stamp.patch'
  'system-browser-fallback.patch'
  'system-tools.py'
  'hermes_agent_env.py'
  'package-managed-runtime.patch'
  'package-managed-bootstrap.patch'
  'harden-hud-modifier-monitor.patch'
  'hermes-desktop'
  'launcher.test.cjs'
)
# Run updpkgsums after editing a local file.
sha256sums=('52a8eb321f368576034f40595491abf9646b60c3861eee0cf45f610e5faa9bb6'
            'db079e95aec3eb91febb896a59afd7f4d10fe2227a13c371e8771906f46e0362'
            '0d7ba134037ee7565f40091262eee82b18d089a63238a6bdca7c88d7f5eb324d'
            '67a67935038e0aa88842d110fb4a5bc8dd29fe12c62cb063450464a5d31062d2'
            'b079df6f6162180615ba92e67dae6062d7a22600462e76341d29b963aad25571'
            'c8a782bbee797b064db590d7b6e01963e0c31db7eea7ce2be13fe33a11726b6a'
            '8d5363f2cab8fca873dcf15ebc744624e4971d5f28024c4271e1b3b0ad850b3c'
            '412ad7b2b6bc5149a8d236ad2cb9be54d2ac0ab78dbd3c8e16deb4f4e683713f'
            'ac4077eb2846f90d36858c69d8fe99988606caa0059e85a9606273bb7bc29077'
            '5531cf11774cf9fa219c55287ea2c49160d985ac46c5c2d6f41e82f6de5af7a7'
            '01700c07523710df165b72bbc0c2931415d118576e78868b1b02eec6bffda034')
# pnpm as upstream pins it (pm/lock.json): the native executable and the
# launcher package, whose dist/ holds the node-gyp the executable runs, the
# two artifacts pm installs. Only the build runs it: the runtime output's pm
# store takes the system pnpm.
source_x86_64=(
  "pnpm-exe-${_pnpmver}.tgz::https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-${_pnpmver}.tgz"
  "pnpm-${_pnpmver}.tgz::https://registry.npmjs.org/pnpm/-/pnpm-${_pnpmver}.tgz"
)
# Both archives wrap their files in package/; prepare() unpacks them.
noextract=("pnpm-exe-${_pnpmver}.tgz" "pnpm-${_pnpmver}.tgz")
sha256sums_x86_64=('402f7045b1e0587acb1542f18d38afbccb6babf3c7451394e6fb3d9f0160c6ca'
            'f5173f6127cc505cdb36ec17719fe54a8511c6fd8560c7ceb4bf7c73e3b4458b')

# NOTE: ${srcdir} is empty at the top level of a PKGBUILD — makepkg only sets
# it inside the function scope of prepare()/build()/check()/package_*().
# Computing the extracted directory once at the top silently produces a
# root-prefixed path and `cd` fails. Define a helper and call it from each
# function instead.
_extract_dir() {
  echo "${srcdir}/hermes-agent-${_tagver}"
}

# The pinned pnpm, laid out like pm's store entry (pm/packages.py, Pnpm).
_pnpm_dir() {
  echo "${srcdir}/pnpm-${_pnpmver}"
}

# The pinned pnpm first on PATH: upstream's build scripts refuse any other
# version. Its store, metadata cache and state stay in $srcdir.
_pnpm_env() {
  export PATH="$(_pnpm_dir):${PATH}"
  export pnpm_config_store_dir="${srcdir}/pnpm-cache/store"
  export pnpm_config_cache_dir="${srcdir}/pnpm-cache/cache"
  export pnpm_config_state_dir="${srcdir}/pnpm-cache/state"
  export pnpm_config_update_notifier=false
}

# Whether a patched path (from the repository root) can change the renderer's
# typecheck or the tests of its "ui" vitest project; in doubt it can. $2 is the
# renderer program's file list (tsc --listFilesOnly).
_reaches_renderer() {
  local path=$1 program=$2 name files=() found=0
  case "${path}" in
    # The renderer's own sources of any type (styles, glob-loaded plugins),
    # the app's top-level files (package.json, tsconfig.json, the vite and
    # vitest configs) and everything outside the desktop app.
    apps/desktop/src/* | apps/shared/*) return 0 ;;
    apps/desktop/*/*) ;;
    *) return 0 ;;
  esac
  case "${path}" in
    # tsc follows TypeScript imports, so the list holds every such file the
    # renderer reaches.
    *.ts | *.tsx | *.mts | *.cts)
      grep -qxF "${PWD}/${path}" <<<"${program}"
      ;;
    # tsc lists no other file type (allowJs is off): look for the name,
    # without extension, in the renderer's sources and program files.
    *)
      name="${path##*/}"
      name="${name%.*}"
      mapfile -t files < <(grep -v '/node_modules/' <<<"${program}")
      # A search error (exit 2) counts as found.
      grep -rqF -- "${name}" apps/desktop/src apps/shared "${files[@]}" || found=$?
      (( found != 1 ))
      ;;
  esac
}

prepare() {
  cd "$(_extract_dir)"

  # The archive's mtimes are the upstream commit time. Record it before a
  # patch can change pyproject.toml; package_hermes-agent() writes it into the
  # runtime's install stamp.
  stat -c %Y pyproject.toml > "${srcdir}/commit-date"

  # --fuzz=0: a hunk whose context drifted must fail loudly instead of being
  # applied at a guessed location (offsets are still accepted).
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/keep-venv-interpreter.patch"
  # Upstream #135223 (draft): the banner date comes from the stamp's
  # commitDate, not the stale 2026.9.24 literal. Drop it once upstream ships
  # the fix; until then this hunk fails loudly when __init__.py moves.
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/release-date-from-stamp.patch"
  # Lazy installs are off here, so pm never fetches its Chromium on demand:
  # browser_exec falls back to a system Chrome, Chromium or Brave instead of
  # needing browser.executable_path.
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/system-browser-fallback.patch"
  # Desktop: refuse the in-app updater, the update-channel switch and the
  # first-run bootstrap, and build the X11 HUD helper with the distro's flags.
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/package-managed-runtime.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/package-managed-bootstrap.patch"
  patch --batch --fuzz=0 -Np1 -i "${srcdir}/harden-hud-modifier-monitor.patch"

  # The executable and the launcher's dist/ in one directory, as pm unpacks
  # them.
  local pin
  pin="$(node -p 'require("./pm/lock.json").packages.pnpm.version')"
  if [[ "${pin}" != "${_pnpmver}" ]]; then
    printf 'ERROR: upstream pins pnpm %s (pm/lock.json), PKGBUILD downloads %s: move _pnpmver and sha256sums_x86_64\n' "${pin}" "${_pnpmver}"
    return 1
  fi
  rm -rf "$(_pnpm_dir)"
  mkdir -p "$(_pnpm_dir)"
  bsdtar -xf "${srcdir}/pnpm-exe-${_pnpmver}.tgz" -C "$(_pnpm_dir)" --strip-components 1
  bsdtar -xf "${srcdir}/pnpm-${_pnpmver}.tgz" -C "$(_pnpm_dir)" --strip-components 1 package/dist
  _pnpm_env

  # vite-plugin-tailwindcss (web) and Tailwind's source scan (the renderer)
  # walk up the tree to read .gitignore files when they find no git checkout,
  # and a packaging repository's .gitignore excludes src/: the bundles would
  # ship without their utility classes (check() looks for them). An empty .git
  # makes the archive its own root.
  mkdir -p .git

  # The launcher and its test name an Electron runtime. Point them at
  # _electron, so a runtime switch only edits that variable. sed -i replaces
  # makepkg's symlinks with edited copies; the repository files stay as they are.
  sed -i -E "s|/usr/bin/electron[0-9]+|/usr/bin/${_electron}|g" \
    "${srcdir}/hermes-desktop" "${srcdir}/launcher.test.cjs"
  if ! grep -q "^exec /usr/bin/${_electron} " "${srcdir}/hermes-desktop"; then
    printf 'ERROR: hermes-desktop has no exec line for /usr/bin/%s\n' "${_electron}"
    return 1
  fi

  # Keep desktop metadata aligned with the Agent release, not the separately
  # versioned upstream desktop package.json.
  pnpm --dir apps/desktop pkg set "version=${pkgver}"
  # The source archive has no .git directory. Pin the peeled release commit
  # locally so the bundled install stamp is reproducible and does not require
  # another network lookup during prepare()/build().
  export GITHUB_SHA="${_commit}" GITHUB_REF_NAME="${_pkgver_tag}"
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1

  # Every workspace project, as upstream's Desktop CI installs them; the web
  # and ui-tui workspaces the runtime output bundles are part of the same
  # lockfile, so one install covers both outputs (check()'s typecheck also
  # covers tests-js and tests/install). The frozen lockfile's release-age gate
  # was checked by upstream's CI when it wrote the lock (--trust-lockfile, as
  # in scripts/build/node-deps.mjs). No dependency build scripts here:
  # node-pty is built below and Electron comes from Devario's ${_electron}.
  pnpm install --frozen-lockfile --trust-lockfile --prod=false --ignore-scripts

  # Keep the locked Electron npm package for its TypeScript declarations and
  # tooling, but make any build helper that resolves `require('electron')` use
  # Devario's versioned runtime instead of downloading a second copy. pnpm
  # links it into apps/desktop/node_modules from its virtual store: take the
  # copy apps/desktop resolves (its real path in the virtual store).
  local electron_dir
  electron_dir="$(cd apps/desktop && node -p 'path.dirname(require.resolve("electron/package.json"))')"
  # Only the build tree's own copy may be replaced below: without it (say,
  # dev dependencies omitted) Node would resolve some electron further up.
  if [[ "${electron_dir}" != "$(pwd -P)/"* ]]; then
    printf 'ERROR: electron resolves outside the build tree: %s\n' "${electron_dir}"
    return 1
  fi

  # Name the missing requirement before bash does: without the makedepend the
  # reads below fail with "No such file or directory" in the middle of prepare().
  if [[ ! -s "/usr/lib/${_electron}/version" || ! -x "/usr/lib/${_electron}/electron" ]]; then
    printf 'ERROR: no %s runtime in the build root: ${_electron} has to stay in makedepends\n' "${_electron}"
    return 1
  fi

  # The runtime used here (_electron) is the major upstream locks or a newer
  # one: the package ran on electron42 while upstream locked 40.x. The
  # opposite direction is not safe: an app written against a newer major may
  # call APIs this runtime lacks, so stop instead of shipping that build.
  local locked_electron system_electron
  locked_electron="$(node -p 'require(process.argv[1]).version' "${electron_dir}/package.json")"
  system_electron="$(< "/usr/lib/${_electron}/version")"
  if (( ${locked_electron%%.*} > ${system_electron%%.*} )); then
    printf 'ERROR: upstream locks Electron %s, newer than the system runtime %s — move _electron to a newer electronNN\n' \
      "${locked_electron}" "${system_electron}"
    return 1
  elif (( ${locked_electron%%.*} < ${system_electron%%.*} )); then
    printf 'NOTE: upstream locks Electron %s; the package runs on system Electron %s\n' \
      "${locked_electron}" "${system_electron}"
  fi

  # The virtual store's files are hard links into pnpm's store: replace,
  # never write through them. Upstream's `--dir` packaging copies this
  # runtime instead of downloading one: it refuses links that leave dist/
  # (apps/desktop/scripts/prepared-packaging.mjs) and admits only a
  # dist/version that names the locked Electron
  # (scripts/build/electron-runtime.mjs). So dist/ is a real copy of the
  # system runtime's files, and only that version file names the lock.
  # package_hermes-agent-desktop() keeps none of the staged Electron; the
  # launcher runs _electron.
  rm -rf "${electron_dir}/dist" "${electron_dir}/path.txt"
  mkdir "${electron_dir}/dist"
  cp -r "/usr/lib/${_electron}/." "${electron_dir}/dist/"
  rm "${electron_dir}/dist/version"
  printf '%s\n' "${locked_electron}" > "${electron_dir}/dist/version"
  printf '%s' 'electron' > "${electron_dir}/path.txt"
  test -x "${electron_dir}/dist/electron"

  # Build node-pty's Linux native addon locally (allowBuilds in
  # pnpm-workspace.yaml admits its install script). It runs node-gyp from the
  # launcher's dist/. Explicitly export makepkg's build flags because they
  # are otherwise unexported shell variables, producing an addon without the
  # distro's full RELRO hardening. node-gyp takes Node's headers from the
  # nodejs package (/usr/include/node) instead of downloading them from
  # nodejs.org. The filter keeps the rebuild to the Desktop's dependency
  # graph; without trust_lockfile it would check the whole lockfile's release
  # ages against the registry again.
  export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
  pnpm_config_trust_lockfile=true npm_config_nodedir=/usr \
    pnpm --filter '{./apps/desktop}...' rebuild node-pty
}

build() {
  cd "$(_extract_dir)"
  _pnpm_env
  # makepkg runs build() in a separate subshell from prepare().
  export GITHUB_SHA="${_commit}" GITHUB_REF_NAME="${_pkgver_tag}"
  # The X11 HUD modifier monitor is compiled with cc during the desktop build;
  # it takes these flags from the environment
  # (harden-hud-modifier-monitor.patch).
  export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS

  # The runtime output's bundles.
  pnpm --dir web run build
  pnpm --dir ui-tui run build:ink
  pnpm --dir ui-tui run build
  # The browser-hosted Desktop (`hermes webapp`, new after v0.22.5). Hermes
  # would build it into its install root on first use, which is root-owned
  # here; HERMES_WEBAPP_DIST (launcher and hermes_agent_env.py) makes it
  # serve this bundle as it is. Its private pnpm workspace (.build/) stays out
  # of the package.
  node apps/desktop/scripts/build-webapp.mjs

  # The desktop app resources, built in a subshell so the runtime's venv below
  # still starts from the repository root.
  (
    cd apps/desktop
    # Everything this app needs is installed and staged in prepare(); the
    # packager must not reach the network. build-webapp.mjs above deliberately
    # keeps the network for the private workspace it installs on its own.
    export pnpm_config_offline=true
    # Keep upstream's package.json and lockfile pins intact for deterministic
    # frozen installs. electron-builder still prepares a throwaway Electron
    # zip for the packager; package_hermes-agent-desktop() keeps only the app
    # resources and the launcher runs Devario's ${_electron}.
    pnpm run build

    # Upstream writes the wall clock into the bundled install stamp. Normalize
    # it to makepkg's reproducible-build epoch before electron-builder
    # consumes it.
    local build_time
    build_time="$(date -u -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M:%S.000Z')"
    sed -i -E \
      "s|(\"builtAt\": \")[^\"]+(\")|\1${build_time}\2|" \
      build/install-stamp.json
    grep -Fq "\"builtAt\": \"${build_time}\"" build/install-stamp.json

    # Upstream's prepared-packaging gate admits `--dir`, not a bare `dir`
    # token, and rejects `-c.electronVersion=...` overrides. Omit --x64: an
    # explicit arch flag stages into build/native-deps-<platform>-<arch>,
    # which productOutput does not allow; the host arch reuses
    # build/native-deps.
    pnpm run builder --linux --dir
  ) || return

  # The venv runs on Devario's python (upstream supports 3.14 since v0.21.6,
  # requires-python ">=3.11,<3.15"). A venv only works on the minor version
  # it was built for, so depends=() pins it: when Devario moves python to the
  # next minor, pacman holds that update back until this package follows
  # (to the new minor if upstream supports it, else to a bundled CPython).
  UV_PYTHON_DOWNLOADS=never uv venv \
    --clear \
    --python "/usr/bin/python${_pyver}" \
    --relocatable \
    venv
  # Lazy installs are off for the root-owned venv, so the extras users commonly
  # hit ship here: anthropic (Anthropic provider), edge-tts (default TTS), ddgs
  # (free web search), doc-extract, keychain (`hermes vault key migrate --to
  # keychain`) and the gateways beyond messaging. The documents extras stay
  # out: skills build their own side environment (`hermes pm environment
  # documents`). python-olm (matrix) builds a vendored libolm whose
  # cmake_minimum_required CMake >= 4 rejects unless the policy minimum is
  # raised.
  CMAKE_POLICY_VERSION_MINIMUM=3.5 \
  UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT="$PWD/venv" \
    uv sync --locked --no-dev --no-install-project \
      --extra all,messaging,anthropic,edge-tts,ddgs,doc-extract,keychain \
      --extra feishu,matrix,dingtalk,wecom,teams,google-chat
}

check() {
  cd "$(_extract_dir)"
  _pnpm_env
  export pnpm_config_offline=true

  # The runtime output's bundles and the venv's importable extras.
  test -s hermes_cli/web_dist/index.html
  test -s ui-tui/dist/entry.js
  test -s apps/desktop/dist-webapp/index.html
  PYTHONPATH="$PWD" venv/bin/python -c \
    'import hermes_cli.main, anthropic, edge_tts, ddgs, keyring, lark_oapi, mautrix, dingtalk_stream, defusedxml'

  # pm runs the system uv from the system-tools store. Plugins with Python
  # dependencies make it re-resolve uv.lock, which an older uv than pm's pin
  # can fail (uv 0.13.4 on the v0.22.5 lock: NousResearch/hermes-agent#143254).
  # depends=() asks for at least the pin; stop when upstream moves it.
  local uv_pin
  uv_pin="$(venv/bin/python -c 'import json, sys; print(json.load(open(sys.argv[1]))["packages"]["uv"]["version"])' pm/lock.json)"
  if (( $(vercmp "${uv_pin}" "${_uvmin}") > 0 )); then
    printf 'ERROR: pm pins uv %s, depends=() asks for uv>=%s: raise _uvmin\n' "${uv_pin}" "${_uvmin}"
    return 1
  fi

  # Hermes desktop tests expect English timestamps and isolated temporary git
  # repositories; the default Hermes scratch directory sits inside a git repo.
  export LANG=C.UTF-8 LC_ALL=C.UTF-8
  export GIT_CEILING_DIRECTORIES="${TMPDIR:-/tmp}"
  unset HERMES_DESKTOP_PACKAGE_MANAGED_RUNTIME
  HERMES_LAUNCHER_PATH="${srcdir}/hermes-desktop" node "${srcdir}/launcher.test.cjs"

  # Upstream's full vitest suite (~1700 files) runs in upstream's CI; here it
  # took ~90% of the build time and exercised upstream code on the system's
  # Node, which the app does not run on. Run the tests that cover what the
  # patches change instead: the patched tests and every test importing a
  # patched module. The file list follows the patches automatically; diff -u
  # style headers carry a tab and a timestamp after the path. Only the desktop
  # patches matter here, the runtime patches touch no desktop file.
  local patched=() file
  mapfile -t patched < <(sed -n 's|^+++ b/\([^\t]*\).*|\1|p' \
    "${srcdir}/package-managed-runtime.patch" "${srcdir}/package-managed-bootstrap.patch" \
    "${srcdir}/harden-hud-modifier-monitor.patch" | sort -u)
  # A misparsed header would select no tests and pass (--passWithNoTests).
  (( ${#patched[@]} > 0 ))
  for file in "${patched[@]}"; do
    test -f "${file}"
  done

  # The renderer took most of the typecheck's time, its "ui" vitest project
  # (~1300 test files to scan) most of vitest's; upstream's CI runs both.
  # The renderer's program holds src/ with those tests and every module they
  # import, so a patched file outside it reaches neither. A file list this
  # cannot read counts as reached.
  local program reaches_renderer=0
  program="$(cd apps/desktop && pnpm exec tsc -p . --listFilesOnly)" || program=
  if [[ "${program}" != *"${PWD}/apps/desktop/src/"* ]]; then
    reaches_renderer=1
  fi
  for file in "${patched[@]}"; do
    if (( ! reaches_renderer )) && _reaches_renderer "${file}" "${program}"; then
      printf 'check(): %s reaches the renderer\n' "${file}"
      reaches_renderer=1
    fi
  done
  (( reaches_renderer )) ||
    echo 'check(): no patched file reaches the renderer: no renderer typecheck, no ui tests'

  # Upstream's typecheck script; its renderer part only when a patch reaches
  # the renderer. pnpm exec -c keeps node_modules/.bin ahead of the system's
  # PATH, like pnpm run.
  local typecheck renderer='tsc -p . --noEmit'
  typecheck="$(node -p 'require("./apps/desktop/package.json").scripts.typecheck')"
  if [[ "${typecheck}" != "${renderer} && "* ]]; then
    printf 'ERROR: upstream typecheck no longer starts with "%s": %s\n' "${renderer}" "${typecheck}"
    return 1
  fi
  (( reaches_renderer )) || typecheck="${typecheck#"${renderer} && "}"
  (cd apps/desktop && pnpm exec -c "${typecheck}")

  # Without HERMES_PYTHON, vitest's global setup installs Hermes' Python test
  # environment (a CPython, ffmpeg, node and the Python dependencies, from the
  # network) for the few contracts that run real hermes_cli code. The related
  # tests need none of it. python3 is those contracts' own fallback; should a
  # patch ever relate to one, it fails loudly on the missing dependencies.
  # Without the renderer every vitest project but "ui" runs, including ones
  # upstream adds later.
  # Upstream's update-script tests can reach the script's notification
  # fallback (notify-send, then zenity or kdialog), which would show up in the
  # builder's desktop session; the full suite did so. Keep vitest out of the
  # session: no display, a dead session bus and an empty runtime directory
  # (GDBus falls back to the bus socket there, Wayland clients to wayland-0).
  # Absolute paths, set before the cd: apps/shared files lie outside vitest's
  # root.
  local projects=() related=("${patched[@]/#/${PWD}/}") runtime_dir
  (( reaches_renderer )) || projects=(--project '!ui')
  runtime_dir="$(mktemp -d)"
  (cd apps/desktop && env -u DISPLAY -u WAYLAND_DISPLAY \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent XDG_RUNTIME_DIR="${runtime_dir}" \
    HERMES_PYTHON=python3 pnpm exec vitest related --run --passWithNoTests "${projects[@]}" "${related[@]}")
  rm -rf "${runtime_dir}"

  # Tailwind v4 skips sources that a parent directory's .gitignore excludes
  # when the build directory is no git checkout (a packaging repository ignores
  # src/). The renderer then ships without its utility classes: the window
  # shows unstyled text while the app itself boots fine. The utilities live
  # in the stylesheet of the main chunk (index-*.css until v0.22.5, when the
  # renderer entry was src/main.tsx).
  local css=(apps/desktop/release/linux-unpacked/resources/app.asar.unpacked/dist/assets/main-*.css)
  if ! grep -q '\.flex{' "${css[@]}"; then
    printf 'ERROR: the renderer CSS lacks Tailwind utilities (%s) — build from a git checkout or without a parent .gitignore excluding src/\n' \
      "${css[*]##*/}"
    return 1
  fi

  # node-pty is the only native Node addon shipped by Hermes. Load the staged
  # module with the exact Electron runtime used by the installed launcher; its
  # N-API build must not merely load under makepkg's system Node.
  local node_pty_root="${PWD}/apps/desktop/release/linux-unpacked/resources/app.asar.unpacked/dist/node_modules/node-pty"
  test -f "${node_pty_root}/package.json"
  # Bypass the distro launcher here: it injects the user's electronNN-flags.conf,
  # valid in Chromium mode but rejected while ELECTRON_RUN_AS_NODE is set.
  env ELECTRON_RUN_AS_NODE=1 NODE_PTY_ROOT="${node_pty_root}" \
    "/usr/lib/${_electron}/electron" -e \
    'const pty = require(process.env.NODE_PTY_ROOT); if (typeof pty.spawn !== "function") process.exit(1)'
}

package_hermes-agent() {
  # The tools of pm's store (system-tools.py) and the libraries of pm's
  # Chromium (`hermes pm install chromium`) sit alongside the interpreter the
  # venv was built for: that minor is pinned deliberately, see build().
  depends=(
    "python>=${_pyver}" "python<${_pymax}"
    'nodejs>=26' 'npm' 'pnpm' "uv>=${_uvmin}" 'ripgrep' 'ffmpeg'
    'nss' 'atk' 'at-spi2-core' 'cups' 'libdrm' 'libxkbcommon' 'mesa' 'pango'
    'cairo' 'alsa-lib' 'libxcomposite' 'libxdamage' 'libxrandr'
    'git' 'curl'
  )
  optdepends=(
    'chromium: system browser for browser_exec (browser.executable_path)'
    'google-chrome: system browser for browser_exec (browser.executable_path)'
    'brave-bin: system browser for browser_exec (browser.executable_path, AUR)'
  )

  cd "$(_extract_dir)"

  # Install to /opt/hermes-agent (fixed, pkgname-independent: the desktop
  # output and the install stamp name it).
  _optdir="$pkgdir/opt/${_optname}"
  install -d "$_optdir"

  rsync -a --exclude='__pycache__' --exclude='.git' \
    --exclude='node_modules' --exclude='web/src' \
    --exclude='web/package.json' \
    --exclude='web/vite.config.ts' --exclude='web/tsconfig*.json' \
    --exclude='web/eslint.config.js' --exclude='web/README.md' \
    --exclude='ui-tui/src' --exclude='ui-tui/node_modules' \
    --exclude='scripts/tests' --exclude='scripts/install.*' \
    --exclude='build' --exclude='/tests' --exclude='/.build' \
    . "$_optdir/"

  echo "console.log('skipping build, using prebuilt dist/entry.js')" > "$_optdir/ui-tui/scripts/build.mjs"

  # The web build's freshness manifest (new in v0.21.6) records its inputs by
  # absolute build path; point it at the installed tree instead of $srcdir.
  sed -i "s|$(_extract_dir)|/opt/${_optname}|g" "$_optdir/hermes_cli/web_dist/hermes-build.json"

  # Since v0.21.6 the version comes from a build stamp beside the code
  # (pyproject says 0.0.0; without the stamp `hermes --version` reports
  # "unknown"). Upstream's packager script writes it. "external" keeps hermes
  # from syncing the root-owned venv and marks the tree as not its own. The
  # commit time comes from prepare().
  # The script fills gaps from CI variables (GITHUB_REF_NAME, ...) and from
  # git, which would find this packaging repository around $srcdir: start it
  # with a bare environment and keep git inside $srcdir.
  env -i PATH="$PATH" GIT_CEILING_DIRECTORIES="$srcdir" \
    venv/bin/python scripts/write_install_stamp.py \
    --output "$_optdir/install-stamp.json" \
    --commit "$_commit" \
    --commit-date "$(<"${srcdir}/commit-date")" \
    --base-version "$pkgver" \
    --distance 0 \
    --source pkg \
    --update-mechanism external
  # `distribution` names the steward that owns the tree; `hermes update` then
  # refuses with "managed by pacman" before it tries to lock the root-owned
  # tree. The script only offers upstream's own stewards, the runtime takes
  # any name. `runtimeDir` points pm at the system-tools store below; the
  # runtime resolves it as given (not relative to the stamp), so absolute.
  venv/bin/python - "$_optdir/install-stamp.json" "/opt/${_optname}/system-store/tools" <<'PY'
import json, sys
path, store = sys.argv[1:]
with open(path, encoding="utf-8") as f:
    stamp = json.load(f)
stamp["distribution"] = "pacman"
stamp["runtimeDir"] = store
with open(path, "w", encoding="utf-8") as f:
    json.dump(stamp, f, indent=2)
    f.write("\n")
PY

  # pm's store of the tools depends=() provides: symlinks into /usr/bin under
  # the pins of pm/lock.json (see system-tools.py).
  venv/bin/python -B "$srcdir/system-tools.py" "$_optdir" "$_optdir/system-store/tools"

  # Ship the prebuilt TUI into hermes_cli/tui_dist/ so _find_bundled_tui()
  # finds it and skips the npm install step (which would fail with EACCES on
  # the root-owned /opt tree). hermes_cli is imported from /opt via the .pth
  # file, NOT from the venv site-packages.
  _tuidir="$_optdir/hermes_cli/tui_dist"
  install -d "$_tuidir"
  if [ -d ui-tui/dist ]; then
    cp -a ui-tui/dist/* "$_tuidir/"
  fi
  # The bundle is an ES module. Upstream's bundle ships this package.json
  # beside it (scripts/build/agent.py); without it node finds the root
  # package.json, warns MODULE_TYPELESS_PACKAGE_JSON and parses entry.js twice.
  echo '{"type":"module"}' > "$_tuidir/package.json"

  _sitedir="$_optdir/venv/lib/python${_pyver}/site-packages"
  install -d "$_sitedir"
  # The launcher's environment for every python of the venv, also the ones
  # started without the launcher (the gateway service unit).
  install -m644 "$srcdir/hermes_agent_env.py" "$_sitedir/"
  {
    echo "import sys; sys.path.insert(0, \"/opt/${_optname}\")"
    echo "import hermes_agent_env"
  } > "$_sitedir/hermes.pth"

  # Bytecode for the whole tree: users cannot write __pycache__ into the
  # root-owned /opt, so without it every start compiles everything again
  # (`hermes --help` 1.15 s instead of 0.46 s). checked-hash: makepkg resets
  # every mtime to SOURCE_DATE_EPOCH, which would turn timestamp-based .pyc
  # files stale. A .py edited in place still wins over its old .pyc.
  # -s/-p record the installed paths, not $pkgdir, in tracebacks.
  "/usr/bin/python${_pyver}" -m compileall -q -j0 \
    --invalidation-mode checked-hash -s "$pkgdir" -p / "$_optdir"

  # makepkg's own strip step inspects each of the ~37k files (about three
  # minutes in CI); only the venv's native libraries are ELF objects. The
  # name test alone would also catch text files named *.so.
  find "$_optdir" -type f -name '*.so*' -print0 |
    while IFS= read -r -d '' lib; do
      if [ "$(head -c 4 "$lib")" = $'\x7fELF' ]; then
        strip --strip-unneeded "$lib"
      fi
    done

  # Readable for every user: the TUI build leaves ui-tui/dist at mode 700
  # (since v0.21.6).
  chmod -R a+rX "$_optdir"
  # uv leaves its venv lock world-writable (0666); only root changes this venv.
  rm -f "$_optdir/venv/.lock"

  install -d "$pkgdir/usr/bin"
  {
    echo "#!/bin/bash"
    echo "unset PYTHONPATH"
    echo "unset PYTHONHOME"
    echo ': "${XDG_DATA_HOME:=$HOME/.local/share}"'
    echo 'export HERMES_DISABLE_LAZY_INSTALLS=1'
    echo 'export HERMES_LAZY_INSTALL_TARGET="$XDG_DATA_HOME/hermes-agent/python"'
    echo "export HERMES_WEBAPP_DIST=/opt/${_optname}/apps/desktop/dist-webapp"
    # Installation launchers answer --print-runtime-command with the
    # interpreter command of their tree as JSON; the desktop app mints its
    # gateway tickets with that interpreter. Upstream's launchers answer
    # through this module. keep-venv-interpreter.patch makes it name the venv
    # python whatever HERMES_HOME says. The command it reports runs hermes
    # without this launcher; hermes_agent_env.py supplies the exports
    # there. -I -B as in upstream's launchers: no cwd on sys.path, no
    # bytecode writes.
    echo 'if [[ ${1-} == --print-runtime-command ]]; then'
    echo "  exec /opt/${_optname}/venv/bin/python -I -B -m hermes_cli._launchers" '"$@"'
    echo 'fi'
    # No browser export: browser_exec reads only browser.executable_path
    # (then pm's Chromium). The config migration to v52 would write an
    # exported AGENT_BROWSER_EXECUTABLE_PATH into the user's config.yaml.
    echo "exec /opt/${_optname}/venv/bin/python -m hermes_cli.main" '"$@"'
  } > "$pkgdir/usr/bin/hermes"

  chmod 755 "$pkgdir/usr/bin/hermes"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_hermes-agent-desktop() {
  pkgdesc="Desktop UI for Hermes Agent (chat, voice, files, settings)"
  # The app runs its backend through /usr/bin/hermes from the sibling output
  # of this very recipe, and never installs a runtime of its own; it needs a
  # runtime of at least its own version, which one build of one recipe
  # guarantees. The agent's own dependencies (ffmpeg, ripgrep, browsers, ...)
  # are not repeated here.
  depends=(
    "${_electron}"
    "hermes-agent>=${pkgver}"
    'hicolor-icon-theme'
    'libnotify'
    'libsecret'
    'libx11'
    'libxi'
    'xdg-utils'
  )
  optdepends=(
    'libayatana-appindicator: tray indicator support'
  )

  cd "$(_extract_dir)"
  local appdir="apps/desktop/release/linux-unpacked"
  local resources="${appdir}/resources"
  if [ ! -d "${appdir}" ]; then
    printf 'ERROR: electron-builder did not produce %s\n' "${appdir}"
    ls -la apps/desktop/release/ 2>/dev/null || true
    return 1
  fi
  if [ ! -f "${resources}/app.asar" ] || \
     [ ! -d "${resources}/app.asar.unpacked" ] || \
     [ ! -f "${resources}/install-stamp.json" ]; then
    printf 'ERROR: electron-builder output is missing required app resources\n'
    find "${resources}" -maxdepth 2 -printf '%M %p\n' 2>/dev/null || true
    return 1
  fi
  # Only the first three resources are installed. The skipped ones are
  # upstream's Windows icon, electron-updater metadata (Hermes ships no
  # electron-updater) and Electron's own default app, which the system
  # Electron provides. Anything else is a new runtime resource the app would
  # miss on Linux, so stop until it is packaged or deliberately added here.
  local entry
  for entry in "${resources}"/*; do
    case "${entry##*/}" in
      app.asar|app.asar.unpacked|install-stamp.json) ;;
      icon.ico|app-update.yml|default_app.asar) ;;
      *)
        printf 'ERROR: unexpected electron-builder resource %s — install it or allowlist it in package_hermes-agent-desktop()\n' \
          "${entry##*/}"
        return 1
        ;;
    esac
  done
  # Install dir stays version-independent of pkgname: the launcher and the
  # packaged app reference /usr/lib/hermes-agent-desktop by path. One recipe
  # guarantees only one variant of the two outputs is ever published.
  local libdir="/usr/lib/${_libname}"
  install -dm755 "${pkgdir}${libdir}"
  install -Dm644 "${resources}/app.asar" \
    "${pkgdir}${libdir}/app.asar"
  cp -a "${resources}/app.asar.unpacked" \
    "${pkgdir}${libdir}/app.asar.unpacked"
  install -Dm644 "${resources}/install-stamp.json" \
    "${pkgdir}${libdir}/install-stamp.json"
  # The agent runtime comes from the hermes-agent dependency (/usr/bin/hermes).
  # This package must not ship or run an installer that writes an agent tree.
  install -Dm755 "${srcdir}/hermes-desktop" "${pkgdir}/usr/bin/${_binname}"
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/${_binname}.desktop" <<EOF
[Desktop Entry]
Name=Hermes
GenericName=AI Agent Client
Comment=${pkgdesc}
Exec=/usr/bin/${_binname} %U
Terminal=false
Type=Application
Icon=${_upstream,,}
StartupWMClass=${_upstream}
Categories=Development;
Keywords=AI;Agent;Chat;Assistant;
MimeType=x-scheme-handler/hermes;
EOF
  # assets/icon.png is 1024x1024 (AUR says 512x512, which is wrong for the
  # bitmap it installs).
  install -Dm644 "apps/desktop/assets/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${_upstream,,}.png"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
