# Maintainer: Caroline Snyder <carolinemariesnyder@gmail.com>
#
# Layer-based photo editor with PSD support, written from scratch in pure Rust.
# Part of the ArtCraft "Crafting Apps" family: https://getartcraft.com
#
# Upstream builds the wasm app (`apps/photocraft-web`) from the same workspace, so the
# build targets the two native crates explicitly rather than the whole workspace.
# Requires rust >= 1.95 (workspace `rust-version`).

pkgname=photocraft
pkgver=0.7.0
pkgrel=1
pkgdesc="Layer-based photo editor with PSD support, written from scratch in pure Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/photocraft"
license=('MIT OR Apache-2.0')
depends=(
    'glibc'
    'libgcc'
    'libxkbcommon'
    'vulkan-icd-loader'
    'libxkbcommon-x11'
    'wayland'
    'libx11'
    'libxcb'
    'libxcursor'
    'libxi'
  )
makedepends=(
    'rust'
  )
optdepends=(
    'libglvnd: EGL/GL rendering when no Vulkan loader is present'
    'libxrandr: multi-monitor and DPI change handling'
    'mesa: Vulkan drivers for GPU rendering'
    'xdg-desktop-portal: native file dialogs and system dark/light theme'
  )
source=("$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('420bc64e3548579b1b255aed33be055be1688c3427f429dc5f1c28daf8639a2c')

# Tag commit and release date, baked into the binary's build provenance
# (`option_env!("PHOTOCRAFT_BUILD_SHA")` / `PHOTOCRAFT_BUILD_DATE`) and into the AppStream
# metadata below. Fixed rather than derived from the clock so rebuilds match.
_commit=79261615956ab21334e49ca1d384390272e647da
_releasedate=2026-10-11
_appid=ai.storyteller.photocraft

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"

  export PHOTOCRAFT_BUILD_SHA="$_commit"
  export PHOTOCRAFT_BUILD_DATE="$_releasedate"

  cargo build --release --frozen -p photocraft -p photocraft-cli --features heif
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/photocraft" "$pkgdir/usr/bin/photocraft"
  install -Dm755 "target/release/photocraft-cli" "$pkgdir/usr/bin/photocraft-cli"

  install -Dm644 "packaging/linux/$_appid.desktop" \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "packaging/linux/$_appid.mime.xml" \
    "$pkgdir/usr/share/mime/packages/$_appid.xml"

  # The metainfo ships as a template; upstream substitutes the same two tokens.
  sed -e "s/@VERSION@/$pkgver/g" -e "s/@DATE@/$_releasedate/g" \
    "packaging/linux/$_appid.metainfo.xml.in" > "$_appid.metainfo.xml"
  install -Dm644 "$_appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"

  install -dm755 "$pkgdir/usr/share/icons/hicolor"
  cp -a assets/app-icon/hicolor/. "$pkgdir/usr/share/icons/hicolor/"

  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "NOTICE" "$pkgdir/usr/share/doc/$pkgname/NOTICE"
  install -Dm644 "ATTRIBUTION.md" "$pkgdir/usr/share/doc/$pkgname/ATTRIBUTION.md"

  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
