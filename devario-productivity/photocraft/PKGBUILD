# Maintainer: Caroline Snyder <carolinemariesnyder@gmail.com>

pkgname=photocraft
pkgver=0.23.1
pkgrel=1
pkgdesc="Layer-based photo editor with PSD support, written from scratch in pure Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/photocraft"
license=('MIT OR Apache-2.0')
depends=(
    'glibc'
    'libgcc'
    'libxkbcommon'
    'libxkbcommon-x11'   # winit X11 backend panics without it (photocraft#201)
    'vulkan-icd-loader'
    'hicolor-icon-theme'
  )
makedepends=(
    'git'
    'rust>=1.95'
    'cmake'
    'pkgconf'
  )
optdepends=(
    'libglvnd: EGL/GL rendering when no Vulkan loader is present'
    'wayland: Wayland windowing support'
    'libx11: X11 windowing support'
    'libxcursor: themed cursor rendering under X11'
    'libxi: pen tablet and touch input under X11'
    'libxrandr: multi-monitor and DPI change handling'
    'mesa: Vulkan drivers for GPU rendering'
    'xdg-desktop-portal: native file dialogs and system dark/light theme'
    'cups: system printing through lp and lpstat'
  )
_fontsrev=b076417b5880bd4154bd22f00695b1d28c6bea83
_i18nrev=e02939ef009218e81c44e8ec001fbb7603461de4
source=(
    "$url/archive/refs/tags/v$pkgver.tar.gz"
    "craft-fonts-$_fontsrev.tar.gz::https://github.com/storytold/craft-fonts/archive/$_fontsrev.tar.gz"
    "craft-i18n-$_i18nrev.tar.gz::https://github.com/storytold/craft-i18n/archive/$_i18nrev.tar.gz"
)
sha256sums=(
    '66786e5b1e88bff0a1f04ab5073be50faa7e65b3cdebcbd679e1837ff52a82c6'
    '35eadfeb7e4217a933f24b73a3d190b90fed81e6c933266f092c161746c0a9eb'
    '0bd1481c0de61d0e31dd2dd9f955135e573f8ebdbb04a87f4567125674b350bd'
)

_commit=45066c4
_releasedate=2026-11-12
_appid=ai.storyteller.photocraft

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"

  export PHOTOCRAFT_BUILD_SHA="$_commit"
  export PHOTOCRAFT_BUILD_DATE="$_releasedate"
  export CRAFT_FONTS_DIR="$srcdir/craft-fonts-$_fontsrev"
  export CRAFT_FONTS_REQUIRED=1
  export CRAFT_I18N_DIR="$srcdir/craft-i18n-$_i18nrev"
  export CRAFT_I18N_REQUIRED=1

  cargo build --release --frozen -p photocraft -p photocraft-cli --features heif

  # Separate invocation: the example's dev-dep features must not unify into the binaries.
  cargo build --release --frozen -p "$pkgname-cli" --features heif --example man-and-completions
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/photocraft" "$pkgdir/usr/bin/photocraft"
  install -Dm755 "target/release/photocraft-cli" "$pkgdir/usr/bin/photocraft-cli"

  "target/release/examples/man-and-completions" "$srcdir/cli-docs"
  install -Dm644 -t "$pkgdir/usr/share/man/man1" "$srcdir"/cli-docs/*.1
  install -Dm644 "$srcdir/cli-docs/$pkgname-cli.bash" \
    "$pkgdir/usr/share/bash-completion/completions/$pkgname-cli"
  install -Dm644 "$srcdir/cli-docs/_$pkgname-cli" \
    "$pkgdir/usr/share/zsh/site-functions/_$pkgname-cli"
  install -Dm644 "$srcdir/cli-docs/$pkgname-cli.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname-cli.fish"

  install -Dm644 "packaging/linux/$_appid.desktop" \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "packaging/linux/$_appid.mime.xml" \
    "$pkgdir/usr/share/mime/packages/$_appid.xml"

  sed -e "s/@VERSION@/$pkgver/g" -e "s/@DATE@/$_releasedate/g" \
    "packaging/linux/$_appid.metainfo.xml.in" > "$_appid.metainfo.xml"
  install -Dm644 "$_appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"

  install -dm755 "$pkgdir/usr/share/icons/hicolor"
  cp -a assets/app-icon/hicolor/. "$pkgdir/usr/share/icons/hicolor/"

  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "NOTICE" "$pkgdir/usr/share/doc/$pkgname/NOTICE"
  install -Dm644 "ATTRIBUTION.md" "$pkgdir/usr/share/doc/$pkgname/ATTRIBUTION.md"

  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
