source=("https://download.gimp.org/gimp/v${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('16a2696cadc9e03a2ef97ccb895e062f654cb2b8211fb57074db85f26646c847')

# gen-languages aborts unless a UTF-8 locale resolves, and the isolated build
# root ships only C.utf8. Compile en_US.UTF-8 in the build tree so the recipe
# needs no glibc-locales dependency.
_fix_locale() {
  local _locale_root="$srcdir/.build-locales"

  if [[ ! -r "$_locale_root/en_US.UTF-8/LC_CTYPE" ]]; then
    if [[ ! -r /usr/share/i18n/locales/en_US ||
          ! -r /usr/share/i18n/charmaps/UTF-8.gz ]]; then
      printf '%s\n' '==> ERROR: glibc locale sources are missing; cannot generate en_US.UTF-8.' >&2
      return 1
    fi
    mkdir -p "$_locale_root" || return
    localedef --no-archive -i en_US -f UTF-8 \
      "$_locale_root/en_US.UTF-8" || return
  fi

  export LOCPATH="$_locale_root"
  export LC_ALL=en_US.UTF-8
  export LANG=en_US.UTF-8
}

build() {
  _fix_locale || return

  local meson_options=(
    --sysconfdir=/etc
    --libexecdir=/usr/bin
    -Dopenmp=enabled
    -Dcheck-update=no
    -Dopenexr=enabled
    -Dheadless-tests=disabled # enabled by default, depends on xorg-server-xvfb
    -Dappdata-test=disabled   # the appdata check queries the bug-report URL
  )

  arch-meson "${pkgname}-${pkgver}" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  _fix_locale || return

  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "${pkgdir}"
}

