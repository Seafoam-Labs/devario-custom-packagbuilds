# Local adaptation for Seafoam Labs; based on the Arch Linux gimp recipe.
# Arch recipe commit: 046dde99e5c2ee21b531e015b76148929dd9cc2a
# Local changes: build the self-contained 3.2.8 release tarball instead of the
# GIMP_3_2_8 git tag plus a floating gimp-data checkout, which also removes the
# git makedepend and submodule wiring; pin .so depends to the provisions these
# repositories publish and keep upstream's bare forms where the provider
# publishes no versioned one; name xz's liblzma soname instead of repeating
# liblcms2; disable AppStream validation with the Meson option instead of
# deleting the check; compile en_US.UTF-8 inside the build tree because
# gen-languages needs a UTF-8 locale and the isolated root ships only C.utf8;
# drop the obsolete gimp.install upgrade notice.
# Maintainer: Christian Hesse <mail@eworm.de>
# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Contributor: Daniel Isenmann <daniel@archlinux.org>

pkgname=gimp
pkgver=3.2.8
pkgrel=2.2
pkgdesc='GNU Image Manipulation Program'
url='https://www.gimp.org/'
arch=('x86_64')
license=('GPL-3.0-or-later')
# .so depends name the versioned provisions these repositories publish.
# fontconfig, gdk-pixbuf2, gtk3, libgirepository, libheif, libmng, libwmf,
# poppler-glib and the X libraries publish only bare sonames, and aalib,
# appstream, libmypaint, openexr and openjpeg2 publish none, so those stay bare.
