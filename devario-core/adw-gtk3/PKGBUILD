# Maintainer: Devario maintainers

pkgname=adw-gtk3
pkgver=6.5
pkgrel=1
pkgdesc='Libadwaita-style light and dark themes for GTK 3 and GTK 4'
arch=('any')
url='https://github.com/lassekongo83/adw-gtk3'
license=('LGPL-2.1-only')
optdepends=(
  'gtk3: GTK 3 applications'
  'gtk4>=4.20: GTK 4 applications'
)
options=('!strip')
# Upstream's release contains compiled CSS and assets for both variants.
# Retain the matching source archive for the license and corresponding source.
source=(
  "$pkgname-$pkgver.tar.xz::$url/releases/download/v$pkgver/adw-gtk3v$pkgver.tar.xz"
  "$pkgname-$pkgver-source.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
)
sha256sums=(
  'a81780fadfc432be0fc3d89c4ebb41aa28e4f032d42c36f9789c57dd10cfa41c'
  'fc9fc3b3e89d90d9a0e38bae05445ce9e65faf47acea3ac658e5f42566def473'
)

package() {
  install -dm755 "$pkgdir/usr/share/themes"
  cp -a "$srcdir/adw-gtk3" "$srcdir/adw-gtk3-dark" "$pkgdir/usr/share/themes/"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
