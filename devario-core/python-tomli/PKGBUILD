# Maintainer: Devario maintainers
_name=tomli
pkgname=python-tomli
pkgver=2.5.0
pkgrel=1
pkgdesc='A lil TOML parser for Python'
arch=(any)
url='https://github.com/hukkin/tomli'
license=(MIT)
depends=('python>=3.8')
makedepends=(
  python-build
  'python-flit-core>=3.12'
  'python-flit-core<5'
  python-installer
)
source=("https://files.pythonhosted.org/packages/source/t/$_name/$_name-$pkgver.tar.gz")
sha256sums=('264507556cd8b8c8e7c6ee037cdf443a463f03f4c958e57195e3d369711b8ff6')

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
