# Official Rust binaries used only to bootstrap the source-built Rust package.
pkgname=rust-bootstrap
pkgver=1.100.1
pkgrel=1
epoch=1
pkgdesc='Temporary official Rust compiler, Cargo, rustfmt and standard libraries for bootstrapping'
arch=('x86_64')
url='https://www.rust-lang.org/'
license=('Apache-2.0 OR MIT')
depends=('glibc' 'libgcc' 'zlib' 'gcc-libs')
provides=("rust=$epoch:$pkgver" "cargo=$pkgver" 'rustfmt' "rust-wasm=$epoch:$pkgver")
conflicts=('rust' 'cargo' 'rustfmt' 'rust-wasm' 'rustup')
# Preserve the already-built compiler and its libraries exactly as distributed.
options=('!strip' '!debug' '!lto' 'staticlibs')
# Integrity is pinned via sha256sums taken from the signed upstream channel
# manifest recorded in provenance.json (signer 108F66205EAEB0AAA8DD5E1C85AB96E6FA1BE5FE).
# The 1.100.1 components are referenced through the release-neutral dist root so no
# unverified dated dist directory is guessed; validation confirms availability and
# regenerates the sums from the actual fetched bytes.
source=(
  "https://static.rust-lang.org/dist/rustc-1.100.1-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/cargo-1.100.1-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/rustfmt-1.100.1-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/rust-std-1.100.1-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/rust-std-1.100.1-wasm32-unknown-unknown.tar.xz"
  "https://static.rust-lang.org/dist/rust-std-1.100.1-wasm32-wasip1.tar.xz"
  "https://static.rust-lang.org/dist/rust-std-1.100.1-wasm32-wasip2.tar.xz"
)
sha256sums=('e8e8f0a79da23a7526aea34f2da59e96ea8f51e4ef5e5a3831f71f41e63a495e'
            'f0a81f7ea2e3238e85fadb3b9f5bc03111ed368697a04dd350567f6ed836d638'
            '26c96dbf9253c9be9c340233d91ca9e385095335fd8a97a2698373e188620461'
            '27c6ff8ce7d6a968dc98c74e0c214a92a1e7b61d7c2b027189040bc649a4bdc1'
            '8021de8ffd8f11cd1f745fc9ea3cb3f48f6f4de453684aea7fd6e6d75c37a1f1'
            'e5510b89296c6a546228f5b7355226774cb25591109682249b649215e844760f'
            '02c3a3669db66716b1b0eb2b2c713f3e120cd606b3132b156dc5e3159030b1b8')

package() {
  local archive directory
  for archive in "${source[@]}"; do
    [[ $archive == *.tar.xz ]] || continue
    directory=${archive##*/}
    directory=${directory%.tar.xz}
    sh "$srcdir/$directory/install.sh" \
      --prefix=/usr --destdir="$pkgdir" --disable-ldconfig || return 1
  done
  # Package manager owns installation/removal; discard upstream uninstall state.
  rm -f "$pkgdir/usr/lib/rustlib/"{components,install.log,rust-installer-version,uninstall.sh,manifest-*}
  install -Dm644 "$srcdir/rustc-$pkgver-x86_64-unknown-linux-gnu/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
