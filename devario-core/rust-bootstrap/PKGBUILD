# Official Rust binaries used only to bootstrap the source-built Rust package.
pkgname=rust-bootstrap
pkgver=1.100.0
pkgrel=1
epoch=1
pkgdesc='Temporary official Rust compiler, Cargo, rustfmt and standard libraries for bootstrapping'
arch=('x86_64')
url='https://www.rust-lang.org/'
license=('Apache-2.0 OR MIT')
depends=('glibc' 'libgcc' 'zlib' 'gcc-libs')
provides=("rust=$epoch:$pkgver" "cargo=$pkgver" 'rustfmt' "rust-wasm=$epoch:$pkgver")
conflicts=('rust' 'cargo' 'rustfmt' 'rust-wasm' 'rustup')
# Preserve the already-built compiler and its libraries exactly as distributed.
options=('!strip' '!debug' '!lto' 'staticlibs')
# Integrity is pinned via sha256sums taken from the signed upstream channel
# manifest recorded in provenance.json (signer 108F66205EAEB0AAA8DD5E1C85AB96E6FA1BE5FE).
source=(
  "https://static.rust-lang.org/dist/2026-11-12/rustc-1.100.0-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/2026-11-12/cargo-1.100.0-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/2026-11-12/rustfmt-1.100.0-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/2026-11-12/rust-std-1.100.0-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/2026-11-12/rust-std-1.100.0-wasm32-unknown-unknown.tar.xz"
  "https://static.rust-lang.org/dist/2026-11-12/rust-std-1.100.0-wasm32-wasip1.tar.xz"
  "https://static.rust-lang.org/dist/2026-11-12/rust-std-1.100.0-wasm32-wasip2.tar.xz"
)
sha256sums=('f1d0b1dec81dab6f523cd098507763487b0d4bd7fd2c87582f154128719be03b'
            '7e29ce07d7c6e92d1826870575ba27d57fff6cb3e754aa57d99099cb88fab35d'
            '4c9389e4722b16499e5d47d89837ec84a4ef755f105ed2a84c038156064e01ab'
            '4591b6486594ded52ecd6135db95bf9355bbd3ca7a380888b141528bbcf9a5d4'
            '19b7954d650fc0d22767eceb76b8e03d07ce0d6a9f4234f33c32a17ee8d6d7b9'
            '7a506aa6fcc8ed4308780fc412ba5713eb1c97bf5b1e940eaa2cf1f70299c777'
            '532d5210ca87ddc4a7697170524d271f51b74ff9296e25e2b2d6df436d624d6f')

package() {
  local archive directory
  for archive in "${source[@]}"; do
    [[ $archive == *.tar.xz ]] || continue
    directory=${archive##*/}
    directory=${directory%.tar.xz}
    sh "$srcdir/$directory/install.sh" \
      --prefix=/usr --destdir="$pkgdir" --disable-ldconfig || return 1
  done
  # Package manager owns installation/removal; discard upstream uninstall state.
  rm -f "$pkgdir/usr/lib/rustlib/"{components,install.log,rust-installer-version,uninstall.sh,manifest-*}
  install -Dm644 "$srcdir/rustc-$pkgver-x86_64-unknown-linux-gnu/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
