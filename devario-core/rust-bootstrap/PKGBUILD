# Official Rust binaries used only to bootstrap the source-built Rust package.
pkgname=rust-bootstrap
pkgver=1.98.0
pkgrel=1
epoch=1
pkgdesc='Temporary official Rust compiler, Cargo, rustfmt and standard libraries for bootstrapping'
arch=('x86_64')
url='https://www.rust-lang.org/'
license=('Apache-2.0 OR MIT')
depends=('glibc' 'libgcc' 'zlib' 'gcc-libs')
provides=("rust=$epoch:$pkgver" "cargo=$pkgver" 'rustfmt' "rust-wasm=$epoch:$pkgver")
conflicts=('rust' 'cargo' 'rustfmt' 'rust-wasm' 'rustup')
# Preserve the already-built compiler and its libraries exactly as distributed.
options=('!strip' '!debug' '!lto' 'staticlibs')
validpgpkeys=('108F66205EAEB0AAA8DD5E1C85AB96E6FA1BE5FE')
source=(
  "https://static.rust-lang.org/dist/2026-08-20/rustc-1.98.0-x86_64-unknown-linux-gnu.tar.xz"{,.asc}
  "https://static.rust-lang.org/dist/2026-08-20/cargo-1.98.0-x86_64-unknown-linux-gnu.tar.xz"{,.asc}
  "https://static.rust-lang.org/dist/2026-08-20/rustfmt-1.98.0-x86_64-unknown-linux-gnu.tar.xz"{,.asc}
  "https://static.rust-lang.org/dist/2026-08-20/rust-std-1.98.0-x86_64-unknown-linux-gnu.tar.xz"{,.asc}
  "https://static.rust-lang.org/dist/2026-08-20/rust-std-1.98.0-wasm32-unknown-unknown.tar.xz"{,.asc}
  "https://static.rust-lang.org/dist/2026-08-20/rust-std-1.98.0-wasm32-wasip1.tar.xz"{,.asc}
  "https://static.rust-lang.org/dist/2026-08-20/rust-std-1.98.0-wasm32-wasip2.tar.xz"{,.asc}
)
sha256sums=(
  '0e37cb339f447fc44d6d781073bacacebfdc5612f2600e4c7e84c266f5f3aced' 'SKIP'
  '2f512d170d3dd23e16ababcda32ee2e6d5172d861a7af1f504e0b1e270cafab9' 'SKIP'
  '8922a03e68265a74a8040590e28b173fb5d9d49655bb6eacfd880fbd3bef0dc3' 'SKIP'
  'f5022e6c95a5ad23cca2513dc8281200f585fa188de6370aa37b128a43f876a3' 'SKIP'
  '3bb537c09555b96020a38a3a8810c38908b194eff3c2cb6184a45dda5c6828de' 'SKIP'
  '07af7da4d9e943226c438cd5b60ba2b1f23a88c077eb09ccb227a385529c8b08' 'SKIP'
  'c54e91aa066465963064ea69edc0bebb243eea357e36d4488bcfa2686f8cc538' 'SKIP'
)

package() {
  local archive directory
  for archive in "${source[@]}"; do
    [[ $archive == *.tar.xz ]] || continue
    directory=${archive##*/}
    directory=${directory%.tar.xz}
    sh "$srcdir/$directory/install.sh" \
      --prefix=/usr --destdir="$pkgdir" --disable-ldconfig || return 1
  done
  # Package manager owns installation/removal; discard upstream uninstall state.
  rm -f "$pkgdir/usr/lib/rustlib/"{components,install.log,rust-installer-version,uninstall.sh,manifest-*}
  install -Dm644 "$srcdir/rustc-$pkgver-x86_64-unknown-linux-gnu/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
