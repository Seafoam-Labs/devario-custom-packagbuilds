# Devario: Qt 6.12 components must be built against matching Qt tools.
# Packaging source: https://gitlab.archlinux.org/archlinux/packaging/packages/qt6-shadertools/-/raw/main/PKGBUILD
# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-shadertools
_pkgver=6.12.0
pkgver=${_pkgver/-/}
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Provides functionality for the shader pipeline that allows Qt Quick to operate on Vulkan, Metal, and Direct3D, in addition to OpenGL'
depends=(glibc
         libgcc
         libstdc++
         "qt6-base=$pkgver")
makedepends=(cmake
             git
             ninja)
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver)
sha256sums=('bd98ae84bad099e2fc417219311016d144347d65ee8d2a5a9211d79a52aaf497')

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  [[ -x "$pkgdir/usr/lib/qt6/bin/qsb" ]] || {
    error "The qsb shader baker required by Qt Quick was not installed"
    return 1
  }
  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}
