# Contributor: Sergej Pupykin <arch+pub@sergej.pp.ru>
# Contributor: EVorster <evorster@gmail.com>

pkgname=vid.stab
pkgver=1.1.2
pkgrel=2
pkgdesc='Video stabilization library'
arch=(x86_64)
url=http://public.hronopik.de/vid.stab
license=(GPL-2.0-or-later)
depends=(
  glibc
  libgcc
  libgomp
)
makedepends=(
  cmake
  git
  ninja
)
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  libvidstab.so
  'libvidstab.so=1.2-64'
)
source=(git+https://github.com/georgmartius/vid.stab.git#tag=v${pkgver})
b2sums=('61e32f89adb31d25180f061b61364f00cb9afc602f584037d1c4357a21e5707e92b901a96fb1201d03c326ae478be3dbdac69a181d14d0664f1c5a1534c85a60')

pkgver() {
  cd vid.stab
  git describe --tags | sed 's/^v//'
}

build() {
  cmake -S vid.stab -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  _verify_soname "${pkgdir}/usr/lib/libvidstab.so" libvidstab.so.1.2 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
