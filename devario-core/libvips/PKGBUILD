# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=libvips
pkgname=('libvips' 'libvips-docs')
pkgver=8.18.7
pkgrel=2
pkgdesc="A fast image processing library with low memory needs"
arch=('x86_64')
license=('LGPL-2.1-or-later')
url="https://libvips.github.io/libvips/"
depends=('cairo' 'cfitsio' 'expat' 'fftw' 'fontconfig' 'glib2' 'glibc' 'highway'
         'lcms2' 'libarchive' 'libcgif' 'libexif' 'libgcc' 'libimagequant'
         'libjpeg-turbo' 'libmatio' 'libpng' 'libraw' 'librsvg' 'libstdc++'
         'libtiff' 'libwebp' 'openexr' 'openjpeg2' 'pango' 'zlib')
makedepends=('doxygen' 'gi-docgen' 'glib2-devel' 'gobject-introspection'
             'graphviz' 'imagemagick' 'libheif' 'libjxl' 'meson' 'openslide'
             'poppler-glib' 'vala')
checkdepends=('python-pytest' 'python-pyvips')
source=("https://github.com/libvips/libvips/releases/download/v$pkgver/vips-$pkgver.tar.xz")
sha512sums=('f1fb30f15c321c686ede573b3d00a850a9b138ea82473a5ad900454923758e0ee593ee9fb724a68aff389b506996719f9220e6f1fb62be375df15a7cb08edfa4')

build() {
  local meson_options=(
    -D cpp-docs=true
    -D docs=true
    -D nifti=disabled
    -D pdfium=disabled
    -D uhdr=disabled
    -D vapi=true
  )

  arch-meson vips-$pkgver build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build
  LD_LIBRARY_PATH="$srcdir/build/libvips" \
    pytest -k "not test_text" -sv --log-cli-level=WARNING \
    vips-$pkgver/test/test-suite
}

package_libvips() {
  optdepends=('imagemagick: for magick module'
              'libheif: for heif module'
              'libjxl: for jxl module'
              'openslide: for openslide module'
              'poppler-glib: for poppler module'
              'python: for vipsprofile')
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    'libvips.so'
    'libvips.so=42-64'
    'libvips-cpp.so'
    'libvips-cpp.so=42-64')

  meson install -C build --destdir="$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libvips.so" libvips.so.42 || return 1
  _verify_soname "$pkgdir/usr/lib/libvips-cpp.so" libvips-cpp.so.42 || return 1

  mkdir -p doc/usr/share
  mv {"$pkgdir",doc}/usr/share/doc
}

package_libvips-docs() {
  pkgdesc+=' (documentation)'
  depends=()

  mv doc/* "$pkgdir"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
