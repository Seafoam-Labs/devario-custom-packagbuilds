# Contributor: Evangelos Foutras <foutrelis@archlinux.org>

pkgbase=libgudev
pkgname=(
  libgudev
  libgudev-docs
)
pkgver=238
pkgrel=5
pkgdesc="GObject bindings for libudev"
url="https://gitlab.gnome.org/GNOME/libgudev"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  libgcc
  libsystemd
)
makedepends=(
  git
  glib2-devel
  glibc-locales
  gobject-introspection
  gtk-doc
  meson
  systemd
  umockdev
  vala
)
source=("git+$url.git#tag=$pkgver")
b2sums=('6da9512d87154fbd62aae044a39abd84bee451f5a21203180062c369ebedf2ee1bc7672408cf806918111397bc74be58314e6c3155e638137603d11012a4355f')

prepare() {
  cd libgudev
}

build() {
  local meson_options=(
    -D gtk_doc=true
  )

  arch-meson libgudev build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_libgudev() {
  depends+=(
    # published glib2 and systemd-libs declare these as versioned provisions
    'libglib-2.0.so=0-64'
    'libgobject-2.0.so=0-64'
    'libudev.so=1-64'
  )
  provides+=(libgudev-1.0.so 'libgudev-1.0.so=0-64')

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libgudev-1.0.so" libgudev-1.0.so.0 || return 1

  mkdir -p doc/usr/share
  mv {"$pkgdir",doc}/usr/share/gtk-doc
}

package_libgudev-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv doc/* "$pkgdir"
}

# vim:set sw=2 sts=-1 et:

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
