# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=libimobiledevice-glue
pkgver=1.3.3
pkgrel=2
pkgdesc='A library with common code used by libraries and tools around the libimobiledevice project'
arch=(x86_64)
url='https://libimobiledevice.org/'
license=(LGPL-2.1-or-later)
depends=(
  glibc
  'libplist>=2.8.0'
)
makedepends=(pkgconf)
provides=('libimobiledevice-glue-1.0.so')
source=("https://github.com/libimobiledevice/$pkgname/releases/download/$pkgver/$pkgname-$pkgver.tar.bz2")
sha256sums=('920ce01382a32695f49b23292b4979a03f0afd16c58e8755d8b7f41804acc1a9')

build() {
  cd "$pkgname-$pkgver"
  # Refuse an older libplist even when dependency checks are skipped.
  pkg-config --atleast-version=2.8.0 libplist-2.0 || return 1
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-static
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd "$pkgname-$pkgver"
  make check
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
