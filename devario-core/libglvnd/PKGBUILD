# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=libglvnd
pkgver=1.7.0
pkgrel=4
pkgdesc="The GL Vendor-Neutral Dispatch library"
arch=('x86_64')
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
license=('custom:BSD-like')
makedepends=('libxext' 'libx11' 'xorgproto' 'python' 'meson')
provides=('libgl' 'libegl' 'libgles')
provides+=(
  libEGL.so 'libEGL.so=1-64'
  libGL.so 'libGL.so=1-64'
  libGLESv2.so 'libGLESv2.so=2-64'
  libGLX.so 'libGLX.so=0-64'
  libGLdispatch.so 'libGLdispatch.so=0-64'
  libOpenGL.so 'libOpenGL.so=0-64'
)
source=("https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$pkgver/libglvnd-v$pkgver.tar.gz"
        license-from-upstream)
sha512sums=('7b6eb8e075b48f1d915b892044adc3260547d74ed61d1e2fa6c5f0f8c3527754abea314181e088626d4fd58bb221085e5288c4758d828e171c7dcb0e4991745c'
            'bf0f4a7e04220a407400f89226ecc1f798cc43035f2538cc8860e5088e1f84140baf0d4b0b28f66e4b802d4d6925769a1297c24e1ba39c1c093902b2931781a5')

build() {
  arch-meson $pkgname-v$pkgver build \
    -D gles1=false

  meson compile -C build
}

package() {
  # libglvnd needs mesa for indirect rendering
  depends=('libxext' 'mesa' 'opengl-driver')

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libEGL.so" libEGL.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libGL.so" libGL.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libGLESv2.so" libGLESv2.so.2 || return 1
  _verify_soname "$pkgdir/usr/lib/libGLX.so" libGLX.so.0 || return 1
  _verify_soname "$pkgdir/usr/lib/libGLdispatch.so" libGLdispatch.so.0 || return 1
  _verify_soname "$pkgdir/usr/lib/libOpenGL.so" libOpenGL.so.0 || return 1

  install -Dm644 license-from-upstream "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
