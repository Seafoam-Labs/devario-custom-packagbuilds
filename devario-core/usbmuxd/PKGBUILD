# Contributor: Gabriel Martinez <reitaka@gmail.com>

pkgname=usbmuxd
pkgver=1.1.1
pkgrel=9
pkgdesc='USB Multiplex Daemon'
arch=('x86_64')
url='https://libimobiledevice.org/'
license=('GPL-2.0-or-later' 'GPL-3.0-or-later')
depends=('glibc' 'libimobiledevice>=1.3.0' 'libusb>=1.0.9' 'libplist>=2.3.0')
makedepends=('autoconf' 'automake' 'libtool' 'pkgconf' 'systemd')

# Upstream tag 1.1.1, pinned independently of mutable Git refs.
_commit=79c8b38d1488a6b07e1e68f39d8caec3f1a45622
source=(
  "$pkgname-$_commit.tar.gz::https://github.com/libimobiledevice/usbmuxd/archive/$_commit.tar.gz"
  usbmuxd.sysusers
  libplist-2.3.0.diff
)
sha256sums=(
  'a4312626468a2c65850fda68191d461873a47bff79f05d82bea7c17e73e535eb'
  '984709f59bb012d92d2c7a260a0b2ac28b5b11a711faa76324abe9c84923be3f'
  'cb705a3627e6f4446689a3f4c22c262bbb7d8436f1b2bde417552cb93fab7446'
)

prepare() {
  cd "$srcdir/$pkgname-$_commit"
  patch -Np1 -i "$srcdir/libplist-2.3.0.diff"
  autoreconf -fiv
}

build() {
  cd "$srcdir/$pkgname-$_commit"
  # This release predates GCC's default switch to C23.
  CFLAGS="$CFLAGS -std=gnu17" ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --sbindir=/usr/bin \
    --with-udevrulesdir=/usr/lib/udev/rules.d \
    --with-systemdsystemunitdir=/usr/lib/systemd/system
  make
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  make check
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  make DESTDIR="$pkgdir" install
  install -Dm644 "$srcdir/usbmuxd.sysusers" "$pkgdir/usr/lib/sysusers.d/usbmuxd.conf"
}
