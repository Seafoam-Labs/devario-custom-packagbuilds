# Maintainer: Seafoam Labs

pkgname=zix
pkgver=0.8.2
pkgrel=2
pkgdesc='Lightweight C library of portability wrappers and data structures'
arch=('x86_64')
url='https://drobilla.net/software/zix.html'
license=('0BSD OR ISC')
depends=('glibc')
makedepends=('meson')
provides=('libzix-0.so')
source=("https://download.drobilla.net/$pkgname-$pkgver.tar.xz")
sha256sums=('4c73aab0f8cbbfe56b00c8c6d648316021e699c5ae6cbf254391ef309047e67b')

build() {
  # Avoid the sphinxygen/Doxygen typedef incompatibility.
  arch-meson "$pkgname-$pkgver" build \
    -Ddocs=disabled \
    -Dtests=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$pkgname-$pkgver/COPYING" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$pkgname-$pkgver"/LICENSES/*.txt
}
