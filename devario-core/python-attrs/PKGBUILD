# Maintainer: Devario maintainers
pkgname=python-attrs
pkgver=26.1.0
pkgrel=1
pkgdesc='Classes without boilerplate'
arch=(any)
url='https://www.attrs.org'
license=('MIT')
depends=('python')
makedepends=('python-hatchling' 'python-hatch-vcs' 'python-hatch-fancy-pypi-readme' 'python-build' 'python-installer')
source=('https://files.pythonhosted.org/packages/9a/8e/82a0fe20a541c03148528be8cac2408564a6c9a0cc7e9171802bc1d26985/attrs-26.1.0.tar.gz')
sha256sums=('d03ceb89cb322a8fd706d4fb91940737b6642aa36998fe130a9bc96c985eff32')

build() {
  cd "attrs-26.1.0"
  python -m build --wheel --no-isolation
}

package() {
  cd "attrs-26.1.0"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
