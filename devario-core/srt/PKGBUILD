# Contributor: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=srt
pkgver=1.5.7
pkgrel=2
pkgdesc='Secure Reliable Transport library'
url='https://www.srtalliance.org/'
arch=('x86_64')
license=('MPL-2.0')
depends=(
  bash
  glibc
  libgcc
  libstdc++
  openssl
)
makedepends=(
  cmake
  git
  ninja
)
# Pin the release commit: the old v1.5.7 checksum matched its parent instead.
source=('git+https://github.com/Haivision/srt#commit=899348d8318eb9a3c5a5b6ec43c4a1114288773a')
b2sums=('6287246e06dcc8d9e9ed7a36df1826f12ea2a15e87a9cca8845744bf127292735861d5c8818b94428d5bd07b28ccf7602f092fe1e4ccfd479bceb8446281296e')

build() {
  local cmake_options=(
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_BUILD_TYPE=None
    -DENABLE_STATIC=OFF
    -DENABLE_TESTING=ON
  )

  cmake -S srt -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

check() {
  cd build
  ./uriparser-test
  ./utility-test
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
