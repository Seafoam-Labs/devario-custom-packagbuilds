# Devario: Qt 6.12 components must be built against matching Qt tools.
# Packaging source: https://gitlab.archlinux.org/archlinux/packaging/packages/qt6-declarative/-/raw/main/PKGBUILD
# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-declarative
_pkgver=6.12.0
pkgver=${_pkgver/-/}
pkgrel=2
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Classes for QML and JavaScript languages'
depends=(glibc
         libgcc
         libstdc++
         "qt6-base=$pkgver")
makedepends=(cmake
             git
             ninja
             python
             "qt6-languageserver=$pkgver"
             "qt6-shadertools=$pkgver"
             "qt6-svg=$pkgver"
             vulkan-headers)
optdepends=('qt6-svg: for QtQuickVectorImage and svgtoqml')
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver)
sha256sums=('2abdb7dc4300da123b730ff70e11f5c3b8643dc27ce9efcb906bd8670fbf17e7')

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_REQUIRE_FIND_PACKAGE_Qt6ShaderToolsTools=ON \
    -DCMAKE_REQUIRE_FIND_PACKAGE_Qt6Gui=ON \
    -DCMAKE_REQUIRE_FIND_PACKAGE_Qt6Widgets=ON \
    -DFEATURE_qml_animation=ON \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # Qt otherwise permits a QML-only build with no Qt Quick libraries.
  local module library
  for module in Qml Quick QuickWidgets; do
    library="$pkgdir/usr/lib/libQt6${module}.so.6"
    if [[ ! -s "$library" ]] || ! readelf -d "$library" | grep -Fq "Library soname: [libQt6${module}.so.6]"; then
      error "Missing or invalid Qt ${module} runtime library; refusing an incomplete package"
      return 1
    fi
  done

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}
