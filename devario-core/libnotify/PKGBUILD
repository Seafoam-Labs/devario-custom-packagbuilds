pkgbase=libnotify
pkgname=(
  libnotify
  libnotify-docs
)
pkgver=0.8.9
pkgrel=1
pkgdesc="Library for sending desktop notifications"
url="https://gitlab.gnome.org/GNOME/libnotify"
arch=(x86_64)
license=(LGPL-2.1-or-later)
makedepends=(
  docbook-xsl
  gdk-pixbuf2
  gi-docgen
  glib2
  glib2-devel
  glibc
  gobject-introspection
  gtk4
  libxslt
  meson
  xmlto
)
checkdepends=(
  dbus
  python-dbus
  python-dbusmock
  xorg-server-xvfb
)
source=("https://download.gnome.org/sources/$pkgbase/${pkgver%.*}/$pkgbase-$pkgver.tar.xz")
sha256sums=('c906bb084027ea512f94a60fbfc0cc8d4f17e4b4d525bed370d07a6d8714c923')

build() {
  local meson_options=(
    -D docbook_docs=enabled
    -D gtk_doc=true
    -D introspection=enabled
    -D man=true
    -D tests=true
  )

  arch-meson "$pkgbase-$pkgver" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  # Upstream runs automated tests with D-Bus mocks and Xvfb, excluding
  # interactive tests through its default test setup.
  meson test -C build --print-errorlogs
}

package_libnotify() {
  # Keep runtime dependencies out of the documentation split's metadata.
  depends=(
    gdk-pixbuf2
    glib2
    glibc
  )
  optdepends=(
    'libnotify-docs: API documentation'
    'notification-daemon: Notification server'
  )
  provides=(libnotify.so)

  meson install -C build --destdir "$pkgdir"

  mkdir -p doc/usr/share
  mv "$pkgdir/usr/share/doc" doc/usr/share/
}

package_libnotify-docs() {
  pkgdesc+=" (documentation)"

  mv doc/* "$pkgdir"
}
