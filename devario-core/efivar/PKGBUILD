# Maintainer: David Runge <dvzrv@archlinux.org>
# Contributor: Tobias Powalowski <tpowa@archlinux.org>
# Contributor: Keshav Amburay <(the ddoott ridikulus ddoott rat) (aatt) (gemmaeiil) (ddoott) (ccoomm)>

pkgname=efivar
pkgdesc="Tools and libraries to work with EFI variables"
pkgver=39
pkgrel=3
arch=(x86_64)
url="https://github.com/rhboot/efivar"
license=(LGPL-2.1-or-later)
depends=(glibc)
makedepends=(
  git
  mandoc
)
# Devario ships no GRUB, so check()'s GRUB_PREFIX target has nothing to use:
# dispatch this row with --no-check.
checkdepends=(grub)
# Shelly keeps bare .so provisions unversioned, so declare the SONAME the
# published payload carries.
provides=(
  libefiboot.so
  'libefiboot.so=1-64'
  libefisec.so
  'libefisec.so=1-64'
  libefivar.so
  'libefivar.so=1-64'
)
source=("git+$url?signed#tag=$pkgver")
sha512sums=('SKIP')
b2sums=('SKIP')
validpgpkeys=('B00B48BC731AA8840FED9FB0EED266B70F4FEF10') # Peter Jones <pjones@redhat.com>

build() {
  # disable -Werror by default by setting ERRORS to empty string
  make ERRORS='' all -C $pkgname
}

check() {
  make GRUB_PREFIX=grub test -k -j1 -C $pkgname
}

package() {
  local make_options=(
    V=1
    DESTDIR="$pkgdir/"
    libdir=/usr/lib/
    bindir=/usr/bin/
    mandir=/usr/share/man/
    includedir=/usr/include/
    install
    -j1
    -C $pkgname
  )

  make "${make_options[@]}"
  install -vDm 644 $pkgname/{README.md,TODO} -t "$pkgdir/usr/share/doc/$pkgname/"

  _verify_soname "$pkgdir/usr/lib/libefiboot.so" libefiboot.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libefisec.so" libefisec.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libefivar.so" libefivar.so.1 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
