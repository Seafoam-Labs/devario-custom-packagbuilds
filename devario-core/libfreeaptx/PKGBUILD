# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=libfreeaptx
pkgver=0.2.2
pkgrel=2
pkgdesc="Open Source aptX codec library"
url="https://github.com/regularhunter/libfreeaptx"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(glibc)
makedepends=(git)
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  libfreeaptx.so
  'libfreeaptx.so=0-64'
)
source=("git+$url#tag=$pkgver")
b2sums=('4ed9db239b23b76cca22b0d390e859678dae5c959989cccd7a669951d7ffc18437d165c80f47b3fff587f19f52136dec6360b6735f0068b461eb0132716a6bb6')

prepare() {
  cd $pkgname
}

_make() {
  make CPPFLAGS="$CPPFLAGS" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" \
    PREFIX=/usr "$@"
}

build() {
  cd $pkgname
  _make
}

package() {
  cd $pkgname
  _make DESTDIR="$pkgdir" install
  _verify_soname "$pkgdir/usr/lib/libfreeaptx.so" libfreeaptx.so.0 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

# vim:set sw=2 sts=-1 et:
