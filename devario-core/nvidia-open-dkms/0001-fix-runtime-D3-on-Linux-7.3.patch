From 847adda56f3e8c66763e9ba6b25e3b4b05831c53 Mon Sep 17 00:00:00 2001
From: treshaun <71833988+treshaun@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:04:54 +0100
Subject: [PATCH] fix runtime D3 on Linux 7.3

---
 kernel-open/nvidia/nv-pci.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/kernel-open/nvidia/nv-pci.c b/kernel-open/nvidia/nv-pci.c
index 48d8b78..35a7df0 100644
--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -36,6 +36,8 @@
 #include <linux/completion.h>
 #include <linux/iommu.h>
 #include <linux/kthread.h>
+#include <linux/fs_struct.h>
+#include <linux/version.h>
 
 #include <linux/clk.h>
 #include <linux/device.h>
@@ -439,7 +441,14 @@ static void nv_get_pci_sysfs_config
                    NV_PCI_SLOT_NUMBER(pci_dev));
     if (ret > 0 && ret < sizeof(filename))
     {
-        struct file *file = filp_open(filename, O_RDONLY, 0);
+        struct file *file;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+        scoped_with_init_fs()
+            file = filp_open(filename, O_RDONLY, 0);
+#else
+        file = filp_open(filename, O_RDONLY, 0);
+#endif
         if (!IS_ERR(file))
         {
 #if defined(NV_SEQ_READ_ITER_PRESENT)
