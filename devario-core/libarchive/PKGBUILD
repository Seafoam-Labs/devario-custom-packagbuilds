# Adapted from Arch Linux packaging for explicit Shelly ABI provisions.
# Maintainer: Bartłomiej Piotrowski <bpiotrowski@archlinux.org>
# Maintainer: Dan McGee <dan@archlinux.org>

pkgname=libarchive
pkgver=3.8.10
pkgrel=1
pkgdesc='Multi-format archive and compression library'
arch=('x86_64')
url='https://libarchive.org/'
license=(
  BSD-2-Clause
  BSD-4-Clause-UC
  'Apache-2.0 OR CC0-1.0 OR OpenSSL'
)
depends=('acl'
         'bzip2'
         'glibc'
         'libxml2>=2.7.3'
         'lz4'
         'openssl'
         'xz'
         'zlib>=1.2.1'
         'zstd')
makedepends=('git' 'autoconf>=2.71' 'automake>=1.11' 'libtool' 'gettext' 'texinfo')
provides=('libarchive.so' 'libarchive.so=13-64')
validpgpkeys=('DB2C7CF1B4C265FAEF56E3FC5848A18B8F14184B'  # Martin Matuska <martin@matuska.org>
              '659C84C0E23EA1FA97E0B58CC040B508D63D2B36') # Martin Matuska <mm@FreeBSD.org>
source=("git+https://github.com/${pkgname}/${pkgname}.git?signed#tag=v${pkgver}")
# Refresh the source checksum for v3.8.10 in the separate checksum stage; value below is from v3.8.9.
sha256sums=('85b5e4f75184468a4c4f043b2ec772e2d6715e89a6c9d3196f02e39dc1a977bb')

_backports=(
)

_reverts=(
)

prepare() {
  # extract licenses
  # NOTE: some license files are missing: https://github.com/libarchive/libarchive/issues/2385
  sed -n '43,65p' $pkgname/COPYING > BSD-2-Clause.txt
  sed -n '33,62p' $pkgname/$pkgname/archive_read_support_filter_compress.c > BSD-4-Clause-UC.txt

  cd "${pkgname}"

  local _c _l
  for _c in "${_backports[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git log --oneline "${_l}" "${_c}"
    git cherry-pick --mainline 1 --no-commit "${_c}"
  done
  for _c in "${_reverts[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git log --oneline "${_l}" "${_c}"
    git revert --mainline 1 --no-commit "${_c}"
  done

  autoreconf -fiv
}

build() {
  cd "${pkgname}"

  ./configure \
      --prefix=/usr \
      --without-nettle \
      --disable-static
  make
}

check() {
  cd "${pkgname}"

  make check
}

package() {
  depends+=(
    'libacl.so'
    'libbz2.so'
    'libxml2.so'
    'libcrypto.so'
    'liblzma.so'
    'libz.so'
    'libzstd.so')

  make DESTDIR="$pkgdir" install -C "$pkgname"
  _verify_soname "$pkgdir/usr/lib/libarchive.so" libarchive.so.13 || return 1
  install -vDm 644 ./*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
