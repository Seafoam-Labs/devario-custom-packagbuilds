# Maintainer: Devario maintainers
# Pure-Python upstream wheel bootstraps setuptools' own runtime dependencies.
pkgname=python-jaraco.functools
pkgver=4.6.0
pkgrel=1
pkgdesc='Python jaraco.functools library (build-tool bootstrap)'
arch=(any)
url='https://pypi.org/project/jaraco.functools/'
license=('MIT')
depends=('python>=3.12' 'python-more-itertools')
makedepends=('python-installer')
source=('https://files.pythonhosted.org/packages/02/36/ecc85bc96c273dc8a11273ed4782272975e6338d4a3e9228621175edf0e3/jaraco_functools-4.6.0-py3-none-any.whl')
noextract=('jaraco_functools-4.6.0-py3-none-any.whl')
sha256sums=('99e3dc0060c5cbe8fcd1cdb36258e2a65ca40f1566b2033b12abb1bb44dd3c30')

package() {
  python -m installer --destdir="$pkgdir" "$srcdir/jaraco_functools-4.6.0-py3-none-any.whl"
  local site_packages
  site_packages="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  install -Dm644 "$pkgdir$site_packages/jaraco_functools-4.6.0.dist-info/licenses/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
