# Devario Core: pre-built mistral.rs CPU inference engine.
# Provides the `mistralrs` binary used by Pearl's launcher assistant.
# GPU users: install a CUDA variant from upstream releases or build from
# source with `cargo install mistralrs --features cuda`.
pkgname=mistralrs
pkgver=0.9.5
pkgrel=1
pkgdesc='Fast, flexible LLM inference engine (pre-built CPU binary)'
arch=('x86_64')
url='https://github.com/EricLBuehler/mistral.rs'
license=('MIT')
depends=('glibc' 'libgcc')
optdepends=('cuda: NVIDIA GPU acceleration (requires CUDA-enabled build)'
            'vulkan-icd-loader: Vulkan GPU acceleration (requires source build)')
provides=('mistralrs')
conflicts=('mistralrs-git')
options=('!strip' '!debug')
source=("https://github.com/EricLBuehler/mistral.rs/releases/download/v$pkgver/mistralrs-cpu-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('9b542da90b6541abd599ff275e3246fa6e144885bdcd67d1f0aefdba1729f7b5')

package() {
    install -Dm755 "$srcdir/mistralrs" "$pkgdir/usr/bin/mistralrs"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
