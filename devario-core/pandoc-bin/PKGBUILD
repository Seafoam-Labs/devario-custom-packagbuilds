# Official upstream binary for documentation-tool bootstrapping.
pkgname=pandoc-bin
pkgver=3.12
pkgrel=1
pkgdesc='Universal document converter (official upstream binary)'
arch=('x86_64')
url='https://pandoc.org'
license=('GPL-2.0-or-later')
depends=('glibc' 'zlib')
provides=("pandoc=$pkgver" "pandoc-cli=$pkgver")
conflicts=('pandoc' 'pandoc-cli')
options=('!strip' '!debug')
source=('https://github.com/jgm/pandoc/releases/download/3.11/pandoc-3.11-linux-amd64.tar.gz')
sha256sums=('37edb3bbcf722f921a009941bf5874e2e0c09263226c9b4a2d980788cb062ab6')

package() {
  install -Dm755 "pandoc-$pkgver/bin/pandoc" "$pkgdir/usr/bin/pandoc"
  install -Dm644 "pandoc-$pkgver/share/man/man1/pandoc.1.gz" "$pkgdir/usr/share/man/man1/pandoc.1.gz"
}
