# Contributor: Allan McRae <allan@archlinux.org>
# Contributor: judd <jvinet@zeroflux.org>

pkgname=sed
pkgver=4.10
pkgrel=3
pkgdesc='GNU stream editor'
arch=('x86_64')
url='https://www.gnu.org/software/sed/'
license=('GPL-3.0-or-later')
depends=('glibc' 'acl' 'attr')
makedepends=('gettext')
checkdepends=('glibc-locales')
validpgpkeys=('155D3FC500C834486D1EEA677FD9FCCB000BEEEE') # Jim Meyering <meyering@meta.com>
# Savannah 500s while packing sed.git (job 5327) and no mirror carries the signed v4.10 tag,
# so build the release tarball instead: same tagger key, generated configure (no bootstrap and
# no unpinned gnulib HEAD), and po/ already holds the stable translations upstream's msgfmt
# loop existed to copy out of it.
source=("https://ftp.gnu.org/gnu/sed/sed-${pkgver}.tar.gz"{,.sig})
sha256sums=('4d179ffaf92ec4dcec541f7c032be1c3b9a1856f4970adb95a505221702f5277'
            'SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}

