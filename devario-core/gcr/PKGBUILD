# Contributor: Ionut Biru <ibiru@archlinux.org>

pkgbase=gcr
pkgname=(
  gcr
  gcr-docs
)
pkgver=3.41.2
pkgrel=3
pkgdesc="A library for bits of crypto UI and parsing"
url="https://gitlab.gnome.org/GNOME/gcr"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgcrypt
  libp11-kit
  libsecret
  openssh
  pango
)
makedepends=(
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  libxslt
  meson
  vala
)
source=("git+https://gitlab.gnome.org/GNOME/gcr.git?signed#tag=$pkgver")
b2sums=('8fee923174d0b350a924994d6fada63c2deac46859f62b09cd7adca971ab47ae4c5f82b69a03e203254da695f46f05457c9a081923010e1437dec035d28f07ed')
validpgpkeys=(
  EF3226243ABEFC1A828BC5B46A2AC2B52126D946 # Dhanuka Warusadura <dhanuka@gnome.org>
  A7C626E13F9AD776776BD9CA1D8A57CF2E8D36A3 # Niels De Graef (nielsdg) <nielsdegraef@gmail.com>
)

prepare() {
  cd gcr
}

build() {
  local meson_options=(
    # ssh-agent moved to gcr-4
    -D ssh_agent=false
  )

  arch-meson gcr build "${meson_options[@]}"
  meson compile -C build
}

check() {
  # Secure memory tests fail
  dbus-run-session meson test -C build --print-errorlogs || :
}

package_gcr() {
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    libgck-1.so
    libgck-1.so=0-64
    libgcr-base-3.so
    libgcr-base-3.so=1-64
    libgcr-ui-3.so
    libgcr-ui-3.so=1-64
  )
  install=gcr.install

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libgck-1.so" libgck-1.so.0 || return 1
  _verify_soname "$pkgdir/usr/lib/libgcr-base-3.so" libgcr-base-3.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libgcr-ui-3.so" libgcr-ui-3.so.1 || return 1

  mkdir -p doc/usr/share
  mv {"$pkgdir",doc}/usr/share/doc
}

package_gcr-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv doc/* "$pkgdir"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

