+/// Activate the session VT without resetting its mode; logind owns VT_PROCESS
+/// for controlled graphical sessions, and VT_AUTO + KD_GRAPHICS traps switches.
+fn switch_vt(vt: usize) -> Result<(), Error> {
+    let term = Terminal::open("/dev/tty0").map_err(|e| Error::Error(format!("open tty0: {}", e)))?;
+    term.vt_activate(vt)
