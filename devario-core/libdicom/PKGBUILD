# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=libdicom
pkgver=1.3.0
pkgrel=1
pkgdesc='C library and tools for reading DICOM data sets'
arch=(x86_64)
url='https://github.com/ImagingDataCommons/libdicom'
license=(MIT)
# Arch's recipe declares no provision for this library; name both SONAME forms
# per this tree's ABI convention (meson version 1.3.0 yields SONAME libdicom.so.1).
provides=(
  libdicom.so
  'libdicom.so=1-64'
)
makedepends=(git meson uthash)
checkdepends=(check)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('918aa014e91ebbaad96e5961bacd0237cccba68bfaf8dbb568cd833d5ef8ea60cbe271a4c2b418885997489840cfd2d41531ce3c6a2e46831cb0defdb7018be5')
b2sums=('98f31b5d672c73b65faa849ad64d3ca55b8b12e7dbe1a390ab78e4eec5bb5676178226462bd411884bc5fad13f81a9ec60f4f6d42d295c5c2ba63a15d322e2d1')

build() {
  arch-meson build "$pkgname"
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  depends+=(glibc)

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libdicom.so" libdicom.so.1 || return 1

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/LICENSE"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
