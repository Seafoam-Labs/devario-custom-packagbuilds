# Maintainer: Devario maintainers
# Based on Arch packaging for gumbo-parser 0.13.2-1:
# https://gitlab.archlinux.org/archlinux/packaging/packages/gumbo-parser
# Upstream maintainers: Balló György and Carl Smedstad

pkgname=gumbo-parser
pkgver=0.14.1
pkgrel=1
pkgdesc='HTML5 parsing library in pure C99'
arch=(x86_64)
url='https://codeberg.org/gumbo-parser/gumbo-parser/'
license=(Apache-2.0)
depends=(glibc)
makedepends=(autoconf automake libtool)
checkdepends=(gtest)
provides=('libgumbo.so=4-64')
source=("$pkgname-$pkgver.tar.gz::${url}archive/$pkgver.tar.gz")
sha256sums=('ba5d13b9b508ec693613b3b61518163aced38f8e885f7e28dc047348a4e61365')

prepare() {
  cd "$srcdir/$pkgname"
  ./autogen.sh
}

build() {
  cd "$srcdir/$pkgname"
  ./configure --prefix=/usr --disable-static
  make
}

check() {
  cd "$srcdir/$pkgname"
  make check
}

package() {
  cd "$srcdir/$pkgname"
  make DESTDIR="$pkgdir" install
  # Shelly preserves explicit ABI provisions; reject an unexpected library.
  LC_ALL=C readelf -h "$pkgdir/usr/lib/libgumbo.so" | grep -E 'Class:[[:space:]]+ELF64' >/dev/null || return 1
  LC_ALL=C readelf -d "$pkgdir/usr/lib/libgumbo.so" | grep -F 'Library soname: [libgumbo.so.4]' >/dev/null || return 1
}
