# Maintainer: Devario maintainers
pkgname=python-rpds-py
pkgver=2026.11.1
pkgrel=1
pkgdesc='Python bindings for Rust persistent data structures'
arch=(x86_64)
url='https://github.com/crate-py/rpds'
license=('MIT')
depends=('python>=3.11' 'gcc-libs' 'glibc')
makedepends=('rust>=1.85' 'maturin>=1.9' 'maturin<2.0' 'python-installer')
# Upstream release tag v2026.11.1 of https://github.com/crate-py/rpds.git,
# as a source archive. The archive unpacks to rpds-<version> (the tag's 'v'
# prefix is dropped by the archive), so the directory is matched with a glob.
source=("https://github.com/crate-py/rpds/archive/refs/tags/v2026.11.1.tar.gz")
sha256sums=('7bc144d53398a21ec8863bc0a70e7179cdb60f59859e27198a75aa1a9808c942')

prepare() {
  cd "$srcdir"/rpds-*
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
}

build() {
  cd "$srcdir"/rpds-*
  export CARGO_HOME="$srcdir/cargo-home"
  maturin build --release --frozen --strip --interpreter python --out dist
}

package() {
  cd "$srcdir"/rpds-*
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
