# Maintainer: Devario maintainers
pkgname=python-rpds-py
pkgver=2026.9.1
pkgrel=1
pkgdesc='Python bindings for Rust persistent data structures'
arch=(x86_64)
url='https://github.com/crate-py/rpds'
license=('MIT')
depends=('python>=3.11' 'gcc-libs' 'glibc')
makedepends=('rust>=1.85' 'maturin>=1.9' 'maturin<2.0' 'python-installer')
source=('https://files.pythonhosted.org/packages/42/68/3bd46b8a5e01d3c2ebdf9c5e9497912e3fe0cde02bac21a7130ca866e403/rpds_py-2026.9.1.tar.gz')
sha256sums=('4793ef7f78268b124b73fa933440f01d258bbae01de9fa53e9080c9ab0425a12')

prepare() {
  cd "rpds_py-2026.9.1"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
}

build() {
  cd "rpds_py-2026.9.1"
  export CARGO_HOME="$srcdir/cargo-home"
  maturin build --release --frozen --strip --interpreter python --out dist
}

package() {
  cd "rpds_py-2026.9.1"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
