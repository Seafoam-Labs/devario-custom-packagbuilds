# Contributor: Massimiliano Torromeo <massimiliano.torromeo@gmail.com>
# Contributor: Kovivchak Evgen <oneonfire@gmail.com>

pkgname=jemalloc
epoch=1
pkgver=5.4.0
pkgrel=2
pkgdesc='General-purpose scalable concurrent malloc implementation'
arch=('x86_64')
license=('BSD-2-Clause')
url='https://jemalloc.net/'
depends=('glibc' 'libgcc' 'libgcc_s.so=1-64' 'libstdc++' 'libstdc++.so=6-64')
optdepends=('perl: for jeprof')
makedepends=('git')
provides=('libjemalloc.so' 'libjemalloc.so=2-64')
source=("git+https://github.com/jemalloc/jemalloc.git#tag=${pkgver}")
sha256sums=('1013d73abb1820cd7c7a24b2270414c09f663474bdeb1c86c36a200f4f950ad6')

prepare() {
  cd "${pkgname}"

  autoreconf -fi
}

build() {
  cd "${pkgname}"

  ./configure \
    --enable-prof \
    --enable-autogen \
    --disable-static \
    --prefix=/usr
  make
}

check() {
  make -C "${pkgname}" check
}

package() {
  cd "${pkgname}"

  make DESTDIR="${pkgdir}" install
  _verify_soname "${pkgdir}/usr/lib/libjemalloc.so" libjemalloc.so.2 || return 1

  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
