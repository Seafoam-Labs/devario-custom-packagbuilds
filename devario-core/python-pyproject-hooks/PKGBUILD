# Maintainer: Devario maintainers
# Pure-Python upstream wheel bootstraps setuptools' own runtime dependencies.
pkgname=python-pyproject-hooks
pkgver=1.3.3
pkgrel=1
pkgdesc='Python pyproject-hooks library (build-tool bootstrap)'
arch=(any)
url='https://pypi.org/project/pyproject-hooks/'
license=('MIT')
depends=('python>=3.12' )
makedepends=('python-installer')
source=('https://files.pythonhosted.org/packages/85/11/044d1ae1b4ec0d7af88ee5bc91e081be1022533032b906a7bdabdbb60977/pyproject_hooks-1.3.3-py3-none-any.whl')
noextract=('pyproject_hooks-1.3.3-py3-none-any.whl')
sha256sums=('5fc53fdac9f7bd63fbcdc868fb5f90b4784d78a53a3d3388cd738b807441a20b')

package() {
  python -m installer --destdir="$pkgdir" "$srcdir/pyproject_hooks-1.3.3-py3-none-any.whl"
  local site_packages
  site_packages="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  install -Dm644 "$pkgdir$site_packages/pyproject_hooks-1.3.3.dist-info/licenses/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
