# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Contributor: Eric Bélanger <eric@archlinux.org>

pkgname=mpg123
pkgver=1.33.7
pkgrel=2
pkgdesc='Console based real time MPEG Audio Player for Layer 1, 2 and 3'
url='https://mpg123.de/'
arch=('x86_64')
license=('LGPL-2.1-only')
depends=('alsa-lib' 'glibc')
makedepends=('jack' 'libpulse' 'sdl2-compat')
optdepends=(
  'sdl2-compat: for sdl audio support'
  'jack: for jack audio support'
  'libpulse: for pulse audio support'
  'perl: for conplay'
)
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  libmpg123.so
  'libmpg123.so=0-64'
  libout123.so
  'libout123.so=0-64'
  libsyn123.so
  'libsyn123.so=0-64'
)
source=(https://downloads.sourceforge.net/sourceforge/mpg123/mpg123-${pkgver}.tar.bz2{,.sig})
sha512sums=('694743802bb7be0f4a39bf62e681ae0bfed769cb87dc6c5b6fb5f9245966631efb5c5b9bd58588f7af55ced5d020f97c8a54993e71b5295bc45ebd152473f40e'
            'SKIP')
validpgpkeys=('D021FF8ECF4BE09719D61A27231C4CBC60D5CAFE')

build() {
  cd mpg123-${pkgver}
  ./configure \
    --prefix=/usr \
    --enable-int-quality \
    --with-audio="alsa oss sdl jack pulse"
  # https://bugzilla.gnome.org/show_bug.cgi?id=655517
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd mpg123-${pkgver}
  make DESTDIR="${pkgdir}" install
  _verify_soname "${pkgdir}/usr/lib/libmpg123.so" libmpg123.so.0 || return 1
  _verify_soname "${pkgdir}/usr/lib/libout123.so" libout123.so.0 || return 1
  _verify_soname "${pkgdir}/usr/lib/libsyn123.so" libsyn123.so.0 || return 1
  install -Dm 755 scripts/conplay -t "${pkgdir}/usr/bin"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

