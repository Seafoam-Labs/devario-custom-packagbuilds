pkgbase=json-glib
pkgname=(json-glib json-glib-docs)
pkgver=1.10.8
pkgrel=2
pkgdesc="JSON library built on GLib"
url="https://gnome.pages.gitlab.gnome.org/json-glib/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=('glib2>=2.72.0' glibc)
makedepends=(
  docbook-xsl
  gettext
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  meson
  ninja
  pkgconf
  python-docutils
)
source=("git+https://gitlab.gnome.org/GNOME/json-glib.git?signed#tag=$pkgver")
b2sums=('fddbe1c61075a56c58d82338423f051653623c124cb0898d50711a13aaae510e5b98874849defe420494e795e453fb9018feec768a2bb928c27caefadcc26739')
validpgpkeys=(
  53EF3DC3B63E2899271BD26322E8091EEA11BBB7 # Emmanuele Bassi <ebassi@gnome.org>
)

build() {
  arch-meson json-glib build -D installed_tests=false -D man=true
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_json-glib() {
  depends+=(
    'libglib-2.0.so=0-64'
    'libgobject-2.0.so=0-64'
    'libgio-2.0.so=0-64'
  )
  provides=('libjson-glib-1.0.so=0-64')

  meson install -C build --no-rebuild --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libjson-glib-1.0.so" libjson-glib-1.0.so.0

  mkdir -p "$srcdir/doc/usr/share"
  mv "$pkgdir/usr/share/doc" "$srcdir/doc/usr/share/"
}

package_json-glib-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  mv "$srcdir/doc/"* "$pkgdir"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
