pkgbase=wayland
pkgname=(wayland wayland-docs)
pkgver=1.26.0
pkgrel=2
pkgdesc='A computer display server protocol'
arch=('x86_64')
url='https://wayland.freedesktop.org/'
license=('MIT')
depends=('glibc' 'libffi' 'expat' 'libxml2' 'default-cursors')
makedepends=('meson' 'libxslt' 'doxygen' 'xmlto' 'graphviz' 'docbook-xsl' 'mdbook')
validpgpkeys=('C7223EBE4EF66513B892598911A30156E0E67611'  # Bryce Harrington
              'C0066D7DB8E9AC6844D728715E54498E697F11D7'  # Derek Foreman
              '34FF9526CFEF0E97A340E2E40FDE7BE0E88F5E48') # emersion <contact@emersion.fr>
source=("https://gitlab.freedesktop.org/wayland/wayland/-/releases/$pkgver/downloads/wayland-$pkgver.tar.xz"{,.sig})
sha256sums=('64176eaa46e4969903e286f8e5ef8331affc17fdf03ac9b58381d2b23162b7a3'
            'SKIP')

build() {
  arch-meson $pkgbase-$pkgver build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_wayland() {
  provides=(
    libwayland-client.so 'libwayland-client.so=0-64'
    libwayland-cursor.so 'libwayland-cursor.so=0-64'
    libwayland-egl.so 'libwayland-egl.so=1-64'
    libwayland-server.so 'libwayland-server.so=0-64'
  )

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libwayland-client.so" libwayland-client.so.0 || return 1
  _verify_soname "$pkgdir/usr/lib/libwayland-cursor.so" libwayland-cursor.so.0 || return 1
  _verify_soname "$pkgdir/usr/lib/libwayland-egl.so" libwayland-egl.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libwayland-server.so" libwayland-server.so.0 || return 1
  mkdir -p docs/share
  mv "$pkgdir"/usr/share/{doc,man} docs/share
  install -Dm 644 $pkgbase-$pkgver/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

package_wayland-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv docs "$pkgdir/usr"
  install -Dm 644 $pkgbase-$pkgver/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

# vim:set sw=2 sts=-1 et:

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
