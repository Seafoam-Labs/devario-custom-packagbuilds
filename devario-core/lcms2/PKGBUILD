# Adapted for Devario: preserve explicit library ABIs for Shelly.
# Arch packaging commit: 4c1b2ecc48244412625c8efd1f809c339c8630f8
# Maintainer: Eric Bélanger <eric@archlinux.org>

pkgname=lcms2
pkgver=2.19.1
pkgrel=2
pkgdesc='Small-footprint color management engine, version 2'
arch=('x86_64')
url='http://www.littlecms.com/'
license=('MIT')
depends=('glibc' 'libjpeg-turbo' 'libtiff')
provides=('liblcms2.so' 'liblcms2.so=2-64')
source=("https://github.com/mm2/Little-CMS/releases/download/lcms${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('bfc54f7bab59fbc921012014a8032e4cba4abd46db47d46b76416a8c0b2815c8')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr
  make
}

check() {
  cd "${pkgname}-${pkgver}"

  make check
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  _verify_soname "$pkgdir/usr/lib/liblcms2.so" liblcms2.so.2 || return 1
  install -D -m0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
