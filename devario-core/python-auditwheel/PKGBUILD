_pkgname=auditwheel
pkgname=python-$_pkgname
pkgver=6.8.2
pkgrel=1
pkgdesc='Auditing and relabeling cross-distribution Linux wheels'
arch=('any')
url='https://github.com/pypa/auditwheel'
license=('MIT' 'BSD')
depends=('python>=3.10' 'python-wheel' 'python-packaging>=20.9' 'python-pyelftools>=0.24' 'unzip' 'patchelf>=0.14.5')
makedepends=('python-build' 'python-installer' 'python-setuptools>=61' 'python-setuptools-scm>=8' 'python-wheel')
#checkdepends=('python-pytest>=3.4' 'python-jsonschema' 'python-pretend' 'python-docker')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha512sums=('0e9b38926e8828dc9f48726ea1fcae5b80f76de96838d503ca2e6f8f9136717d9f1a3643917462971e90b5ef2e9d6fc4fca6d34a33a04456ce78b8698f2a5c3b')

build() {
  cd $_pkgname-$pkgver

  SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver python -m build -nw
}

#check() {
#  cd $_pkgname-$pkgver
#
#  python -m venv --system-site-packages test
#  test/bin/python -m installer dist/*.whl
#
#  PATH="test/bin:$PATH" python -m pytest
#}

package() {
  cd $_pkgname-$pkgver

  python -m installer -d "$pkgdir" dist/*.whl
  #install -Dm 644 auditwheel/policy/policy.json "$pkgdir"/usr/lib/python3.10/site-packages/auditwheel/policy/policy.json

  install -Dm 644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

