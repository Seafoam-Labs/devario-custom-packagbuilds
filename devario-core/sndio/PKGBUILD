# Contributor: T.J. Townsend <blakkheim@archlinux.org>
# Contributor: Ivy Foster <iff@archlinux.org>

pkgname=sndio
pkgver=1.10.0
pkgrel=2
pkgdesc='A small audio and MIDI framework'
arch=('x86_64')
url='https://sndio.org'
license=('ISC')
depends=(
    'alsa-lib'
    'glibc'
    'libbsd')
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
    'libsndio.so'
    'libsndio.so=7-64')
backup=('etc/default/sndiod')
source=("https://sndio.org/sndio-${pkgver}.tar.gz"{,.asc})
sha256sums=('bebd3bfd01c50c9376cf3e7814b9379bed9e17d0393b5113b7eb7a3d0d038c54'
            'SKIP')
validpgpkeys=('6B1A7447AAF091CCDD36BAA6015E339411694A6E') # Alexandre Ratchov <alex@caoua.org>

build() {
    cd "sndio-${pkgver}"
    ./configure --prefix='/usr' --enable-alsa --with-libbsd
    make
}

package() {
    make -C "sndio-${pkgver}" DESTDIR="$pkgdir" install
    _verify_soname "${pkgdir}/usr/lib/libsndio.so" libsndio.so.7 || return 1
    install -D -m644 "sndio-${pkgver}/contrib/sndiod.service" -t "${pkgdir}/usr/lib/systemd/system"
    install -D -m644 "sndio-${pkgver}/contrib/default.sndiod" "${pkgdir}/etc/default/sndiod"
    install -D -m644 "sndio-${pkgver}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
