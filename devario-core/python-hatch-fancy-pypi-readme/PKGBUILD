# Maintainer: Devario maintainers
pkgname=python-hatch-fancy-pypi-readme
pkgver=25.1.0
pkgrel=1
pkgdesc='Hatch plugin for building PyPI readme metadata'
arch=(any)
url='https://github.com/hynek/hatch-fancy-pypi-readme'
license=('MIT')
depends=('python' 'python-hatchling')
makedepends=('python-build' 'python-installer')
source=('https://files.pythonhosted.org/packages/f3/0f/aed57c301f339936eb91cb4d8c1e5088a101081854bd3ec18a889df32365/hatch_fancy_pypi_readme-25.1.0.tar.gz')
sha256sums=('9c58ed3dff90d51f43414ce37009ad1d5b0f08ffc9fc216998a06380f01c0045')

build() {
  cd "hatch_fancy_pypi_readme-25.1.0"
  python -m build --wheel --no-isolation
}

package() {
  cd "hatch_fancy_pypi_readme-25.1.0"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
