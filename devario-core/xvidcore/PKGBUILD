pkgname=xvidcore
pkgver=1.3.7
pkgrel=5
pkgdesc='XviD is an open source MPEG-4 video codec'
arch=(x86_64)
url=https://www.xvid.com/
license=(GPL-2.0-only)
depends=(glibc)
makedepends=(nasm)
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  libxvidcore.so
  'libxvidcore.so=4-64'
)
source=(https://downloads.xvid.com/downloads/xvidcore-${pkgver}.tar.gz)
b2sums=('26b2dce1456fd49a5afb4d2edc718c70b86240843e267cae4d267e6dd38ee37b6f6beabbb8bb3f7e2237a1ac6d2d34f2431df50c98a785fa4a45f591f021ac24')

prepare() {
  cd xvidcore/build/generic
  autoreconf -fiv
}

build() {
  export CFLAGS+=' -std=gnu17'
  cd xvidcore/build/generic
  ./configure \
    --prefix=/usr
  make
}

package() {
  cd xvidcore/build/generic
  make DESTDIR="${pkgdir}" install
  _verify_soname "${pkgdir}/usr/lib/libxvidcore.so" libxvidcore.so.4 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
