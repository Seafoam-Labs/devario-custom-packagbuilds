pkgname=vulkan-tools
pkgver=1.4.363.0
pkgrel=1
pkgdesc='Vulkan information and demonstration tools'
arch=('x86_64')
url='https://github.com/KhronosGroup/Vulkan-Tools'
license=('Apache-2.0')
depends=('glibc' 'libgcc' 'libstdc++' 'libx11' 'libxcb' 'vulkan-icd-loader' 'wayland')
makedepends=(
  'cmake'
  'glslang'
  'libxrandr'
  'ninja'
  'python'
  'vulkan-headers>=1.4.363'
  'wayland-protocols'
)
groups=('vulkan-devel')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/vulkan-sdk-${pkgver}.tar.gz")
sha256sums=('6cbeb83294434e636a0c78760f1a6dfe3e50c1bab0cffa154603ce73e70508f1')

build() {
  cmake -S "$srcdir/Vulkan-Tools-vulkan-sdk-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_SKIP_INSTALL_RPATH=ON \
    -DUPDATE_DEPS=OFF \
    -DBUILD_ICD=OFF \
    -DBUILD_WSI_XCB_SUPPORT=ON \
    -DBUILD_WSI_XLIB_SUPPORT=ON \
    -DBUILD_WSI_WAYLAND_SUPPORT=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/Vulkan-Tools-vulkan-sdk-$pkgver/LICENSE.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
