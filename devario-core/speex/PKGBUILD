# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jason Chu <jason@archlinux.org>

pkgname=speex
pkgver=1.2.1
pkgrel=4
pkgdesc="A free codec for free speech"
url="https://www.speex.org/"
arch=(x86_64)
license=(BSD-3-Clause)
depends=(
  glibc
  libogg
  speexdsp
)
makedepends=(git)
source=("git+https://gitlab.xiph.org/xiph/speex.git#tag=Speex-$pkgver")
b2sums=('62dbca5623ba37a92366d2ed19c3ae2dbce4620ac38d6d011def049541271319b9ca119ecbce315fe8f6289d5b79a3c6da4d4434cac4ed6b82b40393f6807a0e')

prepare() {
  cd speex
  ./autogen.sh
}

build() {
  cd speex
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    --enable-binaries \
    --disable-static
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd speex
  make -k check
}

package() {
  depends+=(
    'libogg.so=0-64'
    'libspeexdsp.so=1-64'
  )
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides+=(
    libspeex.so
    'libspeex.so=1-64'
  )

  cd speex
  make DESTDIR="$pkgdir" install
  _verify_soname "$pkgdir/usr/lib/libspeex.so" libspeex.so.1 || return 1
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 COPYING
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

