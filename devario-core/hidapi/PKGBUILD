pkgname=hidapi
pkgver=0.15.0
pkgrel=2
pkgdesc='Simple library for communicating with USB and Bluetooth HID devices'
arch=(x86_64)
url='https://github.com/libusb/hidapi'
license=('GPL3' 'BSD' 'custom')
depends=('systemd-libs')
optdepends=('libusb: for hidapi-libusb')
makedepends=('cmake' 'libusb')
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  'libhidapi-hidraw.so'
  'libhidapi-hidraw.so=0-64'
  'libhidapi-libusb.so'
  'libhidapi-libusb.so=0-64'
)
source=("https://github.com/libusb/${pkgname}/archive/${pkgname}-${pkgver}.tar.gz")
sha512sums=('a4ddd13a80a84956872fa52aa861b40e4959f301d8d91afe0feaf9dbd87394561e1fdd20cbf8cf47200845f80a8db8a934bc2e3025fe6f16435e37c17621e7b6')

build() {
  cmake -B build -S ${pkgname}-${pkgname}-${pkgver} -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm0644 ${pkgname}-${pkgname}-${pkgver}/LICENSE*.txt -t "${pkgdir}/usr/share/licenses/${pkgname}/"
  _verify_soname "${pkgdir}/usr/lib/libhidapi-hidraw.so" libhidapi-hidraw.so.0 || return 1
  _verify_soname "${pkgdir}/usr/lib/libhidapi-libusb.so" libhidapi-libusb.so.0 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
