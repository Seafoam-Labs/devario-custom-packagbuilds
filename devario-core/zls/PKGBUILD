# Build ZLS with the matching Zig release series.
pkgname=zls
pkgver=0.17.0
pkgrel=1
pkgdesc='Zig language server for Zig 0.17'
arch=('x86_64')
url='https://zigtools.org/zls/'
license=('MIT')
depends=('zig=0.17.0')
conflicts=('zls-0.16')
options=('!lto')
source=(
  "zls-${pkgver}.tar.gz::https://github.com/zigtools/zls/archive/refs/tags/${pkgver}.tar.gz"
  "zls-${pkgver}-known_folders.tar.gz::https://github.com/ziglibs/known-folders/archive/6da0d0c41b78b9ed2d34fa364fcb81b5ebece6c4.tar.gz"
  "zls-${pkgver}-diffz.tar.gz::https://github.com/ziglibs/diffz/archive/aac8aa99c436ab8277b0711922aad062c0167b12.tar.gz"
  "zls-${pkgver}-lsp_kit.tar.gz::https://github.com/zigtools/lsp-kit/archive/3e1058db66079911fdde82f833fdce6856e0a706.tar.gz"
)
noextract=(
  "zls-${pkgver}-known_folders.tar.gz"
  "zls-${pkgver}-diffz.tar.gz"
  "zls-${pkgver}-lsp_kit.tar.gz"
)
sha256sums=(
  'f77940720768daf67c01802ea3cf3029dfd8a74afd7b68b39676c4f814dd992e'
  '194aaa7566f3d9b4e893e3e53ef46ce880d4fc3631535ccea05405f558070f39'
  '33036e596176426449617975113eeddf513c991f42e10df855ccfb0e6f103fae'
  '06dab48dad0dd5770bdcaa64fe13b386e479a67dc81899005d04f48897ec2003'
)

prepare() {
  # --system resolves dependencies by the hashes from upstream build.zig.zon.
  # Source archives are checked by Shelly before extraction.
  install -d "${srcdir}/zig-deps/known_folders-0.0.0-Fy-PJiDLAAB98m3uYUzatrTb2mO2fpvwx2zpSroEtfbO"
  tar -xf "${srcdir}/zls-${pkgver}-known_folders.tar.gz" --strip-components=1 \
    -C "${srcdir}/zig-deps/known_folders-0.0.0-Fy-PJiDLAAB98m3uYUzatrTb2mO2fpvwx2zpSroEtfbO"
  install -d "${srcdir}/zig-deps/diffz-0.0.1-G2tlISvOAQDORzPTSxDgiKwlHuADKeJMdJrw4kRfLufj"
  tar -xf "${srcdir}/zls-${pkgver}-diffz.tar.gz" --strip-components=1 \
    -C "${srcdir}/zig-deps/diffz-0.0.1-G2tlISvOAQDORzPTSxDgiKwlHuADKeJMdJrw4kRfLufj"
  install -d "${srcdir}/zig-deps/lsp_kit-0.1.0-bi_PL9o2DADHS1PDra3MGz1MXnsboN_ewNvrc419z7Fb"
  tar -xf "${srcdir}/zls-${pkgver}-lsp_kit.tar.gz" --strip-components=1 \
    -C "${srcdir}/zig-deps/lsp_kit-0.1.0-bi_PL9o2DADHS1PDra3MGz1MXnsboN_ewNvrc419z7Fb"
}

build() {
  cd "zls-${pkgver}"
  export ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-global-cache"

  zig build --system "${srcdir}/zig-deps" --prefix "${srcdir}/zls-install" \
    -Doptimize=ReleaseSafe -Dcpu=baseline -Dpie=true
}

check() {
  cd "zls-${pkgver}"
  export ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-global-cache"

  zig build test --system "${srcdir}/zig-deps" -Doptimize=ReleaseSafe -Dcpu=baseline -Dpie=true
  "${srcdir}/zls-install/bin/zls" --version
}

package() {
  cd "zls-${pkgver}"

  install -Dm755 "${srcdir}/zls-install/bin/zls" "${pkgdir}/usr/bin/zls"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 schema.json "${pkgdir}/usr/share/zls/schema.json"
}
