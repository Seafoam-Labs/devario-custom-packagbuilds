# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=egl-wayland2
pkgver=1.0.2
pkgrel=2
pkgdesc="EGLStream-based Wayland external platform (2)"
url="https://github.com/NVIDIA/egl-wayland2"
arch=(x86_64)
license=(Apache-2.0)
depends=(
  eglexternalplatform
  mesa
  glibc
  libdrm
  wayland
)
makedepends=(
  git
  'libglvnd>=1.3.4'
  meson
  wayland-protocols
)
provides=(libnvidia-egl-wayland2.so 'libnvidia-egl-wayland2.so=1-64')
# Upstream tracks this repo's HEAD, which would rebuild 1.0.2-1 from whatever HEAD is.
source=("git+$url#tag=v$pkgver")
b2sums=('SKIP')

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libnvidia-egl-wayland2.so" libnvidia-egl-wayland2.so.1 || return 1
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgname/LICENSE
}

# vim:set sw=2 sts=-1 et:

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
