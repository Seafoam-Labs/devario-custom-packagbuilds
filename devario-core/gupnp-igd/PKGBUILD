# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Eric Bélanger <eric@archlinux.org>

pkgname=gupnp-igd
pkgver=1.6.0
pkgrel=3
pkgdesc="Library to handle UPnP IGD port mapping"
url="https://wiki.gnome.org/Projects/GUPnP"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glibc
  gupnp
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
)
source=("git+https://gitlab.gnome.org/GNOME/gupnp-igd.git#tag=$pkgver")
b2sums=('cd630573188d5b683628b4322bf0ef28580b4746fb07b8a3ad1830b25e133dae5e31f33624cba85fe68aeadb371e51b0063c7f61bd2b2b3fbdbd36396dbeced1')

prepare() {
  cd $pkgname
}

build() {
  local meson_options=(
    -D gtk_doc=true
  )

  arch-meson $pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  # No multicast in our containers?
  meson test -C build --print-errorlogs || :
}

package() {
  # Pinned: glib2 publishes these; gupnp and gssdp publish their pins in this batch.
  depends+=(
    libg{lib,object,io}-2.0.so=0-64
    libg{ssdp,upnp}-1.6.so=0-64
  )
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    libgupnp-igd-1.6.so
    libgupnp-igd-1.6.so=0-64
  )

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libgupnp-igd-1.6.so" libgupnp-igd-1.6.so.0 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

