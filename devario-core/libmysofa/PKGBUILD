# Adapted for Devario: advertise versioned SONAME provisions beside Shelly's bare ones.
# Packaging source: https://gitlab.archlinux.org/archlinux/packaging/packages/libmysofa/-/commit/e7b688903f89e671b49e4d6b1ab26e2cc68ce88f
# Maintainer: Daniel Bermond <dbermond@archlinux.org>

pkgname=libmysofa
pkgver=1.3.5
pkgrel=2
pkgdesc='C library to read HRTFs if they are stored in the AES69-2015 SOFA format'
arch=('x86_64')
url='https://github.com/hoene/libmysofa/'
license=('BSD-3-Clause')
depends=(
    'glibc'
    'zlib')
makedepends=(
    'cmake'
    'cunit'
    'git')
checkdepends=(
    'nodejs')
provides=('libmysofa.so' 'libmysofa.so=1-64')
source=("git+https://github.com/hoene/libmysofa.git#tag=v${pkgver}")
sha256sums=('c7590e8100409efc6fec52fdec7dbcd7add56fa4cde403a39be72219b284d9fa')

build() {
    cmake \
        -G 'Unix Makefiles' \
        -B libmysofa/build \
        -S libmysofa \
        -DCMAKE_BUILD_TYPE:STRING='None' \
        -DCMAKE_INSTALL_PREFIX:PATH='/usr' \
        -DCODE_COVERAGE:BOOL='OFF' \
        -Wno-author
    cmake --build libmysofa/build
}

check() {
    ctest --test-dir libmysofa/build --output-on-failure --stop-on-failure
}

package() {
    DESTDIR="${pkgdir}" cmake --install libmysofa/build
    _verify_soname "${pkgdir}/usr/lib/libmysofa.so" libmysofa.so.1 || return 1
    install -D -m644 libmysofa/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
