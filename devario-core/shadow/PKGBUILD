# Custom unprivileged-build variant of Arch shadow (see README.md).
# Maintainer: David Runge <dvzrv@archlinux.org>
# Contributor: Dave Reisner <dreisner@archlinux.org>
# Contributor: Aaron Griffin <aaron@archlinux.org>

pkgname=shadow
pkgver=4.20.0.arch1
_upstream_tag=${pkgver%.*}
_dist_tag=${pkgver%.*}-arch${pkgver#*.arch}
pkgrel=3
pkgdesc="Password and account management tool suite with support for shadow files and PAM"
arch=(x86_64)
url="https://github.com/shadow-maint/shadow"
license=(
  0BSD
  BSD-3-Clause
)
depends=(
  glibc
  libcap  # setcap runs in post_install/post_upgrade
)
makedepends=(
  acl
  audit
  docbook-xsl
  git
  itstool
  libcap
  libxcrypt
  libxslt
  pam
)
backup=(
  etc/default/useradd
  etc/login.defs
  etc/pam.d/chpasswd
  etc/pam.d/newusers
  etc/pam.d/passwd
)
install=shadow.install
options=(!emptydirs)
# NOTE: distribution patches are taken from https://gitlab.archlinux.org/archlinux/packaging/upstream/shadow/
source=(
  git+$url.git?signed#tag=${_upstream_tag}
  https://gitlab.archlinux.org/archlinux/packaging/upstream/shadow/-/releases/${_dist_tag}/downloads/$pkgname-${_dist_tag}.patch.{sig,zst}
  shadow.{timer,service}
  useradd.defaults
  LICENSE
  defer-file-capabilities.patch
  shadow.install
)
