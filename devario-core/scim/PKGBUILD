pkgname=scim
pkgver=1.4.18
pkgrel=6
pkgdesc='Input method user interface and development platform'
url='https://github.com/scim-im/scim'
license=('LGPL')
arch=('x86_64')
depends=('libltdl' 'gtk3')
makedepends=('intltool')
source=("$pkgname-$pkgver.tar.gz::https://github.com/scim-im/scim/archive/$pkgver.tar.gz"
        '0001-imdkit-prototype-transport-address-callback.patch')
sha512sums=('9a6090fc1ab950905a9c54d6678ce3d2a44297d1a992a3e933b0466688638e6cf470c1682daa58a6fbb6de3216b649273faf7edff1ac0ecca1c2c77fc19108fb'
            'c05309334898f9b45e4689311f5caac93193cb5eb1170f998014abb90aeb7b8d548eb485e3982631b29d0473102198f1c6437a4b3739fd6ecdc48eebf394b757')

backup=('etc/scim/config' 'etc/scim/global')
install=install

prepare() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	patch -Np1 -i "${srcdir}/0001-imdkit-prototype-transport-address-callback.patch"
	./bootstrap
}

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	make DESTDIR="${pkgdir}" install
}
