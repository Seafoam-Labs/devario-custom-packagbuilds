# Based on Arch Linux's tzdata packaging by Andreas Radke.
pkgname=tzdata
pkgver=2026d
_tzcode=2026d
_tzdata=2026d
pkgrel=2
pkgdesc='Sources for time zone and daylight saving time data'
arch=('x86_64')
url='https://www.iana.org/time-zones'
license=('LicenseRef-tz')
makedepends=('tar')
optdepends=('bash: for tzselect'
            'glibc: for zdump, zic')
options=('!emptydirs')
source=("https://www.iana.org/time-zones/repository/releases/tzcode${_tzcode}.tar.gz"{,.asc}
        "https://www.iana.org/time-zones/repository/releases/tzdata${_tzdata}.tar.gz"{,.asc})
sha512sums=('42d4b37549a35893187851187cae93c811928f808c24ac0003bf0b782837d0934f2f7da7e93a0417273c7e0a66f79e9d512290ae4811cb73a7d02b62b3f0fed1'
            'SKIP'
            '1a27de5af50bbc28a2f64c506ab3678b09d9e5ab6c118f39eb38bb823aa8f57069bf5e465848e71df8274c6b8bcd0fc736a88107e5792d816a1db5d867cbc219'
            'SKIP')
validpgpkeys=('7E3792A9D8ACF7D633BC1588ED97E90E62AA7E34') # Paul Eggert

# Both archives contain identical shared files (calendars, Makefile, etc.).
# Shelly rejects those collisions during automatic extraction. Verify the
# archives normally, then combine them with tar in our own source directory.
noextract=("tzcode${_tzcode}.tar.gz" "tzdata${_tzdata}.tar.gz")

_timezones=('africa' 'antarctica' 'asia' 'australasia'
            'europe' 'northamerica' 'southamerica'
            'etcetera' 'backward' 'factory')

prepare() {
  mkdir -p "${srcdir}/tz-${pkgver}"
  cd "${srcdir}/tz-${pkgver}"
  tar -xf "${srcdir}/tzcode${_tzcode}.tar.gz" --no-same-owner
  tar -xf "${srcdir}/tzdata${_tzdata}.tar.gz" --no-same-owner
  sed -i 's:sbin:bin:g' Makefile
}

build() {
  cd "${srcdir}/tz-${pkgver}"
  make LFLAGS="${LDFLAGS} ${LTOFLAGS}"
}

check() {
  cd "${srcdir}/tz-${pkgver}"
  # Run upstream checks without contacting the external HTML validator.
  make CHECK_WEB_PAGES= check
}

package() {
  cd "${srcdir}/tz-${pkgver}"
  make DESTDIR="${pkgdir}" install

  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo" "${_timezones[@]}"
  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo/posix" "${_timezones[@]}"
  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo/right" -L leapseconds "${_timezones[@]}"
  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo" -p America/New_York
  install -m644 -t "${pkgdir}/usr/share/zoneinfo" \
    iso3166.tab leap-seconds.list zone1970.tab zone.tab SECURITY

  # The system administrator selects /etc/localtime.
  rm "${pkgdir}/etc/localtime"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
