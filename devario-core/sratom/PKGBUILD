# Contributor: speps <speps at aur dot archlinux dot org>

pkgbase=sratom
pkgname=(sratom)
pkgver=0.6.22
pkgrel=2
pkgdesc="An LV2 Atom RDF serialisation library"
arch=(x86_64)
url="https://drobilla.net/software/sratom.html"
license=(ISC)
# python-sphinx-lv2-theme and python-sphinxygen publish in no Devario repository,
# so sratom builds with -Ddocs=disabled and ships no sratom-docs split.
makedepends=(
  doxygen
  lv2
  meson
  python-sphinx
  serd
  sord
)
source=(https://download.drobilla.net/$pkgname-$pkgver.tar.xz{,.sig})
sha512sums=('bb3a46e88faf1596d2f10ac9d22f063e52f7c068a0712b0234168346727f179ea236280dae89e4136e97c243d0815444af1dcc6b86d70b99f5f88008481288b0'
            'SKIP')
b2sums=('be8726f3fe805b7176e3b3c0c8839536ef2825b1ca06eb0fed281272fd183eaa27b945eceab14ca7e8360cd8720ede99f560bc99af1f6b4028279c2d9ee5366b'
        'SKIP')
validpgpkeys=('907D226E7E13FA337F014A083672782A9BF368F3') # David Robillard <d@drobilla.net>

build() {
  arch-meson $pkgname-$pkgver build -Ddocs=disabled
  meson compile -C build
}

check() {
  meson test -C build
}

package_sratom() {
  depends=(
    glibc
    serd 'libserd-0.so=0-64'
    sord 'libsord-0.so=0-64'
    lv2
  )
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    libsratom-0.so
    'libsratom-0.so=0-64'
  )

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libsratom-0.so" libsratom-0.so.0 || return 1
  install -vDm 644 $pkgname-$pkgver/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 $pkgname-$pkgver/{NEWS,README.md} -t "$pkgdir/usr/share/doc/$pkgname/"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
