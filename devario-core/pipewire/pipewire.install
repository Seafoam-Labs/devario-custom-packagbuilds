_pipewire_socket() {
  # Socket defaults are optional in build roots without systemd's tools.
  if ! command -v systemctl >/dev/null 2>&1; then
    printf 'pipewire: skipping socket %s; systemctl is unavailable\n' "$1" >&2
    return 0
  fi

  # Keep diagnostics (including masks), but do not fail package setup for
  # optional user-service configuration. Never start a service here.
  if ! systemctl --global "$1" pipewire.socket; then
    printf 'pipewire: could not %s pipewire.socket; retry systemctl --global %s pipewire.socket on the target system\n' "$1" "$1" >&2
  fi
}

post_install() {
  _pipewire_socket enable
}

# No upgrade action: preserve the administrator's socket state. The old
# pre-0.1.6 migration predates Devario and required Arch's vercmp utility.

pre_remove() {
  _pipewire_socket disable
}

