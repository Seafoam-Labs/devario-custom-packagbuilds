pkgbase=doxygen
pkgname=doxygen
pkgver=1.18.0
pkgrel=3
pkgdesc='Documentation system for C++, C, Java, IDL and PHP'
url='http://www.doxygen.nl'
arch=(x86_64)
license=(GPL-2.0-or-later MIT)
# Headless documentation generator; bundled fmt/spdlog avoid a documentation cycle.
depends=(glibc libgcc libstdc++ sqlite)
makedepends=(cmake ninja flex bison python)
checkdepends=(libxml2 graphviz)
optdepends=('graphviz: diagrams in generated documentation')

source=(
  ${pkgbase}-${pkgver}.tar.gz::https://github.com/doxygen/doxygen/archive/Release_${pkgver//./_}.tar.gz
  0001-test-009-bug.patch
)
sha512sums=('532257eba9a41cca373ff9b124206c61cf5127bfb31c616aaba5bc58316a914205c509e5b7b32a5e059443f01bcf95c481b980a6fd37f9725ca55843e67dfacf'
            '75c07cafce00df210282f003cb1df01d1e60c51131d0073dff83168652c71b6b86307d152ec2752a02cbdec478a9b601e2d940f5970598b0e2cdf900727fb8ef')
b2sums=('1c517ac1ccaade627c110bbf9d399d1432c229cd5aacee4a95f3a9a2d21bf489b5caf9c7e1d25cf594e66f74bb7dad85c3796f123c8551acda65c4008b1dafc3'
        '2d1cfd74fac79e4c653b24f6be5b3ccad5c6525ed00d8e251c4ba790cbef328bb5298c98a12dcaa9ff1ea3d1c0883ae46f1f912b8ebf29862f46f94c2e9b87ef')

prepare() {
  cd "$pkgbase-Release_${pkgver//./_}"
  patch -Np1 < ../0001-test-009-bug.patch
}

build() {
  export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}"
  cmake -S "$pkgbase-Release_${pkgver//./_}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Dbuild_doc=OFF -Dbuild_wizard=OFF -Duse_libclang=OFF \
    -Duse_sys_fmt=OFF -Duse_sys_spdlog=OFF -Duse_sys_sqlite3=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgbase-Release_${pkgver//./_}/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgbase-Release_${pkgver//./_}/deps/spdlog/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-spdlog"
  install -Dm644 "$pkgbase-Release_${pkgver//./_}/deps/fmt/include/fmt/fmt.license.rst" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-fmt"
}
