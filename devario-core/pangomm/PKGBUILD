# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan de Groot <jgc@archlinux.org>

pkgbase=pangomm
pkgname=(
  pangomm
  pangomm-docs
)
pkgver=2.58.0
pkgrel=1
pkgdesc="C++ bindings for Pango"
url="https://www.gtkmm.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  'cairomm-1.16>=1.15.1'
  glib2
  glibc
  'glibmm-2.68>=2.68.0'
  libgcc
  libsigc++-3.0
  libstdc++
  'pango>=1.58.0'
)
makedepends=(
  cairomm-1.16-docs
  git
  glibmm-2.68-docs
  libsigc++-3.0-docs
  'meson>=0.62.0'
  'mm-common>=1.0.0'
  doxygen
  libxslt
  m4
  perl
  python
)
options=(!emptydirs)
source=("git+https://gitlab.gnome.org/GNOME/pangomm.git#tag=$pkgver")
# Pending refresh by the separate checksum validation step for the new tag.
b2sums=('b6ffa68ee3c7c66385ef66089b213d5c9fec76a4efc816beee5c9ff5344c78390533df926946c3345301fe14d36ac1f5a198f092ef27e9738e310539e8520024')

prepare() {
  cd pangomm
}

build() {
  local meson_options=(
    -D maintainer-mode=true
  )

  arch-meson pangomm build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_pangomm() {
  depends+=(
    libcairomm-1.16.so
    libglibmm-2.68.so
    libsigc-3.0.so
  )
  provides=(libpangomm-2.48.so)

  meson install -C build --destdir "$pkgdir"

  # Split -docs
  mkdir -p docs/usr/share
  mv -t docs/usr/share "$pkgdir"/usr/share/{devhelp,doc}
}

package_pangomm-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  options=(!strip)

  mv -t "$pkgdir" docs/*
}

