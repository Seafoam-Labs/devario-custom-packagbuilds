# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=libplacebo
pkgver=7.387.0
pkgrel=1
pkgdesc='Reusable library for GPU-accelerated video/image rendering primitives'
url='https://github.com/haasn/libplacebo'
arch=('x86_64')
license=('LGPL-2.1-or-later')
depends=('vulkan-icd-loader' 'glslang' 'lcms2>=2.9' 'shaderc>=2019.1'
         'glibc' 'libgcc' 'libstdc++' 'libunwind' 'libdovi>=1.6.7' 'xxhash')
makedepends=(
  'meson>=1.3.0' 'ninja' 'vulkan-headers>=1.4' 'glad' 'nuklear'
  'python' 'python-setuptools' 'python-mako' 'python-markupsafe' 'python-jinja'
  'libglvnd'
)
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  'libplacebo.so'
  'libplacebo.so=387-64'
)
source=(https://code.videolan.org/videolan/libplacebo/-/archive/v${pkgver}/libplacebo-v${pkgver}.tar.gz
        fix_glslang_linking.patch)
sha512sums=('57db9dd1526345dd95033fb4ae0db0ae8ae311973a3159307b67fd5504dad7810ed406f76c8ab7e952f7556e598cccaeb4abe6d2f5f623a73ed63418442337ae'
            'f25f4532fd93b39efc2b481e88eadb8013d5ea32b0b785de336b3d03b52cd22577a933c5df6ed29f9c188a7ac7c8fa465114b230d3e43cb319a70072d8cbaefd')
b2sums=('e0b25ca4af9c4e318ea33b1db3bf20b2e2a8aae153e7e896856e65d14a1c1b3a2dba96d216c01de568d1f23499257cdc3ca13fdb6ecb7c8e2cc705be232c3d9d'
        '227a59c05d66e5226c297e39acad3244a50ab3fdc1c2742fd94979ffa09679e60c89fe916ff72321b0f91cb3516e35e52e0913067cde4c1325a28ff9db22fb3c')

prepare() {
  cd ${pkgname}-v${pkgver}
  # https://gitlab.alpinelinux.org/alpine/aports/-/blob/master/community/libplacebo/glslang-deps.patch
  patch -Np1 -i "${srcdir}/fix_glslang_linking.patch"
}

build() {
  cd ${pkgname}-v${pkgver}
  CXXFLAGS+=" -I/usr/include/glslang"
  arch-meson build \
    -D tests=true \
    -D vulkan=enabled \
    -D glslang=enabled \
    -D shaderc=enabled \
    -D lcms=enabled \
    -D d3d11=disabled \
    -D libdovi=enabled \
    -D demos=false
  meson compile -C build
}

check() {
  cd ${pkgname}-v${pkgver}
  meson test -C build --print-errorlogs
}

package() {
  depends+=(
    'libdovi.so=3-64'           # this batch's libdovi 3.4.0-2 publishes the pinned form
    'liblcms2.so=2-64'          # published lcms2 2.19.1-2 declares the pinned form
    'libshaderc_shared.so=1-64' # published shaderc 2026.4-2 declares the pinned form
    'libvulkan.so'              # vulkan-icd-loader 1.4.364-1 publishes this bare only
  )

  cd ${pkgname}-v${pkgver}
  meson install -C build --destdir "${pkgdir}"
  _verify_soname "${pkgdir}/usr/lib/libplacebo.so" libplacebo.so.387 || return 1
  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

