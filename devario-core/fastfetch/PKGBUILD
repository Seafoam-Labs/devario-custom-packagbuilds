# Adapted for Devario from Arch Linux's fastfetch package.
# Arch maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Mark Wagie <mark dot wagie at proton dot me>

pkgname=fastfetch
pkgver=2.70.0
pkgrel=2
pkgdesc="A feature-rich and performance oriented neofetch like system information tool"
url="https://github.com/fastfetch-cli/fastfetch"
arch=('x86_64')
license=('MIT')
depends=('chafa>=1.10' 'glibc' 'imagemagick' 'shelly' 'yyjson' 'zlib')
checkdepends=('python')
makedepends=('cmake>=3.21.0' 'dbus' 'dconf' 'efl' 'libglvnd'
             'libva' 'libvdpau' 'libxcb' 'libxrandr' 'lua>=5.3' 'ocl-icd' 'opencl-headers'
             'sqlite' 'vulkan-headers' 'vulkan-icd-loader' 'wayland' 'xfconf')
optdepends=('dbus: Bluetooth, Player & Media detection'
            'dconf: Needed for values that are only stored in DConf + Fallback for GSettings'
            'glib2: Output for values that are only stored in GSettings'
            'hwdata: GPU output'
            'libdrm: Displays detection'
            'libelf: st term font detection and fast path of systemd version detection'
            'libglvnd: OpenGL module'
            'libva: Primary backend of hardware-accelerated video codec detection'
            'libvdpau: Fallback backend of hardware-accelerated video codec detection'
            'libxrandr: Multi monitor support'
            'lua: Lua scripting in format section of JSON config'
            'ocl-icd: OpenCL module'
            'python: Needed for zsh and fish completions'
            'sqlite: Needed for Sqlite integration and Soar packages count'
            'vulkan-icd-loader: Vulkan module & fallback for GPU output')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz"
  'devario-config.jsonc'
  'devario-logo.png'
  'fish-striped.txt'
  'fish-compact.txt'
  'fish-bold.txt'
  '0001-shelly-package-detection.patch'
  'test-shelly.py'
)
sha256sums=('8aa01bd3faff2be1d94f231d76489ce6d9f781f51f6e93eafe82359d6d8669af'
            'b4f9b751305c2b5647a3544637ecacea32b4658457c4804fdcb3c090e765783f'
            '21dcc8a853a546bdd989005c7bebdc2df2f39046e39f2d275d39d78f8f02c7b8'
            '4b9e7758bc4be9cf4162b6e0bb932ca62a250172c360002a051c72c60b1299bf'
            '30a6f7ca42a9cec786cd373ab71a79dafc57ba757115472d98cdd6cb2358de41'
            '813af34960dfd84ed2597e25ef9b6de4cc3bd6f9de47158b23b2e066ea029c6e'
            '7d169f65a74585872e24ebb5049af6834fadeade4f654b9bc36413c721bd312e'
            '3c784ad16b9b6ba192d9174a529d98655d7989a52209e06e06fd67e0841701a1')

prepare() {
	patch -d "${pkgname}-${pkgver}" -Np1 -i "${srcdir}/0001-shelly-package-detection.patch"
}

build() {
	cmake -B build -S "${pkgname}-${pkgver}" \
		-DCMAKE_BUILD_TYPE='RelWithDebInfo' \
		-DCMAKE_INSTALL_PREFIX='/usr' \
		-DBUILD_FLASHFETCH='OFF' \
		-DBUILD_TESTS='ON' \
		-DENABLE_SQLITE3='ON' \
		-DENABLE_RPM='OFF' \
		-DENABLE_IMAGE_LOGO='ON' \
		-DENABLE_IMAGEMAGICK7='ON' \
		-DENABLE_IMAGEMAGICK6='OFF' \
		-DENABLE_CHAFA='ON' \
		-DENABLE_SYSTEM_YYJSON='ON' \
		-DPACKAGES_DISABLE_APK='ON' \
		-DPACKAGES_DISABLE_DPKG='ON' \
		-DPACKAGES_DISABLE_EMERGE='ON' \
		-DPACKAGES_DISABLE_EOPKG='ON' \
		-DPACKAGES_DISABLE_GUIX='ON' \
		-DPACKAGES_DISABLE_LINGLONG='ON' \
		-DPACKAGES_DISABLE_LPKG='ON' \
		-DPACKAGES_DISABLE_LPKGBUILD='ON' \
		-DPACKAGES_DISABLE_OPKG='ON' \
		-DPACKAGES_DISABLE_PACMAN='ON' \
		-DPACKAGES_DISABLE_PACSTALL='ON' \
		-DPACKAGES_DISABLE_PALUDIS='ON' \
		-DPACKAGES_DISABLE_PKG='ON' \
		-DPACKAGES_DISABLE_PKGTOOL='ON' \
		-DPACKAGES_DISABLE_RPM='ON' \
		-DPACKAGES_DISABLE_SORCERY='ON' \
		-DPACKAGES_DISABLE_XBPS='ON' \
		-Wno-dev
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure || return 1
	python "${srcdir}/test-shelly.py" build/fastfetch \
		"${srcdir}/${pkgname}-${pkgver}/src/modules/packages/option.h" || return 1
	# CMake can silently omit image backends when development libraries are missing.
	local features feature
	features="$(build/fastfetch --list-features)" || return 1
	for feature in imagemagick7 chafa zlib; do
		if ! grep -Fxq "$feature" <<< "$features"; then
			printf 'Required Fastfetch image feature missing: %s\n' "$feature" >&2
			return 1
		fi
	done
	# Exercise the bundled configuration with each logo before packaging.
	local logo
	for logo in striped compact bold; do
		build/fastfetch --config "${srcdir}/devario-config.jsonc" \
			--logo-type file --logo "${srcdir}/fish-${logo}.txt" --pipe false >/dev/null || return 1
	done
}

package() {
	DESTDIR="${pkgdir}" cmake --install build

	local assets="${pkgdir}/usr/share/devario/fastfetch" logo
	install -Dm644 "${srcdir}/devario-config.jsonc" "${assets}/config.jsonc"
	install -Dm644 "${srcdir}/devario-logo.png" "${assets}/devario-logo.png"
	for logo in striped compact bold; do
		install -Dm644 "${srcdir}/fish-${logo}.txt" "${assets}/fish-${logo}.txt"
	done
	# Keep the text-logo path used by older Devario configurations.
	install -Dm644 "${srcdir}/fish-bold.txt" "${assets}/devario-fish.txt"
	install -dm755 "${pkgdir}/etc/xdg/fastfetch"
	ln -s ../../../usr/share/devario/fastfetch/config.jsonc \
		"${pkgdir}/etc/xdg/fastfetch/config.jsonc"
}
