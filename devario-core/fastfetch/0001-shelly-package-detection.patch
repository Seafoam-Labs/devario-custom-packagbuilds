+// Query the supported Shelly interface so DBPath, RootDir and Includes are
+// resolved by Shelly itself. Never fall back to a stale Pacman database.
+static const char* getShellyPackages(uint32_t* count) {
+    FF_STRBUF_AUTO_DESTROY output = ffStrbufCreate();
+    FFProcessHandle handle;
+    const char* error = ffProcessSpawn((char* const[]) {
+        "shelly", "list", "standard", "--show-hidden", "--json", nullptr
+    }, false, ffGetNullFD(), &handle);
+    if (error) {
+        return "Failed to start Shelly package query";
+    }
+    int exitStatus;
+    error = ffProcessReadOutputWithStatus(&handle, &output, &exitStatus);
+    if (error || exitStatus != 0) {
+        return "Shelly package query failed";
+    }
+    yyjson_doc* doc = yyjson_read(output.chars, output.length, YYJSON_READ_NOFLAG);
+    if (!doc) {
+        return "Shelly returned invalid package JSON";
+    }
+    yyjson_val* root = yyjson_doc_get_root(doc);
+    if (!yyjson_is_arr(root) || yyjson_arr_size(root) > UINT32_MAX) {
+        yyjson_doc_free(doc);
+        return "Shelly package JSON must be an array";
+    }
+    size_t index, length;
+    yyjson_val* package;
+    yyjson_arr_foreach(root, index, length, package) {
+        yyjson_val* name = yyjson_obj_get(package, "Name");
+        if (!yyjson_is_obj(package) || !yyjson_is_str(name) || yyjson_get_len(name) == 0) {
+            yyjson_doc_free(doc);
+            return "Shelly returned an invalid package record";
+        }
+    }
+    *count = (uint32_t) yyjson_arr_size(root);
+    yyjson_doc_free(doc);
+    return nullptr;
 }
 
