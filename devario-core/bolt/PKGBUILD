# Maintainer: Devario maintainers

pkgbase=bolt
pkgname=('bolt' 'boltctl')
pkgver=0.9.10
pkgrel=1
pkgdesc='Thunderbolt device authorization and enrollment'
arch=('x86_64')
url='https://gitlab.freedesktop.org/bolt/bolt'
license=('LGPL-2.1-or-later')
depends=('glib2' 'glibc' 'systemd-libs')
makedepends=('asciidoc' 'glib2-devel' 'meson' 'ninja' 'pkgconf' 'polkit' 'systemd')
checkdepends=('python-dbus' 'python-dbusmock' 'python-gobject' 'umockdev')
source=("$pkgbase-$pkgver.tar.gz::$url/-/archive/$pkgver/$pkgbase-$pkgver.tar.gz")
sha256sums=('0e9646ff153f4445d85bfaac1b0d77d86df9c639f84888f15ee7b0f1fa892b58')

build() {
  arch-meson "$pkgbase-$pkgver" build --libexecdir=lib -Dman=true
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_bolt() {
  pkgdesc='Thunderbolt authorization daemon, D-Bus service and device policy'
  depends+=('polkit' 'systemd')
  optdepends=('boltctl: command-line device authorization and enrollment')
  meson install -C build --destdir "$pkgdir"
  rm "$pkgdir/usr/bin/boltctl" "$pkgdir/usr/share/man/man1/boltctl.1"
  rmdir "$pkgdir/usr/bin" "$pkgdir/usr/share/man/man1"
}

package_boltctl() {
  pkgdesc='Command-line client for Thunderbolt device authorization'
  depends+=("bolt=$pkgver-$pkgrel")
  install -Dm755 build/boltctl "$pkgdir/usr/bin/boltctl"
  install -Dm644 build/boltctl.1 "$pkgdir/usr/share/man/man1/boltctl.1"
}
