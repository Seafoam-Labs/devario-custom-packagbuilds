pkgbase=fmt
pkgname=fmt
pkgver=12.2.1
pkgrel=1
pkgdesc='Open-source formatting library for C++'
arch=(x86_64)
url=https://fmt.dev
license=(MIT)
makedepends=('cmake>=3.8' git ninja)
source=("git+https://github.com/fmtlib/fmt.git#tag=${pkgver}")
b2sums=('165d50cd60b7c495baf580445661c63610a7b02747234956d68904384bbd66eccb89fc4ac5d9258f17147e6e44e7a1f5dce7f612c062fcfce0c964da53f659e7')

build() {
  cmake -S fmt -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev \
    -DBUILD_SHARED_LIBS=ON -DFMT_DOC=OFF
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  depends=(
    glibc
    libgcc
    libstdc++
  )
  provides=('libfmt.so' 'libfmt.so=12-64')

  DESTDIR="${pkgdir}" cmake --install build --component fmt_core
  install -Dm 644 -t "${pkgdir}"/usr/share/licenses/${pkgname} fmt/LICENSE
}

