# Pinned Darkly application styles for Pearl. No KWin decorations or Plasma theme.
pkgname=pearl-darkly-style
pkgver=0.5.42
pkgrel=1
pkgdesc='Darkly application styles for Qt 5 and Qt 6, without KWin decorations'
arch=('x86_64')
url='https://github.com/Bali10050/Darkly'
license=('GPL-2.0-or-later')
depends=('qt5-declarative>=5.15.2' 'qt6-declarative>=6.7.0' 'kcoreaddons5>=5.102.0' 'kcoreaddons>=6.10.0'
         'kconfig5>=5.102.0' 'kconfig>=6.10.0' 'kconfigwidgets5>=5.102.0' 'kcolorscheme>=6.10.0'
         'kguiaddons5>=5.102.0' 'kguiaddons>=6.10.0' 'ki18n5>=5.102.0' 'ki18n>=6.10.0'
         'kiconthemes5>=5.102.0' 'kiconthemes>=6.10.0' 'kwindowsystem5>=5.102.0' 'kwindowsystem>=6.10.0'
         'frameworkintegration5>=5.102.0' 'frameworkintegration>=6.10.0' 'kirigami>=6.10.0')
makedepends=('git' 'cmake>=3.16' 'extra-cmake-modules>=5.102.0' 'gcc' 'make' 'patch')
provides=("darkly=$pkgver")
conflicts=('darkly' 'darkly-bin' 'darkly-git')
_commit=812546ed69ff7e55cf3cb0fe2b79379e85101bef
source=("darkly::git+$url.git#commit=$_commit" 'application-style.patch')
# Checksum the commit's git archive tar; SKIP is for detached signatures only.
# Source checksum below is from 0.5.39; refresh for 0.5.42 in checksum validation.
sha256sums=('f21ce9f034107569b1c4849a63fd0e8de36dd80b2545749d20c5dfeebb04056a'
            '4d955f537ba9d04f9ca1f4007ac39f23a68bbeeeb7cbb380aa8abcc9d0627763')

prepare() {
    cd "$srcdir/darkly"
    # Avoid legacy Qt 5 Kirigami and KCM UI dependencies; QtEngine supplies the
    # platform integration and Pearl supplies the settings UI.
    patch -Np1 -i "$srcdir/application-style.patch"
}

build() {
    cmake -S "$srcdir/darkly" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_QT5=ON -DBUILD_QT6=ON -DBUILD_TESTING=OFF \
        -DWITH_DECORATIONS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$srcdir/build"
}

package() {
    # Explicit payload excludes upstream's Plasma assets and decoration plugins.
    install -Dm755 "$srcdir/build/bin/darkly5.so" "$pkgdir/usr/lib/qt/plugins/styles/darkly5.so"
    install -Dm755 "$srcdir/build/bin/darkly6.so" "$pkgdir/usr/lib/qt6/plugins/styles/darkly6.so"
    install -Dm644 "$srcdir/darkly/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
