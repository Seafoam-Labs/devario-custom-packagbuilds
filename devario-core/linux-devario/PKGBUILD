##### Package identity ########################################################

_pkgsuffix=devario
_major=7.3
_minor=0
# Release number of the devario-<version>-<N> tag on GitHub.
_tagrel=8

pkgbase="linux-$_pkgsuffix"
pkgver=${_major}.${_minor}
_srctag=devario-${pkgver}-${_tagrel}
_srcname="$_srctag"
pkgdesc='Linux EEVDF by Devario with other patches and improvements.'
arch=('x86_64')
url="https://github.com/Seafoam-Labs/linux"
license=('GPL-2.0-only')
options=('!strip' '!debug' '!lto')

_die() {
  if declare -F error >/dev/null; then error "$@"; else echo "==> ERROR: $*" >&2; fi
  exit 1
}

##### Build options ###########################################################
#
# _release_opts below is the single source of truth: it is both the set of
# values an official Devario package is built with and the default for local
# builds. Every option here changes the produced kernel or package.
#
# Local build (default, _devario_release=no): any option may be overridden from
# the environment, e.g. `_HZ_ticks=500 _processor_opt=native makepkg`.
#
# Release build (_devario_release=yes, set by the release pipeline): every
# option is pinned to the value below, and an environment override of any of
# them aborts the build instead of being silently replaced, so a misconfigured
# builder is detected rather than published.
#
# _rebuild        Devario rebuild of the same tag; bump here (and commit) for a
#                 rebuild without a new tag, e.g. a new pahole. pkgrel is
#                 <_tagrel>.<_rebuild>, so a new tag always sorts above any
#                 rebuild of the previous one.
# _processor_opt  x86-64 ISA level (CONFIG_X86_64_VERSION, kbuild ISA patch):
#                   generic_v1  baseline x86-64, every 64-bit x86 CPU
#                   generic_v2  x86-64-v2 (SSE4.2, POPCNT, ...), ~Nehalem / Bulldozer+
#                   generic_v3  x86-64-v3 (AVX2, BMI2, ...),      ~Haswell / Zen+
#                   native      build machine's CPU; never for distributed packages
#                 The live ISO and installed systems need a compatible CPU.
# _HZ_ticks       timer frequency: 100, 250, 300, 500, 600, 750, 1000
# _tickrate       tick type: periodic, idle, full
# _preempt        preemption model: full, lazy
# _hugepage       transparent hugepage default: always, madvise
# _cc_harder      yes: build with -O3 (CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3)
# _per_gov        yes: performance as default cpufreq governor (instead of schedutil)
# _lru_cast      yes: enable LRU CAST (CONFIG_LRU_CAST)
# _localmodcfg    yes: build only modules listed in a modprobed-db database
#                 (path in _localmodcfg_path); https://wiki.archlinux.org/title/Modprobed-db
# _use_current    yes: start from the running kernel's /proc/config.gz instead of
#                 the shipped config; the options above are still applied on top
# _makenconfig    yes: open nconfig before building
# _makexconfig    yes: open xconfig before building
# _build_debug    yes: also produce a -dbg package with the unstripped vmlinux

_release_opts=(
  _rebuild=2
  _processor_opt=generic_v3
  _HZ_ticks=1000
  _tickrate=full
  _preempt=full
  _hugepage=always
  _cc_harder=yes
  _per_gov=no
  _lru_cast=yes
  _localmodcfg=no
  _use_current=no
  _makenconfig=no
  _makexconfig=no
  _build_debug=no
)

: "${_devario_release:=no}"
case $_devario_release in
  yes|no) ;;
  *) _die "invalid _devario_release='$_devario_release' (yes or no)" ;;
esac
: "${_localmodcfg_path:="$HOME/.config/modprobed.db"}"

for _kv in "${_release_opts[@]}"; do
  _k=${_kv%%=*}
  _v=${_kv#*=}
  if [ "$_devario_release" = "yes" ]; then
    if [ -n "${!_k+set}" ] && [ "${!_k}" != "$_v" ]; then
      _die "release build: $_k='${!_k}' overrides the pinned value '$_v'; unset it in the builder environment"
    fi
    printf -v "$_k" '%s' "$_v"
  else
    # empty counts as unset, like the former ${_x:=default}
    [ -n "${!_k}" ] || printf -v "$_k" '%s' "$_v"
  fi
done
unset _kv _k _v

pkgrel="${_tagrel}.${_rebuild}"

##### Sources #################################################################

makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)

source=(
  "https://github.com/Seafoam-Labs/linux/releases/download/${_srctag}/${_srctag}.tar.gz"
  "config"
)

export KBUILD_BUILD_HOST=devario
export KBUILD_BUILD_USER="$pkgbase"
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
  cd "$_srcname"

  echo "Setting version..."
  echo "-$pkgrel" > localversion.10-pkgrel
  echo "${pkgbase#linux}" > localversion.20-pkgname

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  ### Base config
  if [ "$_use_current" = "yes" ]; then
    [[ -s /proc/config.gz ]] || _die "Running kernel has no /proc/config.gz (CONFIG_IKCONFIG_PROC)"
    echo "Using the running kernel's config..."
    zcat /proc/config.gz > .config
  else
    echo "Setting config..."
    cp ../config .config
  fi

  ### ISA level
  case "$_processor_opt" in
    generic_v[1-3])
      scripts/config -d X86_NATIVE_CPU --set-val X86_64_VERSION "${_processor_opt#generic_v}";;
    native)
      scripts/config -e X86_NATIVE_CPU;;
    *)
      _die "_processor_opt='$_processor_opt' is invalid (generic_v1, generic_v2, generic_v3, native)";;
  esac
  echo "Selected '$_processor_opt' CPU optimization"

  ### Timer frequency
  case "$_HZ_ticks" in
    100|250|500|600|750|1000)
      scripts/config -d HZ_300 -e "HZ_${_HZ_ticks}" --set-val HZ "${_HZ_ticks}";;
    300)
      scripts/config -e HZ_300 --set-val HZ 300;;
    *)
      _die "_HZ_ticks='$_HZ_ticks' is invalid (100, 250, 300, 500, 600, 750, 1000)";;
  esac
  echo "Selected ${_HZ_ticks}Hz tick rate"

  ### Tick type
  case "$_tickrate" in
    periodic) scripts/config -d NO_HZ_IDLE -d NO_HZ_FULL -d NO_HZ -d NO_HZ_COMMON -e HZ_PERIODIC;;
    idle)     scripts/config -d HZ_PERIODIC -d NO_HZ_FULL -e NO_HZ_IDLE -e NO_HZ -e NO_HZ_COMMON;;
    full)     scripts/config -d HZ_PERIODIC -d NO_HZ_IDLE -d CONTEXT_TRACKING_FORCE \
                -e NO_HZ_FULL_NODEF -e NO_HZ_FULL -e NO_HZ -e NO_HZ_COMMON -e CONTEXT_TRACKING;;
    *)        _die "_tickrate='$_tickrate' is invalid (periodic, idle, full)";;
  esac
  echo "Selected '$_tickrate' tick type"

  ### Preemption model
  case "$_preempt" in
    full) scripts/config -e PREEMPT -d PREEMPT_LAZY;;
    lazy) scripts/config -d PREEMPT -e PREEMPT_LAZY;;
    *)    _die "_preempt='$_preempt' is invalid (full, lazy)";;
  esac
  echo "Selected '$_preempt' preemption model"

  ### Governor
  if [ "$_per_gov" = "yes" ]; then
    echo "Setting performance governor as default..."
    scripts/config -d CPU_FREQ_DEFAULT_GOV_SCHEDUTIL -e CPU_FREQ_DEFAULT_GOV_PERFORMANCE
  fi

  ### -O3
  if [ "$_cc_harder" = "yes" ]; then
    echo "Enabling -O3..."
    scripts/config -d CC_OPTIMIZE_FOR_PERFORMANCE -e CC_OPTIMIZE_FOR_PERFORMANCE_O3
  fi

  ### THP
  case "$_hugepage" in
    always)  scripts/config -d TRANSPARENT_HUGEPAGE_MADVISE -e TRANSPARENT_HUGEPAGE_ALWAYS;;
    madvise) scripts/config -d TRANSPARENT_HUGEPAGE_ALWAYS -e TRANSPARENT_HUGEPAGE_MADVISE;;
    *)       _die "_hugepage='$_hugepage' is invalid (always, madvise)";;
  esac
  echo "Selected '$_hugepage' transparent hugepage mode"

  ### LRU CAST
  if [ "$_lru_cast" = "yes" ]; then
    echo "Enabling LRU_CAST..."
    scripts/config -e LRU_CAST
  fi

  ### DRM panic screen with QR code
  echo "Enabling QR code panic screen..."
  scripts/config --set-str DRM_PANIC_SCREEN qr_code -e DRM_PANIC_SCREEN_QR_CODE \
    --set-str DRM_PANIC_SCREEN_QR_CODE_URL https://panic.archlinux.org/panic_report# \
    --set-val DRM_PANIC_SCREEN_QR_VERSION 40

  ### modprobed-db
  if [ "$_localmodcfg" = "yes" ]; then
    [ -e "$_localmodcfg_path" ] || _die "No modprobed.db found at $_localmodcfg_path"
    echo "Running make localmodconfig..."
    make LSMOD="$_localmodcfg_path" localmodconfig
  fi

  ### Finalize config
  echo "Rewriting configuration..."
  make prepare
  yes "" | make config >/dev/null
  diff -u ../config .config || :

  [ "$_makenconfig" = "yes" ] && make nconfig
  [ "$_makexconfig" = "yes" ] && make xconfig

  # After the interactive configurators, so a changed LOCALVERSION is reflected.
  make -s kernelrelease > version
  echo "Prepared $pkgbase version $(<version)"

  echo "Saving configuration for later reuse..."
  cat .config > "../config-${pkgver}-${pkgrel}${pkgbase#linux}"
}

build() {
  cd "$_srcname"
  make -j"$(nproc)" all
  make -C tools/bpf/bpftool vmlinux.h feature-clang-bpf-co-re=1
}

_package() {
  pkgdesc="The $pkgdesc kernel and modules"
  depends=('coreutils' 'kmod' 'initramfs')
  optdepends=('wireless-regdb: to set the correct wireless channels of your country'
              'linux-firmware: firmware images needed for some devices'
              'modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig'
              'scx-scheds: to use sched-ext schedulers')
  provides=(VIRTUALBOX-GUEST-MODULES WIREGUARD-MODULE KSMBD-MODULE NTSYNC-MODULE ADIOS-MODULE)

  cd "$_srcname"

  local modulesdir="$pkgdir/usr/lib/modules/$(<version)"

  echo "Installing boot image..."
  # systemd expects to find the kernel here to allow hibernation
  # https://github.com/systemd/systemd/commit/edda44605f06a41fb86b7ab8128dcf99161d2344
  install -Dm644 "$(make -s image_name)" "$modulesdir/vmlinuz"

  # Compatibility metadata for repository tools; native metadata is below
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"
  printf 'version=%s\nimage=vmlinuz\nid=%s\n' "$(<version)" "$pkgbase" \
    | install -Dm644 /dev/stdin "$modulesdir/devario-kernel"

  echo "Installing modules..."
  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install  # Suppress depmod

  # remove build link
  rm "$modulesdir"/build
}

_package-headers() {
  pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"
  depends=(binutils glibc libelf libgcc openssl pahole xxhash zlib zstd "$pkgbase")
  provides=(LINUX-HEADERS)

  cd "$_srcname"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux tools/bpf/bpftool/vmlinux.h
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
  cp -t "$builddir" -a scripts
  ln -srt "$builddir" "$builddir/scripts/gdb/vmlinux-gdb.py"

  # required when STACK_VALIDATION is enabled
  install -Dt "$builddir/tools/objtool" tools/objtool/objtool

  # required when DEBUG_INFO_BTF_MODULES is enabled
  if [ -f tools/bpf/resolve_btfids/resolve_btfids ]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids
  fi

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/x86" -a arch/x86/include
  install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

  # https://bugs.archlinux.org/task/13146
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h

  # https://bugs.archlinux.org/task/20402
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h

  # https://bugs.archlinux.org/task/71392
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  echo "Installing KConfig files..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  echo "Installing Rust files..."
  if compgen -G "rust/*.rmeta" >/dev/null; then
    install -Dt "$builddir/rust" -m644 rust/*.rmeta
  fi
  if compgen -G "rust/*.so" >/dev/null; then
    install -Dt "$builddir/rust" rust/*.so
  fi
  if [ -d rust/kernel ]; then
    local _gen
    while IFS= read -r -d "" _gen; do
      install -Dm644 "$_gen" "$builddir/$_gen"
    done < <(find rust -type f -name 'generated_*.rs' -print0)
  fi

  echo "Installing unstripped VDSO..."
  make INSTALL_MOD_PATH="$pkgdir/usr" vdso_install \
    link=  # Suppress build-id symlinks

  echo "Removing unneeded architectures..."
  local arch
  for arch in "$builddir"/arch/*/; do
    [[ $arch = */x86/ ]] && continue
    echo "Removing $(basename "$arch")"
    rm -r "$arch"
  done

  echo "Removing documentation..."
  rm -r "$builddir/Documentation"

  echo "Removing broken symlinks..."
  find -L "$builddir" -type l -printf 'Removing %P\n' -delete

  echo "Removing loose objects..."
  find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file -Sib "$file")" in
      application/x-sharedlib\;*)      strip -v $STRIP_SHARED "$file" ;;   # .so
      application/x-archive\;*)        strip -v $STRIP_STATIC "$file" ;;   # .a
      application/x-executable\;*)     strip -v $STRIP_BINARIES "$file" ;; # binaries
      application/x-pie-executable\;*) strip -v $STRIP_SHARED "$file" ;;   # PIE binaries
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

  echo "Stripping vmlinux..."
  strip -v $STRIP_STATIC "$builddir/vmlinux"

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

_package-dbg() {
  pkgdesc="Non-stripped vmlinux file for the $pkgdesc kernel"
  depends=("$pkgbase-headers")

  cd "$_srcname"
  install -Dt "$pkgdir/usr/src/debug/$pkgbase" -m644 vmlinux
}

pkgname=("$pkgbase")
[ "$_build_debug" = "yes" ] && pkgname+=("$pkgbase-dbg")
pkgname+=("$pkgbase-headers")
for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
  }"
done

