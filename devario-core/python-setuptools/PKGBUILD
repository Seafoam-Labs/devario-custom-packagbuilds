pkgname=python-setuptools
_name=${pkgname#python-}
pkgver=84.0.0
pkgrel=4
epoch=1
pkgdesc="Easily download, build, install, upgrade, and uninstall Python packages"
arch=('any')
url="https://pypi.org/project/setuptools/"
license=('MIT')
groups=(python-build-backend)
depends=(
  'python'
)
depends+=(
  'python-jaraco.collections'
  'python-jaraco.functools'
  'python-jaraco.text'
  'python-more-itertools'
  'python-packaging'
  'python-platformdirs'
  'python-wheel'
)
makedepends=(
  'git'
)
makedepends+=(
  'python-build'
  'python-installer'
  'python-setuptools'
)
provides=('python-distribute')
replaces=('python-distribute')
source=("git+https://github.com/pypa/setuptools.git#tag=v$pkgver")
# v84.0.0 resolves to 72e919a8b10aaafc041205d4e3ae0e6a2e1e5f87.
# Retain the verified release checksum without requiring a PGP key at build time.
b2sums=('2826e1bceb5373b0b96bbf64ccf4183982e8eddb53d06cd346f81f4c5e0177f80a4ebfa281f7eec6af26f26d479b6e2a7d71d60813959086c8959e5f20cedf8f')

prepare() {
  cd "$_name"
  # Populate dependencies list for devendored deps
  sed '/^core =/,/]/!d' pyproject.toml > ../requirements.txt
  sed -i '1d;$d' ../requirements.txt
  sed -i '/^dependencies =/ {
  r ../requirements.txt
  s/^core =/dependencies =/
  }' pyproject.toml

  # validate-pyproject is still vendored for its pregenerated validations
  rm -r "$_name"/_vendor
}

build() {
  export SETUPTOOLS_INSTALL_WINDOWS_SPECIFIC_FILES=0

  cd "$_name"
  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  install -d "$pkgdir"/usr/share/licenses/$pkgname
  ln -s "$site_packages"/"$_name"-$pkgver.dist-info/licenses/LICENSE \
    "$pkgdir"/usr/share/licenses/$pkgname

  cd "$_name"
  python -m installer --destdir="$pkgdir" dist/*.whl

  rm "$pkgdir/$site_packages/$_name"/*.exe
}
