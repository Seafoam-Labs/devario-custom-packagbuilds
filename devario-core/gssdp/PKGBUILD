# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: György Balló <ballogy@freestart.hu>

pkgbase=gssdp
pkgname=(
  gssdp
  gssdp-docs
)
pkgver=1.6.6
pkgrel=2
pkgdesc="GObject-based API for handling resource discovery and announcement over SSDP"
url="https://wiki.gnome.org/Projects/GUPnP"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  libgcc
  libsoup3
)
makedepends=(
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  gtk4
  meson
  pandoc
  vala
)
source=("git+https://gitlab.gnome.org/GNOME/gssdp.git?signed#tag=gssdp-$pkgver")
b2sums=('1190a504be9483c7fae07706e3c6cbeb8fd510f25a283b36cf990d392576ce0110c731cd70575d2b7003791a64c15282e17dba503ba913b6fb5bfd508eefd1d9')
validpgpkeys=(
  AC9CD4E32D7C7F6357BA8ADD10F6E970175D29E1 # Jens Georg <mail@jensge.org>
)

prepare() {
  cd gssdp
}

build() {
  local meson_options=(
    -D gtk_doc=true
  )

  arch-meson gssdp build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_gssdp() {
  # Pinned: glib2 publishes these, and libsoup3 publishes its pin in this batch.
  depends+=(
    libg{lib,object,io}-2.0.so=0-64
    libsoup-3.0.so=0-64
  )
  optdepends=('gtk4: gssdp-device-sniffer')
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    libgssdp-1.6.so
    libgssdp-1.6.so=0-64
  )

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libgssdp-1.6.so" libgssdp-1.6.so.0 || return 1

  cd "$pkgdir"
  _pick docs usr/share/doc
}

package_gssdp-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  mv docs/* "$pkgdir"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

