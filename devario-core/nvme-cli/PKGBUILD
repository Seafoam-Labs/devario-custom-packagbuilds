pkgname=nvme-cli
pkgver=3.1
pkgrel=1
pkgdesc='NVMe storage management utilities and library'
arch=('x86_64')
url='https://github.com/linux-nvme/nvme-cli'
license=('GPL-2.0-only' 'GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc' 'json-c' 'keyutils' 'kmod' 'libgcc' 'openssl' 'util-linux')
makedepends=('meson' 'systemd')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('8a6879f1f2af53743c03a8f77f247261306300d3f3b0edfd242c5f646bdfdccb')

build() {
  meson setup build "$srcdir/$pkgname-$pkgver" \
    --prefix=/usr \
    --sbindir=bin \
    --libdir=lib \
    --sysconfdir=/etc \
    --buildtype=plain \
    --wrap-mode=nofallback \
    -Ddocs=man \
    -Ddocs-build=false \
    -Dpython=disabled \
    -Djson-c=enabled \
    -Dkeyutils=enabled \
    -Dlibkmod=enabled \
    -Dopenssl=enabled \
    -Dsystemddir=lib/systemd/system \
    -Dudevrulesdir=lib/udev/rules.d \
    -De2e-tests=false
  meson compile -C build
}

check() {
  # Upstream unit tests use fixtures; hardware end-to-end tests stay disabled.
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$srcdir/$pkgname-$pkgver/LICENSES/"*.txt
}
