# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Kevin <kevin@archlinux.org>
# Contributor: criminy <criminy@gmail.com>

# This ABI has its own package name; do not provide or replace the GTK3 package.
pkgbase=cairomm-1.16
pkgname=(
  cairomm-1.16
  cairomm-1.16-docs
)
pkgver=1.19.1
pkgrel=1
pkgdesc="C++ bindings for Cairo"
url="https://www.cairographics.org/cairomm/"
arch=(x86_64)
license=(LGPL-2.0-or-later)
depends=(
  cairo
  glibc
  libgcc
  libsigc++-3.0
  libstdc++
)
makedepends=(
  git
  libsigc++-3.0-docs
  meson
  mm-common
)
options=(!emptydirs)
checkdepends=(boost)
source=("git+https://gitlab.freedesktop.org/cairo/cairomm.git#tag=$pkgver")
b2sums=('ae80b004fdc804cdde4e50e9beb81265181c83558ccb87226d0969db481b6a17b722c454828826ccb8b51ff415c95b835cac912ccff901944b25bbffda022117')

prepare() {
  cd cairomm
}

build() {
  local meson_options=(
    -D maintainer-mode=true
  )

  arch-meson cairomm build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_cairomm-1.16() {
  depends+=(libsigc-3.0.so)
  provides=(libcairomm-1.16.so libcairomm-1.16.so=1-64)

  meson install -C build --destdir "$pkgdir"

  _verify_soname "$pkgdir/usr/lib/libcairomm-1.16.so" libcairomm-1.16.so.1 || return 1

  # Split -docs
  mkdir -p docs/usr/share
  mv -t docs/usr/share "$pkgdir"/usr/share/{devhelp,doc}
}

package_cairomm-1.16-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  options=(!strip)

  mv -t "$pkgdir" docs/*
}

# Keep the advertised ABI tied to the actual installed library.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

