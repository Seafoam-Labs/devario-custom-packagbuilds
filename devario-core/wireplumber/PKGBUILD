# Adapted for Devario: advertise versioned SONAME provisions beside Shelly's bare ones.
# User service setup is best-effort in isolated roots without systemctl.
# Packaging source: https://gitlab.archlinux.org/archlinux/packaging/packages/wireplumber/-/commit/9fab437c176cf9f72bb0876421d73dc217b1021a
# Maintainer: David Runge <dvzrv@archlinux.org>
# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgbase=wireplumber
pkgname=(
  wireplumber
  libwireplumber
  wireplumber-docs
  wireplumber-system-services
)
pkgver=0.5.19
pkgrel=1
pkgdesc="Session / policy manager implementation for PipeWire"
url="https://pipewire.pages.freedesktop.org/wireplumber/"
arch=(x86_64)
license=(MIT)
makedepends=(
  doxygen
  git
  'glib2>=2.68'
  'glib2-devel>=2.68'
  glibc
  gobject-introspection
  graphviz
  libgcc
  'libpipewire>=1.0.2'
  'lua>=5.3'
  'meson>=0.59.0'
  pipewire
  python-breathe
  python-lxml
  python-sphinx
  python-sphinx_rtd_theme
  systemd
  systemd-libs
)
checkdepends=(pipewire-audio)
source=(
  "git+https://gitlab.freedesktop.org/pipewire/$pkgbase.git#tag=$pkgver"
)
b2sums=('3cfd6d99d563c08c13948e1c7d48bf25a7255f85ddba576fd3e15acb7d76da20bdaaf4b68dfca88b2a5d6c67d190df377ed358ac236db1168ffd61afaaa4302c')

prepare() {
  cd $pkgbase
}

build() {
  local meson_options=(
    -D elogind=disabled
    -D system-lua=true
    -D systemd-system-service=true
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

_ver=${pkgver:0:3}

_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

package_wireplumber() {
  depends=(
    "libwireplumber=$pkgver-$pkgrel"
    glibc
    libgcc
    libg{lib,object,io}-2.0.so
    'libpipewire>=1.0.2'
    libpipewire-0.3.so
    libsystemd.so
    'lua>=5.3'
    pipewire
    systemd-libs
  )
  optdepends=(
    'wireplumber-docs: Documentation'
    'wireplumber-system-services: System daemon (not recommended)'
  )
  provides=(pipewire-session-manager)
  conflicts=(pipewire-media-session)
  install=wireplumber.install

  meson install -C build --destdir "$pkgdir"

  (
    cd "$pkgdir"

    _pick libw usr/lib/libwireplumber-$_ver.so*
    _pick libw usr/lib/girepository-1.0
    _pick libw usr/lib/pkgconfig
    _pick libw usr/include
    _pick libw usr/share/gir-1.0

    _pick docs usr/share/doc/wireplumber/html

    _pick system usr/lib/systemd/system
  )

  install -Dt "$pkgdir/usr/share/doc/$pkgname" -m644 $pkgbase/{NEWS,README}*
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgbase/LICENSE
}

package_libwireplumber() {
  pkgdesc+=" - client library"
  depends=(
    glibc
    libgcc
    libg{lib,module,object,io}-2.0.so
    libpipewire-0.3.so
  )
  provides=("libwireplumber-$_ver.so" "libwireplumber-$_ver.so=0-64")

  mv libw/* "$pkgdir"

  _verify_soname "$pkgdir/usr/lib/libwireplumber-$_ver.so" "libwireplumber-$_ver.so.0" || return 1

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgbase/LICENSE
}

package_wireplumber-docs() {
  pkgdesc+=" - documentation"

  mv docs/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgbase/LICENSE
}

package_wireplumber-system-services() {
  pkgdesc+=" - system services"
  depends=(
    "wireplumber=$pkgver-$pkgrel"
    pipewire-system-services
  )

  mv system/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgbase/LICENSE
}

