# Maintainer: AndyRTR <andyrtr@archlinux.org>

pkgbase=graphite
pkgname=(graphite graphite-docs)
pkgver=1.3.15
pkgrel=2
epoch=1
arch=('x86_64')
url="https://graphite.sil.org/"
pkgdesc="a \"smart font\" system to handle the complexities of lesser-known languages of the world"
license=('LGPL-2.1-or-later OR MPL-2.0 OR GPL-2.0-or-later')
depends=('glibc' 'libstdc++' 'libgcc')
makedepends=('cmake' 'freetype2' 'python'
             # for documentation
             'doxygen' 'dblatex' 'graphviz' 'asciidoc' 'texlive-xetex')
checkdepends=('python-fonttools')
# https://github.com/silnrsi/graphite/releases/download/1.3.14/graphite2-1.3.14.sha256sum
source=(https://github.com/silnrsi/graphite/releases/download/${pkgver}/graphite2-${pkgver}.tgz
        gcc15.patch)
sha256sums=('c6bc8b4252724665297f7cad0c55897285c673f9b8e6db3522ace833593fe0b1'
            '2296d1c189cfb129403f83e7a704a333147856b37475320965c463386ef9d8ef')
prepare() {
    cd graphite2-${pkgver}
    patch -Np1 -i ../gcc15.patch  # https://github.com/silnrsi/graphite/pull/97
}

build() {
  local cmake_options=(
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -DCMAKE_SKIP_INSTALL_RPATH=ON
    -DGRAPHITE2_COMPARE_RENDERER=OFF
    -DGRAPHITE2_VM_TYPE=direct
  )

  # TeX Live's hooks never run in a build root, so there is no ls-R and the packaged
  # fmtutil.cnf holds no format entries: pdflatex aborts on the missing format and the
  # docs target fails - dblatex for manual.pdf, doxygen's make -C latex for refman.pdf.
  # Assemble fmtutil.cnf and updmap.cfg from the collection fragments and generate them
  # per-user, the way the RLPM texlive hooks do on an installed system.
  export FORCE_SOURCE_DATE=1 # make pdftex adhere to SOURCE_DATE_EPOCH in the shipped refman.pdf
  export TEXMF='{$TEXMFAUXTREES$TEXMFCONFIG,$TEXMFVAR,$TEXMFHOME,$TEXMFLOCAL,$TEXMFSYSCONFIG,$TEXMFSYSVAR,$TEXMFDIST}'
  export TEXMFCONFIG="$srcdir/texmf-config" TEXMFVAR="$srcdir/texmf-var"
  mkdir -p "$TEXMFCONFIG/web2c"
  cat /usr/share/texmf-dist/web2c/fmtutil-hdr.cnf /var/lib/texmf/devario/installedpkgs/*.fmts \
    > "$TEXMFCONFIG/web2c/fmtutil.cnf"
  cat /usr/share/texmf-dist/web2c/updmap-hdr.cfg /var/lib/texmf/devario/installedpkgs/*.maps \
    > "$TEXMFCONFIG/web2c/updmap.cfg"
  fmtutil-user --byfmt pdflatex
  updmap-user

  cmake -S graphite2-${pkgver} -B build "${cmake_options[@]}"
  cmake --build build
  cmake --build build -t docs -j1
}

check() {
  cd build
  ctest --output-on-failure --stop-on-failure -j$(nproc)
}

package_graphite() {
  optdepends=('graphite-docs: Documentation')
  provides=('libgraphite2.so' 'libgraphite2.so=3-64')

  DESTDIR="$pkgdir" cmake --install build
  _verify_soname "$pkgdir/usr/lib/libgraphite2.so" libgraphite2.so.3 || return 1

  # licenses
  install -Dm644 graphite2-${pkgver}/COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_graphite-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  local docdir="${pkgdir}/usr/share/doc/${pkgbase}"
  mkdir -p "${docdir}/api"
  cp -vrf build/doc/doxygen/{html,latex/refman.pdf} "${docdir}/api"
  cp -vrf build/doc/{GTF,manual}.html "${docdir}"

  # licenses
  install -Dm644 graphite2-${pkgver}/COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

# vim:set sw=2 sts=-1 et:

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
