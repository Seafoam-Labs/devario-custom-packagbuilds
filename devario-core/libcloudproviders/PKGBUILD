# Contributor: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Fina Wilke <fina@felinira.net>

pkgbase=libcloudproviders
pkgname=(
  libcloudproviders
  libcloudproviders-docs
)
pkgver=0.4.2
pkgrel=2
pkgdesc="DBus API that allows cloud storage sync clients to expose their services"
url="https://gitlab.gnome.org/GNOME/libcloudproviders"
arch=(x86_64)
license=(LGPL-3.0-or-later)
depends=(
  libgcc
  glib2
  glibc
)
makedepends=(
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  meson
  vala
)
source=("git+$url.git?signed#tag=$pkgver")
b2sums=('8fbee0ce57343b12454b3053aaafb704602d7a8d6352ecc3cedc5a0190ddbebb8d319f62b91cd8b0061d8a576d87ed87310ad84628b792761fba78aa4b0c2c26')
validpgpkeys=(
  AD1483F8A95118F7F0C8AF4A965D4777208E7691 # Corentin Noël <corentin.noel@collabora.com>
)

prepare() {
  cd $pkgname
}

build() {
  local meson_options=(
    -D documentation=true
  )

  arch-meson $pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-suite doc
}

package_libcloudproviders() {
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    libcloudproviders.so
    libcloudproviders.so=0-64
  )

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libcloudproviders.so" libcloudproviders.so.0 || return 1

  mkdir -p doc/usr/share
  mv {"$pkgdir",doc}/usr/share/doc
}

package_libcloudproviders-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv doc/* "$pkgdir"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

