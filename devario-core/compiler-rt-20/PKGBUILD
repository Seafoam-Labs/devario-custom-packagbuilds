# Contributor: Jan "heftig" Steffens <jan.steffens@gmail.com>

pkgname=compiler-rt20
pkgver=20.1.8
pkgrel=2
pkgdesc="Compiler runtime libraries for clang 20"
arch=('x86_64')
url="https://compiler-rt.llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')
depends=(
  'libgcc'
  'libstdc++'
)
makedepends=('llvm20' 'cmake' 'ninja' 'python')
# Build 32-bit compiler-rt libraries on x86_64 (FS#41911)
makedepends_x86_64=('lib32-gcc-libs')
options=('staticlibs' '!lto')
_source_base=https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver
source=($_source_base/compiler-rt-$pkgver.src.tar.xz{,.sig}
        $_source_base/cmake-$pkgver.src.tar.xz{,.sig}
        $_source_base/third-party-$pkgver.src.tar.xz{,.sig}
        remove-linux-scc.patch)
sha256sums=('15277402f6fd63397c0917a5c7171cda82d16d226094b828c1ed0f58f73b9c69'
            'SKIP'
            '3319203cfd1172bbac50f06fa68e318af84dcb5d65353310c0586354069d6634'
            'SKIP'
            '9a4e452a8163732d417db067a89190fcda823cb3aa33199e834ac7c028923f4b'
            'SKIP'
            '78b5797727cc39590a621f2fca1694fc0bb8cfa8f2dcf615fd169939d569fd1f')
validpgpkeys=('474E22316ABF4785A88C6E8EA2C794A986419D8A'  # Tom Stellard <tstellar@redhat.com>
              'D574BD5D1D0E98895E3BF90044F2485E45D59042'  # Tobias Hieta <tobias@hieta.se>
              'FFB3368980F3E6BB5737145A316C56D064CACBA5'  # Douglas Yung <douglas.yung@sony.com>
              '71046D1E9C6656BDD61171873E83BABF4A4F9E85'  # Cullen Rhodes <cullen.rhodes@arm.com>
)

prepare() {
  mv cmake{-$pkgver.src,}
  mv third-party{-$pkgver.src,}
  cd compiler-rt-$pkgver.src
  # LLVM #194116: support Linux headers that no longer provide linux/scc.h.
  patch -Np2 -i "$srcdir/remove-linux-scc.patch"
  mkdir build
}

build() {
  cd compiler-rt-$pkgver.src/build
  export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}"

  local cmake_args=(
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr/lib/llvm20
    -DCMAKE_SKIP_RPATH=ON
    -DLLVM_CMAKE_DIR=/usr/lib/llvm20
    -DCOMPILER_RT_INCLUDE_TESTS=OFF
    -DCOMPILER_RT_INSTALL_PATH=/usr/lib/llvm20/lib/clang/${pkgver%%.*}
  )
  cmake .. "${cmake_args[@]}"
  cmake --build .
}

package() {
  cd compiler-rt-$pkgver.src/build

  DESTDIR="$pkgdir" cmake --install .
  install -Dm644 ../LICENSE.TXT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

