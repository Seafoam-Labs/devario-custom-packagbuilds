# Contributor: Alexander Baldeck <alexander@archlinux.org>

pkgname=pixman
pkgver=0.46.4
pkgrel=2
pkgdesc="The pixel-manipulation library for X and cairo"
arch=(x86_64)
url="https://gitlab.freedesktop.org/pixman/pixman"
license=('MIT')
depends=('glibc')
makedepends=('meson' 'libpng')
provides=('libpixman-1.so' 'libpixman-1.so=0-64')
source=(https://www.x.org/releases/individual/lib/${pkgname}-${pkgver}.tar.xz)
sha512sums=('83b133e7969ba34f883f4e08dcc5d388c4397f43ce836c191c05945fe77c16ff501d531600780c12678a0d08105828a6bdeff2156b63f9c1a84087bc7f40ae9f')
#validpgpkeys=('') # Maarten Lankhorst <maarten.lankhorst@linux.intel.com>

build() {
  local _mesonopts=(
    -D loongson-mmi=disabled
    -D vmx=disabled
    -D arm-simd=disabled
    -D neon=disabled
    -D mips-dspr2=disabled
    -D rvv=disabled
    -D gtk=disabled
  )

  if [[ $CARCH == "x86_64" ]]; then
    _mesonopts+=(
      -D a64-neon=disabled
    )
  fi

  if [[ $CARCH == "aarch64" ]]; then
    _mesonopts+=(
      -D mmx=disabled
      -D sse2=disabled
      -D ssse3=disabled
    )
  fi

  arch-meson $pkgname-$pkgver build "${_mesonopts[@]}"
  ninja -C build
}

check() {
  meson test -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  _verify_soname "$pkgdir/usr/lib/libpixman-1.so" libpixman-1.so.0 || return 1
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgname-$pkgver/COPYING
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
