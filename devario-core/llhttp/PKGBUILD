# Contributor: Marcus Ben Spencer <marcus@marcusspencer.xyz>
# Contributor: George Rawlinson <grawlinson@archlinux.org>

pkgname=llhttp
pkgver=9.4.3
pkgrel=4
pkgdesc='Port of http_parser to llparse'
arch=(x86_64)
url='https://llhttp.org'
license=(MIT)
# The release Makefile links Clang objects without forwarding LTO linker flags.
options=(!lto)
depends=(glibc)
provides=('libllhttp.so' 'libllhttp.so=9.4-64')
makedepends=(clang
             cmake
             git
             npm
             ts-node)
source=(git+https://github.com/nodejs/llhttp#tag=v$pkgver)
sha256sums=('4680f7742e0bd25fd7dd24431a62c82899743f14dea248ec80a7873661d35f38')

build() {
  cd $pkgname

  # codegen
  npm install
  # Upstream's release target lists clean and all as sibling prerequisites.
  # Serialize this step so cleanup cannot remove files during compilation.
  make -j1 release RELEASE="$pkgver"

  # build
  cd ..
  cmake -B build -S $pkgname/release \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Keep the explicit ABI provision accurate for Shelly dependency resolution.
  LC_ALL=C readelf -h "$pkgdir/usr/lib/libllhttp.so" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$pkgdir/usr/lib/libllhttp.so" | grep -Fq 'Library soname: [libllhttp.so.9.4]' || return 1
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" $pkgname/LICENSE
}
