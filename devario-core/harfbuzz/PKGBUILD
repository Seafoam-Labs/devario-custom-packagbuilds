prepare() {
  cd harfbuzz
}

build() {
  local meson_options=(
    -D cpp_std=c++17
    -D graphite2=enabled
  )

  # Harfbuzz wants no exceptions
  CFLAGS="${CFLAGS/-fexceptions/}"
  CXXFLAGS="${CXXFLAGS/-fexceptions/}"

  arch-meson harfbuzz build "${meson_options[@]}"
  meson compile -C build
}

check() {
  mkdir -p tmp
  TMPDIR="$PWD/tmp" meson test -C build --print-errorlogs --no-rebuild
  rm -r tmp
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_harfbuzz() {
  depends=(
    freetype2 libfreetype.so
    glib2 libg{lib,object}-2.0.so
    glibc
    graphite libgraphite2.so
    libpng libpng16.so
    zlib libz.so
  )
  optdepends=('harfbuzz-utils: utilities')
  provides=(
    libharfbuzz{,-{subset,gobject,raster,vector}}.so
    'libharfbuzz.so=0-64'
    'libharfbuzz-subset.so=0-64'
    'libharfbuzz-gobject.so=0-64'
    'libharfbuzz-raster.so=0-64'
    'libharfbuzz-vector.so=0-64'
  )

  meson install -C build --destdir "$pkgdir" --no-rebuild
  local library
  for library in libharfbuzz{,-{subset,gobject,raster,vector}}; do
    _verify_soname "$pkgdir/usr/lib/$library.so" "$library.so.0" || return 1
  done

  ( cd "$pkgdir"

    _pick hb-cairo usr/lib/libharfbuzz-cairo*
    _pick hb-cairo usr/lib/pkgconfig/harfbuzz-cairo.pc
    _pick hb-cairo usr/include/harfbuzz/hb-cairo.h

    _pick hb-icu usr/lib/libharfbuzz-icu*
    _pick hb-icu usr/lib/pkgconfig/harfbuzz-icu.pc
    _pick hb-icu usr/include/harfbuzz/hb-icu.h

    _pick hb-utils usr/bin
    _pick hb-utils usr/share/man/man1

    _pick hb-docs usr/share/gtk-doc
  )

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 harfbuzz/COPYING
}

package_harfbuzz-cairo() {
  pkgdesc+=" - Cairo integration"
  depends=(
    cairo libcairo.so
    freetype2
    glib2
    glibc
    graphite
    harfbuzz libharfbuzz.so
  )
  provides=(libharfbuzz-cairo.so 'libharfbuzz-cairo.so=0-64')

  mv hb-cairo/* "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libharfbuzz-cairo.so" libharfbuzz-cairo.so.0 || return 1

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 harfbuzz/COPYING
}

package_harfbuzz-icu() {
  pkgdesc+=" - ICU integration"
  depends=(
    glibc
    harfbuzz libharfbuzz.so
    icu libicuuc.so
  )
  provides=(libharfbuzz-icu.so 'libharfbuzz-icu.so=0-64')

  mv hb-icu/* "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libharfbuzz-icu.so" libharfbuzz-icu.so.0 || return 1

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 harfbuzz/COPYING
}

package_harfbuzz-utils() {
  pkgdesc+=" - Utilities"
  depends=(
    cairo libcairo.so
    chafa libchafa.so
    freetype2 libfreetype.so
    glew libGLEW.so
    glfw
    glib2 libg{lib,object}-2.0.so
    glibc
    harfbuzz libharfbuzz{,-gobject,-subset}.so
    harfbuzz-cairo libharfbuzz-cairo.so
    libgl libGL.so
    libstdc++ libstdc++.so
  )

  mv hb-utils/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 harfbuzz/COPYING
}

package_harfbuzz-docs() {
  pkgdesc+=" - Documentation"

  mv hb-docs/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 harfbuzz/COPYING
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

