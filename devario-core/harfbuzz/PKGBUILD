  "git+https://github.com/harfbuzz/harfbuzz?signed#tag=$pkgver"
)
b2sums=('49b05d0f5af343e1576938bcde78fc1687ff50cab9b7ab3c0fcdf0ae1ac4abbbd80c52bd56b4711833519b85e1bca3a8473b5121b575482c0f7903a5c316d26b')
