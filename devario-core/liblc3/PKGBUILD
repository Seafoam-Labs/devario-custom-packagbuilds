# Contributor: OSAMC <https://github.com/osam-cologne/archlinux-proaudio>
# Contributor: Florian Hülsmann <fh@cbix.de>

pkgname=liblc3
pkgver=1.1.3
pkgrel=3
pkgdesc="Low Complexity Communication Codec library and tools"
url="https://github.com/google/liblc3"
arch=(x86_64)
license=(Apache-2.0)
depends=(glibc)
makedepends=(
  git
  meson
  python
)
optdepends=('python: Python bindings')
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  liblc3.so
  'liblc3.so=1-64'
)
source=("git+$url#tag=v$pkgver")
b2sums=('5cd325138c59baa56317e6d0ccf04003743202b915e5efe7f9284153150f7bc5158e1a432eb0366c6640e2964b723b1ff28e8735da7cdb9c102870debc413cd3')

prepare() {
  cd liblc3
}

build() {
  local meson_options=(
    -D python=true
    -D tools=true
  )

  arch-meson liblc3 build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/liblc3.so" liblc3.so.1 || return 1
  install -Dt "$pkgdir/usr/share/doc/$pkgname" -m644 liblc3/README.md
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

