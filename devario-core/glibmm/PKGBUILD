# Contributor: Jan de Groot <jgc@archlinux.org>
# Contributor: Tom Newsom <Jeepster@gmx.co.uk>

pkgbase=glibmm
pkgname=(
  glibmm
  glibmm-docs
)
pkgver=2.66.10
pkgrel=2
pkgdesc="C++ bindings for GLib"
url="https://www.gtkmm.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  libgcc
  libsigc++
  libstdc++
  perl
)
makedepends=(
  clang
  git
  libsigc++-docs
  meson
  mm-common
  perl-xml-parser
)
checkdepends=(glib-networking)
options=(!emptydirs)
source=("git+https://gitlab.gnome.org/GNOME/glibmm.git#tag=$pkgver")
b2sums=('6075c2243eff2abfd991aaf822b69e2df4935f3773834b64865d1eb69a563b48d5c7ea6419e3cc5d59d20e12eb73153821150f86e8ed25fae658a6e910420e7e')

prepare() {
  cd glibmm
}

build() {
  local meson_options=(
    -D maintainer-mode=true
  )

  arch-meson glibmm build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_glibmm() {
  # Pinned: devario-core/libsigc++ publishes libsigc-2.0.so=0-64 in this batch.
  depends+=(libsigc-2.0.so=0-64)
  # Shelly keeps a bare .so provision without expanding it to the SONAME.
  provides=(
    libglibmm-2.4.so
    libglibmm-2.4.so=1-64
    libgiomm-2.4.so
    libgiomm-2.4.so=1-64
  )

  meson install -C build --destdir "$pkgdir"
  _verify_soname "$pkgdir/usr/lib/libglibmm-2.4.so" libglibmm-2.4.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libgiomm-2.4.so" libgiomm-2.4.so.1 || return 1

  # Split -docs
  mkdir -p docs/usr/share
  mv -t docs/usr/share "$pkgdir"/usr/share/{devhelp,doc}
}

package_glibmm-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  options=(!strip)

  mv -t "$pkgdir" docs/*
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}

