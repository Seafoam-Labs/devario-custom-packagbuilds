pkgname=vulkan-icd-loader
pkgver=1.4.364
pkgrel=1
pkgdesc='Vulkan Installable Client Driver (ICD) loader'
arch=('x86_64')
url='https://github.com/KhronosGroup/Vulkan-Loader'
license=('Apache-2.0' 'MIT' 'HPND-Kevlin-Henney')
depends=('glibc')
makedepends=('cmake' 'ninja' 'pkgconf' 'python' 'libx11' 'libxcb' 'libxrandr' 'wayland' "vulkan-headers>=$pkgver")
optdepends=('vulkan-driver: Vulkan implementation for your GPU')
provides=('libvulkan.so')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2d5e5a84e83c5360a828d02d828e900380ecf1ac8c7d3182650b7755d11cf536')

build() {
  cmake -S "Vulkan-Loader-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_REQUIRE_FIND_PACKAGE_VulkanHeaders=ON \
    -DBUILD_WSI_XCB_SUPPORT=ON \
    -DBUILD_WSI_XLIB_SUPPORT=ON \
    -DBUILD_WSI_XLIB_XRANDR_SUPPORT=ON \
    -DBUILD_WSI_WAYLAND_SUPPORT=ON \
    -DBUILD_TESTS=OFF \
    -DUPDATE_DEPS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "Vulkan-Loader-$pkgver/LICENSE.txt" \
    -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "Vulkan-Loader-$pkgver/"LICENSES/*.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
