pkgname = nvidia-utils
	pkgdesc = NVIDIA driver utilities
	install = nvidia-utils.install
	depends = libglvnd
	depends = egl-wayland>=1.1.9
	depends = egl-wayland2
	depends = egl-gbm
	depends = egl-x11
	depends = libx11
	depends = libxext
	depends = wayland
	depends = lib32-zlib
	depends = lib32-gcc-libs
	depends = lib32-libglvnd
	optdepends = nvidia-settings: configuration tool
	optdepends = xorg-server: Xorg support
	optdepends = xorg-server-devel: nvidia-xconfig
	optdepends = opencl-nvidia: OpenCL support
	optdepends = lib32-opencl-nvidia: 32-bit OpenCL support
	provides = vulkan-driver
	provides = opengl-driver
	provides = nvidia-libgl
	provides = lib32-nvidia-utils=620.70.06
	provides = lib32-vulkan-driver
	provides = lib32-opengl-driver
	provides = lib32-nvidia-libgl
	conflicts = nvidia-libgl
	conflicts = lib32-nvidia-utils
	conflicts = lib32-nvidia-libgl
	replaces = nvidia-libgl
	replaces = lib32-nvidia-utils
	replaces = lib32-nvidia-libgl

pkgname = opencl-nvidia
	pkgdesc = NVIDIA OpenCL implementation
	depends = zlib
	optdepends = opencl-headers: headers necessary for OpenCL development
	provides = opencl-driver

pkgname = lib32-opencl-nvidia
	pkgdesc = NVIDIA OpenCL implementation (32-bit)
	depends = lib32-zlib
	depends = lib32-gcc-libs
	optdepends = opencl-headers: headers necessary for OpenCL development
	provides = lib32-opencl-driver

pkgname = nvidia-open-dkms
	pkgdesc = NVIDIA open kernel modules - module sources
