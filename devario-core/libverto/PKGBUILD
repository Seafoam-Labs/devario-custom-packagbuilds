# Maintainer: Andreas Radke <andyrtr@archlinux.org>
# Contributor: Mantas Mikulėnas <grawity@gmail.com>

pkgname=libverto
pkgver=0.3.2
pkgrel=7
pkgdesc="Main event loop abstraction library"
arch=('x86_64')
url="https://github.com/latchset/libverto"
license=('MIT')
depends=('glibc' 'libevent')
provides=('libverto.so' 'libverto.so=1-64' 'libverto-libevent.so' 'libverto-libevent.so=1-64' 'libverto-module-base')
conflicts=("krb5<1.19.3-2" "libverto-libevent<0.3.2-4")
replaces=("libverto-libevent<0.3.2-4")
source=("https://github.com/latchset/libverto/releases/download/$pkgver/libverto-$pkgver.tar.gz")
sha256sums=('8d1756fd704f147549f606cd987050fb94b0b1ff621ea6aa4d6bf0b74450468a')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr \
    --disable-static \
    --with-libevent \
    --without-libev \
    --without-glib
  make
}

check() {
  cd "$pkgname-$pkgver"
  make check
}

package_libverto() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  _verify_soname "$pkgdir/usr/lib/libverto.so" libverto.so.1 || return 1
  _verify_soname "$pkgdir/usr/lib/libverto-libevent.so" libverto-libevent.so.1 || return 1

  install -Dm0644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
