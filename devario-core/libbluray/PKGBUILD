# Contributor: Ionut Biru <ibiru@archlinux.org>
# Contributor: Bartłomiej Piotrowski <bpiotrowski@archlinux.org>
# Contributor: Andrew Cook <ariscop@gmail.com>

pkgname=libbluray
pkgver=1.5.1
pkgrel=2
pkgdesc='Library to access Blu-Ray disks for video playback'
arch=(x86_64)
url=https://www.videolan.org/developers/libbluray.html
license=(LGPL-2.1-only)
depends=(
  fontconfig
  glibc
  'libfreetype.so=6-64'  # published freetype2 2.14.3-2 declares the pinned form
  libxml2
)
makedepends=(
  apache-ant
  git
  java-environment=17
  meson
  ninja
)
optdepends=('java-runtime: BD-J library')
# Shelly keeps a bare .so provision without expanding it to the SONAME.
provides=(
  libbluray.so
  'libbluray.so=4-64'
)
source=(
  git+https://code.videolan.org/videolan/libbluray.git#tag=${pkgver}
  git+https://code.videolan.org/videolan/libudfread.git
)
b2sums=('c6d5fa659c605e69b2e47d23564995f451ad57182b47a0509e21b589f926992bd3adf4d2355b4beafb1467e84b0319ffd422544861b63583db308b99b79cbfcb'
        'SKIP')

prepare() {
  cd libbluray
  for submodule in contrib/libudfread; do
    git submodule init ${submodule}
    git config submodule.${submodule}.url ../${submodule#*/}
    git -c protocol.file.allow=always submodule update ${submodule}
  done
}

build() {
  arch-meson libbluray build
  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
  _verify_soname "${pkgdir}/usr/lib/libbluray.so" libbluray.so.4 || return 1
}

# Shelly preserves explicit ABI provisions. Refuse to publish stale values.
_verify_soname() {
  LC_ALL=C readelf -h "$1" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$1" | grep -Fq "Library soname: [$2]" || return 1
}
