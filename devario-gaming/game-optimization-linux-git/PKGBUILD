# Maintainer: Piotr Gorski <lucjan.lucjanov@gmail.com>

_pkgname=Game-Optimization-Linux
pkgname=game-optimization-linux-git
pkgver=2.2.0beta.r1.g285cc87
pkgrel=1
pkgdesc="GameOpti: per-game Linux launch profiles, upscaling, MangoHud and Btrfs storage tools (git)"
arch=('any')
url="https://github.com/DevVoidPL/Game-Optimization-Linux"
license=('MIT')
depends=(
  'hicolor-icon-theme'
  'polkit'
  'pyside6'
  'python'
  'python-py7zr'
  'python-yaml'
)
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  '7zip: OptiScaler archives that use the BCJ2 filter'
  'btrfs-progs: Btrfs compression of game folders'
  'compsize: Btrfs compression measurements'
  'gamemode: GameMode in launch profiles'
  'gamescope: Gamescope in launch profiles'
  'mangohud: MangoHud presets and performance logging'
  'sdl3: controller input for Couch Mode'
  'vkbasalt: vkBasalt/ReShade post-processing'
)
provides=('game-optimization-linux')
conflicts=('game-optimization-linux')
install="$pkgname.install"
source=("git+$url.git"
        "game-optimization-install-runner")
b2sums=('SKIP'
        'd7a46c4d62bfb2a14553f8f4618bb27e99d4379e48368f4374a96c4d207c60839d93f757657e26368244fb56907b30f1bb1772e270e880acdee82f6c208b6b9f')

pkgver() {
  cd "$_pkgname"
  # v2.2.0-Beta-1-g285cc87 -> 2.2.0beta.r1.g285cc87
  git describe --long --tags --abbrev=7 \
    | sed -E 's/^v//; s/-([0-9]+)-g([0-9a-f]+)$/.r\1.g\2/; s/-//g' \
    | tr '[:upper:]' '[:lower:]'
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  # The upstream pytest suite is not used: at v2.2.0-Beta about 15 of its 118
  # files fail or segfault headless (QtMultimedia, animation timing, stale
  # expectations), also as non-root. Smoke-test the built wheel instead.
  local _root="$srcdir/check-root"
  rm -rf "$_root"
  python -m installer --destdir="$_root" dist/*.whl
  local _site
  _site=$(python -c 'import site, sys; print(site.getsitepackages()[0])')

  QT_QPA_PLATFORM=offscreen PYTHONPATH="$_root$_site" python - <<'PY'
import importlib, pkgutil, pathlib
import game_optimization_linux as pkg
root = pathlib.Path(pkg.__file__).parent
for need in ("qml/qmldir", "qml/couch", "translations/game_optimization_pl.qm"):
    assert (root / need).exists(), f"missing from wheel: {need}"
names = [m.name for m in pkgutil.walk_packages(pkg.__path__, pkg.__name__ + ".")]
for name in names:
    importlib.import_module(name)
print(f"imported {len(names)} modules")
PY
  # The Steam runner builds a launch plan without starting anything; keep its
  # report out of the real home.
  local _home="$srcdir/check-home"
  rm -rf "$_home"
  HOME="$_home" XDG_CONFIG_HOME="$_home/config" XDG_DATA_HOME="$_home/data" \
  XDG_STATE_HOME="$_home/state" XDG_CACHE_HOME="$_home/cache" \
  PYTHONPATH="$_root$_site" \
    python -m game_optimization_linux.runner --appid 440 --plan-only -- /bin/true
}

package() {
  cd "$_pkgname"
  local _id=io.github.DevVoidPL.GameOptimizationLinux

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 "data/$_id.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "data/$_id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  local _icon
  for _icon in data/icons/hicolor/*/apps/"$_id".*; do
    install -Dm644 "$_icon" "$pkgdir/usr/share/${_icon#data/}"
  done

  # Read-only Btrfs measurement helper + its polkit action. Both paths are
  # hardcoded upstream (services/privileged_measurement.py, the .policy file).
  install -Dm755 libexec/game-optimization-linux-measure-helper -t "$pkgdir/usr/libexec/"
  install -Dm644 "data/$_id.measure.policy" -t "$pkgdir/usr/share/polkit-1/actions/"

  # Per-user Steam runner setup for the system package (see the script).
  install -Dm755 "$srcdir/game-optimization-install-runner" -t "$pkgdir/usr/bin/"

  install -Dm644 README.md docs/frame-generation.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
