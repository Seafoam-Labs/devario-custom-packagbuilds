# Contributor: Jason Stryker <public at jasonstryker dot com>
# Contributor: Konstantin Liberty <jon9097 at gmail dot com>

pkgname=protontricks
pkgver=1.15.1
pkgrel=1
pkgdesc="Run Winetricks commands for Steam Play/Proton games among other common Wine features"
arch=('any')
url="https://github.com/Matoking/protontricks"
license=('GPL-3.0-only')
depends=(
  'python'
  'python-pillow'
  'python-vdf'
  'winetricks'
)
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-setuptools-scm'
  'python-wheel'
)
optdepends=(
  'yad: GUI for game selection'
  'zenity: GUI for winetricks'
)
source=("git+$url.git#tag=$pkgver")
b2sums=('e490e8a7a02173b909b5f680d233258540c3b97169ace660f50b3cf4f55df50152abe96fa8a1d7457eafc74ee9efe8f036fd4088cc1bc0ba6000bb8befcf653e')

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" ./*.md

  # We already install the desktop entries, not needed
  rm -v "$pkgdir/usr/bin/protontricks-desktop-install"
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  rm -vr "$pkgdir/$site_packages/protontricks/data/share"
}
