# Maintainer: Faugus <felix.ribeiro@live.com>

pkgname=faugus-launcher
pkgver=2.5.5
pkgrel=1
pkgdesc="A simple and lightweight app for running Windows games using UMU-Launcher"
arch=('any')
url="https://github.com/Faugus/faugus-launcher"
license=('MIT')
depends=('python-gobject' 'python-requests' 'python-pillow' 'python-vdf' 'python-psutil' 'icoextract' 'gtk4' 'libadwaita' 'libmanette')
makedepends=('meson>=1.2.0' 'gettext')
provides=('faugus-launcher')
conflicts=('faugus-launcher')
source=("https://github.com/Faugus/${pkgname}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('6109783545294f7be3111c98a0997b284d693678c836013f9a313932766b1f6a')

build() {
    cd "${pkgname}-${pkgver}"
    meson setup --prefix=/usr --libexecdir=lib --sbindir=bin \
      --buildtype=plain --auto-features=enabled --wrap-mode=nodownload \
      -Db_pie=true -Dpython.bytecompile=1 . build
    meson compile -C build
}

package() {
    cd "${pkgname}-${pkgver}"
    DESTDIR="${pkgdir}" meson install -C build
}
