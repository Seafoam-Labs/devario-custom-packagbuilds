# Maintainer: Seafoam Labs recipe maintainers
# Source build from Vysp3r/ProtonPlus; no AUR build or runtime dependency.

pkgname=protonplus
pkgver=0.6.8
pkgrel=2.1
pkgdesc='A modern compatibility tools manager for Linux game launchers'
arch=('x86_64')
url='https://github.com/Vysp3r/ProtonPlus'
license=('GPL-3.0-or-later')
depends=('appstream' 'cairo' 'glib2' 'glibc' 'gtk4' 'json-glib'
         'libadwaita>=1.6' 'libarchive' 'libgee' 'libnotify' 'libsoup3' 'sdl3>=3.2.0')
makedepends=('desktop-file-utils' 'gettext' 'meson' 'ninja' 'python' 'vala')
optdepends=('steam: manage Steam compatibility tools'
            'lutris: manage Lutris Wine runners')
_commit=6038800818562e6fbe6ac978c92544a756ffba73
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/Vysp3r/ProtonPlus/tar.gz/$_commit")
sha256sums=('3ca8c5ed38f2b9c7a91acc2130c8f7d52f09531d4a602890d760e47187e7acb7')

build() {
  # Use Meson directly with the same packaging settings as the former wrapper.
  meson setup --prefix=/usr --libexecdir=lib --sbindir=bin \
    --buildtype=plain --auto-features=enabled --wrap-mode=nodownload \
    -Db_pie=true -Dpython.bytecompile=1 "ProtonPlus-$_commit" build
  meson compile -C build
}

check() {
  # The clean build root has no compiled GSettings schemas, and the app's own
  # schema is not installed yet, so the unit tests abort with "No GSettings
  # schemas are installed". Compile the project's schemas into a private dir
  # and use the in-memory backend so no dconf is needed.
  local _schemas="$srcdir/test-schemas"
  mkdir -p "$_schemas"
  /usr/bin/find "ProtonPlus-$_commit" -name '*.gschema.xml' -exec cp -t "$_schemas" {} +
  glib-compile-schemas "$_schemas"

  GSETTINGS_SCHEMA_DIR="$_schemas" GSETTINGS_BACKEND=memory \
    meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "ProtonPlus-$_commit/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
