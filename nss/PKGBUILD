# Based on Arch Linux's NSS packaging by Jan Alexander Steffens and Jan de Groot.
pkgbase=nss
pkgname=('nss' 'ca-certificates-mozilla')
pkgver=3.130
pkgrel=2
pkgdesc='Network Security Services'
url='https://firefox-source-docs.mozilla.org/security/nss/index.html'
arch=('x86_64')
license=('MPL-2.0')
depends=('glibc' 'nspr' 'p11-kit' 'sh' 'sqlite' 'zlib')
makedepends=('gyp' 'ninja' 'openssl' 'perl' 'pkgconf' 'python')

# Shelly supports HTTPS archives, but not Arch's hg+https source protocol.
# The tarball digest is published in Mozilla's adjacent SHA256SUMS file.
source=(
  "https://archive.mozilla.org/pub/security/nss/releases/NSS_${pkgver//./_}_RTM/src/nss-${pkgver}.tar.gz"
  0001-Fix-generating-nss.pc-with-system-nspr.patch
  bundle.sh
  certdata2pem.py
)
sha256sums=(
  'afab9f82c78bfa3e7e8b4a61ac31922675c58203f67ff385a2714df7fe9bd5c5'
  'a6dafd549f4f6cbf14c9a5c61c3347d9283488372f0b52037139602b0b0fa08e'
  '3bfadf722da6773bdabdd25bdf78158648043d1b7e57615574f189a88ca865dd'
  'd2a1579dae05fd16175fac27ef08b54731ecefdf414085c610179afcf62b096c'
)

prepare() {
  cd "${srcdir}"
  mkdir -p certs
  ln -srft certs "nss-${pkgver}/nss/lib/ckfw/builtins/"{certdata.txt,nssckbi.h}

  cd "nss-${pkgver}/nss"
  patch -Np1 -i "${srcdir}/0001-Fix-generating-nss.pc-with-system-nspr.patch"
}

build() {
  cd "${srcdir}/certs"
  python "${srcdir}/certdata2pem.py"

  cd "${srcdir}"
  sh ./bundle.sh

  cd "nss-${pkgver}/nss"
  ./build.sh \
    --disable-tests \
    --enable-libpkix \
    --opt \
    --system-nspr \
    --system-sqlite
}

package_nss() {
  cd "${srcdir}/nss-${pkgver}"
  local nsprver="$(pkg-config --modversion nspr)"
  local libdir=/usr/lib includedir=/usr/include/nss

  sed nss/pkg/pkg-config/nss.pc.in \
    -e 's,%prefix%,/usr,g' \
    -e 's,%exec_prefix%,${prefix},g' \
    -e "s,%libdir%,${libdir},g" \
    -e "s,%includedir%,${includedir},g" \
    -e "s,%NSPR_VERSION%,${nsprver},g" \
    -e "s,%NSS_VERSION%,${pkgver},g" |
    install -Dm644 /dev/stdin "${pkgdir}${libdir}/pkgconfig/nss.pc"
  ln -s nss.pc "${pkgdir}${libdir}/pkgconfig/mozilla-nss.pc"

  install -Dt "${pkgdir}${libdir}" dist/Release/lib/*.so

  local vmajor vminor vpatch
  { read -r vmajor; read -r vminor; read -r vpatch; } \
    < <(awk '/#define.*NSS_V(MAJOR|MINOR|PATCH)/ {print $3}' nss/lib/nss/nss.h)
  sed nss/pkg/pkg-config/nss-config.in \
    -e 's,@prefix@,/usr,g' \
    -e 's,@exec_prefix@,/usr,g' \
    -e "s,@libdir@,${libdir},g" \
    -e "s,@includedir@,${includedir},g" \
    -e "s,@MOD_MAJOR_VERSION@,${vmajor},g" \
    -e "s,@MOD_MINOR_VERSION@,${vminor},g" \
    -e "s,@MOD_PATCH_VERSION@,${vpatch},g" |
    install -D /dev/stdin "${pkgdir}/usr/bin/nss-config"

  install -Dt "${pkgdir}/usr/bin" \
    dist/Release/bin/{*util,shlibsign,signtool,signver,ssltap}
  install -Dt "${pkgdir}${includedir}" -m644 dist/public/nss/*.h
  install -Dt "${pkgdir}/usr/share/man/man1" -m644 \
    nss/doc/nroff/{*util,signtool,signver,ssltap}.1

  # Keep system trust integration through p11-kit, as in Arch's package.
  ln -sf pkcs11/p11-kit-trust.so "${pkgdir}${libdir}/libnssckbi.so"
}

package_ca-certificates-mozilla() {
  pkgdesc="Mozilla's set of trusted CA certificates"
  depends=('ca-certificates-utils>=20181109-3')
  install -Dm644 "${srcdir}/ca-bundle.trust.p11-kit" \
    "${pkgdir}/usr/share/ca-certificates/trust-source/mozilla.trust.p11-kit"
}
