# Maintainer: Devario maintainers

pkgname=fluent-icon-theme
pkgver=2026.07.27
pkgrel=1
pkgdesc='Fluent design icon theme'
arch=('any')
url='https://github.com/vinceliuice/Fluent-icon-theme'
license=('GPL-3.0-only')
depends=('gtk-update-icon-cache' 'hicolor-icon-theme')
options=('!strip')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/2026-07-27.tar.gz")
sha256sums=('24a8aca29a5b652a0e60ff8e5f12b86fe4b9c4c969565fad7c3fa7c1742b3631')

prepare() {
  cd "Fluent-icon-theme-2026-07-27"
  # Package-manager hooks generate caches after installation.
  sed -i '/^[[:space:]]*gtk-update-icon-cache /d' install.sh
}

package() {
  cd "Fluent-icon-theme-2026-07-27"
  install -d "$pkgdir/usr/share/icons"
  bash install.sh -d "$pkgdir/usr/share/icons"
  # Omit upstream aliases whose target icons are absent.
  find "$pkgdir/usr/share/icons" -xtype l -delete
}
