# Maintainer: Devario maintainers

pkgname=capitaine-cursors
pkgver=4
pkgrel=1
pkgdesc='macOS-inspired Capitaine cursors in dark and light variants'
arch=('any')
url='https://github.com/keeferrourke/capitaine-cursors'
license=('LGPL-3.0-or-later')
makedepends=('bc' 'librsvg' 'xorg-xcursorgen')
options=('!strip')
source=(
  "capitaine-cursors-4-capitaine-cursors.tar.gz::$url/archive/refs/tags/r4.tar.gz"
)
sha256sums=(
  '41f66e9f4d41729dc5e9185aab3bc4a719fdcca939e6f3f590b6b811b28dedd2'
)

prepare() {
  cd "capitaine-cursors-r$pkgver"
  # Render the SVGs with librsvg instead of the obsolete Inkscape CLI.
  # Explicit dimensions determine the output size; no DPI argument is needed.
  sed -i 's/inkscape -z -e /rsvg-convert -o /; s/ -d $5 / /' build.sh
}

build() {
  cd "capitaine-cursors-r$pkgver"
  bash build.sh -t dark -d xhd
  bash build.sh -t light -d xhd
}

package() {
  cd "capitaine-cursors-r$pkgver"
  install -d "$pkgdir/usr/share/icons"
  cp -r dist/dark "$pkgdir/usr/share/icons/capitaine-cursors"
  cp -r dist/light "$pkgdir/usr/share/icons/capitaine-cursors-light"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
