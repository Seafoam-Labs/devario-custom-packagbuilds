# Maintainer: Devario maintainers

pkgname=colloid-icon-theme
pkgver=2026.08.10
pkgrel=1
pkgdesc='Rounded Colloid icon theme'
arch=('any')
url='https://github.com/vinceliuice/Colloid-icon-theme'
license=('GPL-3.0-only')
depends=('gtk-update-icon-cache' 'hicolor-icon-theme')
optdepends=('breeze-icons: fallback icons')
options=('!strip')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/2026-08-10.tar.gz")
sha256sums=('367c3ce3ab85721e41ca9aa4fccd1761ec236d1b8cd7daf65f5e9ec88c1a8a15')

prepare() {
  cd "Colloid-icon-theme-2026-08-10"
  # Package-manager hooks generate caches after installation.
  sed -i '/^[[:space:]]*gtk-update-icon-cache /d' install.sh
}

package() {
  cd "Colloid-icon-theme-2026-08-10"
  install -d "$pkgdir/usr/share/icons"
  bash install.sh -d "$pkgdir/usr/share/icons"
  # Omit upstream aliases whose target icons are absent.
  find "$pkgdir/usr/share/icons" -xtype l -delete
}
