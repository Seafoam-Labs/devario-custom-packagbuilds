  'b330d59ce8e0e460209f638a97ce772b78d9e6b56ccf63c8a50e9d941289a1af'
  '85a9dfc31f68a13d536e67200abeb72956300b5388cd3c239b1ce2e198dcadd8'
)

package() {
  install -d "$pkgdir/usr/share/icons"
