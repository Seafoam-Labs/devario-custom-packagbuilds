# Maintainer: Noam Lewis
#
# Adapted for Devario from the upstream AUR source recipe.

pkgname=fresh-editor
pkgver=0.5.8
pkgrel=1
pkgdesc='A lightweight, fast terminal-based text editor with LSP support and TypeScript plugins'
url='https://getfresh.dev/'
license=('GPL-3.0-or-later')
arch=('x86_64')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'clang')
provides=('fresh-editor')
conflicts=('fresh-editor-bin')
# `!lto`: makepkg's default `lto` option adds -flto=auto to CFLAGS, so clang
# emits the C dependencies (QuickJS, ...) as LLVM bitcode. rustc then links
# with its own bundled rust-lld, which cannot read bitcode from a newer system
# clang ("Unknown attribute kind (105)"). Plain object files have no LLVM
# version coupling; Rust's own LTO (profile.release) is unaffected.
options=('!debug' '!lto')
source=("fresh-editor-${pkgver}-source.tar.gz::https://github.com/sinelaw/fresh/releases/download/v${pkgver}/fresh-editor-${pkgver}-source.tar.gz")
sha256sums=('a36fa779b44a76ee589bd66a4d91a216ed9e3995ceca9f1a5811935fbb6eb5d3')

prepare() {
  cd "fresh-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "fresh-$pkgver"
  export CARGO_TARGET_DIR=target
  export CC=clang
  # Do not embed a FRESH_BUILD_CHANNEL or install an update receipt. Devario
  # updates this package through the standard system upgrade, so Fresh must
  # not be given a channel-specific update path.
  # `web` is opt-in in Cargo.toml (it embeds the browser UI and pulls in the
  # sha1 WebSocket-handshake dep), so it has to be named here or the package
  # ships a `fresh` that rejects `--web` (#3316).
  cargo build --locked --release --features web
}

package() {
  cd "fresh-$pkgver"

  # Binary (installed alongside plugins, symlinked from /usr/bin)
  install -Dm755 target/release/fresh "$pkgdir/usr/share/$pkgname/fresh"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/share/$pkgname/fresh" "$pkgdir/usr/bin/fresh"

  # Documentation
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # License
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Plugins
  cp -r crates/fresh-editor/plugins "$pkgdir/usr/share/$pkgname/"

  # Keymaps
  cp -r crates/fresh-editor-core/keymaps "$pkgdir/usr/share/$pkgname/"

  # Desktop file
  install -Dm644 crates/fresh-editor/resources/fresh.desktop "$pkgdir/usr/share/applications/fresh.desktop"

  # Hicolor icons
  for icon in docs/icons/linux/hicolor/*/apps/fresh.png; do
    size=$(basename "$(dirname "$(dirname "$icon")")")
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${size}/apps/fresh.png"
  done
}