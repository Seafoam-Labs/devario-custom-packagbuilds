pkgname=python-pycryptodomex
pkgver=4.6.0
pkgrel=1

pkgdesc='A self-contained Python package of low-level cryptographic primitives'
url='https://www.pycryptodome.org/'
arch=('x86_64')
license=('BSD-2-Clause')

depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Legrandin/pycryptodome/archive/refs/tags/v4.6.0.tar.gz")
sha512sums=('b4774581afe696f4005be2e4303759d74e8c566af7b158d1894d1496090b1e871c278a19d783d24bee70c5b5dd4d0393a6951493b07429ae649db4a04e59380b')

build() {
    cd "pycryptodome-${pkgver}"
    python -m build --wheel --no-isolation
}

package_python-pycryptodomex() {
    cd "pycryptodome-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 LICENSE.rst "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.rst
}
