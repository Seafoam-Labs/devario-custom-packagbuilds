# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=llama-cpp
pkgver=0.8.0
pkgrel=1
pkgdesc='LLM inference in C/C++'
arch=(x86_64)
url=https://github.com/ggml-org/llama.cpp
license=(MIT)
depends=(
  'ggml=0.28.0'
  glibc
  libgcc
  libstdc++
  'openssl>=3.0'
)
makedepends=(
  'cmake>=3.18'
  git
  ninja
  npm
)
source=(git+https://github.com/ggml-org/llama.cpp.git#tag=v${pkgver}
        llama-server-system.service
        llama-server-user.service)
b2sums=('6a76b003b984de82764ada91f18cde7924df0e6d79b15a567138d3281983c3cd26fe1cf92fe4ffd08f60e84f60785ff25e647d56eb96048e5c150f89b93d28b8'
        '1be8149b527a245ef35ef5ec0f93d50187608636905f78d7d28c090105db4a11ca2eed9871622bd78d44087acaef9d1d6012c6db58ba6c4451c0967c44d1a958'
        'a9414c96f069d0aaa287eb0f9c1f30c751612e53901014e38d4ef1b6c71eb98be1036b02413620ddcdbecb5d3830f4c0c83c6e1812b8a63b70e6fe9f3d2a137c')

build() {
  pushd "./llama.cpp/tools/ui"
  npm ci --ignore-scripts
  npm run build
  popd

  cmake -S llama.cpp -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=None \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DLLAMA_BUILD_IS_DEV=OFF \
      -DLLAMA_BUILD_APP=OFF \
      -DLLAMA_BUILD_EXAMPLES=ON \
      -DLLAMA_BUILD_SERVER=ON \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_TOOLS=ON \
      -DLLAMA_BUILD_UI=ON \
      -DLLAMA_USE_SYSTEM_GGML=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm 644 llama.cpp/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
  install -Dm 644 llama-server-system.service "${pkgdir}"/usr/lib/systemd/system/llama-server.service
  install -Dm 644 llama-server-user.service "${pkgdir}"/usr/lib/systemd/user/llama-server.service
  sed -i "s/%PKGVER%/$pkgver/g" "${pkgdir}"/usr/lib/systemd/*/llama-server.service
  mkdir -p "${pkgdir}"/usr/share/llama/models
}
