# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>

pkgname=opencode
pkgver=2.3.0
pkgrel=1
pkgdesc='The open source coding agent'
arch=('x86_64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
depends=(
  'curl'
  'glibc'
  'icu'
  'ripgrep'
  'tar'
)
makedepends=(
  'bun>=1.4.4'
  'bun<2'
  'git'
)
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
)
options=(
  '!debug'
  '!strip'
)
_target=opencode-linux-x64-baseline
source=("git+$url.git#tag=v$pkgver")
b2sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  bun install --frozen-lockfile --ignore-scripts
}

build() {
  cd "$srcdir/$pkgname/packages/cli"
  OPENCODE_VERSION="$pkgver" OPENCODE_TARGET="${_target#opencode-}" bun run ./script/build.ts --skip-install

  # Generate these before packaging so a failed command cannot be hidden by a pipe.
  local binary="dist/${_target/opencode/cli}/bin/opencode"
  "$binary" --completions bash > "$srcdir/opencode.bash"
  "$binary" --completions zsh > "$srcdir/opencode.zsh"
}

check() {
  cd "$srcdir/$pkgname/packages/cli"
  local binary="dist/${_target/opencode/cli}/bin/opencode"
  [[ $("$binary" --version) == "$pkgver" ]]
  test -s "$srcdir/opencode.bash"
  test -s "$srcdir/opencode.zsh"
}

package() {
  cd "$srcdir/$pkgname"
  install -vDm755 -t "$pkgdir/usr/bin" "packages/cli/dist/${_target/opencode/cli}/bin/opencode"

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  install -vDm644 "$srcdir/opencode.bash" "$pkgdir/usr/share/bash-completion/completions/opencode"
  install -vDm644 "$srcdir/opencode.zsh" "$pkgdir/usr/share/zsh/site-functions/_opencode"
}
