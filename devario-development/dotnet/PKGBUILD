prepare() {
  cd dotnet

  # fix bootstrap
  git remote set-url origin https://github.com/dotnet/dotnet.git

  # shelly's isolated root ships no pacman, so match the bootstrap version against the
  # archive dotnet-source-built-artifacts installs instead of querying the package db
  local _bootstrapver=$(xmllint --xpath "//*[local-name()='PrivateSourceBuiltArtifactsVersion']/text()" eng/Versions.props)
  shopt -s nullglob
  local _bootstrap=(/usr/share/dotnet/source-built-artifacts/Private.SourceBuilt.Artifacts."$_bootstrapver"*.tar.gz)
  shopt -u nullglob

  if (( ${#_bootstrap[@]} )); then
    cp -r /usr/share/dotnet .dotnet
    ln -sf "${_bootstrap[0]}" prereqs/packages/archive/
  fi

  # eng/Directory.Build.props sets DotNetBuildSharedComponents only when VersionSDKMinor is 1, so a
  # checkout from a later feature band does not build runtime/aspnetcore itself and
  # eng/init-source-only.proj aborts unless it is fed the 1xx shared components. prep-source-build.sh
  # at this tag downloads no such archive, so ../dotnet-bootstrap carries the 1xx artifacts archive
  # named by MicrosoftNETSdkPackageVersion, pre-renamed to the Private.SourceBuilt.SharedComponents
  # prefix that eng/VmrLayout.props points ExternalTarballsDir at. Link the seed rather than fetching
  # it here: the input is then published and checksum-verified instead of arriving from a live feed,
  # and the glob couples the seed to the exact version this checkout demands.
  local _sdkminor=$(xmllint --xpath "//*[local-name()='VersionSDKMinor']/text()" eng/Versions.props)
  if [[ $_sdkminor != 1 ]]; then
    local _sharedver=$(xmllint --xpath "//*[local-name()='MicrosoftNETSdkPackageVersion']/text()" eng/Version.Details.props)
    shopt -s nullglob
    local _seed=(/opt/dotnet-bootstrap/Private.SourceBuilt.SharedComponents."$_sharedver".*.tar.gz)
    shopt -u nullglob

    if (( ! ${#_seed[@]} )); then
      error "No dotnet-bootstrap shared components for ${_sharedver}: publish ../dotnet-bootstrap at that version first"
      return 1
    fi
    mkdir -p prereqs/packages/archive
    ln -sf "${_seed[0]}" prereqs/packages/archive/
  fi

  ./prep-source-build.sh
}

build() {
  cd dotnet

  export COMPlus_LTTng=0
  export VERBOSE=1
  export OPENSSL_ENABLE_SHA1_SIGNATURES=1

  export PATH="/usr/lib/llvm20/bin:$PATH"

  # this uses malloc_usable_size, which is incompatible with fortification level 3
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  CFLAGS=$(echo $CFLAGS  | sed -e 's/-fstack-clash-protection//' )
  CXXFLAGS=$(echo $CXXFLAGS  | sed -e 's/-fstack-clash-protection//' )
  export EXTRA_CFLAGS="$CFLAGS"
  export EXTRA_CXXFLAGS="$CXXFLAGS"
  export EXTRA_LDFLAGS="$LDFLAGS"
  unset CFLAGS
  unset CXXFLAGS
  unset LDFLAGS

  # rtm branding strips out the "prerelease" tag from the version (see https://github.com/dotnet/dotnet/blob/b0f34d51fccc69fd334253924abd8d6853fad7aa/build.sh#L18)
  ./build.sh --clean-while-building --online --source-build
}

package_dotnet-host() {
  pkgdesc='A generic driver for the .NET Core Command Line Interface'
  depends=(
    glibc
    libgcc
    libstdc++
  )
  optdepends=('bash-completion: Bash completion support')

  install -dm 755 "${pkgdir}"/usr/{bin,lib,share/{dotnet,licenses/dotnet-host}}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner dotnet host
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver}-arch-*.tar.gz -C "${pkgdir}"/usr/share/licenses/dotnet-host/ --no-same-owner LICENSE.txt ThirdPartyNotices.txt
  ln -s /usr/share/dotnet/dotnet "${pkgdir}"/usr/bin/dotnet
  ln -s /usr/share/dotnet/host/fxr/${_runtimever}/libhostfxr.so "${pkgdir}"/usr/lib/libhostfxr.so
  install -Dm 644 dotnet/src/sdk/scripts/register-completions.bash "${pkgdir}"/usr/share/bash-completion/completions/dotnet
  install -Dm 644 dotnet/src/sdk/scripts/register-completions.zsh "${pkgdir}"/usr/share/zsh/site-functions/_dotnet
}

package_dotnet-runtime() {
  pkgdesc='The .NET Core runtime'
  depends=(
    dotnet-host
    glibc
    icu
    krb5
    libgcc
    libstdc++
    libunwind
    zlib
    openssl
  )
  optdepends=('lttng-ust2.12: CoreCLR tracing')
  provides=(
    dotnet-runtime=${_majorver}
    dotnet-runtime-${_majorver}
  )
  conflicts=(dotnet-runtime-${_majorver})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner shared/Microsoft.NETCore.App
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-runtime
}

package_aspnet-runtime() {
  pkgdesc='The ASP.NET Core runtime'
  depends=(dotnet-runtime)
  provides=(
    aspnet-runtime=${_majorver}
    aspnet-runtime-${_majorver}
  )
  conflicts=(aspnet-runtime-${_majorver})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner shared/Microsoft.AspNetCore.App
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/aspnet-runtime
}

package_dotnet-sdk() {
  pkgdesc='The .NET Core SDK'
  depends=(
    dotnet-runtime
    dotnet-targeting-pack
    glibc
    libgcc
    libstdc++
  )
  optdepends=('aspnet-targeting-pack: Build ASP.NET Core applications')
  provides=(
    dotnet-sdk=${_majorver}
    dotnet-sdk-${_majorver}
  )
  conflicts=(dotnet-sdk-${_majorver})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner sdk sdk-manifests templates
  install -dm 755 "${pkgdir}"/usr/share/dotnet/metadata/workloads/${pkgver}
  touch "${pkgdir}"/usr/share/dotnet/metadata/workloads/${pkgver}/userlocal
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-sdk
}

