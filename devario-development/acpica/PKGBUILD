pkgname=acpica
pkgver=20260930
pkgrel=1
pkgdesc="ACPI tools, including Intel ACPI Source Language compiler"
arch=(x86_64)
url="https://acpica.org"
license=(GPL-2.0-only)
depends=(glibc)
makedepends=(flex bison)
provides=(iasl)
conflicts=(iasl)
replaces=(iasl)
options=(!makeflags)
source=(https://github.com/open-acpica/acpica/releases/download/$pkgver/acpica-unix-$pkgver.tar.gz)
sha256sums=('aa18901b92e30749be0edc3081c8d550c61fce4fa37546fc6a65d367a4ae71a5')

build() {
  NOWERROR=TRUE make -C $pkgname-unix-$pkgver
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname-unix-$pkgver
}
