# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-ffi-compiler
epoch=1
# WARN: limited to 1.x as 2.x is a different gem
pkgver=1.4.3
pkgrel=1
pkgdesc='Ruby library for automating compilation of native libraries for use with ffi'
arch=(any)
url='https://github.com/ffi/ffi-compiler'
license=(Apache-2.0)
depends=(ruby-ffi ruby-rake)
makedepends=(git ruby-rspec ruby-rubygems-tasks ruby-rdoc)
options=(!emptydirs)
source=(git+https://github.com/ffi/ffi-compiler.git#tag=$pkgver)
sha256sums=('644f479aca6be05e3e58f375ff74592058934061dc1bd1ec88aeecb4e716fc5a')

build() {
  local _gemdir="$(gem env gemdir)"
  cd ffi-compiler
  rake build
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    pkg/ffi-compiler-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  cd ffi-compiler
  rake spec
}

package() {
  cd ffi-compiler
  cp -a tmp_install/* "$pkgdir"/
}
