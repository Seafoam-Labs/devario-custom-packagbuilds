pkgname=paseo
pkgver=0.15.0
pkgrel=1
pkgdesc='Desktop workspace for coding agents with a bundled Paseo server and CLI'
arch=('x86_64')
url='https://paseo.sh'
license=('Apache-2.0')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'coreutils'
  'dbus'
  'expat'
  'git'
  'glib2'
  'glibc'
  'grep'
  'gtk3'
  'libcups'
  'libgcc'
  'libnotify'
  'libsecret'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'libxtst'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'util-linux'
  'util-linux-libs'
  'xdg-utils'
)
makedepends=('libarchive')
optdepends=(
  'libappindicator-gtk3: system tray integration'
  'openssh: remote connections over SSH'
  'xdg-desktop-portal: desktop integration on Wayland'
)
provides=("paseo-desktop=$pkgver")
conflicts=('paseo-desktop')
# Preserve the bundled Electron runtime and native Node modules.
options=('!strip' '!debug')
source=("paseo-$pkgver-LICENSE::https://raw.githubusercontent.com/getpaseo/paseo/v$pkgver/LICENSE")
sha256sums=('79d5aedce6aa0adc547336dc1bd34c5cc9308ba110fac7079ed97515ee573ad3')
source_x86_64=("https://github.com/getpaseo/paseo/releases/download/v$pkgver/Paseo-$pkgver-amd64.deb")
sha256sums_x86_64=('9b37e15469422be4cf6fad9aa4865a61e1a8129f3a9ca142362ded679bf29ca1')

package() {
  # The builder unpacks the .deb container; install only its application payload.
  bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir" --no-same-owner ./opt ./usr

  local appdir="$pkgdir/opt/Paseo"
  # Shelly manages updates instead of electron-updater's Debian installer.
  rm -f "$appdir/resources/package-type" "$appdir/resources/app-update.yml"
  chmod 4755 "$appdir/chrome-sandbox"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/Paseo/Paseo "$pkgdir/usr/bin/paseo-desktop"
  ln -s /opt/Paseo/resources/bin/paseo "$pkgdir/usr/bin/paseo"

  install -Dm644 "$srcdir/paseo-$pkgver-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$appdir/LICENSE.electron.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
  install -Dm644 "$appdir/LICENSES.chromium.html" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSES.chromium.html"
}
