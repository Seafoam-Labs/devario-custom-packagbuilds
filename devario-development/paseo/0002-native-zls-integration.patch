+import React from "react";
+import { flushSync } from "react-dom";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, expect, it, vi } from "vitest";
+import { EditorView } from "@codemirror/view";
+import type { FileEditorModel } from "../model";
+import type { ZlsInput } from "@getpaseo/protocol/zig-lsp";
+import { ZigTools } from "./tools.web";
+
+const runtime = vi.hoisted(() => ({
+  connected: true,
+  supported: true,
+  calls: [] as ZlsInput[],
+  client: { editorZls: vi.fn() },
+}));
+vi.mock("@/runtime/host-runtime", () => ({
+  useHostRuntimeClient: () => runtime.client,
+  useHostRuntimeIsConnected: () => runtime.connected,
+}));
+vi.mock("@/runtime/host-features", () => ({ useHostFeature: () => runtime.supported }));
+let root: Root;
+let view: EditorView;
+afterEach(() => {
+  root?.unmount();
+  view?.destroy();
+  document.body.replaceChildren();
+  runtime.connected = true;
+  runtime.supported = true;
+});
+
+it("opens cross-file definition targets and restarts cleanly across disconnects", async () => {
+  let counter = 0;
+  runtime.calls = [];
+  runtime.client.editorZls.mockImplementation(async (input: ZlsInput) => {
+    runtime.calls.push(input);
+    if (input.action === "open") return { documentId: `document-${++counter}` };
+    if (input.action === "query")
+      return {
+        version: input.version,
+        locations: [
+          {
+            path: "/repo/helper.zig",
+            range: { start: { line: 7, character: 2 }, end: { line: 7, character: 8 } },
+          },
+        ],
+      };
+    if (input.action === "diagnostics") return { version: input.version, diagnostics: [] };
+    return {};
+  });
+  const container = document.createElement("div");
+  document.body.append(container);
+  root = createRoot(container);
+  view = new EditorView({ parent: document.body, doc: "answer" });
+  const model = {
+    getSnapshot: () => ({ status: "clean" }),
+    subscribe: () => () => {},
+  } as unknown as FileEditorModel;
+  const navigate = vi.fn();
+  const render = () =>
+    flushSync(() =>
+      root.render(
+        <ZigTools
+          view={view}
+          model={model}
+          serverId="host"
+          cwd="/repo"
+          path="/repo/main.zig"
+          onNavigate={navigate}
+        />,
+      ),
+    );
+  render();
+  await expect.poll(() => container.textContent).toContain("ZLS ready");
+  const button = (name: string) =>
+    [...container.querySelectorAll("button")].find((item) => item.textContent === name)!;
+  button("Definition").click();
+  await expect.poll(() => navigate.mock.calls.length).toBe(1);
+  expect(navigate).toHaveBeenCalledWith({ path: "/repo/helper.zig", lineStart: 8 });
+  button("Restart ZLS").click();
+  await expect.poll(() => counter).toBe(2);
+  expect(
+    runtime.calls.some((input) => input.action === "close" && input.documentId === "document-1"),
+  ).toBe(true);
+  runtime.connected = false;
+  render();
+  await expect.poll(() => container.textContent).toContain("disconnected");
+  runtime.connected = true;
+  render();
+  await expect.poll(() => counter).toBe(3);
+  // Parent editor teardown can run before the child React cleanup.
+  view.destroy();
+  root.unmount();
+});
diff --git a/packages/app/src/file-panels/source/editor/zls/tools.web.tsx b/packages/app/src/file-panels/source/editor/zls/tools.web.tsx
