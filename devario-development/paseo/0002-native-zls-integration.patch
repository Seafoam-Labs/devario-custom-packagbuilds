@@ -0,0 +1,67 @@
+import { z } from "zod";
+
+export const LspPositionSchema = z.object({
+  line: z.number().int().nonnegative(),
+  character: z.number().int().nonnegative(),
+});
+export const LspRangeSchema = z.object({ start: LspPositionSchema, end: LspPositionSchema });
+export const LspEditSchema = z.object({ range: LspRangeSchema, newText: z.string() });
+export const ZlsDiagnosticSchema = z.object({
+  range: LspRangeSchema,
+  message: z.string(),
+  severity: z.number().int().min(1).max(4).optional(),
+});
+export const ZlsCompletionSchema = z.object({
+  label: z.string(),
+  detail: z.string().optional(),
+  sortText: z.string().optional(),
+  filterText: z.string().optional(),
+  kind: z.number().optional(),
+  insertText: z.string(),
+  snippet: z.boolean(),
+  range: LspRangeSchema.optional(),
+  additionalTextEdits: z.array(LspEditSchema).optional(),
+});
+export const ZlsLocationSchema = z.object({ path: z.string(), range: LspRangeSchema });
+const document = { documentId: z.string().uuid() };
+const version = { version: z.number().int().nonnegative() };
+export const ZlsInputSchema = z.discriminatedUnion("action", [
+  z.object({
+    action: z.literal("open"),
+    cwd: z.string().min(1),
+    path: z.string().min(1),
+    content: z.string().max(1024 * 1024),
+  }),
+  z.object({
+    action: z.literal("change"),
+    ...document,
+    ...version,
+    content: z.string().max(1024 * 1024),
+  }),
+  z.object({ action: z.literal("save"), ...document, ...version }),
+  z.object({
+    action: z.literal("query"),
+    ...document,
+    ...version,
+    method: z.enum(["completion", "hover", "definition", "references"]),
+    position: LspPositionSchema,
+  }),
+  z.object({ action: z.literal("diagnostics"), ...document, ...version }),
+  z.object({ action: z.literal("close"), ...document }),
+]);
+export const ZlsResultSchema = z.object({
+  documentId: z.string().optional(),
+  version: z.number().optional(),
+  completions: z.array(ZlsCompletionSchema).optional(),
+  isIncomplete: z.boolean().optional(),
+  diagnostics: z.array(ZlsDiagnosticSchema).optional(),
+  locations: z.array(ZlsLocationSchema).optional(),
+  hover: z.string().nullable().optional(),
+});
+export type ZlsInput = z.infer<typeof ZlsInputSchema>;
+export type ZlsResult = z.infer<typeof ZlsResultSchema>;
+export type LspPosition = z.infer<typeof LspPositionSchema>;
+export type LspRange = z.infer<typeof LspRangeSchema>;
+export type ZlsCompletion = z.infer<typeof ZlsCompletionSchema>;
+export type ZlsDiagnostic = z.infer<typeof ZlsDiagnosticSchema>;
+export type ZlsLocation = z.infer<typeof ZlsLocationSchema>;
