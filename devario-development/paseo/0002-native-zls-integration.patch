+import { describe, expect, it } from "vitest";
+import type { ZlsInput, ZlsResult } from "@getpaseo/protocol/zig-lsp";
+import { ZlsDocument } from "./document";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+describe("ZLS document ordering", () => {
+  it("coalesces edits made during initialization before requesting completion", async () => {
+    const opening = deferred<ZlsResult>();
+    const messages: ZlsInput[] = [];
+    const doc = new ZlsDocument(
+      async (input) => {
+        messages.push(input);
+        if (input.action === "open") return opening.promise;
+        return { version: "version" in input ? input.version : undefined, completions: [] };
+      },
+      "/repo",
+      "main.zig",
+      "a",
+    );
+    doc.update("ab");
+    doc.update("abc");
+    const query = doc.query("completion", { line: 0, character: 3 });
+    opening.resolve({ documentId: "test" });
+    await query;
+    expect(messages.map((m) => m.action)).toEqual(["open", "change", "query"]);
+    expect(messages[1]).toMatchObject({ version: 2, content: "abc" });
+    doc.close();
+  });
+  it("discards a query response after a newer edit", async () => {
+    const completion = deferred<ZlsResult>();
+    const doc = new ZlsDocument(
+      async (input) =>
+        input.action === "open"
+          ? { documentId: "test" }
+          : input.action === "query"
+            ? completion.promise
+            : {},
+      "/repo",
+      "main.zig",
+      "a",
+    );
+    await doc.ready();
+    const query = doc.query("completion", { line: 0, character: 1 });
+    await doc.flush();
+    doc.update("newer");
+    completion.resolve({ version: 0, completions: [] });
+    expect(await query).toBeNull();
+    doc.close();
+  });
+  it("closes a session that finishes opening after its tab is gone", async () => {
+    const opening = deferred<ZlsResult>();
+    const messages: ZlsInput[] = [];
+    const doc = new ZlsDocument(
+      async (input) => {
+        messages.push(input);
+        return input.action === "open" ? opening.promise : {};
+      },
+      "/repo",
+      "main.zig",
+      "a",
+    );
+    doc.close();
+    opening.resolve({ documentId: "test" });
+    await expect(doc.ready()).rejects.toThrow("closed");
+    expect(messages.at(-1)).toEqual({ action: "close", documentId: "test" });
+  });
+  it("sends didSave after the corresponding buffer update", async () => {
+    const messages: ZlsInput[] = [];
+    const doc = new ZlsDocument(
+      async (input) => {
+        messages.push(input);
+        return input.action === "open" ? { documentId: "test" } : {};
+      },
+      "/repo",
+      "main.zig",
+      "a",
+    );
+    doc.update("saved");
+    await doc.saved();
+    expect(messages.slice(1)).toEqual([
+      { action: "change", documentId: "test", version: 1, content: "saved" },
+      { action: "save", documentId: "test", version: 1 },
+    ]);
+    doc.close();
+  });
+});
