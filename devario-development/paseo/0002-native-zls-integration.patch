+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { ZlsService } from "./zls-service.js";
+
+// Package check() opts in with checkdepends Zig + ZLS. Unit tests remain portable.
+describe.skipIf(process.env.PASEO_TEST_ZLS !== "1")("real ZLS", () => {
+  let dir: string;
+  let service: ZlsService;
+  const owner = {};
+  beforeEach(async () => {
+    dir = await mkdtemp(path.join(tmpdir(), "paseo-zls-real-"));
+    await writeFile(path.join(dir, "helper.zig"), "pub const answer: u32 = 42;\n");
+    service = new ZlsService();
+  });
+  afterEach(async () => {
+    service.dispose();
+    await rm(dir, { recursive: true, force: true });
+  });
+  it("completes unsaved text, hovers and navigates imports, reports and clears errors", async () => {
+    const content = 'const helper = @import("helper.zig");\nconst value = helper.answer;\n';
+    await writeFile(path.join(dir, "main.zig"), content);
+    const { documentId } = await service.execute(
+      { action: "open", cwd: dir, path: "main.zig", content },
+      owner,
+    );
+    const query = (
+      method: "definition" | "references" | "completion" | "hover",
+      line: number,
+      character: number,
+      version = 0,
+    ) =>
+      service.execute(
+        {
+          action: "query",
+          documentId: documentId!,
+          version,
+          method,
+          position: { line, character },
+        },
+        owner,
+      );
+    const definitions = await query("definition", 1, 24);
+    expect(
+      definitions.locations?.some(
+        (item) => item.path === path.join(dir, "helper.zig") && item.range.start.line === 0,
+      ),
+    ).toBe(true);
+    expect((await query("hover", 1, 24)).hover).toContain("u32");
+    expect((await query("references", 0, 8)).locations?.length).toBeGreaterThan(0);
+    const unsaved = 'const helper = @import("helper.zig");\nconst value = helper.\n';
+    await service.execute(
+      { action: "change", documentId: documentId!, version: 1, content: unsaved },
+      owner,
+    );
+    expect(
+      (await query("completion", 1, 21, 1)).completions?.some((item) =>
+        item.label.includes("answer"),
+      ),
+    ).toBe(true);
+    await service.execute(
+      { action: "change", documentId: documentId!, version: 2, content: "const x = ;\n" },
+      owner,
+    );
+    await expect
+      .poll(
+        async () =>
+          (
+            await service.execute(
+              { action: "diagnostics", documentId: documentId!, version: 2 },
+              owner,
+            )
+          ).diagnostics?.length,
+        { timeout: 10000 },
+      )
+      .toBeGreaterThan(0);
+    await service.execute(
+      { action: "change", documentId: documentId!, version: 3, content },
+      owner,
+    );
+    await expect
+      .poll(
+        async () =>
+          (
+            await service.execute(
+              { action: "diagnostics", documentId: documentId!, version: 3 },
+              owner,
+            )
+          ).diagnostics?.length,
+        { timeout: 10000 },
+      )
+      .toBe(0);
+    await service.execute({ action: "close", documentId: documentId! }, owner);
+  }, 30000);
+  it("reports compiler errors from a project's check step", async () => {
+    await writeFile(
+      path.join(dir, "build.zig"),
+      `const std = @import("std");
+pub fn build(b: *std.Build) void {
+    const exe = b.addExecutable(.{
+        .name = "check-fixture",
+        .root_module = b.createModule(.{ .root_source_file = b.path("main.zig"), .target = b.graph.host }),
+    });
+    b.step("check", "Check compilation").dependOn(&exe.step);
+}
+`,
+    );
+    const content = "pub fn main() void { const n: u8 = 300; _ = n; }\n";
+    await writeFile(path.join(dir, "main.zig"), content);
+    const { documentId } = await service.execute(
+      { action: "open", cwd: dir, path: "main.zig", content },
+      owner,
+    );
+    await service.execute({ action: "save", documentId: documentId!, version: 0 }, owner);
+    await expect
+      .poll(
+        async () => {
+          const result = await service.execute(
+            { action: "diagnostics", documentId: documentId!, version: 0 },
+            owner,
+          );
+          return result.diagnostics?.map((item) => item.message).join("\n") ?? "";
+        },
+        { timeout: 30000 },
+      )
+      .toMatch(/cannot represent|300/);
+  }, 40000);
+});
