--- /dev/null
+++ b/packages/app/src/file-panels/source/editor/zls/positions.ts
@@ -0,0 +1,18 @@
+import type { Text } from "@codemirror/state";
+import type { LspPosition, LspRange } from "@getpaseo/protocol/zig-lsp";
+
+/** CodeMirror and our negotiated LSP positions both count UTF-16 code units. */
+export function toLspPosition(doc: Text, offset: number): LspPosition {
+  const line = doc.lineAt(offset);
+  return { line: line.number - 1, character: offset - line.from };
+}
+export function fromLspPosition(doc: Text, position: LspPosition): number | null {
+  if (position.line < 0 || position.line >= doc.lines || position.character < 0) return null;
+  const line = doc.line(position.line + 1);
+  return position.character <= line.length ? line.from + position.character : null;
+}
+export function fromLspRange(doc: Text, range: LspRange): { from: number; to: number } | null {
+  const from = fromLspPosition(doc, range.start),
+    to = fromLspPosition(doc, range.end);
+  return from !== null && to !== null && to >= from ? { from, to } : null;
+}
