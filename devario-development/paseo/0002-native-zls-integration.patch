@@ -0,0 +1,100 @@
+import type { ZlsInput, ZlsResult, LspPosition } from "@getpaseo/protocol/zig-lsp";
+
+export type ZlsTransport = (input: ZlsInput) => Promise<ZlsResult>;
+
+/** Serializes buffer updates, but lets edits overtake slow queries. */
+export class ZlsDocument {
+  version = 0;
+  private id: string | null = null;
+  private closed = false;
+  private failure: Error | null = null;
+  private sentVersion = 0;
+  private content: string;
+  private opening: Promise<void>;
+  private queue: Promise<void> = Promise.resolve();
+
+  constructor(
+    private transport: ZlsTransport,
+    cwd: string,
+    path: string,
+    content: string,
+  ) {
+    this.content = content;
+    this.opening = transport({ action: "open", cwd, path, content })
+      .then(async (result) => {
+        if (!result.documentId) throw new Error("The daemon did not open a ZLS session");
+        this.id = result.documentId;
+        if (this.closed)
+          await this.transport({ action: "close", documentId: this.id }).catch(() => {});
+      })
+      .catch((error) => {
+        this.failure = error;
+        throw error;
+      });
+    // Opening can fail before a caller asks for ready().
+    void this.opening.catch(() => {});
+  }
+  async ready() {
+    await this.opening;
+    this.assertOpen();
+  }
+  update(content: string) {
+    if (content === this.content) return;
+    this.content = content;
+    this.version++;
+  }
+  async flush() {
+    const operation = this.queue.then(async () => {
+      await this.ready();
+      const version = this.version;
+      if (version === this.sentVersion) return;
+      await this.transport({
+        action: "change",
+        documentId: this.id!,
+        version,
+        content: this.content,
+      });
+      this.sentVersion = version;
+    });
+    this.queue = operation.catch((error) => {
+      this.failure = error;
+    });
+    await operation;
+  }
+  async query(method: "completion" | "hover" | "definition" | "references", position: LspPosition) {
+    const version = this.version;
+    await this.flush();
+    if (version !== this.version) return null;
+    const result = await this.transport({
+      action: "query",
+      documentId: this.id!,
+      version,
+      method,
+      position,
+    });
+    return !this.closed && this.version === version && result.version === version ? result : null;
+  }
+  async diagnostics() {
+    const version = this.version;
+    await this.flush();
+    if (version !== this.version) return null;
+    const result = await this.transport({ action: "diagnostics", documentId: this.id!, version });
+    return !this.closed && this.version === version && result.version === version
+      ? (result.diagnostics ?? [])
+      : null;
+  }
+  async saved() {
+    const version = this.version;
+    await this.flush();
+    if (this.version === version)
+      await this.transport({ action: "save", documentId: this.id!, version });
+  }
+  close() {
+    this.closed = true;
+    if (this.id) void this.transport({ action: "close", documentId: this.id }).catch(() => {});
+  }
+  private assertOpen() {
+    if (this.closed) throw new Error("ZLS editor closed");
+    if (this.failure) throw this.failure;
+  }
+}
