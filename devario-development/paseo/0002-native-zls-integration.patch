@@ -0,0 +1,169 @@
+import {
+  autocompletion,
+  completionKeymap,
+  snippet,
+  type Completion,
+  type CompletionContext,
+} from "@codemirror/autocomplete";
+import { lintGutter, setDiagnostics, type Diagnostic } from "@codemirror/lint";
+import { EditorView, hoverTooltip, keymap } from "@codemirror/view";
+import { Prec } from "@codemirror/state";
+import type { ZlsCompletion, ZlsDiagnostic, ZlsLocation } from "@getpaseo/protocol/zig-lsp";
+import { ZlsDocument } from "./document";
+import { fromLspRange, toLspPosition } from "./positions";
+
+export function completionOption(
+  item: ZlsCompletion,
+  version: number,
+  document: ZlsDocument,
+): Completion {
+  return {
+    label: item.filterText ?? item.label,
+    displayLabel: item.label,
+    detail: item.detail,
+    type:
+      item.kind === 3 || item.kind === 2
+        ? "function"
+        : item.kind === 14
+          ? "keyword"
+          : item.kind === 7 || item.kind === 22
+            ? "type"
+            : "variable",
+    apply(view, completion, from, to) {
+      if (document.version !== version) return;
+      const range = item.range ? fromLspRange(view.state.doc, item.range) : { from, to };
+      if (!range) return;
+      const edits = (item.additionalTextEdits ?? []).map((edit) => {
+        const bounds = fromLspRange(view.state.doc, edit.range);
+        return bounds ? { ...bounds, insert: edit.newText } : null;
+      });
+      if (edits.some((edit) => !edit)) return;
+      const additional = edits.filter((edit) => edit !== null).sort((a, b) => a.from - b.from);
+      if (
+        additional.some(
+          (edit, i) =>
+            (edit.from <= range.to && edit.to >= range.from) ||
+            (i > 0 && additional[i - 1].to >= edit.from),
+        )
+      )
+        return;
+      if (additional.length) {
+        const transaction = view.state.update({ changes: additional });
+        range.from = transaction.changes.mapPos(range.from, 1);
+        range.to = transaction.changes.mapPos(range.to, 1);
+        view.dispatch(transaction);
+      }
+      if (item.snippet) snippet(item.insertText)(view, completion, range.from, range.to);
+      else
+        view.dispatch({
+          changes: { ...range, insert: item.insertText },
+          selection: { anchor: range.from + item.insertText.length },
+          userEvent: "input.complete",
+        });
+    },
+  };
+}
+
+export function displayDiagnostics(view: EditorView, diagnostics: ZlsDiagnostic[]) {
+  const converted: Diagnostic[] = diagnostics.flatMap((diagnostic) => {
+    const range = fromLspRange(view.state.doc, diagnostic.range);
+    if (!range) return [];
+    const severity: Diagnostic["severity"] =
+      diagnostic.severity === 1 ? "error" : diagnostic.severity === 2 ? "warning" : "info";
+    return [{ ...range, severity, message: diagnostic.message, source: "ZLS" }];
+  });
+  view.dispatch(setDiagnostics(view.state, converted));
+}
+
+export function zlsExtensions(input: {
+  document: ZlsDocument;
+  changed(): void;
+  locations(items: ZlsLocation[], kind: "definition" | "references"): void;
+  error(error: unknown): void;
+}) {
+  const { document } = input;
+  const navigate = (
+    view: EditorView,
+    method: "definition" | "references",
+    pos = view.state.selection.main.head,
+  ) => {
+    void document
+      .query(method, toLspPosition(view.state.doc, pos))
+      .then((result) => {
+        if (result) input.locations(result.locations ?? [], method);
+      })
+      .catch(input.error);
+    return true;
+  };
+  return [
+    lintGutter(),
+    autocompletion({
+      override: [
+        async (context: CompletionContext) => {
+          const word = context.matchBefore(/@?[\w]*/);
+          const previous = context.state.sliceDoc(Math.max(0, context.pos - 1), context.pos);
+          if (!context.explicit && !word?.text && previous !== "." && previous !== "@") return null;
+          const version = document.version;
+          try {
+            const result = await document.query(
+              "completion",
+              toLspPosition(context.state.doc, context.pos),
+            );
+            if (!result || context.aborted) return null;
+            const items = [...(result.completions ?? [])].sort((a, b) =>
+              (a.sortText ?? a.label).localeCompare(b.sortText ?? b.label),
+            );
+            return {
+              from: word?.from ?? context.pos,
+              options: items.map((item) => completionOption(item, version, document)),
+            };
+          } catch (error) {
+            input.error(error);
+            return null;
+          }
+        },
+      ],
+    }),
+    hoverTooltip(async (view, pos) => {
+      try {
+        const result = await document.query("hover", toLspPosition(view.state.doc, pos));
+        if (!result?.hover) return null;
+        return {
+          pos,
+          above: true,
+          create() {
+            const dom = globalThis.document.createElement("pre");
+            dom.textContent = result.hover!;
+            dom.style.cssText =
+              "white-space:pre-wrap;max-width:60ch;max-height:25em;overflow:auto;padding:8px;margin:0";
+            return { dom };
+          },
+        };
+      } catch (error) {
+        input.error(error);
+        return null;
+      }
+    }),
+    Prec.high(
+      keymap.of([
+        ...completionKeymap,
+        { key: "F12", run: (view) => navigate(view, "definition") },
+        { key: "Shift-F12", run: (view) => navigate(view, "references") },
+      ]),
+    ),
+    EditorView.domEventHandlers({
+      mousedown(event, view) {
+        if (event.button !== 0 || !(event.ctrlKey || event.metaKey)) return false;
+        const pos = view.posAtCoords({ x: event.clientX, y: event.clientY });
+        if (pos === null) return false;
+        event.preventDefault();
+        return navigate(view, "definition", pos);
+      },
+    }),
+    EditorView.updateListener.of((update) => {
+      if (!update.docChanged) return;
+      document.update(update.state.doc.toString());
+      input.changed();
+    }),
+  ];
+}
