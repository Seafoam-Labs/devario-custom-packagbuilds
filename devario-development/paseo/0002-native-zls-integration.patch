@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+import {
+  SessionInboundMessageSchema,
+  SessionOutboundMessageSchema,
+  ServerInfoStatusPayloadSchema,
+} from "./messages.js";
+
+describe("native ZLS protocol", () => {
+  it("validates editor requests and rejects unbounded buffers or arbitrary methods", () => {
+    const request = {
+      type: "editor.zls.request",
+      requestId: "id",
+      input: { action: "open", cwd: "/repo", path: "main.zig", content: "const x = 1;" },
+    };
+    expect(SessionInboundMessageSchema.parse(request)).toEqual(request);
+    expect(
+      SessionInboundMessageSchema.safeParse({
+        ...request,
+        input: { ...request.input, content: "x".repeat(1024 * 1024 + 1) },
+      }).success,
+    ).toBe(false);
+    expect(
+      SessionInboundMessageSchema.safeParse({
+        ...request,
+        input: {
+          action: "query",
+          documentId: "d739952f-0c18-448e-aabd-e71c2e08cc99",
+          version: 0,
+          method: "executeCommand",
+          position: { line: 0, character: 0 },
+        },
+      }).success,
+    ).toBe(false);
+  });
+  it("round-trips locations and leaves the feature optional for older hosts", () => {
+    const response = {
+      type: "editor.zls.response",
+      payload: {
+        requestId: "id",
+        result: {
+          version: 3,
+          locations: [
+            {
+              path: "/repo/helper.zig",
+              range: { start: { line: 0, character: 1 }, end: { line: 0, character: 2 } },
+            },
+          ],
+        },
+      },
+    };
+    expect(SessionOutboundMessageSchema.parse(response)).toEqual(response);
+    expect(
+      ServerInfoStatusPayloadSchema.parse({ status: "server_info", serverId: "old", features: {} })
+        .features?.nativeZls,
+    ).toBeUndefined();
+  });
+});
