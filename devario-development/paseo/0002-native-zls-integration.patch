+import { describe, expect, it } from "vitest";
+import { EditorState } from "@codemirror/state";
+import { fromLspPosition, fromLspRange, toLspPosition } from "./positions";
+
+describe("LSP UTF-16 positions", () => {
+  it("round-trips emoji and line boundaries", () => {
+    const { doc } = EditorState.create({ doc: "🌊a\nβ" });
+    expect(toLspPosition(doc, 3)).toEqual({ line: 0, character: 3 });
+    expect(fromLspPosition(doc, { line: 1, character: 1 })).toBe(5);
+    for (let offset = 0; offset <= doc.length; offset++)
+      expect(fromLspPosition(doc, toLspPosition(doc, offset))).toBe(offset);
+  });
+  it("rejects invalid ranges instead of applying them to other text", () => {
+    const { doc } = EditorState.create({ doc: "abc" });
+    expect(
+      fromLspRange(doc, { start: { line: 0, character: 3 }, end: { line: 0, character: 1 } }),
+    ).toBeNull();
+    expect(fromLspPosition(doc, { line: 2, character: 0 })).toBeNull();
+    expect(fromLspPosition(doc, { line: 0, character: 4 })).toBeNull();
+  });
+});
