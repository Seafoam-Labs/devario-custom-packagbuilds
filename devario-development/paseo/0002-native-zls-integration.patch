@@ -0,0 +1,131 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import {
+  ZlsService,
+  normalizeCompletions,
+  normalizeLocations,
+  compatibleVersions,
+} from "./zls-service.js";
+import type { LspProcess, LspProcessOptions } from "./lsp-process.js";
+
+let dir: string;
+let service: ZlsService;
+const owner = {};
+let processes: {
+  options: LspProcessOptions;
+  notifications: { method: string; params: any }[];
+  closed: boolean;
+}[];
+beforeEach(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), "paseo-zls-unit-"));
+  await writeFile(path.join(dir, "main.zig"), "const x = 1;");
+  processes = [];
+  service = new ZlsService((options) => {
+    const fake = { options, notifications: [] as { method: string; params: any }[], closed: false };
+    processes.push(fake);
+    return {
+      request: async () => ({ capabilities: {} }),
+      notify: (method: string, params: any) => fake.notifications.push({ method, params }),
+      assertAlive() {
+        if (fake.closed) throw new Error("closed");
+      },
+      close() {
+        fake.closed = true;
+      },
+    } as unknown as LspProcess;
+  });
+});
+afterEach(async () => {
+  service.dispose();
+  await rm(dir, { recursive: true, force: true });
+});
+
+async function open(who = owner) {
+  return (
+    await service.execute(
+      { action: "open", cwd: dir, path: "main.zig", content: "const x = 1;" },
+      who,
+    )
+  ).documentId!;
+}
+describe("ZLS session ownership and synchronization", () => {
+  it("isolates buffers, rejects foreign tokens, and releases disconnected owners", async () => {
+    const id = await open();
+    const other = {};
+    await open(other);
+    await expect(
+      service.execute({ action: "diagnostics", documentId: id, version: 0 }, other),
+    ).rejects.toThrow("expired");
+    service.releaseOwner(owner);
+    expect(processes[0].closed).toBe(true);
+    expect(processes[1].closed).toBe(false);
+    await expect(open()).rejects.toThrow("closed");
+  });
+  it("rejects traversal and non-Zig files", async () => {
+    await expect(
+      service.execute({ action: "open", cwd: dir, path: "../outside.zig", content: "" }, owner),
+    ).rejects.toThrow();
+    await writeFile(path.join(dir, "file.txt"), "");
+    await expect(
+      service.execute({ action: "open", cwd: dir, path: "file.txt", content: "" }, owner),
+    ).rejects.toThrow("Zig and ZON");
+    expect(processes).toHaveLength(0);
+  });
+  it("drops old diagnostic versions and sends full updates and saves", async () => {
+    const id = await open();
+    const diagnostic = {
+      range: { start: { line: 0, character: 0 }, end: { line: 0, character: 5 } },
+      message: "error",
+      severity: 1,
+    };
+    const notify = processes[0].options.notification;
+    const uri = processes[0].notifications.find((n) => n.method === "textDocument/didOpen")!.params
+      .textDocument.uri;
+    notify("textDocument/publishDiagnostics", { uri, version: 0, diagnostics: [diagnostic] });
+    expect(
+      (await service.execute({ action: "diagnostics", documentId: id, version: 0 }, owner))
+        .diagnostics,
+    ).toHaveLength(1);
+    await service.execute(
+      { action: "change", documentId: id, version: 1, content: "const x = 2;" },
+      owner,
+    );
+    notify("textDocument/publishDiagnostics", { uri, version: 0, diagnostics: [diagnostic] });
+    expect(
+      (await service.execute({ action: "diagnostics", documentId: id, version: 1 }, owner))
+        .diagnostics,
+    ).toEqual([]);
+    await expect(
+      service.execute({ action: "change", documentId: id, version: 0, content: "stale" }, owner),
+    ).rejects.toThrow("Stale");
+    await service.execute({ action: "save", documentId: id, version: 1 }, owner);
+    expect(processes[0].notifications.at(-1)?.method).toBe("textDocument/didSave");
+  });
+  it("normalizes insert/replace completions and cross-file LocationLinks", () => {
+    const range = { start: { line: 2, character: 1 }, end: { line: 2, character: 4 } };
+    expect(
+      normalizeCompletions({
+        items: [
+          {
+            label: "hello",
+            insertTextFormat: 2,
+            textEdit: { newText: "hello(${1:name})", insert: range, replace: range },
+          },
+        ],
+      })[0],
+    ).toMatchObject({ insertText: "hello(${1:name})", snippet: true, range });
+    expect(
+      normalizeLocations([{ targetUri: "file:///tmp/a%20b.zig", targetSelectionRange: range }]),
+    ).toEqual([{ path: "/tmp/a b.zig", range }]);
+    expect(normalizeLocations([{ uri: "https://example.com", range }])).toEqual([]);
+  });
+});
+
+it("checks release series while allowing compatible patch releases", () => {
+  expect(compatibleVersions("0.17.0", "0.17.1")).toBe(true);
+  expect(compatibleVersions("0.16.0", "0.17.0")).toBe(false);
+  expect(compatibleVersions("0.17.0-dev.1", "0.17.0")).toBe(false);
+  expect(compatibleVersions("invalid", "invalid")).toBe(false);
+});
diff --git a/packages/server/src/server/editor/zls-service.ts b/packages/server/src/server/editor/zls-service.ts
new file mode 100644
index 0000000..7bcaba9
--- /dev/null
+++ b/packages/server/src/server/editor/zls-service.ts
@@ -0,0 +1,293 @@
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import { randomUUID } from "node:crypto";
+import { access, realpath, stat } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import {
+  LspRangeSchema,
+  LspEditSchema,
+  ZlsDiagnosticSchema,
+  type ZlsInput,
+  type ZlsResult,
+  type ZlsDiagnostic,
+  type ZlsCompletion,
+  type ZlsLocation,
+} from "@getpaseo/protocol/zig-lsp";
+import { resolveExplorerFilePath } from "../file-explorer/service.js";
+import { LspProcess, type LspProcessOptions } from "./lsp-process.js";
+
+const execFileAsync = promisify(execFile);
+const startLsp = (options: LspProcessOptions) => new LspProcess(options);
+
+export function compatibleVersions(zig: string, zls: string): boolean {
+  const series = (value: string) => /^(\d+\.\d+)\./.exec(value.trim())?.[1];
+  return (
+    !!series(zig) && series(zig) === series(zls) && zig.includes("-dev") === zls.includes("-dev")
+  );
+}
+
+interface Document {
+  owner: object;
+  process: LspProcess;
+  uri: string;
+  version: number;
+  diagnostics: ZlsDiagnostic[];
+  touched: number;
+}
+
+/** Each editor buffer has its own server: different clients' unsaved text cannot collide. */
+export class ZlsService {
+  private documents = new Map<string, Document>();
+  private disposed = false;
+  private toolchain: Promise<void> | null = null;
+  private releasedOwners = new WeakSet<object>();
+  private timer: NodeJS.Timeout;
+  constructor(private factory: (options: LspProcessOptions) => LspProcess = startLsp) {
+    this.timer = setInterval(() => {
+      for (const [id, doc] of this.documents) if (Date.now() - doc.touched > 90000) this.close(id);
+    }, 30000);
+    this.timer.unref();
+  }
+
+  async execute(input: ZlsInput, owner: object): Promise<ZlsResult> {
+    if (this.disposed || this.releasedOwners.has(owner)) throw new Error("ZLS connection closed");
+    if (input.action === "open") return this.open(input, owner);
+    const doc = this.documents.get(input.documentId);
+    if (!doc || doc.owner !== owner) throw new Error("ZLS session expired; reconnect the editor");
+    doc.touched = Date.now();
+    if (input.action === "close") {
+      this.close(input.documentId);
+      return {};
+    }
+    doc.process.assertAlive();
+    if (input.action === "change") {
+      if (input.version <= doc.version) throw new Error("Stale ZLS document update");
+      doc.version = input.version;
+      doc.diagnostics = [];
+      doc.process.notify("textDocument/didChange", {
+        textDocument: { uri: doc.uri, version: doc.version },
+        contentChanges: [{ text: input.content }],
+      });
+      return { version: doc.version };
+    }
+    if (input.version !== doc.version) throw new Error("Stale ZLS document version");
+    if (input.action === "save") {
+      doc.process.notify("textDocument/didSave", { textDocument: { uri: doc.uri } });
+      return { version: doc.version };
+    }
+    if (input.action === "diagnostics")
+      return { version: doc.version, diagnostics: doc.diagnostics };
+    const result = await doc.process.request(`textDocument/${input.method}`, {
+      textDocument: { uri: doc.uri },
+      position: input.position,
+      ...(input.method === "references" ? { context: { includeDeclaration: true } } : {}),
+      ...(input.method === "completion" ? { context: { triggerKind: 1 } } : {}),
+    });
+    // A response to an earlier buffer must never edit or navigate the current one.
+    if (doc.version !== input.version) return { version: input.version };
+    if (input.method === "completion")
+      return {
+        version: doc.version,
+        completions: normalizeCompletions(result),
+        isIncomplete: !Array.isArray(result) && result?.isIncomplete === true,
+      };
+    if (input.method === "hover")
+      return { version: doc.version, hover: hoverText(result?.contents) };
+    return { version: doc.version, locations: normalizeLocations(result) };
+  }
+
+  private async open(
+    input: Extract<ZlsInput, { action: "open" }>,
+    owner: object,
+  ): Promise<ZlsResult> {
+    if (this.documents.size >= 32) throw new Error("Too many open Zig editors");
+    const cwd = await realpath(input.cwd);
+    const file = await resolveExplorerFilePath({ root: cwd, relativePath: input.path });
+    if (!/\.(zig|zon)$/i.test(file)) throw new Error("ZLS supports Zig and ZON files only");
+    if (!(await stat(file)).isFile()) throw new Error("ZLS requires a regular file");
+    const root = await projectRoot(file, cwd);
+    if (this.factory === startLsp) await this.verifyToolchain();
+    if (this.disposed || this.releasedOwners.has(owner)) throw new Error("ZLS connection closed");
+    if (this.documents.size >= 32) throw new Error("Too many open Zig editors");
+    const id = randomUUID();
+    const uri = pathToFileURL(file).href;
+    const configuration: Record<string, unknown> = {};
+    if (process.env.PASEO_ZIG_PATH) configuration.zig_exe_path = process.env.PASEO_ZIG_PATH;
+    const doc: Document = {
+      owner,
+      uri,
+      version: 0,
+      diagnostics: [],
+      touched: Date.now(),
+      process: this.factory({
+        command: process.env.PASEO_ZLS_PATH || "zls",
+        cwd: root,
+        configuration,
+        notification: (method, params) => {
+          if (method !== "textDocument/publishDiagnostics" || params?.uri !== uri) return;
+          if (params.version !== undefined && params.version !== doc.version) return;
+          const parsed = ZlsDiagnosticSchema.array().safeParse(params.diagnostics);
+          if (parsed.success) doc.diagnostics = parsed.data.slice(0, 2000);
+        },
+      }),
+    };
+    this.documents.set(id, doc);
+    try {
+      const initialized = await doc.process.request("initialize", {
+        processId: process.pid,
+        clientInfo: { name: "Paseo", version: "0.15.2" },
+        rootUri: pathToFileURL(root).href,
+        workspaceFolders: [{ uri: pathToFileURL(root).href, name: path.basename(root) }],
+        initializationOptions: configuration,
+        capabilities: {
+          general: { positionEncodings: ["utf-16"] },
+          workspace: { configuration: true, workspaceFolders: true },
+          textDocument: {
+            synchronization: { didSave: true },
+            completion: {
+              completionItem: {
+                snippetSupport: true,
+                insertReplaceSupport: true,
+                documentationFormat: ["plaintext"],
+              },
+            },
+            hover: { contentFormat: ["plaintext"] },
+            definition: { linkSupport: true },
+            publishDiagnostics: { versionSupport: true },
+          },
+        },
+      });
+      if (
+        initialized?.capabilities?.positionEncoding &&
+        initialized.capabilities.positionEncoding !== "utf-16"
+      )
+        throw new Error("ZLS selected an unsupported position encoding");
+      if (!this.documents.has(id)) throw new Error("ZLS editor closed during startup");
+      doc.process.notify("initialized", {});
+      doc.process.notify("textDocument/didOpen", {
+        textDocument: {
+          uri,
+          languageId: /\.zon$/i.test(file) ? "zon" : "zig",
+          version: 0,
+          text: input.content,
+        },
+      });
+      return { documentId: id, version: 0 };
+    } catch (error) {
+      this.close(id);
+      throw error;
+    }
+  }
+
+  private verifyToolchain(): Promise<void> {
+    return (this.toolchain ??= (async () => {
+      let zig: string, zls: string;
+      try {
+        const results = await Promise.all([
+          execFileAsync(process.env.PASEO_ZIG_PATH || "zig", ["version"], {
+            timeout: 5000,
+            maxBuffer: 4096,
+          }),
+          execFileAsync(process.env.PASEO_ZLS_PATH || "zls", ["--version"], {
+            timeout: 5000,
+            maxBuffer: 4096,
+          }),
+        ]);
+        [zig, zls] = results.map((result) => result.stdout.trim());
+      } catch (error) {
+        throw new Error(
+          `Zig/ZLS unavailable on the daemon host. Install both or set PASEO_ZIG_PATH and PASEO_ZLS_PATH. ${String(error)}`,
+        );
+      }
+      if (!compatibleVersions(zig, zls))
+        throw new Error(
+          `Zig ${zig} and ZLS ${zls} are incompatible. Use matching release series (or matching nightly builds).`,
+        );
+    })().catch((error) => {
+      this.toolchain = null;
+      throw error;
+    }));
+  }
+
+  private close(id: string) {
+    const doc = this.documents.get(id);
+    if (!doc) return;
+    this.documents.delete(id);
+    try {
+      doc.process.notify("textDocument/didClose", { textDocument: { uri: doc.uri } });
+    } catch {}
+    doc.process.close();
+  }
+  releaseOwner(owner: object) {
+    this.releasedOwners.add(owner);
+    for (const [id, doc] of this.documents) if (doc.owner === owner) this.close(id);
+  }
+  dispose() {
+    this.disposed = true;
+    clearInterval(this.timer);
+    for (const id of this.documents.keys()) this.close(id);
+  }
+}
+
+async function projectRoot(file: string, cwd: string): Promise<string> {
+  for (let dir = path.dirname(file); ; dir = path.dirname(dir)) {
+    for (const name of ["build.zig", "build.zig.zon"]) {
+      try {
+        await access(path.join(dir, name));
+        return dir;
+      } catch {}
+    }
+    if (dir === cwd || path.dirname(dir) === dir) return cwd;
+  }
+}
+
+export function normalizeCompletions(result: any): ZlsCompletion[] {
+  const items = Array.isArray(result) ? result : result?.items;
+  if (!Array.isArray(items)) return [];
+  return items.slice(0, 1000).flatMap((item: any) => {
+    if (typeof item?.label !== "string") return [];
+    const edit = item.textEdit;
+    const range = LspRangeSchema.safeParse(edit?.replace ?? edit?.range);
+    const additional = LspEditSchema.array().safeParse(item.additionalTextEdits);
+    return [
+      {
+        label: item.label,
+        ...(typeof item.detail === "string" ? { detail: item.detail } : {}),
+        ...(typeof item.sortText === "string" ? { sortText: item.sortText } : {}),
+        ...(typeof item.filterText === "string" ? { filterText: item.filterText } : {}),
+        ...(typeof item.kind === "number" ? { kind: item.kind } : {}),
+        insertText:
+          typeof edit?.newText === "string"
+            ? edit.newText
+            : typeof item.insertText === "string"
+              ? item.insertText
+              : item.label,
+        snippet: item.insertTextFormat === 2,
+        ...(range.success ? { range: range.data } : {}),
+        ...(additional.success ? { additionalTextEdits: additional.data } : {}),
+      },
+    ];
+  });
+}
+
+export function normalizeLocations(result: any): ZlsLocation[] {
+  return (Array.isArray(result) ? result : result ? [result] : [])
+    .slice(0, 2000)
+    .flatMap((location: any) => {
+      const uri = location.targetUri ?? location.uri;
+      const range = LspRangeSchema.safeParse(location.targetSelectionRange ?? location.range);
+      if (typeof uri !== "string" || !uri.startsWith("file:") || !range.success) return [];
+      try {
+        return [{ path: fileURLToPath(uri), range: range.data }];
+      } catch {
+        return [];
+      }
+    });
+}
+
+export function hoverText(contents: any): string | null {
+  if (Array.isArray(contents)) return contents.map(hoverText).filter(Boolean).join("\n\n") || null;
+  if (typeof contents === "string") return contents;
+  return typeof contents?.value === "string" ? contents.value : null;
+}
diff --git a/packages/server/src/server/editor/zls.e2e.test.ts b/packages/server/src/server/editor/zls.e2e.test.ts
