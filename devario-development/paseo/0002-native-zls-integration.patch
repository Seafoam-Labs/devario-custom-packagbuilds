+import { afterEach, expect, it } from "vitest";
+import { EditorView } from "@codemirror/view";
+import { EditorState } from "@codemirror/state";
+import { startCompletion, acceptCompletion, completionStatus } from "@codemirror/autocomplete";
+import { diagnosticCount, openLintPanel } from "@codemirror/lint";
+import { ZlsDocument } from "./document";
+import { zlsExtensions, displayDiagnostics } from "./extensions";
+import type { ZlsInput, ZlsLocation } from "@getpaseo/protocol/zig-lsp";
+
+let view: EditorView | undefined;
+let session: ZlsDocument | undefined;
+afterEach(() => {
+  session?.close();
+  view?.destroy();
+  document.body.replaceChildren();
+});
+
+it("shows and accepts a completion snippet and renders clickable diagnostics", async () => {
+  session = new ZlsDocument(
+    async (input) => {
+      if (input.action === "open") return { documentId: "fixture" };
+      if (input.action === "query")
+        return {
+          version: input.version,
+          completions: [{ label: "hello", insertText: "hello(${1:name})", snippet: true }],
+        };
+      return {};
+    },
+    "/repo",
+    "main.zig",
+    "hel",
+  );
+  await session.ready();
+  view = new EditorView({
+    parent: document.body,
+    state: EditorState.create({
+      doc: "hel",
+      selection: { anchor: 3 },
+      extensions: zlsExtensions({
+        document: session,
+        changed() {},
+        locations() {},
+        error(error) {
+          throw error;
+        },
+      }),
+    }),
+  });
+  view.focus();
+  startCompletion(view);
+  await expect.poll(() => completionStatus(view!.state)).toBe("active");
+  expect(document.querySelector(".cm-tooltip-autocomplete")?.textContent).toContain("hello");
+  await expect.poll(() => acceptCompletion(view!)).toBe(true);
+  expect(view.state.doc.toString()).toBe("hello(name)");
+  expect(view.state.sliceDoc(view.state.selection.main.from, view.state.selection.main.to)).toBe(
+    "name",
+  );
+  displayDiagnostics(view, [
+    {
+      message: "unknown identifier",
+      severity: 1,
+      range: { start: { line: 0, character: 6 }, end: { line: 0, character: 10 } },
+    },
+  ]);
+  expect(diagnosticCount(view.state)).toBe(1);
+  openLintPanel(view);
+  await expect
+    .poll(() => document.querySelector(".cm-diagnostic-error")?.textContent)
+    .toContain("unknown identifier");
+  expect(document.querySelector(".cm-lintRange-error")).not.toBeNull();
+});
+
+it("routes F12 and Shift-F12 to definition and reference locations", async () => {
+  const queries: ZlsInput[] = [];
+  const shown: { items: ZlsLocation[]; kind: string }[] = [];
+  session = new ZlsDocument(
+    async (input) => {
+      queries.push(input);
+      if (input.action === "open") return { documentId: "fixture" };
+      if (input.action === "query")
+        return {
+          version: input.version,
+          locations: [
+            {
+              path: "/repo/helper.zig",
+              range: { start: { line: 4, character: 2 }, end: { line: 4, character: 8 } },
+            },
+          ],
+        };
+      return {};
+    },
+    "/repo",
+    "main.zig",
+    "helper",
+  );
+  await session.ready();
+  view = new EditorView({
+    parent: document.body,
+    state: EditorState.create({
+      doc: "helper",
+      extensions: zlsExtensions({
+        document: session,
+        changed() {},
+        locations(items, kind) {
+          shown.push({ items, kind });
+        },
+        error(error) {
+          throw error;
+        },
+      }),
+    }),
+  });
+  view.focus();
+  view.contentDOM.dispatchEvent(new KeyboardEvent("keydown", { key: "F12", bubbles: true }));
+  await expect.poll(() => shown.length).toBe(1);
+  expect(shown[0]).toMatchObject({ kind: "definition", items: [{ path: "/repo/helper.zig" }] });
+  view.contentDOM.dispatchEvent(
+    new KeyboardEvent("keydown", { key: "F12", shiftKey: true, bubbles: true }),
+  );
+  await expect.poll(() => shown.length).toBe(2);
+  expect(shown[1].kind).toBe("references");
+  expect(queries.filter((q) => q.action === "query")).toHaveLength(2);
+});
