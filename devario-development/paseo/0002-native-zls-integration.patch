+import { describe, expect, it } from "vitest";
+import { LspReader, LspProcess } from "./lsp-process.js";
+
+function frame(value: unknown) {
+  const body = Buffer.from(JSON.stringify(value));
+  return Buffer.concat([Buffer.from(`Content-Length: ${body.length}\r\n\r\n`), body]);
+}
+describe("LSP framing", () => {
+  it("handles UTF-8 byte lengths, split headers and multiple frames", () => {
+    const a = { jsonrpc: "2.0", id: 1, result: "🌊 héllo" };
+    const b = { jsonrpc: "2.0", method: "ready", params: {} };
+    const input = Buffer.concat([frame(a), frame(b)]);
+    const reader = new LspReader();
+    const output = [];
+    for (const byte of input) output.push(...reader.push(Buffer.from([byte])));
+    expect(output).toEqual([a, b]);
+    expect(new LspReader().push(input)).toEqual([a, b]);
+  });
+  it("rejects malformed, oversized and invalid-JSON responses", () => {
+    expect(() => new LspReader().push(Buffer.from("Content-Length: 9000000\r\n\r\n"))).toThrow();
+    expect(() => new LspReader().push(Buffer.from("Missing: length\r\n\r\n"))).toThrow();
+    expect(() => new LspReader().push(Buffer.from("Content-Length: 1\r\n\r\nx"))).toThrow();
+  });
+});
+
+it("times out unresponsive servers and rejects new requests after close", async () => {
+  const process = new LspProcess({
+    command: globalThis.process.execPath,
+    args: ["-e", "setTimeout(() => process.exit(0), 250)"],
+    cwd: "/tmp",
+    configuration: {},
+    notification() {},
+    timeoutMs: 30,
+  });
+  await expect(process.request("initialize", {})).rejects.toThrow("timed out");
+  process.close();
+  expect(() => process.request("completion", {})).toThrow("closed");
+});
+
+it("reports a missing server without leaving pending requests", async () => {
+  const process = new LspProcess({
+    command: "/nonexistent/paseo-zls-test",
+    cwd: "/tmp",
+    configuration: {},
+    notification() {},
+    timeoutMs: 1000,
+  });
+  await expect(process.request("initialize", {})).rejects.toThrow("Unable to start ZLS");
+  process.close();
+});
diff --git a/packages/server/src/server/editor/lsp-process.ts b/packages/server/src/server/editor/lsp-process.ts
new file mode 100644
index 0000000..b84e9c9
--- /dev/null
+++ b/packages/server/src/server/editor/lsp-process.ts
@@ -0,0 +1,197 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+
+const MAX_MESSAGE = 8 * 1024 * 1024;
+
+/** Content-Length counts UTF-8 bytes, and either headers or bodies may span chunks. */
+export class LspReader {
+  private buffer: Buffer = Buffer.alloc(0);
+  push(chunk: Buffer): unknown[] {
+    this.buffer = Buffer.concat([this.buffer, chunk]);
+    const messages: unknown[] = [];
+    for (;;) {
+      const end = this.buffer.indexOf("\r\n\r\n");
+      if (end < 0) {
+        if (this.buffer.length > 8192) throw new Error("Oversized LSP header");
+        break;
+      }
+      if (end > 8192) throw new Error("Oversized LSP header");
+      const match = /^Content-Length:\s*(\d+)\s*$/im.exec(this.buffer.subarray(0, end).toString());
+      const length = match ? Number(match[1]) : NaN;
+      if (!Number.isSafeInteger(length) || length < 0 || length > MAX_MESSAGE)
+        throw new Error("Invalid LSP message size");
+      if (this.buffer.length < end + 4 + length) break;
+      messages.push(JSON.parse(this.buffer.subarray(end + 4, end + 4 + length).toString("utf8")));
+      this.buffer = this.buffer.subarray(end + 4 + length);
+    }
+    return messages;
+  }
+}
+
+export interface LspProcessOptions {
+  command: string;
+  args?: string[];
+  cwd: string;
+  env?: NodeJS.ProcessEnv;
+  notification(method: string, params: any): void;
+  configuration: Record<string, unknown>;
+  timeoutMs?: number;
+}
+
+/** Reusable stdio JSON-RPC transport. It never executes server-provided commands or edits. */
+export class LspProcess {
+  private child: ChildProcessWithoutNullStreams;
+  private nextId = 1;
+  private pending = new Map<
+    number,
+    { resolve(value: any): void; reject(error: Error): void; timer: NodeJS.Timeout }
+  >();
+  private failure: Error | null = null;
+  private closing = false;
+  private stderr = "";
+
+  constructor(private options: LspProcessOptions) {
+    this.child = spawn(options.command, options.args ?? [], {
+      cwd: options.cwd,
+      env: options.env ?? process.env,
+      stdio: ["pipe", "pipe", "pipe"],
+    });
+    const reader = new LspReader();
+    this.child.stdout.on("data", (chunk: Buffer) => {
+      try {
+        for (const message of reader.push(chunk)) this.receive(message);
+      } catch (error) {
+        this.fail(new Error(`Invalid ZLS response: ${String(error)}`));
+        this.close();
+      }
+    });
+    this.child.stderr.on("data", (chunk: Buffer) => {
+      this.stderr = (this.stderr + chunk.toString()).slice(-4096);
+    });
+    this.child.on("error", (error) =>
+      this.fail(
+        new Error(
+          `Unable to start ZLS (${options.command}): ${error.message}. Install ZLS on the daemon host or set PASEO_ZLS_PATH.`,
+        ),
+      ),
+    );
+    this.child.on("exit", (code, signal) =>
+      this.fail(new Error(`ZLS exited (${signal ?? code}). ${this.stderr.trim()}`)),
+    );
+    this.child.stdin.on("error", (error) => this.fail(error));
+  }
+
+  assertAlive() {
+    if (this.failure) throw this.failure;
+    if (this.closing) throw new Error("ZLS session closed");
+  }
+
+  request(method: string, params: unknown): Promise<any> {
+    this.assertAlive();
+    if (this.pending.size >= 64) return Promise.reject(new Error("Too many pending ZLS requests"));
+    const id = this.nextId++;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        try {
+          this.notify("$/cancelRequest", { id });
+        } catch {}
+        reject(new Error(`ZLS timed out: ${method}`));
+      }, this.options.timeoutMs ?? 15000);
+      this.pending.set(id, { resolve, reject, timer });
+      try {
+        this.send({ jsonrpc: "2.0", id, method, params });
+      } catch (error) {
+        clearTimeout(timer);
+        this.pending.delete(id);
+        reject(error);
+      }
+    });
+  }
+
+  notify(method: string, params: unknown) {
+    this.send({ jsonrpc: "2.0", method, params });
+  }
+
+  private send(message: unknown) {
+    this.assertAlive();
+    this.write(message);
+  }
+
+  private write(message: unknown) {
+    const body = Buffer.from(JSON.stringify(message));
+    if (body.length > MAX_MESSAGE || this.child.stdin.writableLength > MAX_MESSAGE)
+      throw new Error("ZLS input queue is full");
+    this.child.stdin.write(
+      Buffer.concat([Buffer.from(`Content-Length: ${body.length}\r\n\r\n`), body]),
+    );
+  }
+
+  private receive(message: any) {
+    if (!message || typeof message !== "object" || message.jsonrpc !== "2.0")
+      throw new Error("Invalid JSON-RPC message");
+    if (typeof message.method === "string") {
+      if (message.id !== undefined) {
+        let result: unknown;
+        if (message.method === "workspace/configuration") {
+          result = (message.params?.items ?? []).map((item: any) =>
+            !item.section || item.section === "zls" ? this.options.configuration : null,
+          );
+        } else if (message.method === "window/workDoneProgress/create") result = null;
+        else {
+          this.send({
+            jsonrpc: "2.0",
+            id: message.id,
+            error: { code: -32601, message: "Unsupported client method" },
+          });
+          return;
+        }
+        this.send({ jsonrpc: "2.0", id: message.id, result });
+      } else this.options.notification(message.method, message.params);
+      return;
+    }
+    const request = this.pending.get(message.id);
+    if (!request) return;
+    clearTimeout(request.timer);
+    this.pending.delete(message.id);
+    if (message.error) request.reject(new Error(message.error.message ?? "ZLS request failed"));
+    else request.resolve(message.result);
+  }
+
+  private fail(error: Error) {
+    this.failure ??= error;
+    for (const item of this.pending.values()) {
+      clearTimeout(item.timer);
+      item.reject(this.failure);
+    }
+    this.pending.clear();
+  }
+
+  close() {
+    if (this.closing) return;
+    const shutdown = this.failure
+      ? Promise.resolve()
+      : this.request("shutdown", null).catch(() => {});
+    this.closing = true;
+    // The normal LSP shutdown lets ZLS stop build-on-save children. Dead servers
+    // still get bounded termination, including when a request is stuck.
+    const term = setTimeout(() => this.child.kill("SIGTERM"), 2000);
+    const kill = setTimeout(() => this.child.kill("SIGKILL"), 4000);
+    term.unref();
+    kill.unref();
+    const clear = () => {
+      clearTimeout(term);
+      clearTimeout(kill);
+    };
+    this.child.once("exit", clear);
+    if (this.child.exitCode !== null || this.child.signalCode !== null) clear();
+    void shutdown.finally(() => {
+      if (!this.failure) {
+        try {
+          this.write({ jsonrpc: "2.0", method: "exit", params: null });
+        } catch {}
+      }
+      this.child.stdin.end();
+      this.fail(new Error("ZLS session closed"));
+    });
+  }
+}
