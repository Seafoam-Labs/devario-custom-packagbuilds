index 0000000..deedb76
--- /dev/null
+++ b/packages/server/src/server/editor/zls.e2e.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { createDaemonTestContext } from "../test-utils/index.js";
+
+describe.skipIf(process.env.PASEO_TEST_ZLS !== "1")("ZLS over the daemon connection", () => {
+  it("opens, queries and closes a Zig buffer through the public client", async () => {
+    const dir = await mkdtemp(path.join(tmpdir(), "paseo-zls-wire-"));
+    const context = await createDaemonTestContext();
+    try {
+      const content = "const answer: u32 = 42;\nconst value = answer;\n";
+      await writeFile(path.join(dir, "main.zig"), content);
+      const opened = await context.client.editorZls({
+        action: "open",
+        cwd: dir,
+        path: "main.zig",
+        content,
+      });
+      expect(opened.documentId).toBeTruthy();
+      const result = await context.client.editorZls({
+        action: "query",
+        documentId: opened.documentId!,
+        version: 0,
+        method: "definition",
+        position: { line: 1, character: 16 },
+      });
+      expect(result.locations?.[0]).toMatchObject({
+        path: path.join(dir, "main.zig"),
+        range: { start: { line: 0, character: 6 } },
+      });
+      await context.client.editorZls({ action: "close", documentId: opened.documentId! });
+      await expect(
+        context.client.editorZls({
+          action: "diagnostics",
+          documentId: opened.documentId!,
+          version: 0,
+        }),
+      ).rejects.toThrow("expired");
+    } finally {
+      await context.cleanup();
+      await rm(dir, { recursive: true, force: true });
+    }
+  }, 45000);
+});
