+++ b/packages/app/src/file-panels/source/editor/zls/tools.web.tsx
@@ -0,0 +1,229 @@
+import { resolveFilePreviewReadTarget } from "@/file-explorer/preview-target";
+import { useEffect, useRef, useState } from "react";
+import { Compartment, StateEffect } from "@codemirror/state";
+import { EditorView } from "@codemirror/view";
+import { openLintPanel } from "@codemirror/lint";
+import type { ZlsLocation } from "@getpaseo/protocol/zig-lsp";
+import { useHostRuntimeClient, useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+import { useHostFeature } from "@/runtime/host-features";
+import type { WorkspaceFileLocation } from "@/workspace/file-open";
+import type { FileEditorModel } from "../model";
+import { ZlsDocument } from "./document";
+import { displayDiagnostics, zlsExtensions } from "./extensions";
+import { fromLspRange, toLspPosition } from "./positions";
+
+export function ZigTools({
+  view,
+  model,
+  serverId,
+  cwd,
+  path,
+  onNavigate,
+}: {
+  view: EditorView;
+  model: FileEditorModel;
+  serverId: string;
+  cwd: string;
+  path: string;
+  onNavigate(location: WorkspaceFileLocation): void;
+}) {
+  const client = useHostRuntimeClient(serverId);
+  const connected = useHostRuntimeIsConnected(serverId);
+  const supported = useHostFeature(serverId, "nativeZls");
+  const [status, setStatus] = useState("Starting ZLS…");
+  const [count, setCount] = useState(0);
+  const [locations, setLocations] = useState<ZlsLocation[]>([]);
+  const [generation, setGeneration] = useState(0);
+  const active = useRef<ZlsDocument | null>(null);
+  const [compartment] = useState(() => new Compartment());
+  const navigateRef = useRef(onNavigate);
+  navigateRef.current = onNavigate;
+  const choose = (location: ZlsLocation) => {
+    if (location.path === path) {
+      const range = fromLspRange(view.state.doc, location.range);
+      if (range)
+        view.dispatch({
+          selection: { anchor: range.from, head: range.to },
+          effects: EditorView.scrollIntoView(range.from, { y: "center" }),
+        });
+      view.focus();
+    } else navigateRef.current({ path: location.path, lineStart: location.range.start.line + 1 });
+    setLocations([]);
+  };
+  const chooseRef = useRef(choose);
+  chooseRef.current = choose;
+
+  useEffect(() => {
+    setLocations([]);
+    setCount(0);
+    if (!connected || !client) {
+      setStatus("ZLS: disconnected");
+      return;
+    }
+    if (!supported) {
+      setStatus("ZLS requires the patched daemon on this host");
+      return;
+    }
+    const target = resolveFilePreviewReadTarget({ path, workspaceRoot: cwd });
+    if (!target) {
+      setStatus("ZLS: file location unavailable");
+      return;
+    }
+    const document = new ZlsDocument(
+      (input) => client.editorZls(input),
+      target.cwd,
+      target.path,
+      view.state.doc.toString(),
+    );
+    active.current = document;
+    let stopped = false;
+    let pollTimer: ReturnType<typeof setTimeout> | undefined;
+    let changeTimer: ReturnType<typeof setTimeout> | undefined;
+    const reportError = (error: unknown) => {
+      if (stopped) return;
+      const message = error instanceof Error ? error.message : String(error);
+      setStatus(`ZLS: ${message}`);
+      // A suspended browser may outlive the daemon's idle-session lease.
+      if (message.includes("ZLS session expired")) setGeneration((value) => value + 1);
+    };
+    const showLocations = (items: ZlsLocation[], kind: "definition" | "references") => {
+      if (stopped) return;
+      if (kind === "definition" && items.length === 1) chooseRef.current(items[0]);
+      else {
+        setLocations(items);
+        setStatus(
+          items.length
+            ? `ZLS: ${items.length} ${kind === "references" ? "references" : "definitions"}`
+            : "ZLS: no results",
+        );
+      }
+    };
+    const poll = async () => {
+      try {
+        const diagnostics = await document.diagnostics();
+        if (!stopped && diagnostics) {
+          displayDiagnostics(view, diagnostics);
+          setCount(diagnostics.length);
+        }
+      } catch (error) {
+        reportError(error);
+      }
+      if (!stopped) pollTimer = setTimeout(poll, 1000);
+    };
+    setStatus("Starting ZLS…");
+    // The compartment is appended once for this connection, then removed on teardown.
+    const extensions = zlsExtensions({
+      document,
+      changed() {
+        setLocations([]);
+        setCount(0);
+        clearTimeout(changeTimer);
+        queueMicrotask(() => {
+          if (!stopped) displayDiagnostics(view, []);
+        });
+        changeTimer = setTimeout(() => {
+          void document.flush().catch(reportError);
+        }, 80);
+      },
+      locations: showLocations,
+      error: reportError,
+    });
+    view.dispatch({
+      effects:
+        compartment.get(view.state) === undefined
+          ? StateEffect.appendConfig.of(compartment.of(extensions))
+          : compartment.reconfigure(extensions),
+    });
+    let previousStatus = model.getSnapshot().status;
+    const unsubscribe = model.subscribe(() => {
+      const snapshot = model.getSnapshot();
+      if (snapshot.status === "clean" && previousStatus === "saving")
+        void document.saved().catch(reportError);
+      previousStatus = snapshot.status;
+    });
+    void document
+      .ready()
+      .then(() => {
+        if (!stopped) {
+          setStatus("ZLS ready");
+          void poll();
+        }
+      })
+      .catch(reportError);
+    return () => {
+      stopped = true;
+      unsubscribe();
+      clearTimeout(pollTimer);
+      clearTimeout(changeTimer);
+      document.close();
+      active.current = null;
+      if (view.dom.isConnected) {
+        view.dispatch({ effects: compartment.reconfigure([]) });
+        displayDiagnostics(view, []);
+      }
+    };
+  }, [client, connected, supported, cwd, path, model, view, generation, compartment]);
+
+  const query = (method: "definition" | "references") => {
+    const document = active.current;
+    if (!document) return;
+    void document
+      .query(method, toLspPosition(view.state.doc, view.state.selection.main.head))
+      .then((result) => {
+        if (!result) return;
+        const items = result.locations ?? [];
+        if (method === "definition" && items.length === 1) chooseRef.current(items[0]);
+        else {
+          setLocations(items);
+          setStatus(items.length ? `ZLS: ${items.length} results` : "ZLS: no results");
+        }
+      })
+      .catch((error) => {
+        if (active.current === document) setStatus(`ZLS: ${String(error)}`);
+      });
+  };
+  return (
+    <div
+      style={{
+        borderTop: "1px solid currentColor",
+        padding: 6,
+        fontSize: 12,
+        maxHeight: "35%",
+        overflow: "auto",
+      }}
+    >
+      <div style={{ display: "flex", flexWrap: "wrap", gap: 8, alignItems: "center" }}>
+        <span role="status">{status}</span>
+        <button
+          type="button"
+          onClick={() => {
+            openLintPanel(view);
+            view.focus();
+          }}
+        >
+          Problems ({count})
+        </button>
+        <button type="button" title="F12 or Ctrl/Cmd-click" onClick={() => query("definition")}>
+          Definition
+        </button>
+        <button type="button" title="Shift-F12" onClick={() => query("references")}>
+          References
+        </button>
+        <button type="button" onClick={() => setGeneration((value) => value + 1)}>
+          Restart ZLS
+        </button>
+      </div>
+      {locations.length > 0 && (
+        <ul aria-label="ZLS navigation results" style={{ margin: "6px 0", paddingLeft: 20 }}>
+          {locations.map((location, i) => (
+            <li key={`${location.path}:${location.range.start.line}:${i}`}>
+              <button type="button" onClick={() => choose(location)}>
+                {location.path}:{location.range.start.line + 1}:{location.range.start.character + 1}
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
