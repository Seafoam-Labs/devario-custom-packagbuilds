From: Devario maintainers
Subject: [PATCH] highlight: add native Zig and ZON editing support

Register a shared Zig stream parser for the built-in CodeMirror editor and
static source/diff previews. Handle Zig literals, builtins, primitive types,
comments and delimiter indentation without an external editor plugin.

Includes regression tests for ZON, ranges, quoted identifiers, multiline
strings, indentation and source-text preservation. No new npm dependencies.

diff --git a/packages/highlight/src/__tests__/zig.test.ts b/packages/highlight/src/__tests__/zig.test.ts
new file mode 100644
index 0000000..6133e9f
--- /dev/null
+++ b/packages/highlight/src/__tests__/zig.test.ts
@@ -0,0 +1,93 @@
+import { describe, expect, it } from "vitest";
+import { EditorState } from "@codemirror/state";
+import { getIndentation, indentUnit } from "@codemirror/language";
+import { highlightCode } from "../highlighter.js";
+import { getLanguageForFile } from "../parsers.js";
+
+function tokens(source: string, filename = "main.zig") {
+  return highlightCode(source, filename).flat();
+}
+
+describe("native Zig support", () => {
+  it("shares a language between Zig, ZON, the editor and previews", () => {
+    const zig = getLanguageForFile("src/main.ZIG");
+    expect(zig).not.toBeNull();
+    expect(getLanguageForFile("build.zig.zon")).toBe(zig);
+    expect(tokens('.{ .name = .demo, .version = "0.1.0" }', "build.zig.zon")).toContainEqual({
+      text: '"0.1.0"',
+      style: "string",
+    });
+  });
+
+  it("highlights keywords, arbitrary-width types, builtins and literals", () => {
+    const result = tokens(
+      "pub fn main() void { const n: u257 = @as(u257, 42); const ok = true; const p = null; }",
+    );
+    for (const [text, style] of [
+      ["pub", "keyword"],
+      ["fn", "keyword"],
+      ["void", "type"],
+      ["u257", "type"],
+      ["@as", "function"],
+      ["42", "number"],
+      ["true", "literal"],
+      ["null", "literal"],
+    ])
+      expect(result).toContainEqual({ text, style });
+  });
+
+  it("recognizes quoted identifiers and escaped string and character literals", () => {
+    expect(tokens('const @"a name" = "a\\\"b"; const c = \'\\n\';')).toEqual(
+      expect.arrayContaining([
+        { text: '@"a name"', style: "variable" },
+        { text: '"a\\\"b"', style: "string" },
+        { text: "'\\n'", style: "string" },
+      ]),
+    );
+  });
+
+  it("keeps comments and multiline strings from affecting the next line", () => {
+    const source = [
+      "//! documentation",
+      "const text =",
+      "    \\\\hello // {",
+      "    \\\\world",
+      ";",
+      "const x = 1;",
+    ].join("\n");
+    const lines = highlightCode(source, "main.zig");
+    expect(lines[0]).toEqual([{ text: "//! documentation", style: "comment" }]);
+    expect(lines[2]).toContainEqual({ text: "\\\\hello // {", style: "string" });
+    expect(lines[5]).toContainEqual({ text: "const", style: "keyword" });
+    expect(highlightCode('"unfinished\nconst x = 1;', "main.zig")[1]).toContainEqual({
+      text: "const",
+      style: "keyword",
+    });
+  });
+
+  it("separates ranges from decimal and hexadecimal floats", () => {
+    const result = tokens("0..10 0...10 1.25e-3 0x1.fp+2 0b1010 0o755 1_000");
+    for (const text of ["0", "10", "1.25e-3", "0x1.fp+2", "0b1010", "0o755", "1_000"])
+      expect(result).toContainEqual({ text, style: "number" });
+    expect(result).toContainEqual({ text: "..", style: "punctuation" });
+    expect(result).toContainEqual({ text: "...", style: "punctuation" });
+  });
+
+  it("indents blocks and ignores braces inside comments and strings", () => {
+    const language = getLanguageForFile("main.zig")!;
+    const doc = 'pub fn main() void {\n    const text = "}"; // {\n    const n = 1;\n}';
+    const state = EditorState.create({ doc, extensions: [language, indentUnit.of("    ")] });
+    expect(getIndentation(state, state.doc.line(3).from)).toBe(4);
+    expect(getIndentation(state, state.doc.line(4).from)).toBe(0);
+    expect(state.languageDataAt("commentTokens", 0)).toContainEqual({ line: "//" });
+  });
+
+  it("preserves all source text including CRLF and non-ASCII strings", () => {
+    const source = 'const message = "héllo 🌊";\r\n// λ\r\n';
+    expect(
+      highlightCode(source, "main.zig")
+        .map((line) => line.map((t) => t.text).join(""))
+        .join("\n"),
+    ).toBe(source);
+  });
+});
