diff --git a/packages/highlight/src/zig/language.ts b/packages/highlight/src/zig/language.ts
new file mode 100644
index 0000000..32f30b9
--- /dev/null
+++ b/packages/highlight/src/zig/language.ts
@@ -0,0 +1,95 @@
+import { StreamLanguage, type StreamParser } from "@codemirror/language";
+
+// A lexical grammar shared by the editable source pane and static file/diff previews.
+// Zig's multiline strings consist of independently prefixed lines; ordinary strings
+// and character literals never continue onto the next line, including while editing.
+const keywords = new Set(
+  (
+    `addrspace align allowzero and anyframe anytype asm async await break callconv catch ` +
+    `comptime const continue defer else enum errdefer error export extern fn for if inline ` +
+    `linksection noalias noinline nosuspend opaque or orelse packed pub resume return ` +
+    `section struct suspend switch test threadlocal try union unreachable usingnamespace ` +
+    `var volatile while`
+  ).split(" "),
+);
+const types = new Set(
+  (
+    `anyerror anyopaque bool c_char c_int c_long c_longdouble c_longlong c_short c_uint ` +
+    `c_ulong c_ulonglong c_ushort comptime_float comptime_int f16 f32 f64 f80 f128 ` +
+    `isize noreturn type usize void`
+  ).split(" "),
+);
+
+interface ZigState {
+  brackets: { close: string; indent: number }[];
+}
+
+const zigParser: StreamParser<ZigState> = {
+  name: "zig",
+  startState: () => ({ brackets: [] }),
+  copyState: (state) => ({ brackets: state.brackets.map((entry) => ({ ...entry })) }),
+  token(stream, state) {
+    if (stream.eatSpace()) return null;
+    if (stream.match("//")) {
+      stream.skipToEnd();
+      return "comment";
+    }
+    if (stream.match("\\\\")) {
+      stream.skipToEnd();
+      return "string";
+    }
+    // Quoted identifiers are identifiers, not builtins or string values.
+    const quotedIdentifier = stream.match('@"');
+    if (quotedIdentifier || stream.peek() === '"' || stream.peek() === "'") {
+      const quote = quotedIdentifier ? '"' : stream.next();
+      while (!stream.eol()) {
+        const character = stream.next();
+        if (character === "\\") stream.next();
+        else if (character === quote) break;
+      }
+      return quotedIdentifier ? "variableName" : "string";
+    }
+    if (stream.match(/^@[A-Za-z_][A-Za-z0-9_]*/)) return "variableName.function";
+    // Do not swallow the range operator in 0..10 or 0...10 as a decimal point.
+    if (
+      stream.match(/^0x[0-9a-fA-F][0-9a-fA-F_]*(?:\.(?!\.)[0-9a-fA-F_]*)?(?:[pP][+-]?[0-9_]+)?/) ||
+      stream.match(/^0b[01][01_]*/) ||
+      stream.match(/^0o[0-7][0-7_]*/) ||
+      stream.match(/^[0-9][0-9_]*(?:\.(?!\.)[0-9_]+)?(?:[eE][+-]?[0-9_]+)?/)
+    )
+      return "number";
+    if (stream.match(/^[A-Za-z_][A-Za-z0-9_]*/)) {
+      const word = stream.current();
+      if (keywords.has(word)) return "keyword";
+      if (types.has(word) || /^[iu][0-9]+$/.test(word)) return "typeName";
+      if (word === "true" || word === "false") return "bool";
+      if (word === "null" || word === "undefined") return "null";
+      return "variableName";
+    }
+    const character = stream.next()!;
+    const closing = { "(": ")", "[": "]", "{": "}" }[character];
+    if (closing) {
+      state.brackets.push({ close: closing, indent: stream.indentation() });
+      return "bracket";
+    }
+    if (/^[)\]}]$/.test(character)) {
+      if (state.brackets.at(-1)?.close === character) state.brackets.pop();
+      return "bracket";
+    }
+    if (/^[,;.:]$/.test(character)) return "punctuation";
+    if (/^[+*/%=!<>|&^?~\-]$/.test(character)) return "operator";
+    return null;
+  },
+  indent(state, textAfter, context) {
+    const bracket = state.brackets.at(-1);
+    if (!bracket) return 0;
+    return bracket.indent + (textAfter.trimStart().startsWith(bracket.close) ? 0 : context.unit);
+  },
+  languageData: {
+    commentTokens: { line: "//" },
+    closeBrackets: { brackets: ["(", "[", "{", '"', "'"] },
+    indentOnInput: /^\s*[}\])]/,
+  },
+};
+
+export const zigLanguage = StreamLanguage.define(zigParser);
