# Maintainer: Devario Linux
#
# Rune is the GPL-3.0-or-later IDE from Unstable Build (https://rune.build).
# The name follows upstream's Arch-family packaging (AUR rune-ide): the
# unrelated AUR "rune" package (a Loki Entertainment game) owns the bare
# name. Build from source rather than repackaging the release tarball:
# debug.OSPackaged=true is a compile-time stamp that hands updates to the
# package manager, and the published binaries ship without it.

pkgname=rune-ide
pkgver=1.3.4
pkgrel=1
pkgdesc='Fast, GPU-rendered, keyboard-driven IDE and terminal multiplexer'
arch=('x86_64' 'aarch64')
url='https://rune.build/'
license=('GPL-3.0-or-later')
# The GUI dlopens its graphics and X11 libraries only when a window opens;
# --tui and --headless run without a graphical stack. Upstream's Debian
# packaging keeps the same libraries as Recommends for that reason.
depends=('glibc' 'hicolor-icon-theme')
makedepends=('go>=1.27.3' 'pkgconf'
             'alsa-lib' 'wayland' 'libxkbcommon'
             'libx11' 'libxcursor' 'libxext' 'libxi' 'libxinerama'
             'libxrandr' 'libxrender' 'libxxf86vm' 'libglvnd')
optdepends=('libglvnd: OpenGL and EGL GUI support'
            'libx11: X11 GUI support'
            'libxcursor: X11 cursor support'
            'libxext: X11 extension support'
            'libxi: XInput GUI support'
            'libxinerama: Xinerama multi-monitor GUI support'
            'libxrandr: RandR display configuration support'
            'libxrender: XRender GUI support'
            'libxxf86vm: XF86VidMode GUI support'
            'xorg-xwayland: GUI on Wayland sessions (Rune renders through X11)'
            'wl-clipboard: clipboard on Wayland sessions'
            'xclip: clipboard on X11 sessions'
            'xsel: clipboard on X11 sessions')
conflicts=('rune-ide-bin')
# makepkg's default LTO CFLAGS can break cgo builds, and Go emits no DWARF
# that makepkg's debug split can use.
options=('!lto' '!debug')
source=("rune-$pkgver.tar.gz::https://github.com/unstablebuild/rune/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c53c058ed4d74986e63eac1a84641ae9367b11aea14d03d462bf0544abddbdac')

# Commit of the v1.3.4 tag (matches the published release manifests);
# release tarballs carry no git metadata to derive it from.
_commit=bd087c3a5

prepare() {
  cd "rune-$pkgver"
  go mod download -modcacherw
}

build() {
  cd "rune-$pkgver"
  export CGO_ENABLED=1
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  export GOTOOLCHAIN=local
  export GOPROXY=off

  local _builddate
  _builddate="$(go run ./cmd/buildstamp)"

  # Mirrors upstream's release build (cmd/rune/Makefile, RUNE_ENV=prod; the
  # production API endpoints are the source-level defaults) plus the
  # dist/debian packaging stamps. OSPackaged=true disables the in-product
  # updater so Shelly owns updates.
  go build \
    -tags ebitensinglethread \
    -ldflags "-linkmode=external \
      -X unstable.build/rune/internal/debug.Tag=v$pkgver \
      -X unstable.build/rune/internal/debug.Commit=$_commit \
      -X unstable.build/rune/internal/debug.BuildDate=$_builddate \
      -X unstable.build/rune/internal/debug.Package=rune \
      -X unstable.build/rune/internal/debug.OSPackaged=true" \
    -o rune ./cmd/rune
}

package() {
  cd "rune-$pkgver"

  # Mirrors the rune.app/bin layout of upstream's Linux release bundle;
  # the shell rc files are embedded in the binary since 1.3.
  install -Dm755 rune "$pkgdir/usr/lib/$pkgname/rune.app/bin/rune"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/rune.app/bin/rune" "$pkgdir/usr/bin/rune"

  # Renamed from upstream's rune.desktop: the unrelated AUR package "rune"
  # (a Loki Entertainment game) already owns that filename.
  install -Dm644 deploy/rune-linux/rune.desktop \
    "$pkgdir/usr/share/applications/rune-ide.desktop"
  install -Dm644 extra/icon.iconset/icon_512x512.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/rune.png"
  install -Dm644 extra/icon.iconset/icon_512x512@2x.png \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/rune.png"
  install -Dm644 dist/debian/rune.1 "$pkgdir/usr/share/man/man1/rune.1"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 extra/osx/Rune.app/Contents/Resources/LICENSES \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSES"
}