license=('unknown')
install="${pkgname}.install"
depends=('vscodium-insiders' 'python')
source=('vscodium-insiders-marketplace.hook'
        'patch.py')
sha512sums=('553209d7a8ebf38cec97735f7207197849e19e3be08ec4f08174bbaa80a79e4936816da6df39e3d30ec25f98df92e4d848924a66d7e346ae1014df03a63c0d79'
            'b10bde86bea330e38eccde4b1becf82e8fb8573a8a0662455072c5d5fd376c1553504c184739213374ed3f794eaf6acac96f964434e0397c0e29b3e107a3f900')

package() {
  install -Dm 644 "${srcdir}"/vscodium-insiders-marketplace.hook "${pkgdir}"/usr/share/libalpm/hooks/vscodium-insiders-marketplace.hook
  install -Dm 755 "${srcdir}"/patch.py "${pkgdir}"/usr/share/vscodium-insiders/resources/app/patch.py
}
