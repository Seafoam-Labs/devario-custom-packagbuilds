# Local recipe for Devario, packaged from the AUR polystrata recipe; see
# DEVARIO-UPSTREAM.json. Local changes: pinned to the newer upstream tag
# v0.2.20-poly.6, the AUR's polystrata.install is dropped — its first-run
# notes live in README.md instead — and the launcher refuses an existing
# directory it did not create instead of running that directory's setup.sh.
# Maintainer: bencevarga <bence@varga.bio>

# pkgver cannot contain a hyphen, so the tag's - becomes .
_tag=v0.2.20-poly.6
pkgname=polystrata
pkgver=${_tag#v}
pkgver=${pkgver//-/.}
pkgrel=1
pkgdesc='Run large AI models on your own PC: Qwen3.8-Flash-Next, GLM 5.3 Flash, DeepSeek V4 Flash and more, on NVIDIA or AMD GPUs'
arch=('any')
url='https://github.com/simplexai-labs/PolyStrata'
license=('MIT')
# The engine is compiled on the user's PC on the first start (the GPU decides
# CUDA or HIP), so the build tools are runtime dependencies here.  On x86-64
# Linux with driver 580 or newer setup.py instead takes upstream's ready-made
# CUDA 13 engine, whose release asset is named after the hash of this exact
# source tree; the tools are still needed for other cards and for AMD.
depends=('python' 'gcc' 'git')
optdepends=(
	'cuda: NVIDIA GPU engine (upstream builds with CUDA 13.0; nvcc is found on PATH or in /opt/cuda*)'
	'rocm-hip-sdk: AMD GPU engine through a system ROCm 7 in /opt/rocm (otherwise ROCm is downloaded into the venv on first start)'
)
source=("https://github.com/simplexai-labs/PolyStrata/archive/refs/tags/$_tag.tar.gz"
        'polystrata.sh')
sha256sums=('9fd665c72c5be294b71fbddd80c039cda65df74df1665021febaf4bb8951c330'
            '50ab9f4b54f83a3526521e05fc44875b690a337923f8a040d763db5dde291ed1')

# The release asset is the Windows engine; on Linux upstream installs by
# cloning this tree and running ./setup.sh. The package ships that tree under
# /opt plus a launcher that copies it into $HOME (setup.sh writes its venv,
# the compiled engine and the models next to itself, without root) and runs
# upstream's own setup.sh.

prepare() {
	sed -e "s/@@PKGVER@@/$pkgver/" -e "s/@@PKGREL@@/$pkgrel/" \
		"$srcdir/polystrata.sh" > "$srcdir/polystrata-launcher.sh"
}

package() {
	install -Dm755 "$srcdir/polystrata-launcher.sh" "$pkgdir/usr/bin/polystrata"
	ln -s polystrata "$pkgdir/usr/bin/polystrata-update"
	mkdir -p "$pkgdir/opt/polystrata"
	cp -a "$srcdir/PolyStrata-${_tag#v}/." "$pkgdir/opt/polystrata/"
	install -Dm644 "$srcdir/PolyStrata-${_tag#v}/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
