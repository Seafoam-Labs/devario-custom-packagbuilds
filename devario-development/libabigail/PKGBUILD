# Based on the Arch Linux recipe by George Rawlinson and Alexander Hirsch.
# abidw and abidiff are built and released together by libabigail.
pkgname=libabigail
pkgver=3.0
pkgrel=1
pkgdesc='ABI analysis library and tools, including abidw and abidiff'
arch=('x86_64')
url='https://sourceware.org/libabigail/'
license=('Apache-2.0 WITH LLVM-exception')
depends=(
  'glibc'
  'binutils'
  'libxml2'
  'libelf'
  'libgcc'
  'libstdc++'
  'libatomic'
  'elfutils'
  'xxhash'
  'xz'
  'onetbb'
)
makedepends=('python-sphinx')
checkdepends=('python')
provides=("abidw=$pkgver" "abidiff=$pkgver" 'libabigail.so')
source=("https://sourceware.org/pub/libabigail/$pkgname-$pkgver.tar.xz")
sha512sums=('4803ada641d4becbff2f2578e1f874794af5295c7c780cfa4d4d96cddb59320625320c667e9ce2ccd4f9675d42ac4721305d4a3bd034862f34bb35dd4f9ff48c')

build() {
  cd "$srcdir/$pkgname-$pkgver"

  ./configure \
    --prefix=/usr \
    --enable-bash-completion \
    --enable-ctf \
    --disable-btf \
    --disable-abidb \
    --disable-fedabipkgdiff \
    --disable-manual \
    --disable-apidoc \
    --disable-static
  make
  make -C doc/manuals man
}

check() {
  make -C "$srcdir/$pkgname-$pkgver" check
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install

  # Upstream does not install these with --disable-manual.
  local tool
  for tool in abicompat abidiff abidw abilint abipkgdiff kmidiff; do
    install -Dm644 "doc/manuals/man/$tool.1" \
      "$pkgdir/usr/share/man/man1/$tool.1"
  done
  install -Dm644 doc/manuals/man/libabigail.7 \
    "$pkgdir/usr/share/man/man7/libabigail.7"

  for tool in abicompat abidiff abidw abilint abipkgdiff; do
    install -Dm644 "bash-completion/$tool" \
      "$pkgdir/usr/share/bash-completion/completions/$tool"
  done
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
