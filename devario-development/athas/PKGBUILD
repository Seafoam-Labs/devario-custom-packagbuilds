pkgname=athas
pkgver=0.17.0
pkgrel=1
pkgdesc='Lightweight code editor with Git, a terminal and AI agents'
url='https://athas.dev'
arch=('x86_64')
license=('AGPL-3.0-or-later')
# Runtime linkage matches the official upstream .deb (Depends:
# libwebkit2gtk-4.1-0, libgtk-3-0) plus the direct ELF NEEDED entries.
depends=(
  'dbus'
  'gcc-libs'
  'git' # remote git operations shell out to the git CLI (vendored libgit2 has no HTTPS/SSH transports)
  'glib2'
  'glibc'
  'gtk3'
  'libsoup3'
  'wayland'
  'webkit2gtk-4.1'
  'xz'
  'zlib'
)
makedepends=(
  'bun>=1.3.14' # upstream packageManager pin; newer bun reads the v1 text lockfile
  'cargo'
  'nodejs-lts-krypton' # Node 24 per upstream .node-version and engines; runs the vp/tauri CLI wrappers
)
optdepends=(
  'org.freedesktop.secrets: credential storage via Secret Service'
  'xdg-desktop-portal: portal-backed dialogs and file pickers'
  'xdg-utils: open links and files with the default applications'
  'zenity: dialog fallback when no desktop portal is available'
)
# `!lto`: makepkg's -flto=auto in CFLAGS turns the vendored C dependencies
# (libgit2, mimalloc, ring, ...) into compiler-specific LTO objects that
# rustc's linker may not be able to read. Rust's own thin LTO
# (profile.release) is unaffected.
options=('!debug' '!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/athasdev/athas/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d612cdd9d918015e762668b9654f83e4b0627138ff2120adf009e6c3a145e556')

_srcenv() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export BUN_INSTALL_CACHE_DIR="$srcdir/bun-cache"
}

prepare() {
  _srcenv

  # The nightly pin only serves rustfmt's unstable formatting options
  # (see rustfmt.toml); no crate uses nightly feature gates and upstream CI
  # builds releases with stable Rust. Drop the pin so rustup-based builders
  # do not pull a nightly toolchain.
  rm -f rust-toolchain.toml

  cargo fetch --locked
  # --ignore-scripts matches upstream CI (`vp install --ignore-scripts`);
  # the skipped `prepare` hook only configures the dev toolchain.
  bun install --frozen-lockfile --ignore-scripts
}

build() {
  _srcenv
  export CARGO_NET_OFFLINE=true
  RUSTFLAGS+=" --remap-path-prefix $PWD=/"

  # --no-bundle builds only the executable with the frontend embedded
  # (the Tauri CLI runs `vp build`, then cargo). No updater artifacts are
  # produced, so no signing key is needed, and the binary reports an unknown
  # bundle type: the in-app updater leaves updates to the package manager.
  bun tauri build --no-bundle
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 target/release/athas "$pkgdir/usr/bin/athas"

  # Tauri resolves resources from <prefix>/lib/<productName> next to
  # <prefix>/bin, the layout upstream documents for distro packaging in
  # scripts/release/packaging/linux/tarball.sh.
  install -dm755 "$pkgdir/usr/lib/Athas/bundled"
  cp -r src/extensions/bundled/icon-themes "$pkgdir/usr/lib/Athas/bundled/"

  install -Dm644 src-tauri/icons/prod/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/athas.png"
  install -Dm644 src-tauri/icons/prod/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/athas.png"
  install -Dm644 'src-tauri/icons/prod/128x128@2x.png' \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/athas.png"

  # Render the upstream desktop template the deb/rpm bundlers use, keeping
  # StartupWMClass the bare binary name and adding %U for file arguments.
  install -dm755 "$pkgdir/usr/share/applications"
  sed -e '/^{{#if comment}}$/d' \
      -e '/^{{#if mime_type}}$/d' \
      -e '/^{{\/if}}$/d' \
      -e 's|{{comment}}|Lightweight code editor with Git, a terminal and AI agents|' \
      -e 's|{{exec}}|athas|g' \
      -e 's|^Exec=athas$|Exec=athas %U|' \
      -e 's|{{icon}}|athas|' \
      -e 's|{{name}}|Athas|' \
      -e 's|{{mime_type}}|x-scheme-handler/athas;|' \
    src-tauri/linux/athas.desktop > "$pkgdir/usr/share/applications/com.code.athas.desktop"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
