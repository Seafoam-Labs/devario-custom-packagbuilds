pkgname=athas
pkgver=0.19.1
pkgrel=1
pkgdesc='Lightweight code editor with Git, a terminal and AI agents'
url='https://athas.dev'
arch=('x86_64')
license=('AGPL-3.0-or-later')
# 0.19 replaced the Tauri/webview app with a pure Rust GPUI workspace: no
# package.json, bun or Node anywhere. Runtime linkage follows the upstream
# deb Depends (packaging/tauri/tauri.conf.json) plus the ELF NEEDED entries:
# GPUI draws through Vulkan on Wayland/X11, keyring's sync-secret-service
# backend links libdbus, and remote git operations shell out to the git CLI
# (vendored libgit2 has no HTTPS/SSH transports). wry/webkit2gtk is only
# linked on macOS/Windows, so no GTK/WebKit runtime dependencies here.
depends=(
  'dbus'
  'fontconfig'
  'gcc-libs'
  'git'
  'glibc'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
  'zlib'
)
# clang/cmake/pkgconf mirror upstream CI's Linux build dependencies; perl
# builds the vendored OpenSSL when libssh2-sys pulls it in.
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'perl'
  'pkgconf'
)
optdepends=(
  'org.freedesktop.secrets: credential storage via Secret Service'
  'xdg-desktop-portal: portal-backed dialogs and file pickers'
  'xdg-utils: open links and files with the default applications'
  'zenity: dialog fallback when no desktop portal is available'
)
# `!lto`: makepkg's -flto=auto in CFLAGS turns the vendored C dependencies
# (libgit2, freetype, ring, ...) into compiler-specific LTO objects that
# rustc's linker may not be able to read. Rust's own thin LTO
# (profile.release) is unaffected. `!strip`: upstream's release profile
# keeps the symbol table (strip = "debuginfo") so crash reports name frames.
options=('!debug' '!lto' '!strip')
source=("$pkgname-$pkgver.tar.gz::https://github.com/athasdev/athas/archive/refs/tags/v0.19.1.tar.gz")
sha256sums=('fecf1c7b48cce8b120da33c13d15e4e5da2787f8c8ef4161539755c6470020f6')

_srcenv() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
}

prepare() {
  _srcenv

  # The nightly pin only serves rustfmt/dev tooling; no crate uses nightly
  # feature gates and the pinned GPUI revision builds on stable Rust. Drop
  # the pin so rustup-based builders do not pull a nightly toolchain.
  rm -f rust-toolchain.toml

  cargo fetch --locked

  # The tag archive carries the development version (0.1.0); the release
  # workflow stamps [workspace.package] version from the tag. Do the same,
  # then sync the workspace member versions in the lockfile.
  sed -i '/^\[workspace\.package\]/,/^\[/ s/^version = "[^"]*"/version = "'"$pkgver"'"/' Cargo.toml
  cargo update --workspace --offline
}

build() {
  _srcenv
  export CARGO_NET_OFFLINE=true
  # Compile-time shipping identity (crates/paths): bundle id com.code.athas
  # and the dev.athas.app data folder, as the upstream release workflow sets.
  export ATHAS_IDENTITY=release
  RUSTFLAGS+=" --remap-path-prefix $PWD=/"

  cargo build --release --locked -p athas -p cli
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 target/release/athas "$pkgdir/usr/bin/athas"
  install -Dm755 target/release/athas-cli "$pkgdir/usr/bin/athas-cli"

  # Upstream's portable tarball marks package-manager installs with this
  # file next to the binary; the in-app updater then leaves updates to us.
  install -Dm644 /dev/null "$pkgdir/usr/bin/managed-by-package-manager"

  install -Dm644 packaging/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/athas.png"
  install -Dm644 packaging/icons/64x64.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/athas.png"
  install -Dm644 packaging/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/athas.png"
  install -Dm644 'packaging/icons/128x128@2x.png' \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/athas.png"

  # Render the upstream desktop template the deb/rpm bundlers use, keeping
  # StartupWMClass the bare binary name and adding %U for file arguments.
  install -dm755 "$pkgdir/usr/share/applications"
  sed -e '/^{{#if comment}}$/d' \
      -e '/^{{#if mime_type}}$/d' \
      -e '/^{{\/if}}$/d' \
      -e 's|{{comment}}|Lightweight code editor with Git, a terminal and AI agents|' \
      -e 's|{{exec}}|athas|g' \
      -e 's|^Exec=athas$|Exec=athas %U|' \
      -e 's|{{icon}}|athas|' \
      -e 's|{{name}}|Athas|' \
      -e 's|{{mime_type}}|x-scheme-handler/athas;|' \
    packaging/linux/athas.desktop > "$pkgdir/usr/share/applications/com.code.athas.desktop"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
