provides=(
  libruby.so 'libruby.so=4.0-64'
  'rubygems=4.0.20' 'ruby-rubygems=4.0.20'
  ruby-default-gems ruby-bundled-gems ruby-stdlib
  "${_gem_provides[@]}"
)
conflicts=(
  rubygems ruby-rubygems ruby-default-gems ruby-bundled-gems ruby-bundledgems ruby-stdlib
  "${_gem_provides[@]%%=*}"
)
# GCC LTO caused Ractor crashes in bootstrap tests; the same build passes without it.
options=(!emptydirs !lto)
source=("https://cache.ruby-lang.org/pub/ruby/${pkgver%.*}/ruby-$pkgver.tar.gz")
sha256sums=('911ace20f90d068ca0e4dda6d0e4f0f81e52e52f2dd4f4004c721e253412e82d')

build() {
  cd "ruby-$pkgver"

  # Ruby's use of malloc_usable_size is incompatible with fortify level 3.
  export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --sharedstatedir=/var/lib \
    --libexecdir=/usr/lib/ruby \
    --enable-shared \
    --enable-yjit \
    --disable-zjit \
    --disable-rpath \
    --disable-install-doc \
    --disable-install-static-library

  make
}

check() {
  cd "ruby-$pkgver"
  make test
}

package() {
  cd "ruby-$pkgver"
  make DESTDIR="$pkgdir" install-nodoc

  # Installed gems retain their sources and specifications; omit archive copies.
  rm -r "$pkgdir/usr/lib/ruby/gems/${pkgver%.*}.0/cache"

  # Verify the explicit ABI provision used by Shelly's dependency resolver.
  LC_ALL=C readelf -h "$pkgdir/usr/lib/libruby.so" | grep -Eq 'Class:[[:space:]]+ELF64' || return 1
  LC_ALL=C readelf -d "$pkgdir/usr/lib/libruby.so" | grep -Fq 'Library soname: [libruby.so.4.0]' || return 1

  install -Dm644 BSDL COPYING LEGAL -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md NEWS.md -t "$pkgdir/usr/share/doc/$pkgname"
}
