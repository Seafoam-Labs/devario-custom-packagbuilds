# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=sip
pkgver=6.17.3
pkgrel=1
arch=(any)
pkgdesc='A tool that makes it easy to create Python bindings for C and C++ libraries'
url='https://www.riverbankcomputing.com/'
license=(BSD-2-Clause)
depends=('python>=3.10'
         'python-packaging>=24.2'
         'python-setuptools>=75.8.1')
makedepends=(git
             python-build
             python-installer
             'python-setuptools>=77'
             'python-setuptools-scm>=8'
             python-wheel)
source=(git+https://github.com/Python-SIP/sip#tag=6.17.3)
sha256sums=('08fcd9270cc9b75e60d89d2ff03beb5edd963d8457642b7fd98e1f7239d23cc3')

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
