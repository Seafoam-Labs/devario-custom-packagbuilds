+        );
+    }
+    #[test]
+    fn subscription_windows_and_retry_after_keep_their_meaning() {
+        let usage = chatgpt_usage(&json!({"rate_limit":{
+            "primary_window":{"used_percent":25,"limit_window_seconds":18000,"reset_at":1800000000},
+            "secondary_window":{"used_percent":80}
+        },"code_review_rate_limit":{"primary_window":{"used_percent":100}}}))
+        .unwrap();
+        assert_eq!(
+            usage
+                .allowances
+                .iter()
+                .map(|row| row.percent().unwrap())
+                .collect::<Vec<_>>(),
+            vec![75.0, 20.0, 0.0]
+        );
+        assert_eq!(usage.allowances[0].resets_at.as_deref(), Some("1800000000"));
+        assert!(usage.allowances[2].label.starts_with("Code review"));
+        assert_eq!(chatgpt_usage(&json!({})).unwrap().status, "unavailable");
+        assert_eq!(retry_after(Some("3600")), 3600);
+        assert_eq!(retry_after(Some("0")), 60);
+        assert_eq!(retry_after(Some("Wed, 21 Oct 2015 07:28:00 GMT")), 60);
+        assert_eq!(retry_after(Some("garbage")), 120);
+    }
+    #[test]
+    fn missing_is_not_zero_and_balances_have_no_percent() {
+        let usage = ProviderUsage::from_json(&json!({"status":"current", "allowances":[
+            {"label":"Balance", "remaining":12.4, "unit":"USD"},
+            {"label":"Requests", "remaining":0, "limit":300}
+        ]}))
+        .unwrap();
+        assert_eq!(usage.allowances[0].percent(), None);
+        assert_eq!(usage.allowances[1].percent(), Some(0.0));
+        assert_eq!(
+            ProviderUsage::from_json(&json!({"status":"current"}))
+                .unwrap()
+                .status,
+            "unavailable"
+        );
+    }
+    #[test]
+    fn windows_stay_independent_and_invalid_values_are_rejected() {
+        let usage = ProviderUsage::from_json(&json!({"status":"current", "allowances":[
+            {"label":"Weekly", "percent_remaining":82}, {"label":"Five hours", "percent_remaining":65}
+        ]})).unwrap();
+        assert_eq!(usage.allowances.len(), 2);
+        for value in [json!(-1), json!(101), json!("65")] {
+            assert!(
+                ProviderUsage::from_json(&json!({"allowances":[{"percent_remaining":value}]}))
+                    .is_err()
+            );
+        }
+    }
+}
+
+/// Preserve each account window; absent limits are not inferred from token counts.
+pub fn chatgpt_usage(value: &Value) -> Result<ProviderUsage> {
+    let mut allowances = Vec::new();
+    for (field, label) in [
+        ("rate_limit", "Account"),
+        ("code_review_rate_limit", "Code review"),
+    ] {
+        for name in ["primary_window", "secondary_window"] {
+            let window = &value[field][name];
+            if let Some(used) = window["used_percent"]
+                .as_f64()
+                .filter(|n| n.is_finite() && *n >= 0.0)
+            {
+                let seconds = window["limit_window_seconds"].as_u64();
+                let label = match seconds {
+                    Some(seconds) => format!("{label} · {} hour window", seconds / 3600),
+                    None => format!("{label} · {name}"),
+                };
+                allowances.push(serde_json::json!({"label":label,"percent_remaining":(100.0-used).clamp(0.0,100.0),"resets_at":window["reset_at"].as_u64().map(|t| t.to_string())}));
+            }
+        }
+    }
+    ProviderUsage::from_json(&serde_json::json!({"status":"current","allowances":allowances}))
+}
+
+/// Both forms of Retry-After are allowed by HTTP. Bound unreasonable provider values.
+pub fn retry_after(value: Option<&str>) -> u64 {
+    value
+        .and_then(|s| {
+            s.parse::<u64>().ok().or_else(|| {
+                chrono::DateTime::parse_from_rfc2822(s).ok().map(|time| {
+                    let now = std::time::SystemTime::now()
+                        .duration_since(std::time::UNIX_EPOCH)
+                        .unwrap_or_default()
+                        .as_secs();
+                    (time.timestamp().max(0) as u64).saturating_sub(now)
+                })
+            })
+        })
+        .unwrap_or(120)
+        .clamp(60, 86400)
+}
