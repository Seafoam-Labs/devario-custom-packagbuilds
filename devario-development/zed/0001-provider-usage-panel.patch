new file mode 100644
index 0000000..63aedfe
--- /dev/null
+++ b/crates/agent_ui/src/provider_usage.rs
@@ -0,0 +1,449 @@
+mod opencode;
+use futures::{FutureExt, StreamExt, future::LocalBoxFuture};
+use gpui::{Context, Subscription, Task, Window, actions};
+use language_model::{LanguageModelRegistry, provider_usage::ProviderUsage};
+use settings::SettingsStore;
+use std::{
+    collections::{BTreeMap, HashSet},
+    time::{Duration, Instant},
+};
+use ui::prelude::*;
+
+actions!(agent, [ToggleProviderUsage]);
+
+#[derive(Clone)]
+struct Account {
+    id: String,
+    source: &'static str,
+    label: String,
+    usage: ProviderUsage,
+    observed: i64,
+    stale: bool,
+}
+
+pub(crate) struct ProviderUsageView {
+    accounts: BTreeMap<String, Account>,
+    expanded: HashSet<String>,
+    filter: &'static str,
+    visible: bool,
+    refresh: Option<Task<()>>,
+    timer: Option<Task<()>>,
+    next_refresh: Option<Instant>,
+    cooldowns: BTreeMap<String, Instant>,
+    _subscriptions: Vec<Subscription>,
+}
+
+impl ProviderUsageView {
+    pub fn new(cx: &mut Context<Self>) -> Self {
+        let registry = LanguageModelRegistry::global(cx);
+        let subscriptions = vec![
+            cx.subscribe(&registry, |this, _, _, cx| this.invalidate(cx)),
+            cx.observe_global::<SettingsStore>(|this, cx| this.invalidate(cx)),
+        ];
+        Self {
+            cooldowns: BTreeMap::new(),
+            accounts: BTreeMap::new(),
+            expanded: HashSet::new(),
+            filter: "All",
+            visible: false,
+            refresh: None,
+            timer: None,
+            next_refresh: None,
+            _subscriptions: subscriptions,
+        }
+    }
+
+    fn invalidate(&mut self, cx: &mut Context<Self>) {
+        self.refresh = None;
+        self.next_refresh = None;
+        self.accounts.clear();
+        self.cooldowns.clear();
+        if self.visible {
+            self.refresh(cx);
+        }
+        cx.notify();
+    }
+
+    pub fn set_visible(&mut self, visible: bool, cx: &mut Context<Self>) {
+        if self.visible == visible {
+            return;
+        }
+        self.visible = visible;
+        if !visible {
+            self.timer = None;
+            self.refresh = None;
+            return;
+        }
+        self.refresh(cx);
+        self.timer = Some(cx.spawn(async move |this, cx| {
+            loop {
+                cx.background_executor()
+                    .timer(Duration::from_secs(60))
+                    .await;
+                if this
+                    .update(cx, |this, cx| {
+                        this.refresh(cx);
+                        cx.notify();
+                    })
+                    .is_err()
+                {
+                    break;
+                }
+            }
+        }));
+    }
+
+    fn refresh(&mut self, cx: &mut Context<Self>) {
+        if self.refresh.is_some()
+            || self
+                .next_refresh
+                .is_some_and(|until| Instant::now() < until)
+        {
+            return;
+        }
+        self.next_refresh = Some(Instant::now() + Duration::from_secs(60));
+        let mut seen = HashSet::new();
+        let mut jobs: Vec<LocalBoxFuture<'static, (String, Vec<Account>)>> = Vec::new();
+        for provider in LanguageModelRegistry::global(cx)
+            .read(cx)
+            .visible_providers()
+        {
+            if !provider.is_authenticated(cx) {
+                continue;
+            }
+            let id = format!("zed:{}", provider.id().0);
+            if self
+                .cooldowns
+                .get(&id)
+                .is_some_and(|until| Instant::now() < *until)
+            {
+                seen.insert(id);
+                continue;
+            }
+            let label = provider.name().0.to_string();
+            let task = provider.provider_usage(cx);
+            jobs.push(
+                async move {
+                    let usage = task.await.unwrap_or_else(|_| ProviderUsage {
+                        status: "error".into(),
+                        ..ProviderUsage::unavailable("Usage temporarily unavailable")
+                    });
+                    let now = chrono::Utc::now().timestamp();
+                    (
+                        id.clone(),
+                        vec![Account {
+                            id,
+                            source: "Zed",
+                            label,
+                            observed: usage.observed_at.map(|t| t as i64).unwrap_or(now),
+                            usage,
+                            stale: false,
+                        }],
+                    )
+                }
+                .boxed_local(),
+            );
+        }
+        // The plugin export is local shared state. Reading it does not require
+        // a configured agent, an ACP connection, or an active conversation.
+        let task = cx
+            .background_executor()
+            .spawn(async { opencode::read_export() });
+        jobs.push(
+            async move {
+                let accounts = task.await.unwrap_or_else(|_| vec![opencode::failure()]);
+                (opencode::PREFIX.into(), accounts)
+            }
+            .boxed_local(),
+        );
+        self.refresh = Some(cx.spawn(async move |this, cx| {
+            let mut results = futures::stream::iter(jobs).buffer_unordered(4);
+            while let Some((prefix, accounts)) = results.next().await {
+                let _ = this.update(cx, |this, cx| {
+                    if prefix.starts_with("zed:") {
+                        let retry = accounts
+                            .iter()
+                            .map(|row| row.usage.retry_after)
+                            .max()
+                            .unwrap_or(60);
+                        this.cooldowns
+                            .insert(prefix.clone(), Instant::now() + Duration::from_secs(retry));
+                    }
+                    // A failed export read retains last-known rows, explicitly stale.
+                    if accounts.len() == 1
+                        && accounts[0].id == prefix
+                        && accounts[0].usage.status == "error"
+                    {
+                        let mut retained = false;
+                        for (id, previous) in this.accounts.iter_mut().filter(|(id, _)| {
+                            if prefix.starts_with("zed:") {
+                                *id == &prefix
+                            } else {
+                                id.starts_with(&prefix)
+                            }
+                        }) {
+                            previous.stale = true;
+                            seen.insert(id.clone());
+                            retained = true;
+                        }
+                        if retained {
+                            cx.notify();
+                            return;
+                        }
+                    }
+                    for mut account in accounts {
+                        seen.insert(account.id.clone());
+                        if account.source == "Zed" && account.usage.status == "error" {
+                            if let Some(previous) = this.accounts.get(&account.id) {
+                                account.observed = previous.observed;
+                                account.usage.allowances = previous.usage.allowances.clone();
+                                account.stale = true;
+                            }
+                        }
+                        this.accounts.insert(account.id.clone(), account);
+                    }
+                    cx.notify();
+                });
+            }
+            let _ = this.update(cx, |this, cx| {
+                this.accounts.retain(|id, _| seen.contains(id));
+                this.cooldowns.retain(|id, _| seen.contains(id));
+                this.refresh = None;
+                cx.notify();
+            });
+        }));
+        cx.notify();
+    }
+}
+
+impl Render for ProviderUsageView {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let now = chrono::Utc::now().timestamp();
+        let refreshing = self.refresh.is_some();
+        let rows = self
+            .accounts
+            .values()
+            .filter(|account| self.filter == "All" || account.source == self.filter)
+            .map(|account| {
+                let id = account.id.clone();
+                let expanded = self.expanded.contains(&id);
+                let stale = account.stale
+                    || (["current", "partial"].contains(&account.usage.status.as_str())
+                        && (account.observed <= 0 || now.saturating_sub(account.observed) > 300));
+                let status = if stale {
+                    if account.usage.status == "partial" {
+                        "Stale · partial"
+                    } else {
+                        "Stale"
+                    }
+                } else {
+                    match account.usage.status.as_str() {
+                        "current" => "Current",
+                        "partial" => "Partial",
+                        "sign_in" => "Sign in required",
+                        "error" => "Temporarily unavailable",
+                        _ => "Usage unavailable",
+                    }
+                };
+                v_flex()
+                    .gap_1()
+                    .py_3()
+                    .border_b_1()
+                    .border_color(cx.theme().colors().border_variant)
+                    .child(
+                        Button::new(
+                            SharedString::from(format!("account-{id}")),
+                            account.label.clone(),
+                        )
+                        .style(ButtonStyle::Subtle)
+                        .on_click(cx.listener(move |this, _, _, cx| {
+                            if !this.expanded.remove(&id) {
+                                this.expanded.insert(id.clone());
+                            }
+                            cx.notify();
+                        })),
+                    )
+                    .child(
+                        Label::new(format!(
+                            "{} · {status}",
+                            if account.source == "OpenCode" {
+                                "OpenCode Quota"
+                            } else {
+                                account.source
+                            }
+                        ))
+                        .size(LabelSize::Small)
+                        .color(if stale {
+                            Color::Warning
+                        } else {
+                            Color::Muted
+                        }),
+                    )
+                    .when(!account.usage.detail.is_empty(), |row| {
+                        row.child(
+                            Label::new(account.usage.detail.clone())
+                                .size(LabelSize::Small)
+                                .color(Color::Muted),
+                        )
+                    })
+                    .children(
+                        account
+                            .usage
+                            .allowances
+                            .iter()
+                            .take(if expanded { usize::MAX } else { 1 })
+                            .map(|allowance| {
+                                v_flex()
+                                    .gap_1()
+                                    .child(
+                                        Label::new(allowance.label.clone()).size(LabelSize::Small),
+                                    )
+                                    .child(Label::new(allowance.description()))
+                                    .when_some(allowance.provenance(), |row, source| {
+                                        row.child(
+                                            Label::new(source)
+                                                .size(LabelSize::Small)
+                                                .color(Color::Muted),
+                                        )
+                                    })
+                                    .when_some(allowance.percent(), |row, percent| {
+                                        row.child(
+                                            div()
+                                                .h_1()
+                                                .w_full()
+                                                .bg(cx.theme().colors().border_variant)
+                                                .child(
+                                                    div()
+                                                        .h_1()
+                                                        .w(gpui::relative(percent as f32 / 100.0))
+                                                        .bg(if percent <= 10.0 {
+                                                            cx.theme().status().warning
+                                                        } else {
+                                                            cx.theme().colors().text_accent
+                                                        }),
+                                                ),
+                                        )
+                                    })
+                                    .when_some(allowance.resets_at.clone(), |row, reset| {
+                                        row.child(
+                                            Label::new(reset_label(&reset))
+                                                .size(LabelSize::Small)
+                                                .color(Color::Muted),
+                                        )
+                                    })
+                            }),
+                    )
+                    .when(!expanded && account.usage.allowances.len() > 1, |row| {
+                        row.child(
+                            Label::new(format!(
+                                "{} more allowances · select to expand",
+                                account.usage.allowances.len() - 1
+                            ))
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                        )
+                    })
+                    .when(!account.usage.allowances.is_empty(), |row| {
+                        row.child(
+                            Label::new(if account.observed <= 0 {
+                                "Observation time unavailable".into()
+                            } else {
+                                format!(
+                                    "Updated {}s ago",
+                                    now.saturating_sub(account.observed).max(0)
+                                )
+                            })
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                        )
+                    })
+            })
+            .collect::<Vec<_>>();
+        v_flex()
+            .flex_1()
+            .min_h_0()
+            .px_3()
+            .gap_2()
+            .child(
+                h_flex()
+                    .justify_between()
+                    .py_2()
+                    .child(Label::new("Provider usage"))
+                    .child(
+                        Button::new(
+                            "refresh-provider-usage",
+                            if refreshing {
+                                "Refreshing…"
+                            } else {
+                                "Refresh"
+                            },
+                        )
+                        .disabled(
+                            refreshing
+                                || self
+                                    .next_refresh
+                                    .is_some_and(|until| Instant::now() < until),
+                        )
+                        .on_click(cx.listener(|this, _, _, cx| this.refresh(cx))),
+                    ),
+            )
+            .child(
+                h_flex()
+                    .gap_1()
+                    .children(["All", "OpenCode", "Zed"].into_iter().map(|filter| {
+                        Button::new(filter, filter)
+                            .toggle_state(self.filter == filter)
+                            .on_click(cx.listener(move |this, _, _, cx| {
+                                this.filter = filter;
+                                cx.notify();
+                            }))
+                    })),
+            )
+            .child(
+                Label::new("OpenCode Quota · shared local account list")
+                    .size(LabelSize::Small)
+                    .color(Color::Muted),
+            )
+            .child(
+                v_flex()
+                    .id("provider-usage-accounts")
+                    .flex_1()
+                    .min_h_0()
+                    .overflow_y_scroll()
+                    .children(rows)
+                    .when(self.accounts.is_empty(), |row| {
+                        row.child(
+                            Label::new(if refreshing {
+                                "Loading provider accounts…"
+                            } else {
+                                "No provider accounts available"
+                            })
+                            .color(Color::Muted),
+                        )
+                    }),
+            )
+    }
+}
+
+fn reset_label(value: &str) -> String {
+    let reset = value
+        .parse::<i64>()
+        .ok()
+        .and_then(|timestamp| chrono::DateTime::from_timestamp(timestamp, 0))
+        .or_else(|| {
+            chrono::DateTime::parse_from_rfc3339(value)
+                .ok()
+                .map(|date| date.with_timezone(&chrono::Utc))
+        });
+    match reset {
+        Some(reset) => {
+            let seconds = (reset - chrono::Utc::now()).num_seconds();
+            if seconds <= 0 {
+                "Reset due · refresh pending".into()
+            } else {
+                format!("Resets in {}h {}m", seconds / 3600, seconds % 3600 / 60)
+            }
+        }
+        None => format!("Resets {value}"),
+    }
+}
