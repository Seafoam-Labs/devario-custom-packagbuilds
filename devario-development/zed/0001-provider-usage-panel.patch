 }
+
+/// Read the signed-in ChatGPT account's windows without sending a prompt.
+pub fn provider_usage(
+    state: &Entity<State>,
+    cx: &AsyncApp,
+) -> BoxFuture<'static, Result<language_model::provider_usage::ProviderUsage>> {
+    use futures::AsyncReadExt as _;
+    use http_client::HttpRequestExt as _;
+    let http_client = state.read_with(cx, |state, _| state.http_client.clone());
+    let state = state.downgrade();
+    cx.spawn(async move |cx| {
+        let creds = match get_fresh_credentials(&state, &http_client, cx).await {
+            Ok(creds) => creds,
+            Err(_) => return language_model::provider_usage::ProviderUsage::from_json(&serde_json::json!({"status":"sign_in","detail":"Sign in to read usage"})),
+        };
+        let mut request = HttpRequest::get("https://chatgpt.com/backend-api/wham/usage")
+            .header("Authorization", format!("Bearer {}", creds.access_token))
+            .header("Accept", "application/json").follow_redirects(http_client::RedirectPolicy::NoFollow)
+            .timeout(std::time::Duration::from_secs(15));
+        if let Some(id) = creds.account_id { request = request.header("ChatGPT-Account-Id", id); }
+        let mut response = http_client.send(request.body(AsyncBody::empty())?).await
+            .map_err(|_| anyhow!("Usage temporarily unavailable"))?;
+        if !response.status().is_success() {
+            return language_model::provider_usage::ProviderUsage::from_json(&serde_json::json!({
+                "status": if response.status().as_u16() == 401 {"sign_in"} else {"error"},
+                "detail":"Account allowance unavailable", "retry_after":language_model::provider_usage::retry_after(response.headers().get("retry-after").and_then(|v| v.to_str().ok())),
+            }));
+        }
+        let mut body = Vec::new();
+        response.body_mut().take(1024 * 1024 + 1).read_to_end(&mut body).await?;
+        anyhow::ensure!(body.len() <= 1024 * 1024, "Usage response too large");
+        let value: serde_json::Value = serde_json::from_slice(&body).map_err(|_| anyhow!("Invalid usage response"))?;
+        language_model::provider_usage::chatgpt_usage(&value)
+    }).boxed()
+}
