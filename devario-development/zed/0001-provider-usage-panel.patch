diff --git a/crates/language_models/src/provider/usage.rs b/crates/language_models/src/provider/usage.rs
new file mode 100644
index 0000000..b0925c1
--- /dev/null
+++ b/crates/language_models/src/provider/usage.rs
@@ -0,0 +1,165 @@
+//! Read-only allowance endpoints. Never send a configured proxy's credentials to a different host.
+use anyhow::{Result, bail};
+use futures::AsyncReadExt;
+use http_client::{AsyncBody, HttpClient, HttpRequestExt, Request};
+use language_model::provider_usage::ProviderUsage;
+use serde_json::{Value, json};
+use std::{sync::Arc, time::Duration};
+
+pub async fn read(
+    client: Arc<dyn HttpClient>,
+    provider: &str,
+    base: String,
+    key: Option<String>,
+) -> Result<ProviderUsage> {
+    let Some(key) = key else {
+        return ProviderUsage::from_json(
+            &json!({"status":"sign_in", "detail":"Sign in to read usage"}),
+        );
+    };
+    let (expected, endpoint) = match provider {
+        "openrouter" => (
+            "https://openrouter.ai/api/v1",
+            "https://openrouter.ai/api/v1/key",
+        ),
+        "deepseek" => (
+            "https://api.deepseek.com",
+            "https://api.deepseek.com/user/balance",
+        ),
+        "vercel_ai_gateway" => (
+            "https://ai-gateway.vercel.sh/v1",
+            "https://ai-gateway.vercel.sh/v1/credits",
+        ),
+        _ => {
+            return Ok(ProviderUsage::unavailable(
+                "No allowance reader for this provider",
+            ));
+        }
+    };
+    let base = base.trim_end_matches('/');
+    if base != expected && !(provider == "deepseek" && base == "https://api.deepseek.com/v1") {
+        return Ok(ProviderUsage::unavailable(
+            "Usage is unavailable for this custom endpoint",
+        ));
+    }
+    let request = Request::get(endpoint)
+        .header("Authorization", format!("Bearer {key}"))
+        .header("Accept", "application/json")
+        .follow_redirects(http_client::RedirectPolicy::NoFollow)
+        .timeout(Duration::from_secs(15))
+        .body(AsyncBody::empty())?;
+    let mut response = client
+        .send(request)
+        .await
+        .map_err(|_| anyhow::anyhow!("Usage request failed"))?;
+    if !response.status().is_success() {
+        let status = response.status().as_u16();
+        let retry = language_model::provider_usage::retry_after(
+            response
+                .headers()
+                .get("retry-after")
+                .and_then(|v| v.to_str().ok()),
+        );
+        return ProviderUsage::from_json(
+            &json!({"status": if status == 401 {"sign_in"} else {"error"},
+            "detail": if status == 403 {"Account does not permit reading usage"} else if status == 429 {"Refresh rate limited"} else {"Usage temporarily unavailable"}, "retry_after":retry}),
+        );
+    }
+    let mut bytes = Vec::new();
+    response
+        .body_mut()
+        .take(1024 * 1024 + 1)
+        .read_to_end(&mut bytes)
+        .await?;
+    if bytes.len() > 1024 * 1024 {
+        bail!("Usage response is too large");
+    }
+    let value: Value =
+        serde_json::from_slice(&bytes).map_err(|_| anyhow::anyhow!("Invalid usage response"))?;
+    normalize(provider, &value)
+}
+
+pub fn normalize(provider: &str, value: &Value) -> Result<ProviderUsage> {
+    let mut allowances = Vec::new();
+    match provider {
+        "openrouter" => {
+            let data = &value["data"];
+            if let (Some(limit), Some(remaining)) =
+                (data["limit"].as_f64(), data["limit_remaining"].as_f64())
+            {
+                allowances.push(json!({"label":format!("API key budget ({})",data["limit_reset"].as_str().unwrap_or("no reset")), "remaining":remaining.max(0.0), "limit":limit, "unit":"USD"}));
+            }
+            for budget in data["budgets"].as_array().into_iter().flatten() {
+                if let (Some(limit), Some(remaining)) = (
+                    budget["limit_usd"].as_f64(),
+                    budget["remaining_usd"].as_f64(),
+                ) {
+                    allowances.push(json!({"label":format!("{} budget ({})",budget["scope"].as_str().unwrap_or("Account"),budget["reset_interval"].as_str().unwrap_or("no reset")),"remaining":remaining.max(0.0),"limit":limit,"unit":"USD","resets_at":budget["resets_at"]}));
+                }
+            }
+            if let (Some(limit), Some(remaining)) = (
+                data["free_model_daily_requests"]["limit"].as_f64(),
+                data["free_model_daily_requests"]["remaining"].as_f64(),
+            ) {
+                allowances.push(json!({"label":"Free models daily", "remaining":remaining.max(0.0),"limit":limit,"unit":"requests"}));
+            }
+        }
+        "deepseek" => {
+            for balance in value["balance_infos"].as_array().into_iter().flatten() {
+                if let (Some(currency), Some(remaining)) = (
+                    balance["currency"].as_str(),
+                    balance["total_balance"]
+                        .as_str()
+                        .and_then(|s| s.parse::<f64>().ok()),
+                ) {
+                    allowances.push(json!({"label":"Credit balance", "remaining":remaining.max(0.0),"unit":currency}));
+                }
+            }
+        }
+        "vercel_ai_gateway" => {
+            if let Some(balance) = value["balance"]
+                .as_f64()
+                .or_else(|| value["balance"].as_str().and_then(|s| s.parse().ok()))
+            {
+                allowances.push(
+                    json!({"label":"Gateway credits", "remaining":balance.max(0.0),"unit":"USD"}),
+                );
+            }
+        }
+        _ => {}
+    }
+    ProviderUsage::from_json(&json!({"status":"current","allowances":allowances}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn unlimited_key_is_not_an_empty_account() {
+        assert_eq!(
+            normalize(
+                "openrouter",
+                &json!({"data":{"limit":null,"limit_remaining":null,"usage":40}})
+            )
+            .unwrap()
+            .status,
+            "unavailable"
+        );
+    }
+    #[test]
+    fn balances_and_key_budgets_keep_their_units() {
+        let balance = normalize(
+            "deepseek",
+            &json!({"balance_infos":[{"currency":"CNY","total_balance":"110.00"}]}),
+        )
+        .unwrap();
+        assert_eq!(balance.allowances[0].remaining, Some(110.0));
+        assert_eq!(balance.allowances[0].percent(), None);
+        let key = normalize(
+            "openrouter",
+            &json!({"data":{"limit":100,"limit_remaining":74.5,"limit_reset":"monthly"}}),
+        )
+        .unwrap();
+        assert_eq!(key.allowances[0].percent(), Some(74.5));
+    }
+}
