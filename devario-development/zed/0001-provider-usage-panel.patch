+//! Account allowances are independent of a conversation's token usage.
+use anyhow::{Result, bail};
+use serde_json::Value;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Allowance {
+    pub label: String,
+    pub display_value: Option<String>,
+    pub authority: String,
+    pub acquisition_method: String,
+    pub result_type: String,
+    pub remaining: Option<f64>,
+    pub limit: Option<f64>,
+    pub percent_remaining: Option<f64>,
+    pub unit: String,
+    pub resets_at: Option<String>,
+}
+
+impl Allowance {
+    pub fn percent(&self) -> Option<f64> {
+        self.percent_remaining.or_else(|| {
+            let limit = self.limit.filter(|value| *value > 0.0)?;
+            Some((100.0 * self.remaining? / limit).clamp(0.0, 100.0))
+        })
+    }
+
+    pub fn provenance(&self) -> Option<String> {
+        if self.authority.is_empty() && self.acquisition_method.is_empty() {
+            return None;
+        }
+        let source = match (self.authority.as_str(), self.acquisition_method.as_str()) {
+            (_, "local_estimation") => "Estimate",
+            ("locally_derived", _) => "Locally derived",
+            ("provider_reported", _) => "Provider reported",
+            _ => "Source not reported",
+        };
+        let kind = match self.result_type.as_str() {
+            "quota" => "allowance",
+            "budget" => "budget",
+            "balance" => "balance",
+            "usage" => "usage",
+            "status" => "status",
+            _ => "value",
+        };
+        Some(format!("{source} · {kind}"))
+    }
+
+    pub fn description(&self) -> String {
+        // v3 exports carry formatted balances/status values, not separate amounts.
+        if let Some(value) = &self.display_value {
+            return value.clone();
+        }
+        match (self.remaining, self.limit, self.percent()) {
+            (Some(remaining), Some(limit), _) => {
+                format!("{remaining:.2} / {limit:.2} {} remaining", self.unit)
+            }
+            (Some(remaining), None, _) => format!("{remaining:.2} {} remaining", self.unit),
+            (_, _, Some(percent)) => format!("{percent:.0}% remaining"),
+            _ => "Usage unavailable".into(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ProviderUsage {
+    pub status: String,
+    pub detail: String,
+    pub allowances: Vec<Allowance>,
+    pub retry_after: u64,
+    pub observed_at: Option<u64>,
+}
+
+impl ProviderUsage {
+    pub fn unavailable(detail: impl Into<String>) -> Self {
+        Self {
+            status: "unavailable".into(),
+            detail: detail.into(),
+            allowances: Vec::new(),
+            retry_after: 60,
+            observed_at: None,
+        }
+    }
+
+    pub fn from_json(value: &Value) -> Result<Self> {
+        let status = value["status"].as_str().unwrap_or("unavailable");
+        if !["current", "partial", "unavailable", "sign_in", "error"].contains(&status) {
+            bail!("Invalid provider usage status");
+        }
+        let mut result = Self::unavailable(value["detail"].as_str().unwrap_or(""));
+        result.status = status.into();
+        result.observed_at = value["observed_at"].as_u64();
+        result.retry_after = value["retry_after"].as_u64().unwrap_or(60).clamp(60, 86400);
+        if let Some(values) = value["allowances"].as_array() {
+            if values.len() > 100 {
+                bail!("Too many allowances");
+            }
+            for item in values {
+                let number = |key: &str| -> Result<Option<f64>> {
+                    if item[key].is_null() {
+                        return Ok(None);
+                    }
+                    let value = item[key]
+                        .as_f64()
+                        .filter(|n| n.is_finite() && *n >= 0.0)
+                        .ok_or_else(|| anyhow::anyhow!("Invalid allowance value"))?;
+                    Ok(Some(value))
+                };
+                let percent = number("percent_remaining")?;
+                if percent.is_some_and(|n| n > 100.0) {
+                    bail!("Invalid allowance percentage");
+                }
+                result.allowances.push(Allowance {
+                    display_value: item["display_value"]
+                        .as_str()
+                        .map(|s| s.chars().take(300).collect()),
+                    authority: item["authority"]
+                        .as_str()
+                        .unwrap_or("")
+                        .chars()
+                        .take(40)
+                        .collect(),
+                    acquisition_method: item["acquisition_method"]
+                        .as_str()
+                        .unwrap_or("")
+                        .chars()
+                        .take(40)
+                        .collect(),
+                    result_type: item["result_type"]
+                        .as_str()
+                        .unwrap_or("")
+                        .chars()
+                        .take(40)
+                        .collect(),
+                    label: item["label"]
+                        .as_str()
+                        .unwrap_or("Allowance")
+                        .chars()
+                        .take(200)
+                        .collect(),
+                    remaining: number("remaining")?,
+                    limit: number("limit")?,
+                    percent_remaining: percent,
+                    unit: item["unit"]
+                        .as_str()
+                        .unwrap_or("")
+                        .chars()
+                        .take(30)
+                        .collect(),
+                    resets_at: item["resets_at"]
+                        .as_str()
+                        .map(|s| s.chars().take(80).collect()),
+                });
+            }
+        }
+        if result.status == "current" && result.allowances.is_empty() {
+            result.status = "unavailable".into();
+            result.detail = "Provider does not report an allowance".into();
+        }
+        result.detail = result.detail.chars().take(300).collect();
+        Ok(result)
+    }
+}
