index 0000000..3305238
--- /dev/null
+++ b/crates/agent_ui/src/provider_usage/opencode.rs
@@ -0,0 +1,438 @@
+//! Reads OpenCode Quota's documented v3 export, not its private credential/cache files.
+//! https://github.com/slkiser/opencode-quota/blob/main/docs/readme/external-integration.md
+use super::Account;
+use anyhow::{Result, bail, ensure};
+use language_model::provider_usage::{Allowance, ProviderUsage};
+use serde::Deserialize;
+use std::{
+    collections::{BTreeMap, HashSet},
+    fs::File,
+    io::Read,
+    path::{Path, PathBuf},
+};
+
+pub(super) const PREFIX: &str = "opencode-quota:";
+const MAX_BYTES: u64 = 2 * 1024 * 1024;
+
+pub(super) fn read_export() -> Result<Vec<Account>> {
+    let path = export_path(
+        std::env::var_os("OPENCODE_QUOTA_EXPORT_PATH").map(PathBuf::from),
+        std::env::var_os("XDG_CACHE_HOME").map(PathBuf::from),
+        paths::home_dir(),
+    )?;
+    read_file(&path)
+}
+
+fn export_path(
+    configured: Option<PathBuf>,
+    cache: Option<PathBuf>,
+    home: &Path,
+) -> Result<PathBuf> {
+    let path = match configured.filter(|path| !path.as_os_str().is_empty()) {
+        Some(path) => match path.strip_prefix("~") {
+            Ok(relative) => home.join(relative),
+            Err(_) => path,
+        },
+        None => cache
+            .filter(|path| !path.as_os_str().is_empty())
+            .unwrap_or_else(|| home.join(".cache"))
+            .join("opencode/quota-export.json"),
+    };
+    ensure!(path.is_absolute(), "Quota export path must be absolute");
+    Ok(path)
+}
+
+fn read_file(path: &Path) -> Result<Vec<Account>> {
+    let metadata = match std::fs::metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            return Ok(vec![notice(
+                "setup",
+                ProviderUsage::unavailable(
+                    "Install @slkiser/opencode-quota and enable its Quota file (JSON) export",
+                ),
+            )]);
+        }
+        Err(error) => return Err(error.into()),
+    };
+    ensure!(
+        metadata.is_file() && metadata.len() <= MAX_BYTES,
+        "Invalid quota export file"
+    );
+    let file = File::open(path)?;
+    ensure!(
+        file.metadata()?.is_file(),
+        "Quota export is not a regular file"
+    );
+    let mut bytes = Vec::new();
+    file.take(MAX_BYTES + 1).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() as u64 <= MAX_BYTES, "Quota export is too large");
+    parse_export(&bytes)
+}
+
+pub(super) fn failure() -> Account {
+    notice(
+        "",
+        ProviderUsage {
+            status: "error".into(),
+            ..ProviderUsage::unavailable(
+                "Cannot read OpenCode Quota export; check the file path and JSON version 3",
+            )
+        },
+    )
+}
+
+fn notice(id: &str, usage: ProviderUsage) -> Account {
+    Account {
+        id: format!("{PREFIX}{id}"),
+        source: "OpenCode",
+        label: "OpenCode Quota".into(),
+        usage,
+        observed: 0,
+        stale: false,
+    }
+}
+
+#[derive(Deserialize)]
+struct Export {
+    version: u32,
+    providers: BTreeMap<String, Provider>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Status {
+    Ok,
+    Partial,
+    Error,
+    Unavailable,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Provider {
+    status: Status,
+    fetched_at: Option<f64>,
+    #[serde(default)]
+    entries: Vec<Entry>,
+    error: Option<String>,
+    #[serde(default)]
+    errors: Vec<ProviderError>,
+}
+
+#[derive(Deserialize)]
+struct ProviderError {
+    label: String,
+    message: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Entry {
+    id: String,
+    name: String,
+    account: Option<String>,
+    authority: Option<String>,
+    acquisition_method: Option<String>,
+    result_type: Option<String>,
+    reset_at: Option<f64>,
+    #[serde(flatten)]
+    value: EntryValue,
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "renderType")]
+enum EntryValue {
+    #[serde(rename = "percent")]
+    Percent {
+        #[serde(rename = "percentRemaining")]
+        remaining: f64,
+    },
+    #[serde(rename = "value")]
+    Value { value: String },
+}
+
+fn timestamp(value: Option<f64>) -> Result<Option<u64>> {
+    value
+        .map(|value| {
+            ensure!(
+                value.is_finite() && (0.0..=253402300799.0).contains(&value),
+                "Invalid quota timestamp"
+            );
+            Ok(value.floor() as u64)
+        })
+        .transpose()
+}
+
+fn parse_export(bytes: &[u8]) -> Result<Vec<Account>> {
+    let export: Export = serde_json::from_slice(bytes)?;
+    ensure!(export.version == 3, "Unsupported quota export version");
+    let mut accounts = Vec::new();
+    for (provider, result) in export.providers {
+        let observed = timestamp(result.fetched_at)?.unwrap_or(0);
+        let mut groups: BTreeMap<String, Vec<Allowance>> = BTreeMap::new();
+        let mut seen = HashSet::new();
+        if matches!(result.status, Status::Ok | Status::Partial) {
+            for entry in result.entries {
+                let account = entry.account.unwrap_or_default();
+                ensure!(
+                    seen.insert((account.clone(), entry.id)),
+                    "Duplicate quota row"
+                );
+                let reset = timestamp(entry.reset_at)?;
+                let (percent, display) = match entry.value {
+                    EntryValue::Percent { remaining } => {
+                        ensure!(remaining.is_finite(), "Invalid quota percentage");
+                        // An over-quota percentage can be negative. Bound only the bar.
+                        (
+                            Some(remaining.clamp(0.0, 100.0)),
+                            format!("{remaining}% remaining"),
+                        )
+                    }
+                    EntryValue::Value { value } => (None, value),
+                };
+                let rows = groups.entry(account).or_default();
+                rows.push(Allowance {
+                    label: entry.name.chars().take(200).collect(),
+                    display_value: Some(display.chars().take(300).collect()),
+                    authority: entry.authority.unwrap_or_else(|| "unknown".into()),
+                    acquisition_method: entry
+                        .acquisition_method
+                        .unwrap_or_else(|| "unknown".into()),
+                    result_type: entry.result_type.unwrap_or_else(|| "unknown".into()),
+                    percent_remaining: percent,
+                    remaining: None,
+                    limit: None,
+                    unit: String::new(),
+                    resets_at: reset.map(|value| value.to_string()),
+                });
+                ensure!(rows.len() <= 100, "Too many quota rows");
+            }
+        }
+        if groups.is_empty() {
+            groups.insert(String::new(), Vec::new());
+        }
+        let detail = match result.status {
+            Status::Partial => format!(
+                "Incomplete · {}",
+                result
+                    .errors
+                    .iter()
+                    .map(|error| format!("{}: {}", error.label, error.message))
+                    .collect::<Vec<_>>()
+                    .join("; ")
+            ),
+            Status::Error => result
+                .error
+                .unwrap_or_else(|| "Plugin quota check failed".into()),
+            _ => String::new(),
+        }
+        .chars()
+        .take(300)
+        .collect::<String>();
+        for (account, allowances) in groups {
+            let status = match result.status {
+                Status::Ok if !allowances.is_empty() => "current",
+                Status::Partial => "partial",
+                Status::Error => "error",
+                _ => "unavailable",
+            };
+            let detail = if status == "unavailable" {
+                "No quota data in the plugin export; check /quota_status".into()
+            } else {
+                detail.clone()
+            };
+            let label = if account.is_empty() {
+                provider.clone()
+            } else {
+                format!("{provider} · {account}")
+            };
+            accounts.push(Account {
+                id: format!("{PREFIX}{}", serde_json::to_string(&(&provider, &account))?),
+                source: "OpenCode",
+                label: label.chars().take(200).collect(),
+                usage: ProviderUsage {
+                    status: status.into(),
+                    detail,
+                    allowances,
+                    observed_at: Some(observed),
+                    retry_after: 60,
+                },
+                observed: observed as i64,
+                stale: false,
+            });
+            if accounts.len() > 500 {
+                bail!("Too many quota accounts");
+            }
+        }
+    }
+    Ok(accounts)
+}
