+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::{Value, json};
+
+    fn entry() -> Value {
+        json!({"id":"alibaba-token-plan.personal.monthly", "name":"Alibaba Monthly", "renderType":"percent",
+            "percentRemaining":62.3, "resetAt":1800000000, "resultType":"quota", "authority":"provider_reported", "acquisitionMethod":"local_cli"})
+    }
+
+    fn parse(value: Value) -> Result<Vec<Account>> {
+        parse_export(&serde_json::to_vec(&value)?)
+    }
+
+    #[test]
+    fn preserves_accounts_windows_and_observation_time() {
+        let mut personal = entry();
+        personal["account"] = json!("personal");
+        let mut work = entry();
+        work["account"] = json!("work");
+        work["percentRemaining"] = json!(25);
+        let rows = parse(json!({"version":3,"exportedAt":1900000000,"providers":{
+            "alibaba-token-plan":{"status":"ok","fetchedAt":1748735958,"entries":[personal,work]},
+            "other":{"status":"ok","fetchedAt":1748735000,"entries":[entry()]}
+        }}))
+        .unwrap();
+        assert_eq!(rows.len(), 3);
+        assert_eq!(
+            rows.iter().map(|row| &row.id).collect::<HashSet<_>>().len(),
+            3
+        );
+        assert!(rows[0].id.starts_with(PREFIX));
+        assert!(rows[0].label.contains("personal"));
+        assert_eq!(rows[0].observed, 1748735958);
+        assert_eq!(rows[0].usage.observed_at, Some(1748735958));
+        assert_eq!(rows[0].usage.allowances[0].percent(), Some(62.3));
+        assert_eq!(
+            rows[0].usage.allowances[0].resets_at.as_deref(),
+            Some("1800000000")
+        );
+        assert_eq!(
+            rows[0].usage.allowances[0].provenance().as_deref(),
+            Some("Provider reported · allowance")
+        );
+    }
+
+    #[test]
+    fn partial_estimates_and_formatted_values_are_not_inferred_amounts() {
+        let rows = parse(json!({"version":3,"providers":{"custom":{
+            "status":"partial","fetchedAt":1748735958,"errors":[{"label":"Work","message":"Sign in again"}],
+            "entries":[
+                {"id":"balance","name":"Balance","renderType":"value","value":"$12.50 left","authority":"locally_derived","acquisitionMethod":"local_estimation","resultType":"balance"},
+                {"id":"enabled","name":"Enabled","renderType":"value","value":"Enabled","resultType":"status"}
+            ]
+        }}})).unwrap();
+        assert_eq!(rows[0].usage.status, "partial");
+        assert!(rows[0].usage.detail.contains("Work: Sign in again"));
+        let balance = &rows[0].usage.allowances[0];
+        assert_eq!(balance.description(), "$12.50 left");
+        assert_eq!(balance.remaining, None);
+        assert_eq!(balance.limit, None);
+        assert_eq!(balance.percent(), None);
+        assert_eq!(balance.provenance().as_deref(), Some("Estimate · balance"));
+        assert_eq!(rows[0].usage.allowances[1].description(), "Enabled");
+        assert_eq!(
+            rows[0].usage.allowances[1].provenance().as_deref(),
+            Some("Source not reported · status")
+        );
+    }
+
+    #[test]
+    fn over_quota_text_is_preserved_and_unknown_times_are_not_freshened() {
+        let mut value = entry();
+        value["percentRemaining"] = json!(-5);
+        let rows =
+            parse(json!({"version":3,"providers":{"test":{"status":"ok","entries":[value]}}}))
+                .unwrap();
+        assert_eq!(rows[0].observed, 0);
+        assert_eq!(rows[0].usage.allowances[0].percent(), Some(0.0));
+        assert_eq!(rows[0].usage.allowances[0].description(), "-5% remaining");
+    }
+
+    #[test]
+    fn errors_and_unavailable_do_not_borrow_values_from_entries() {
+        let rows = parse(json!({"version":3,"providers":{
+            "failed":{"status":"error","error":"Sign in again","entries":[entry()]},
+            "missing":{"status":"unavailable","entries":[entry()]}
+        }}))
+        .unwrap();
+        assert_eq!(rows[0].usage.status, "error");
+        assert_eq!(rows[0].usage.detail, "Sign in again");
+        assert_eq!(rows[1].usage.status, "unavailable");
+        assert!(rows.iter().all(|row| row.usage.allowances.is_empty()));
+        assert_eq!(failure().id, PREFIX);
+    }
+
+    #[test]
+    fn malformed_exports_duplicate_rows_and_invalid_timestamps_are_rejected() {
+        for value in [
+            json!({"version":4,"providers":{}}),
+            json!({"version":3,"providers":{"test":{"status":"ok","entries":[entry(),entry()]}}}),
+            json!({"version":3,"providers":{"test":{"status":"new-status"}}}),
+            json!({"version":3,"providers":{"test":{"status":"ok","fetchedAt":1e30,"entries":[entry()]}}}),
+            json!({"version":3,"providers":{"test":{"status":"ok","entries":[{"id":"a","name":"b","renderType":"percent","percentRemaining":"62"}]}}}),
+        ] {
+            assert!(parse(value).is_err());
+        }
+    }
+
+    #[test]
+    fn local_file_updates_missing_files_and_empty_snapshots() {
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("quota-export.json");
+        let missing = read_file(&file).unwrap();
+        assert_eq!(missing[0].usage.status, "unavailable");
+        assert!(missing[0].usage.detail.contains("@slkiser/opencode-quota"));
+        std::fs::write(
+            &file,
+            serde_json::to_vec(&json!({"version":3,"providers":{"test":{
+                "status":"ok","fetchedAt":1748735958,"entries":[entry()]
+            }}}))
+            .unwrap(),
+        )
+        .unwrap();
+        for _ in 0..2 {
+            assert_eq!(read_file(&file).unwrap()[0].observed, 1748735958);
+        }
+        std::fs::write(&file, b"{\"version\":3,\"providers\":{}}").unwrap();
+        assert!(read_file(&file).unwrap().is_empty());
+        std::fs::remove_file(&file).unwrap();
+        assert_eq!(read_file(&file).unwrap()[0].usage.status, "unavailable");
+    }
+
+    #[test]
+    fn bounded_reader_rejects_large_files_bad_json_and_directories() {
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("quota-export.json");
+        File::create(&file).unwrap().set_len(MAX_BYTES + 1).unwrap();
+        assert!(read_file(&file).is_err());
+        std::fs::write(&file, b"{broken-json").unwrap();
+        assert!(read_file(&file).is_err());
+        assert!(read_file(dir.path()).is_err());
+    }
+
+    #[test]
+    fn export_path_uses_zeds_environment_not_an_agent_or_project_path() {
+        let dir = tempfile::tempdir().unwrap();
+        let home = dir.path();
+        assert_eq!(
+            export_path(None, None, home).unwrap(),
+            home.join(".cache/opencode/quota-export.json")
+        );
+        assert_eq!(
+            export_path(None, Some(home.join("cache")), home).unwrap(),
+            home.join("cache/opencode/quota-export.json")
+        );
+        assert_eq!(
+            export_path(Some(home.join("custom.json")), None, home).unwrap(),
+            home.join("custom.json")
+        );
+        assert_eq!(
+            export_path(Some(PathBuf::from("~/custom.json")), None, home).unwrap(),
+            home.join("custom.json")
+        );
+        assert!(export_path(Some(PathBuf::from("relative.json")), None, home).is_err());
+    }
+}
