From db61d25379b4627f3c0f695412233012632b5729 Mon Sep 17 00:00:00 2001
From: Abel Bernabeu <abel.bernabeu.ctr@bolt.graphics>
Date: Tue, 22 Sep 2026 17:17:31 +0200
Subject: [PATCH] Allow building with LLVM 24

With the previous changes ISPC builds and passes its lit test suite with
LLVM main as of 2026-09-16 (commit 3723ac3407bc09d0b822df08f17228eed8fa76a3,
24.0.0git): 615 passed, 0 failed, 6 expected failures. The same suite on
LLVM 23 is unchanged by the series. Raise LATEST_SUPPORTED_LLVM to 24.
---
 src/ispc_version.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/ispc_version.h b/src/ispc_version.h
index eae563bd7b7..d6caa92a1ed 100644
--- a/src/ispc_version.h
+++ b/src/ispc_version.h
@@ -22,7 +22,7 @@
 #define ISPC_LLVM_24_0 240000
 
 #define OLDEST_SUPPORTED_LLVM ISPC_LLVM_20_0
-#define LATEST_SUPPORTED_LLVM ISPC_LLVM_23_0
+#define LATEST_SUPPORTED_LLVM ISPC_LLVM_24_0
 
 #ifdef __ispc__xstr
 #undef __ispc__xstr
@@ -34,7 +34,7 @@
     __ispc__xstr(LLVM_VERSION_MAJOR) "." __ispc__xstr(LLVM_VERSION_MINOR) "." __ispc__xstr(LLVM_VERSION_PATCH)
 
 #if ISPC_LLVM_VERSION < OLDEST_SUPPORTED_LLVM || ISPC_LLVM_VERSION > LATEST_SUPPORTED_LLVM
-#error "Only LLVM 20.1 - 22.1 and 23.0 development branch are supported"
+#error "Only LLVM 20.1 - 23.1 and 24.0 development branch are supported"
 #endif
 
 #define ISPC_VERSION_STRING                                                                                            \
