# Stage-1 cross GCC, used only to break the riscv64-linux-gnu-gcc <-> glibc cycle.

_target=riscv64-linux-gnu
pkgname=$_target-gcc
pkgver=16.2.1
_commit=d564253eb6c859e266d3cae18e82fb4db9a88316
pkgrel=0.1
pkgdesc='Cross compiler for 32-bit and 64-bit RISC-V (bootstrap seed)'
arch=('x86_64')
url='https://gcc.gnu.org/'
license=('GPL-3.0-or-later WITH GCC-exception-3.1' 'GFDL-1.3-or-later')
depends=(
  "$_target-binutils"
  "$_target-linux-api-headers"
  libgcc
  glibc
  gmp
  libisl libisl.so
  libmpc
  mpfr libmpfr.so
  zlib libz.so
  zstd libzstd.so
)
makedepends=('git')
options=(!emptydirs !strip staticlibs !lto !buildflags)
source=("git+https://forge.sourceware.org/gcc/gcc#commit=$_commit")
sha256sums=('c4def1816bc86f2bb981deb958a572ca63eb0ef784418f0414f1071a4efee44d')
b2sums=('9733f0e36b567880de8a9deebab27502ae3407480d49b0fd920049ca95205523644f5cbde67dac7d50537c29582ab808fa5c228090f87e6afe253ba1d70d13f4')

prepare() {
  cd gcc
  echo "$pkgver" > gcc/BASE-VER

  # Do not run fixincludes
  sed -i 's@\./fixinc\.sh@-c true@' gcc/Makefile.in

  rm -rf "$srcdir/gcc-build"
  mkdir "$srcdir/gcc-build"
}

build() {
  cd "$srcdir/gcc-build"

  "$srcdir/gcc/configure" \
      --prefix=/usr \
      --program-prefix="$_target-" \
      --libdir=/usr/lib \
      --libexecdir=/usr/lib \
      --target="$_target" \
      --host="$CHOST" \
      --build="$CHOST" \
      --with-local-prefix="/usr/$_target" \
      --with-sysroot="/usr/$_target" \
      --with-system-zlib \
      --with-isl \
      --with-linker-hash-style=gnu \
      --with-newlib \
      --without-headers \
      --disable-nls \
      --disable-bootstrap \
      --disable-multilib \
      --disable-shared \
      --enable-static \
      --disable-threads \
      --disable-libatomic \
      --disable-libgomp \
      --disable-libquadmath \
      --disable-libsanitizer \
      --disable-libssp \
      --disable-libvtv \
      --disable-werror \
      --enable-languages=c,c++ \
      --enable-checking=release \
      --enable-default-pie
  make -j"$(nproc)" all-gcc all-target-libgcc
}

package() {
  make -C "$srcdir/gcc-build" DESTDIR="$pkgdir" install-gcc install-target-libgcc
  ln -s "$_target-gcc" "$pkgdir/usr/bin/$_target-cc"

  # install-gcc writes host-side info/locale/man pages that the native gcc owns
  rm -r "$pkgdir/usr/share"
}