# Maya builds its GPU engines for the user's hardware during first-run setup.
pkgname=project-maya
pkgver=1.1.53
pkgrel=1
_commit=7c4aa56ed7faea2788705d8e85dd58e892d19f4b
pkgdesc='Local LLM inference with GPU-specific engine setup and a browser dashboard'
arch=('x86_64')
url='https://github.com/mw00/project-maya'
license=('MIT' 'Apache-2.0' 'ISC' 'OFL-1.1')
# Build tools are runtime dependencies: upstream compiles engines in user storage.
depends=('bash' 'coreutils' 'tar' 'gzip' 'util-linux' 'python>=3.10'
         'python-pip' 'git' 'cmake>=3.24' 'ninja' 'gcc')
optdepends=('cuda: NVIDIA engine compilation and CUDA libraries'
            'nvidia-utils: NVIDIA GPU driver userspace'
            'hip-runtime-amd: AMD GPU backend'
            'hipblas: AMD BLAS backend'
            'hipblaslt: AMD BLAS tuning'
            'rocm-llvm: AMD GPU compiler')
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/mw00/project-maya/tar.gz/$_commit"
        'project-maya'
        'README.md')
sha256sums=('aff9fb89437eb46efaeb4d34e2e4f9d10f6847ffaac5b65c40c52bc2c4d9e74a'
            '151c819ee45c48e8c3927acbdc1fce44cac149f0bde4166c724547d5edb1101b'
            'cf372a6809e801fbcdb538d861c0847ee97447cff98843ba5335874f38684af7')

package() {
  # Retain the complete upstream tree, including vendored wheels and notices.
  # The launcher unpacks it into writable user storage before running maya.sh.
  install -Dm644 "$srcdir/$pkgname-$_commit.tar.gz" \
    "$pkgdir/usr/share/$pkgname/source.tar.gz"
  printf '%s\n' "$_commit" > "$pkgdir/usr/share/$pkgname/commit"
  install -Dm755 "$srcdir/project-maya" "$pkgdir/usr/bin/project-maya"
  ln -s project-maya "$pkgdir/usr/bin/setup-maya"

  local tree="$srcdir/$pkgname-$_commit" notice
  for notice in LICENSE third_party/ggml/LICENSE third_party/exllamav3/LICENSE \
    third_party/beellama.cpp/LICENSE serve/web/LICENSE.lucide.txt serve/web/fonts/OFL.txt; do
    install -Dm644 "$tree/$notice" "$pkgdir/usr/share/licenses/$pkgname/$notice"
  done
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$tree/README.md" "$pkgdir/usr/share/doc/$pkgname/UPSTREAM.md"
}
