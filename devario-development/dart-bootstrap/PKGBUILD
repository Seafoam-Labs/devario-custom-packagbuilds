# Upstream's prebuilt release, used only to bootstrap the self-hosting dart build.
# Published under its own name with the SDK under /opt/$pkgname-sdk so it can sit in the
# same repository as the real dart: no shared ALPM name, no shared path, and no provides,
# so no downstream dependency can ever resolve to this seed instead of dart.
pkgname=dart-bootstrap
pkgver=3.13.7
pkgrel=1
pkgdesc='The dart programming language SDK (bootstrap seed)'
arch=('x86_64')
url='https://dart.dev/'
license=('BSD-3-Clause')
depends=('glibc')
# Preserve the prebuilt SDK exactly as distributed.
options=('!strip' '!debug' '!lto')
source=("https://storage.googleapis.com/dart-archive/channels/stable/release/$pkgver/sdk/dartsdk-linux-x64-release.zip")
sha256sums=('eb99aed266efbcb615c6ae21c12f52cfe935b9f208bccc5fea7f64c21e867229')

package() {
  install -d "$pkgdir/opt/$pkgname-sdk"
  cp -a dart-sdk/. "$pkgdir/opt/$pkgname-sdk/"

  # No /usr/bin links: the seed is reached only through the explicit PATH entry in
  # ../dart, so dart and dart-bootstrap can be installed side by side without either
  # package claiming a path the other owns.
  install -Dm644 dart-sdk/README -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 dart-sdk/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
