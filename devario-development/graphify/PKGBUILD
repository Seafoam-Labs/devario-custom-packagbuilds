pkgname=graphify
_pypiname=graphifyy
pkgver=0.9.101
pkgrel=1
pkgdesc='Turn code, documents, and media into a queryable knowledge graph'
arch=('any')
url='https://github.com/Graphify-Labs/graphify'
license=('Apache-2.0' 'MIT')
depends=(
  'python>=3.10'
  'python-networkx>=3.4'
  'python-numpy>=1.21'
  'python-rapidfuzz>=3.0'
  'python-yaml>=6.0'
  # Only used on Python 3.10; harmless on newer interpreters.
  'python-tomli>=2.0.1'
  # Preserve upstream ABI bounds: these are Python grammar bindings,
  # not the similarly named tree-sitter shared grammar packages.
  'python-tree-sitter>=0.25' 'python-tree-sitter<0.26'
  'python-tree-sitter-python>=0.23' 'python-tree-sitter-python<0.26'
  'python-tree-sitter-javascript>=0.23' 'python-tree-sitter-javascript<0.26'
  'python-tree-sitter-typescript>=0.23' 'python-tree-sitter-typescript<0.25'
  'python-tree-sitter-go>=0.23' 'python-tree-sitter-go<0.26'
  'python-tree-sitter-rust>=0.23' 'python-tree-sitter-rust<0.25'
  'python-tree-sitter-java>=0.23' 'python-tree-sitter-java<0.25'
  'python-tree-sitter-groovy>=0.1' 'python-tree-sitter-groovy<0.3'
  'python-tree-sitter-c>=0.23' 'python-tree-sitter-c<0.25'
  'python-tree-sitter-cpp>=0.23' 'python-tree-sitter-cpp<0.25'
  'python-tree-sitter-ruby>=0.23' 'python-tree-sitter-ruby<0.25'
  'python-tree-sitter-c-sharp>=0.23' 'python-tree-sitter-c-sharp<0.25'
