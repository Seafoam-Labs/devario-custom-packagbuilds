  'python-tree-sitter-powershell>=0.26' 'python-tree-sitter-powershell<0.28'
  'python-tree-sitter-elixir>=0.3' 'python-tree-sitter-elixir<0.5'
  'python-tree-sitter-objc>=3.0' 'python-tree-sitter-objc<4.0'
  'python-tree-sitter-julia>=0.23' 'python-tree-sitter-julia<0.25'
  'python-tree-sitter-verilog>=1.0' 'python-tree-sitter-verilog<2.0'
  'python-tree-sitter-fortran>=0.6' 'python-tree-sitter-fortran<0.8'
  'python-tree-sitter-bash>=0.23' 'python-tree-sitter-bash<0.27'
  'python-tree-sitter-json>=0.23' 'python-tree-sitter-json<0.26'
)
makedepends=('python-build' 'python-installer' 'python-setuptools>=83.0.0')
checkdepends=('python-pytest')
optdepends=(
  'git: repository integration'
  'python-pypdf>=6.19.0: PDF extraction (with python-markdownify)'
  'python-markdownify: PDF extraction (with python-pypdf)'
  'python-docx: Word document extraction'
  'python-openpyxl: Excel and Google Sheets support'
  'python-watchdog: rebuild graphs when files change'
  'python-matplotlib: SVG graph export'
  'python-pillow>=13.0.0: SVG graph export'
  'python-openai: OpenAI-compatible, Gemini, and Ollama backends'
  'python-tiktoken: token counting for OpenAI-compatible backends'
  'python-anthropic: Claude API backend'
  'python-boto3: AWS Bedrock backend'
)
source=("$url/releases/download/v$pkgver/$_pypiname-$pkgver.tar.gz")
sha256sums=('5c5a79501669729aa61b8afe942e0a5b5f988b949745048d6a73832a2263d6a7')

build() {
  cd "$_pypiname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pypiname-$pkgver"
  # Check CLI dispatch and that assistant resources survive wheel packaging.
  python -m pytest -q tests/test_cli_help.py tests/test_wheel_packaging.py
}

package() {
  cd "$_pypiname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE LICENSE-MIT NOTICE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
