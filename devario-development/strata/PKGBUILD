# The release/CLI version and Terminal bundle build number are different.
pkgname=strata-bin
pkgver=0.2.8
pkgrel=1
_bundlever=0.1.54
pkgdesc='Strata Terminal for local LLM inference, with an easy NVIDIA setup helper'
arch=('x86_64')
url='https://github.com/Niko1221/Strata'
license=('MIT' 'GPL-3.0-or-later')
depends=('bash' 'coreutils' 'curl' 'glibc' 'libgcc' 'libstdc++' 'libxcrypt-compat' 'python' 'zlib')
optdepends=('nvidia-utils>=580: NVIDIA GPU access for setup-strata'
            'pciutils: GPU detection for strata launch')
provides=("strata=$pkgver")
conflicts=('strata' 'strata-git')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/strata-control-$_bundlever-linux-x86_64.tar.gz"
        "strata-$pkgver-LICENSE::https://raw.githubusercontent.com/Niko1221/Strata/v$pkgver/LICENSE"
        'setup-strata'
        'README.md')
noextract=("strata-control-$_bundlever-linux-x86_64.tar.gz")
sha256sums=('572520fbb0df30cc164fc7ce195c84908b02aaa67b569d7b1982d94cd18a364b'
            '949b9b0aada7476006469e58ee4ffb0e0f68c2d9137e90a356757b61a09d37f0'
            '05b499d1471e3c365906b69f7aed0a475a12a443d80ee92bf679d16351eb2f12'
            'bb01b28acf8257fbb996c1e2a3c46952a65426da616130d775ab550ce66395f5')

package() {
  install -dm755 "$pkgdir/opt/strata" "$pkgdir/usr/bin"
  # Keep the relocatable interpreter, libraries, license notices and installer
  # resources together. Engines and model weights are acquired by the user.
  tar -xf "$srcdir/strata-control-$_bundlever-linux-x86_64.tar.gz" \
    -C "$pkgdir/opt/strata" --no-same-owner
  ln -s /opt/strata/bin/strata "$pkgdir/usr/bin/strata"
  install -Dm755 "$srcdir/setup-strata" "$pkgdir/usr/bin/setup-strata"
  ln -s setup-strata "$pkgdir/usr/bin/strata-setup"
  install -Dm644 "$srcdir/strata-$pkgver-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
