# Local adaptation of Arch's dotnet-core-10.0 (local revision 1.1).
# Retains the package-manager-independent bootstrap from our dotnet recipe.
# Bootstrap makedepends are unversioned so they resolve through the published
# 8.0 splits' provides until 10.0 is published; prepare() only seeds from an
# exact-version artifacts match, otherwise prep-source-build.sh downloads the
# bootstrap itself.
# Carries the 8.0 recipe's isolated-worker hardening: private en_US.UTF-8
# locale, build subreaper, and no long-lived build servers. The 8.0 shutdown
# timeout patches are unnecessary here: v10.0.114 dropped the build.sh
# shutdown call and conditions the per-repo shutdown off for source-only
# builds (dotnet/source-build#4796).
# Build against openssl, not Arch's openssl-3: Devario's openssl 3.6.5 still
# owns libssl.so=3-64, as in python. When openssl carries the 4.x SONAME,
# switch both openssl deps to openssl-3 and restore Arch's PKG_CONFIG_PATH
# export in build().

pkgbase=dotnet-core-10.0
pkgname=(
  dotnet-runtime-10.0
  aspnet-runtime-10.0
  dotnet-sdk-10.0
  dotnet-targeting-pack-10.0
  aspnet-targeting-pack-10.0
  dotnet-source-built-artifacts-10.0
)
pkgver=10.0.14.sdk114
pkgrel=1.1
arch=(x86_64)
url=https://dotnet.microsoft.com
license=(MIT)
makedepends=(
  bash
  clang20
  cmake
  dotnet-sdk
  dotnet-source-built-artifacts
  git
  icu
  krb5
  libgit2
  libunwind
  libxml2
  lldb
  llvm20
  lttng-ust2.12
  nodejs
  openssl
  python
  systemd
  zlib
)
optdepends=('bash-completion: Bash completion support')
options=(
  !lto
  staticlibs
)
source=(git+https://github.com/dotnet/dotnet.git#tag=v${pkgver/.*.sdk/.0.})
b2sums=('19124368332117509759f20b2034f5dbee9e0c6c8da454f8a46c681307fefd53d084871577b118157b115dd3868aceaf49b68c9d081b8fdd342477684dc4c510')

# Arcade's nested builds require en_US.UTF-8. Keep the compiled locale inside
# the build tree; this does not require root, locale-gen, or host configuration.
_fix_locale() {
  # Start from the portable locale while generating the UTF-8 data.
  export LC_ALL=C
  export LANG=C
  unset LANGUAGE

  local _locale_root="$srcdir/.build-locales"
  if [[ ! -r "$_locale_root/en_US.UTF-8/LC_CTYPE" ]]; then
    if [[ ! -r /usr/share/i18n/locales/en_US ||
          ! -r /usr/share/i18n/charmaps/UTF-8.gz ]]; then
      printf '%s\n' '==> ERROR: glibc locale sources are missing; cannot generate en_US.UTF-8.' >&2
      return 1
    fi
    mkdir -p "$_locale_root" || return
    localedef --no-archive -i en_US -f UTF-8 \
      "$_locale_root/en_US.UTF-8" || return
  fi

  export LOCPATH="$_locale_root"
  # Bash may cache its original locale search path. Keep this shell on the
  # built-in UTF-8 locale; new build processes inherit the private locale path.
  export LC_ALL=C.UTF-8
  export LANG=C.UTF-8

  # Shell locale warnings are parsed as errors by the inner /warnaserror build.
  # Capture stderr as well: exit status alone cannot detect those warnings.
  local _shell _probe
  for _shell in bash sh; do
    if ! _probe=$(env LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 "$_shell" -c 'locale charmap' 2>&1); then
      printf '==> ERROR: %s locale probe failed: %s\n' "$_shell" "$_probe" >&2
      return 1
    fi
    if [[ $_probe != UTF-8 ]]; then
      printf '==> ERROR: %s locale probe was not clean UTF-8: %s\n' "$_shell" "$_probe" >&2
      return 1
    fi
  done
  printf '==> .NET locale verified (recipe 1.1): child en_US.UTF-8; LC_ALL=%s LOCPATH=%s\n' \
    "$LC_ALL" "$LOCPATH"
}

# The isolated worker can leave orphaned build processes unreaped. Adopt and
# reap those descendants while the command runs; preserve its status/signals.
_write_build_subreaper() {
  cat > "$srcdir/seafoam-build-subreaper.py" <<'PY'
import ctypes
import errno
import os
import signal
import sys
import time

if len(sys.argv) < 2:
    raise SystemExit('usage: seafoam-build-subreaper.py COMMAND [ARG ...]')

libc = ctypes.CDLL(None, use_errno=True)
libc.prctl.argtypes = [ctypes.c_int] + [ctypes.c_ulong] * 4
libc.prctl.restype = ctypes.c_int
if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
    raise OSError(ctypes.get_errno(), 'could not enable the build child subreaper')

main_pid = None
pending_signal = None

def forward(signum, frame):
    global pending_signal
    pending_signal = signum
    if main_pid is not None:
        try:
            os.killpg(main_pid, signum)
        except ProcessLookupError:
            pass

forwarded = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
for signum in forwarded:
    signal.signal(signum, forward)

pid = os.fork()
if pid == 0:
    for signum in forwarded:
        signal.signal(signum, signal.SIG_DFL)
    try:
        os.setpgid(0, 0)
        os.execvp(sys.argv[1], sys.argv[1:])
    except OSError as exc:
        print(f'build command could not start: {exc}', file=sys.stderr, flush=True)
        os._exit(127 if exc.errno == errno.ENOENT else 126)

main_pid = pid
try:
    os.setpgid(pid, pid)
except OSError as exc:
    if exc.errno not in (errno.EACCES, errno.ESRCH):
        raise
if pending_signal is not None:
    forward(pending_signal, None)

orphans_reaped = 0
while True:
    try:
        reaped, status = os.waitpid(-1, 0)
    except InterruptedError:
        continue
    if reaped == pid:
        command_status = status
        break
    orphans_reaped += 1

# Drain available zombies without blocking on any surviving background process.
deadline = time.monotonic() + 0.25
while time.monotonic() < deadline:
    try:
        reaped, _ = os.waitpid(-1, os.WNOHANG)
    except ChildProcessError:
        break
    if reaped == 0:
        break
    orphans_reaped += 1

print(f'build subreaper: reaped {orphans_reaped} orphan process(es)', flush=True)
code = os.waitstatus_to_exitcode(command_status)
raise SystemExit(code if code >= 0 else 128 - code)
PY
}

prepare() {
  cd dotnet

  _fix_locale || return
  _write_build_subreaper || return

  # fix bootstrap
  git remote set-url origin https://github.com/dotnet/dotnet.git

  # shelly's isolated root ships no pacman, so match the bootstrap version against the
  # archive dotnet-source-built-artifacts installs instead of querying the package db
  local _bootstrapver=$(xmllint --xpath "//*[local-name()='PrivateSourceBuiltArtifactsVersion']/text()" eng/Versions.props)
  shopt -s nullglob
  local _bootstrap=(/usr/share/dotnet/source-built-artifacts/Private.SourceBuilt.Artifacts."$_bootstrapver"*.tar.gz)
  shopt -u nullglob

  if (( ${#_bootstrap[@]} )); then
    cp -r /usr/share/dotnet .dotnet
    ln -sf "${_bootstrap[0]}" prereqs/packages/archive/
  fi
  python "$srcdir/seafoam-build-subreaper.py" ./prep-source-build.sh
}

build() {
  cd dotnet

  _fix_locale || return

  export COMPlus_LTTng=0
  export VERBOSE=1
  export OPENSSL_ENABLE_SHA1_SIGNATURES=1

  # Local: avoid long-lived build servers (the Roslyn compiler server becomes an
  # unreaped zombie in the isolated worker; see the 8.0 recipe). Some nested
  # builds override these; the subreaper also covers those commands.
  export UseSharedCompilation=false
  export MSBUILDDISABLENODEREUSE=1
  export DOTNET_CLI_USE_MSBUILD_SERVER=0
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
  export DOTNET_GENERATE_ASPNET_CERTIFICATE=false

  export PATH="/usr/lib/llvm20/bin:$PATH"

  # this uses malloc_usable_size, which is incompatible with fortification level 3
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  CFLAGS=$(echo $CFLAGS  | sed -e 's/-fstack-clash-protection//' )
  CXXFLAGS=$(echo $CXXFLAGS  | sed -e 's/-fstack-clash-protection//' )
  export EXTRA_CFLAGS="$CFLAGS"
  export EXTRA_CXXFLAGS="$CXXFLAGS"
  export EXTRA_LDFLAGS="$LDFLAGS"
  unset CFLAGS
  unset CXXFLAGS
  unset LDFLAGS

  # rtm branding strips out the "prerelease" tag from the version (see https://github.com/dotnet/dotnet/blob/b0f34d51fccc69fd334253924abd8d6853fad7aa/build.sh#L18)
  python "$srcdir/seafoam-build-subreaper.py" ./build.sh --clean-while-building --online --source-build
}

package_dotnet-runtime-10.0() {
  pkgdesc='The .NET Core runtime'
  depends=(
    dotnet-host
    glibc
    libgcc
    libstdc++
    icu
    krb5
    libunwind
    zlib
    openssl
  )
  optdepends=('lttng-ust2.12: CoreCLR tracing')
  provides=(dotnet-runtime=${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner shared/Microsoft.NETCore.App
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-runtime-10.0
}

package_aspnet-runtime-10.0() {
  pkgdesc='The ASP.NET Core runtime'
  depends=(dotnet-runtime-10.0)
  provides=(aspnet-runtime=${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner shared/Microsoft.AspNetCore.App
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/aspnet-runtime-10.0
}

package_dotnet-sdk-10.0() {
  pkgdesc='The .NET Core SDK'
  depends=(
    dotnet-runtime-10.0
    dotnet-targeting-pack-10.0
    glibc
    libgcc
    libstdc++
  )
  optdepends=('aspnet-targeting-pack: Build ASP.NET Core applications')
  provides=(dotnet-sdk=${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner sdk sdk-manifests templates
  install -dm 755 "${pkgdir}"/usr/share/dotnet/metadata/workloads/${pkgver%.*.sdk*}.${pkgver#*.sdk}
  touch "${pkgdir}"/usr/share/dotnet/metadata/workloads/${pkgver%.*.sdk*}.${pkgver#*.sdk}/userlocal
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-sdk-10.0
}

