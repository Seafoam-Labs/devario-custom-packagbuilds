# Contributor: Jonas Witschel <diabonas@archlinux.org>
# Contributor: Eli Schwartz <eschwartz@archlinux.org>
# Contributor: Daniel Müllner <muellner@math.stanford.edu>

pkgname=autoconf-archive
pkgver=2024.10.16
pkgrel=4
epoch=1
pkgdesc="A collection of freely re-usable Autoconf macros"
arch=('any')
url="https://www.gnu.org/software/autoconf-archive/"
license=('GPL-3.0-or-later WITH Autoconf-exception-3.0')
depends=('autoconf')
optdepends=('automake: macros for use with it')
# Two deviations from upstream, both to avoid GNU hosts the builder cannot
# reach reliably:
#  - ftpmirror.gnu.org is a redirector that hands out a different mirror per
#    request and failed TLS on the builder; ftp.gnu.org is the canonical
#    non-redirecting host and serves byte-identical files, so its sums are
#    unchanged.
#  - the patch is vendored rather than fetched from cgit.git.savannah.gnu.org,
#    which also failed TLS and intermittently returns 502. The file is that
#    URL's output for commit 241f7ae5f857b0c9bab7866b79b4e47587126b96 and
#    applies cleanly to the pinned tarball, touching only
#    m4/ax_cxx_compile_stdcxx.m4. Its sha256 differs from the upstream pin
#    because cgit's rendering (author encoding, index abbreviation, version
#    trailer) has changed since that pin was recorded; the diff body is the
#    same, as is the GitHub mirror's for the same commit.
source=("https://ftp.gnu.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.xz"{,.sig}
        "0001_fix_AX_CXX_COMPILE_STDCXX.patch")
sha256sums=('7bcd5d001916f3a50ed7436f4f700e3d2b1bade3ed803219c592d62502a57363'
            'SKIP'
            '63d86e19e074c57ebaecaf9d8ad97ec792fdf19224f96835e7dc80153b74b528')
validpgpkeys=('1A4F63A13A4649B632F65EE141BC28FE99089D72') # Peter Simons <simons@cryp.to>

prepare() {
  cd ${pkgname}-${pkgver}
  # Generated detection logic is broken for AX_CXX_COMPILE_STDCXX for serial 21-23
  patch -Np1 -i ../0001_fix_AX_CXX_COMPILE_STDCXX.patch
}

build() {
  cd ${pkgname}-${pkgver}
  ./configure --prefix=/usr
  make
}

check() {
  cd ${pkgname}-${pkgver}
  make check
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
  install -vDm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" COPYING.EXCEPTION
}
