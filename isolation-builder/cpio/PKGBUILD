# Maintainer: Tobias Powalowski <tpowa@archlinux.org>
# Contributor: judd <jvinet@zeroflux.org>
pkgname=cpio
pkgver=2.15
pkgrel=4
pkgdesc="A tool to copy files into or out of a cpio or tar archive"
arch=(x86_64)
license=('GPL-3.0-or-later')
url="https://www.gnu.org/software/cpio"
depends=('glibc')
options=('!emptydirs')
# Savannah 500s while packing cpio.git (job 5330), and d788ea96's gnulib mirror cannot
# cover it: no mirror carries the signed v2.15 tag. Build the release tarball instead,
# which is pre-bootstrapped (generated configure, gnu/, 28 po/*.gmo, doc/cpio.info), so
# gnulib and paxutils are pinned to the release rather than to a floating submodule
# gitlink, and git, rsync and wget leave makedepends with ./bootstrap gone.
source=("https://ftp.gnu.org/gnu/cpio/cpio-${pkgver}.tar.gz"{,.sig}
        0001-Fix-c23-conformity.patch)
validpgpkeys=('325F650C4C2B6AD58807327A3602B07F55D0C732') # Sergey Poznyakoff <gray@gnu.org>
b2sums=('e678111682335f4218d6d0e27d7e3a81b1e9c87ad5963402f73e735265480f296a8ce4fd00a4e7f591bbc7affcb3d433675c1df2d59c23e5d4ed6ba03e2964b8'
        'SKIP'
        'cc886d7429e30f959cd63794b9ab1bb13dc9ceeed8a321c83a7cbc6cfe41674322a7c9414976de1002f0938d62d0590757174f63ef1bfe4e4cdbef0d0ca77f71')

prepare() {
  cd "${pkgname}-${pkgver}"

  # Upstream's c23 fix postdates the 2.15 release, so the tarball still declares xstat
  # and copy_function with empty parameter lists, which C23 reads as "no parameters".
  # https://cgit.git.savannah.gnu.org/cgit/cpio.git/commit/?id=f42137f5ab9cf07d1e62edc05e0212688d3ebaa2
  patch -Np1 -i "${srcdir}/0001-Fix-c23-conformity.patch"
}

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --mandir=/usr/share/man --with-rmt=/dev/null
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
