# Adapted for Devario from the AUR stremio-linux-shell recipe; see
# DEVARIO-UPSTREAM.json. Local changes: build from the release tarball without
# the AUR's epoch, install the schema, translations, man page and D-Bus service
# system-wide, and keep only the runtime dependencies the current release uses.
# Maintainer: yobson <aur@yobson.xyz>
# Contributor: Thomas LECLERCQ <thomasle@mailbox.org> (AUR -git recipe)
# Contributor: nopw <aur@n0.pw> (AUR -git recipe)
#
# The Rust shell is GPL-3.0-only. data/server.js is proprietary, closed-source
# software bundled by upstream; its redistribution terms are unresolved (see
# https://github.com/Stremio/stremio-linux-shell/issues/100). LicenseRef-Stremio
# records that distinction and is installed with the package.

pkgname=stremio-linux-shell
pkgver=1.3.0
pkgrel=1
pkgdesc='A native Linux client for Stremio'
arch=('x86_64')
url='https://github.com/Stremio/stremio-linux-shell'
license=('GPL-3.0-only' 'LicenseRef-Stremio')
depends=(
  'ffmpeg'
  'glib2'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libepoxy'
  'mpv'
  'nodejs'
  'webkitgtk-6.0'
)
makedepends=(
  'cargo'
  'gettext'
  'git'
  'pkgconf'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
optdepends=(
  'xdg-desktop-portal-impl: background mode, file dialogs and opening links'
)
provides=("stremio=$pkgver")
conflicts=('stremio')
options=('!lto')

_tag="v${pkgver//_/-}"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz"
        'stremio.sh'
        'LicenseRef-Stremio')
sha256sums=('73a9b5b55127da7bc596d4882facde9ff9c3345a25ff67eb31370ab036af85c5'
            '00157a3616030afb0437a25cbb2a389dd5e3690c0ad5216218dfd0d9f02fe11e'
            '5d7aa5ffa4c0a631b100a82e4da72cecb2f8ac808032f277d53ed2d92166208f')

# Keep Cargo state inside this recipe, independent of worker-global overrides.
_cargo_env() {
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  export CARGO_INCREMENTAL=0
}

prepare() {
  cd "$srcdir/$pkgname-${_tag#v}"
  _cargo_env
  cargo fetch --locked --target "$(rustc --print host-tuple)"

  # Upstream's unit file points at the Flatpak prefix; the packaged launcher
  # lives in /usr/bin instead.
  sed -i 's|^Exec=/app/bin/stremio |Exec=/usr/bin/stremio |' \
    data/com.stremio.Stremio.service
  grep -Fq 'Exec=/usr/bin/stremio --gapplication-service' \
    data/com.stremio.Stremio.service || {
    echo 'Failed to point the D-Bus service at /usr/bin/stremio' >&2
    return 1
  }
}

build() {
  cd "$srcdir/$pkgname-${_tag#v}"
  _cargo_env
  # build.rs writes the compiled schema and .mo files here. Keep them out of
  # the source tree; package() installs the generated translations.
  export GETTEXT_DIR="$srcdir/locale"
  export GSETTINGS_SCHEMA_DIR="$srcdir/schemas"
  # src/main.rs uses this option_env! value as the gettext directory.
  export STREMIO_LOCALEDIR=/usr/share/locale

  cargo build --release --frozen
}

check() {
  cd "$srcdir/$pkgname-${_tag#v}"
  desktop-file-validate data/com.stremio.Stremio.desktop
  appstreamcli validate --no-net data/com.stremio.Stremio.metainfo.xml
}

package() {
  cd "$srcdir/$pkgname-${_tag#v}"

  # The launcher needs the server path at run time; the binary is private to
  # the package and is not exposed as a second command in PATH.
  install -Dm755 "$srcdir/target/release/stremio-linux-shell" \
    "$pkgdir/usr/lib/stremio/stremio"
  install -Dm644 data/server.js "$pkgdir/usr/lib/stremio/server.js"
  install -Dm755 "$srcdir/stremio.sh" "$pkgdir/usr/bin/stremio"

  install -Dm644 data/com.stremio.Stremio.desktop \
    "$pkgdir/usr/share/applications/com.stremio.Stremio.desktop"
  install -Dm644 data/com.stremio.Stremio.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.stremio.Stremio.metainfo.xml"
  install -Dm644 data/com.stremio.Stremio.gschema.xml \
    "$pkgdir/usr/share/glib-2.0/schemas/com.stremio.Stremio.gschema.xml"
  install -Dm644 data/com.stremio.Stremio.service \
    "$pkgdir/usr/share/dbus-1/services/com.stremio.Stremio.service"
  install -Dm644 data/icons/com.stremio.Stremio.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.stremio.Stremio.svg"
  install -Dm644 data/stremio.1 "$pkgdir/usr/share/man/man1/stremio.1"

  # build.rs starts msgfmt without waiting, so install each catalog the po/
  # files promise: install fails loudly if a .mo is missing (or po/ is empty
  # and the glob stays literal) instead of shipping absent translations.
  local _po _lang
  for _po in po/*.po; do
    _lang=${_po##*/}
    _lang=${_lang%.po}
    install -Dm644 "$srcdir/locale/$_lang/LC_MESSAGES/stremio.mo" \
      "$pkgdir/usr/share/locale/$_lang/LC_MESSAGES/stremio.mo"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/LicenseRef-Stremio" \
    "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Stremio"
}

