# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=icoextract
pkgver=0.3.1
pkgrel=1
pkgdesc='Extract icons from Windows PE files (.exe/.dll)'
arch=(any)
url=https://projects.jlu5.com/icoextract.html
license=(MIT)
depends=(
  python
  python-pefile
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  imagemagick
  mingw-w64-gcc
  python-pillow
  python-pytest
)
optdepends=('python-pillow: required for the optional thumbnailer')
source=("git+https://github.com/jlu5/icoextract.git#tag=$pkgver?signed")
b2sums=('a1e92721088a73df4afef4e4fd847054302704a6cca9a580977ddb482c597e2de90567072b01c91da7755c3be712f4962e10db9b5747178f5ce4a004c49486ff')
validpgpkeys=('D5D568B2D34AB32A337944D22EC3F60DE71C0B9D') # James Lu <james@overdrivenetworks.com>

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

check() {
  cd $pkgname
  make -C tests
  pytest
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm644 -t "$pkgdir/usr/share/thumbnailers" exe-thumbnailer.thumbnailer
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
