pkgname=tuxedo-control-center
pkgver=3.0.10
pkgrel=4
pkgdesc='Performance, power, fan and comfort controls for TUXEDO laptops'
arch=('x86_64')
url='https://github.com/tuxedocomputers/tuxedo-control-center'
license=('GPL-3.0-or-later')
_electron=electron42
depends=('dbus' "$_electron" 'glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'polkit' 'python')
makedepends=('git' 'nodejs' 'npm' 'openssh')
optdepends=('tuxedo-drivers-dkms: fan control and other TUXEDO hardware features'
            'upower: keyboard backlight on supported models')
options=('!strip' '!debug') # Stripping would remove tccd's appended Node.js payload.
install=$pkgname.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "$pkgname.install"
        "$pkgname.sh"
        "$pkgname-paths.patch"
        'electron-builder.yml')
sha256sums=('d192391c559789c8f62af0e614e37e1222c9aa9753c61a30e3149b35d1969532'
