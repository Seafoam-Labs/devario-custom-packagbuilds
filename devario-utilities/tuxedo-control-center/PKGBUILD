            '5e565845836649227c9a28188c59caf745754e7375f77f81ca6ee87d62d92009eb1b3f9e894119cb2a5e7853f7cda6cecce633c38eef5c49a33ee232b6542603')

prepare() {
  sed "s/@ELECTRON@/$_electron/g" "$srcdir/$pkgname.sh" > "$srcdir/$pkgname"
  cd "$srcdir/$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/$pkgname-paths.patch"
  cp "$srcdir/electron-builder.yml" .
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  local electron_dist="/usr/lib/$_electron" electron_version
  electron_version=$(<"$electron_dist/version")
  export HOME="$srcdir" XDG_CACHE_HOME="$srcdir/.cache"
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm_config_allow_git=root

  # Skip upstream's install-time rebuild; the packager rebuilds against system Electron.
  npm ci --ignore-scripts --no-audit --no-fund --cache "$srcdir/npm-cache"
  ./node_modules/.bin/patch-package --error-on-fail
  npm run build-prod
  ./node_modules/.bin/electron-builder --linux dir \
    -c.electronDist="$electron_dist" -c.electronVersion="${electron_version#v}"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local appdir="$pkgdir/usr/lib/$pkgname"
  local data=src/dist-data dist="dist/$pkgname" resources=dist/packages/linux-unpacked/resources

  install -Dm644 -t "$appdir" "$resources/app.asar"
  cp -a "$resources/app.asar.unpacked" "$appdir/"
  install -Dm755 -t "$appdir/data/service" "$dist/data/service/tccd"
  install -Dm644 -t "$appdir/data/camera" "$dist/data/camera/"{cameractrls.py,v4l2_kernel_names.json}

  install -Dm755 "$srcdir/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 -t "$pkgdir/usr/share/applications" "$data/$pkgname"{,-tray}.desktop
  install -Dm644 "$data/${pkgname}_256.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 "$data/${pkgname}_256.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 -t "$pkgdir/usr/share/metainfo" "$data/com.tuxedocomputers.tcc.metainfo.xml"
  install -Dm644 -t "$pkgdir/usr/share/polkit-1/actions" "$data/com.tuxedocomputers."{tccd,tomte}.policy
  install -Dm644 -t "$pkgdir/usr/share/dbus-1/system.d" "$data/com.tuxedocomputers.tccd.conf"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" "$data/tccd"{,-sleep}.service
  install -Dm644 -t "$pkgdir/usr/lib/udev/rules.d" src/udev/99-webcam.rules
}
