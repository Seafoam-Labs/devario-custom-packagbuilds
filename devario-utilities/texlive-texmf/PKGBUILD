pkgbase=texlive-texmf
pkgname=(texlive-doc texlive-meta)
# generate collections with ./list-collections
_collections=( basic bibtexextra binextra context fontsextra fontsrecommended fontutils formatsextra games humanities langarabic langchinese langcjk langcyrillic langczechslovak langenglish langeuropean langfrench langgerman langgreek langitalian langjapanese langkorean langother langpolish langportuguese langspanish latex latexextra latexrecommended luatex mathscience metapost music pictures plaingeneric pstricks publishers xetex )
for _coll in ${_collections[@]}; do
  pkgname+=(texlive-$_coll)
done
# Shelly has no svn source protocol, so upstream's three svn:// checkouts of
# tags/texlive-$pkgver/Master become the $_reldate release tarballs; that tag
# adds only Build/source/texk/dvipdfm-x commits, so Master/ is unchanged.
_reldate=20260301
pkgver=2026.1
pkgrel=3
pkgdesc='TeX Live - '
license=(GPL)
arch=(any)
depends=(texlive-bin)
url='https://tug.org/texlive/'
_historic=https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/${pkgver%%.*}
source=($_historic/texlive-$_reldate-texmf.tar.xz
        $_historic/texlive-$_reldate-extra.tar.xz
        $_historic/texlive-$_reldate-bin.tar.xz
        $_historic/install-tl-unx.tar.gz
        09-texlive-fonts.conf
        texmf.cnf.patch
        70-mktexlsr.hook
        71-texlive-language.hook
        texlive-language.script
        72-texlive-fmtutil.hook
        texlive-fmtutil.script
        73-texlive-updmap.hook
        texlive-updmap.script
        80-mtxrun.hook
        mtxrun.script
        https://files.pythonhosted.org/packages/30/b7/4fa3729952938e6e69e2a3a51c5a74480ce7a031d344830806dde5fb2210/latexminted-0.7.1-py3-none-any.whl
        minted-3.8.patch)
# The three tarball sums are upstream's published .sha512 files; install-tl-unx
# has none published, so that one is computed from the downloaded archive.
