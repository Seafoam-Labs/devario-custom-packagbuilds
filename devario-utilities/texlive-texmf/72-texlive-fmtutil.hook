[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = texlive-bin

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = var/lib/texmf/devario/installedpkgs/*

[Action]
Description = Updating TeXLive format files...
When = PostTransaction
Exec = /usr/share/rlpm/scripts/texlive-fmtutil

