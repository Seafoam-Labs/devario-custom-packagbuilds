pkgname=bpftrace
pkgver=0.27.0
pkgrel=2
pkgdesc='High-level tracing language for Linux eBPF'
arch=('x86_64')
url='https://github.com/iovisor/bpftrace'
license=('Apache-2.0')
depends=(
  'bcc'
  'clang'
  'glibc'
  'libelf'
  'libgcc'
  'libpcap'
  'libstdc++'
  'llvm-libs'
  'systemd-libs'
  'zip'
  'zlib'
  'zstd'
)
# linux-headers has no recipe here; the published Devario kernel headers satisfy the same need.
# llvm-gtest ships libLLVMTesting{Annotations,Support}.a required by LLVMExports.cmake
makedepends=(
  'asciidoctor'
  'binutils'
  'bpf'
  'cereal'
  'cmake'
  'git'
  'gtest'
  'linux-devario-headers'
  'llvm'
  'llvm-gtest'
  'xxd'
)
options=(
  '!debug'
  '!strip'
)
source=(
  "git+$url.git#tag=v$pkgver"
  "$pkgname-libbpf::git+https://github.com/libbpf/libbpf.git"
  '0001-clang-major-minor-version.patch'
)
b2sums=('02d5d8dc97900cf7630c37139f34fcd82ce223f996e4c170c6a19023b2e5e98702fdf5752a9418bbdc69e1df371199a25cb04e3ea16249486bd87fd6b6d30120'
            'SKIP'
            '8eb5bc44d9a0c96210da2d546c987014e5cb1d37340cb64d7e6e630a7ce2244f9541603fc6ec4765a76445f2e324834b29ffd31d6808ebbf4ac566cc2d1f59e8')

prepare() {
  cd $pkgname
  # Devario's clang patch release can lag behind llvm's (e.g. 23.1.5 vs 23.1.6);
  # find Clang by major.minor so the exact-version check does not reject it.
  patch -Np1 -i ../0001-clang-major-minor-version.patch
  git submodule init
  git config submodule.libbpf.url ../$pkgname-libbpf
  git -c protocol.file.allow=always submodule update libbpf
}

build() {
  cmake -S $pkgname -B build \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -W no-dev \
    -D ENABLE_SYSTEMD=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  depends+=(
    'binutils' 'libsframe.so'
  )

  DESTDIR="$pkgdir" cmake --install build
}
