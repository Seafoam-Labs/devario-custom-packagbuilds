# Maintainer: Andreas Radke <andyrtr@archlinux.org>

pkgname=xorg-mkfontscale
pkgver=1.2.4
pkgrel=2
pkgdesc="Create an index of scalable font files for X"
arch=(x86_64)
url="https://gitlab.freedesktop.org/xorg/app/mkfontscale"
license=('MIT-open-group'
         'X11'
         'MIT'
         'HPND-sell-variant')
depends=('freetype2' 'libfontenc' 'zlib' 'glibc' 'sh')
makedepends=('xorg-util-macros' 'xorgproto')
groups=('xorg-apps' 'xorg')
provides=('xorg-mkfontdir')
conflicts=('xorg-mkfontdir')
replaces=('xorg-mkfontdir')
source=(https://xorg.freedesktop.org/archive/individual/app/mkfontscale-${pkgver}.tar.xz{,.sig}
        xorg-mkfontscale.hook
        xorg-mkfontscale.script)
sha512sums=('8f9396a3242a7940c626caaf7b4aa84a819e005d11d612ca979179e2f5ff19f745c053a1510fc2205b60df6c5fb371153f1e353ea75df29da66279e134874174'
            'SKIP'
            '4cc118afd40f4e2421ea9e50e3515d240f6bf87ac0a6f47f1a96b964a0602cbf0bb35515d5cc1aef641436367804a696a749a9cf2497e202d26674ee62edc648'
            '2a53d38c85b962eaee534f6f3fad4122412a7200c6787fd8216eb191904e2e3727400606a73d6f09017016f6c1360e5148afbb8fbe16e35c5e5cd55dec635387')
validpgpkeys=('3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2') # Alan Coopersmith <alan.coopersmith@oracle.com>

build() {
  cd "mkfontscale-${pkgver}"
  ./configure --prefix=/usr
  make
}

package() {
  cd "mkfontscale-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -m755 -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/"

  # Devario uses rlpm, so install the hook and helper under its directories.
  install -Dm644 ../xorg-mkfontscale.hook "${pkgdir}/usr/share/rlpm/hooks/xorg-mkfontscale.hook"
  install -D ../xorg-mkfontscale.script "${pkgdir}/usr/share/rlpm/scripts/xorg-mkfontscale"
}
