+def devario_catalog_status(catalog):
+    """Adapt catalog-advertised repository coverage, not measured mirror health.
+
+    A shared $repo mirrorlist is valid only for roots advertising every Devario
+    repository in the catalog. last_sync is the oldest catalog indexing time;
+    geographical location and transport/IP health are not supplied by this API.
+    """
+    if not isinstance(catalog, list):
+        raise MirrorStatusError('expected a Devario repository catalog array')
+    repositories = set()
+    roots = {}
+    for entry in catalog:
+        name = entry.get('syncPrefix', '')
+        if not re.fullmatch(r'devario-[a-z0-9-]+', name):
+            continue
+        repositories.add(name)
+        server = entry.get('serverUrl', '')
+        suffix = '/' + name + '/$arch'
+        parsed = urllib.parse.urlparse(server)
+        if (parsed.scheme != 'https' or not parsed.netloc or parsed.query
+                or parsed.fragment or parsed.username or parsed.password
+                or any(char.isspace() for char in server)
+                or not server.endswith(suffix)):
+            raise MirrorStatusError('unsupported Devario server URL: ' + server)
+        if 'x86_64' not in entry.get('architectures', []):
+            raise MirrorStatusError('repository does not advertise x86_64: ' + name)
+        try:
+            indexed = datetime.datetime.fromisoformat(entry['lastIndexed'].replace('Z', '+00:00'))
+            if indexed.tzinfo is None:
+                raise ValueError('missing timezone')
+            indexed = indexed.astimezone(datetime.timezone.utc).strftime(PARSE_TIME_FORMAT)
+        except (KeyError, ValueError, TypeError) as err:
+            raise MirrorStatusError('invalid catalog indexing timestamp') from err
+        root = server[:-len(suffix)] + '/'
+        roots.setdefault(root, {})[name] = indexed
+    mirrors = []
+    for root, entries in sorted(roots.items()):
+        if set(entries) != repositories:
+            continue
+        mirrors.append(dict(url=root, protocol='https', last_sync=min(entries.values()),
+                            completion_pct=1.0, country='', country_code='',
+                            isos=False, ipv4=False, ipv6=False))
+    if not repositories or not mirrors:
+        raise MirrorStatusError('no common HTTPS server covers all Devario repositories')
+    return dict(urls=mirrors, last_check=max(m['last_sync'] for m in mirrors))
 
 
