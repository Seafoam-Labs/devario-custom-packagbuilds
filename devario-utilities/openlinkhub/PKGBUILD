# Maintainer: Anton Ždanov <anton@azdanov.dev>

pkgname=openlinkhub
pkgver=0.9.4
pkgrel=1
pkgdesc="Open source Linux interface for iCUE LINK hubs and other Corsair AIOs and hubs"
arch=('x86_64')
url="https://github.com/jurkovic-nikola/OpenLinkHub"
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'glibc'
  'pipewire'
  'systemd-libs'
)
makedepends=(
  'go'
  'pipewire'
  'pkgconf'
  'systemd'
)
optdepends=(
  'alsa-utils: microphone mute control via amixer'
  'amd-smi: AMD GPU metrics'
  'libpulse: microphone mute control via pactl'
  'nvidia-utils: NVIDIA GPU metrics'
  'pciutils: system and GPU detection via lspci'
)
install="$pkgname.install"
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
  '98-openlinkhub-memory.rules'
  'openlinkhub.install'
  'openlinkhub.modules-load'
  'openlinkhub.service'
  'openlinkhub.sysusers'
  'openlinkhub.tmpfiles'
)
sha256sums=('c77b3f914afa0cb9a7bbd5079bfe7be379dddafd71897979db72fdbf2a7c19ff'
            '75eae4f13d228c33655c2690d553e602d94020183a792200340242b526e2e12c'
            '52e9a4fd9f3f293439efaf3bffdee143c997c0cae1991c62b3de61a108b6cf56'
            '129b979310b1a9f52f99512eb81d57fb2f4883eb1c16dbb55530c6b59c1fb46a'
            '9340b6d1e54e35e13fb8f3c5bac90b1a6212aa6af916c865ecf50c7508cbfb29'
            '60bc3e4d162d1cfef296bc4838deddfe0c9fc9ca661edb42b79ee178f6966152'
            '0f39377e1cfa6b20416ceccfb5b684f6a5419d0b41cd29f9838bc353afd38af7')

build() {
  cd "OpenLinkHub-$pkgver"

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  # libpipewire's pkg-config flags include -fno-strict-overflow, which cgo
  # rejects unless explicitly allowed
  export CGO_CFLAGS_ALLOW='-fno-strict-overflow'
  export GOFLAGS="-buildmode=pie -mod=readonly -modcacherw"

  go build -trimpath \
    -ldflags "-linkmode=external -X OpenLinkHub/src/version.Version=${pkgver}" \
    -o "$pkgname" .
}

package() {
  cd "OpenLinkHub-$pkgver"

  install -Dm755 "$pkgname" -t "$pkgdir/usr/bin"
  install -Dm644 "$srcdir/$pkgname.service" -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 "$srcdir/$pkgname.sysusers" "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -Dm644 "$srcdir/$pkgname.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"
  install -Dm644 "$srcdir/$pkgname.modules-load" "$pkgdir/usr/lib/modules-load.d/$pkgname.conf"
  install -Dm644 99-openlinkhub.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 "$srcdir/98-openlinkhub-memory.rules" -t "$pkgdir/usr/lib/udev/rules.d"

  # The daemon resolves database/, static/ and web/ relative to its working
  # directory and writes config.json and profile data there, so the mutable
  # state lives in /var/lib instead of /usr/share.
  install -d "$pkgdir/var/lib/$pkgname"
  cp -a database static web "$pkgdir/var/lib/$pkgname/"

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
