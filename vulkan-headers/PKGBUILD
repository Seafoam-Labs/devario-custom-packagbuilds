pkgname=vulkan-headers
pkgver=1.4.364
pkgrel=1
pkgdesc='Vulkan header files and API registry'
arch=('any')
url='https://github.com/KhronosGroup/Vulkan-Headers'
license=('Apache-2.0' 'MIT')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('37e00e30611375938a9437477de793e355e55d486c25ab3dfd7a1a11ab0f8f07')

build() {
  cmake -S "Vulkan-Headers-$pkgver" -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DVULKAN_HEADERS_ENABLE_INSTALL=ON \
    -DVULKAN_HEADERS_ENABLE_TESTS=OFF \
    -DVULKAN_HEADERS_ENABLE_MODULE=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "Vulkan-Headers-$pkgver/LICENSE.md" \
    -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "Vulkan-Headers-$pkgver/"LICENSES/*.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
