pkgname=libnewt
pkgver=0.52.25
pkgrel=2
_tclver=8.6
pkgdesc="Not Erik's Windowing Toolkit - text mode windowing with slang"
arch=(x86_64)
url='https://pagure.io/newt'
license=(GPL-2.0-only)
depends=(
  glibc
  gpm
  popt
  slang
)
makedepends=(
  "tcl>=$_tclver"
  python
)
optdepends=(
  'python: libnewt support with the _snack module'
  'tcl: whiptcl support'
)
source=("https://releases.pagure.org/newt/newt-${pkgver}.tar.gz")
b2sums=('d134559555f734ef6bdbc56aeec5b7764beb179720d21c49852b13259d68474a4505bca410dc49b36b1cc57f734510fd9b3974ad70a9e51740489834a5fc6441')

prepare() {
  cd "newt-${pkgver}"
  echo '#define USE_INTERP_RESULT 1' >> config.h
  sed -i "s:tcl8.4:tcl$_tclver:" Makefile.in

  ./autogen.sh
}

build() {
  cd "newt-${pkgver}"
  ./configure --prefix=/usr --with-gpm-support
  make
}

package() {
  DESTDIR=$pkgdir make -C "newt-${pkgver}" install
}
