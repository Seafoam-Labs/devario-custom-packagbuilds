_reverts=(
)

pkgver() {
  cd "$_gitname" || return 1

  local desc ver iteration rev hash
  desc=$(git describe --long --tags --abbrev=9) || return 1

  if [[ $desc =~ ^v([0-9]+\.[0-9]+\.[0-9]+)-devario([0-9]*)-([0-9]+)-g([[:xdigit:]]+)$ ]]; then
    ver=${BASH_REMATCH[1]}
    iteration=${BASH_REMATCH[2]:-1}
    rev=${BASH_REMATCH[3]}
    hash=${BASH_REMATCH[4]}
    printf '%s.devario.%s.r%s.g%s\n' "$ver" "$iteration" "$rev" "$hash"
  else
    printf '%s\n' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  fi
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_characterize \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests \
     --exclude scx_arena_libarena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' ! -name 'xtask' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

  # Runtime data via xtask: scx.service, /etc/default/scx,
  # /usr/share/scx/catalog.json, the scxcli polkit policy.
  # --source-dir keeps cargo out of package().
  ./target/$_mode/xtask install --source-dir . --destdir "$pkgdir"
}
